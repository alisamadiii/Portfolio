{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NODE_ENV",
        "VERCEL_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "NEXT_PUBLIC_API_URL",
        "VITE_API_URL",
        "VITE_API_BASE",
        "GITHUB_WEBHOOK_URL_BASE",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "CRYPTO_KEY",
        "GITHUB_APP_ID",
        "GITHUB_APP_NAME",
        "GITHUB_APP_PRIVATE_KEY",
        "GITHUB_APP_WEBHOOK_SECRET",
        "USESEND_API_KEY",
        "USESEND_URL",
        "USESEND_CONTACT_BOOK_ID",
        "USESEND_ADMIN_API_KEY",
        "USESEND_DOMAIN_REGION",
        "R2_ENDPOINT",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET",
        "R2_PUBLIC_BASE_URL",
        "GOOGLE_PLACES_API_KEY",
        "APIFY_TOKEN",
        "UBER_EATS_CLIENT_ID",
        "UBER_EATS_CLIENT_SECRET",
        "UBER_EATS_ENV",
        "DOORDASH_DEVELOPER_ID",
        "DOORDASH_KEY_ID",
        "DOORDASH_SIGNING_SECRET",
        "DOORDASH_OAUTH_CLIENT_ID",
        "DOORDASH_WEBHOOK_TOKEN",
        "DOORDASH_ENV",
        "GRUBHUB_PARTNER_KEY",
        "GRUBHUB_CLIENT_ID",
        "GRUBHUB_CLIENT_SECRET",
        "GRUBHUB_ISSUE_DATE",
        "GRUBHUB_ENV",
        "GRUBHUB_WEBHOOK_USER",
        "GRUBHUB_WEBHOOK_PASSWORD",
        "GOOGLE_ADS_DEVELOPER_TOKEN",
        "GOOGLE_ADS_CLIENT_ID",
        "GOOGLE_ADS_CLIENT_SECRET",
        "GOOGLE_ADS_REFRESH_TOKEN",
        "GOOGLE_ADS_LOGIN_CUSTOMER_ID",
        "GOOGLE_ADS_API_VERSION"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
