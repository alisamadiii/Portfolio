{
  "name": "agency",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 3004",
    "build": "astro build",
    "preview": "astro preview --port 3004",
    "services:images": "node scripts/fetch-service-images.mjs",
    "blog:images": "node scripts/fetch-blog-images.mjs",
    "clients:screenshots": "node --experimental-strip-types scripts/fetch-client-screenshots.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,css,md}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css,md}\" \"scripts/*.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^5.17.3"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.18",
    "playwright": "^1.62.1",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.18"
  }
}
