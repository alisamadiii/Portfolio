---
// About — faithful translation of the "About Us" design mockup.
import MockupLayout from "../layouts/MockupLayout.astro";
import MAIN from "../html/main/about.html?raw";

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/about`;

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "About", item: pageUrl },
    ],
  },
];
---

<MockupLayout
  title="About Us — Ali Samadi Agency | Custom Web Design Studio"
  description="Ali Samadi Agency is a founder-led web design studio in Jacksonville, FL building custom Next.js websites for startups and small businesses — no templates."
  canonical={pageUrl}
  og={{
    title: "About Us — Ali Samadi Agency",
    description:
      "A founder-led web design studio in Jacksonville, FL building custom Next.js websites for startups and small businesses — no templates.",
    url: pageUrl,
    twitterDescription:
      "Founder-led web design studio building custom Next.js websites — no templates.",
  }}
  schema={schema}
  pageType="AboutPage"
>
  <Fragment set:html={MAIN} />
</MockupLayout>
