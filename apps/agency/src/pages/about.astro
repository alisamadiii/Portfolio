---
// About — faithful translation of the "About Us" design mockup.
import MockupLayout from "../layouts/MockupLayout.astro";
import MAIN from "../html/main/about.html?raw";

// Hidden while the lead-gen offer has no results to show yet.
// Flip back to true to restore the stats strip.
const SHOW_STATS = false;
const body = SHOW_STATS
  ? MAIN
  : MAIN.replace(/<section aria-label="Agency at a glance"[\s\S]*?<\/section>/, "");

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/about`;

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "About", item: pageUrl },
    ],
  },
];
---

<MockupLayout
  title="About Us | Ali Samadi Agency, Lead Generation"
  description="A founder-led agency working with businesses everywhere. We run the Google Ads that bring in customers and build websites that turn them into booked jobs."
  canonical={pageUrl}
  og={{
    title: "About Us — Ali Samadi Agency",
    description:
      "A founder-led lead generation agency: Google Ads, websites that convert, and every lead tracked.",
    url: pageUrl,
    twitterDescription:
      "Founder-led lead generation agency: Google Ads plus the websites that convert them.",
  }}
  schema={schema}
  pageType="AboutPage"
>
  <Fragment set:html={body} />
</MockupLayout>
