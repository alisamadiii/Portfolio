---
// Pest control industry page — self-contained bespoke design (own nav/footer,
// near-black exterminator theme). Uses Layout directly, not the shared light
// MockupLayout. SEO/schema carried over from the previous hand-built version.
import Layout from "../layouts/Layout.astro";
import "../styles/pest-control.css";
import MockupScripts from "../components/MockupScripts.astro";
import RAW_BODY from "../html/pest-control.html?raw";
import { PLANS, FROM_PRICE, fmtPrice } from "../data/pricing";

const BODY = RAW_BODY.replaceAll("{{FROM_PRICE}}", fmtPrice(FROM_PRICE)).replaceAll(
  "{{TOP_PRICE}}",
  fmtPrice(PLANS[PLANS.length - 1].monthly)
);

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/pest-control`;

const faqs = [
  {
    q: "How much does a pest control website cost?",
    a: `The website is included in a growth plan starting at ${fmtPrice(FROM_PRICE)} a month, which also covers running your Google Ads, call tracking, hosting, and edits. No setup fee, and Google bills the ad spend to you directly.`,
  },
  {
    q: "I already have a website. Can you redesign it?",
    a: "Yes, and that is most of this work. We rebuild it from scratch on a modern stack, move your content and reviews over, and redirect every old page so you keep the Google rankings you already earned.",
  },
  {
    q: "Do you write the content?",
    a: "Yes. You tell us what you treat, where you work, and what makes you different. We write every page, including the per-pest and per-city pages, in plain language your customers actually search for.",
  },
  {
    q: "Can you add online booking?",
    a: "Yes. At minimum you get a quote form that emails you the pest, the address, and photos. If you use a scheduling tool, we wire it in so customers can book a slot directly.",
  },
  {
    q: "What about my Google Business Profile?",
    a: "The website and your profile work as a pair: we link them, match your name and address exactly, and feed your reviews onto the site. That consistency is a big part of ranking in the map results.",
  },
  {
    q: "How long does it take?",
    a: "You see a homepage design within the first week. A typical pest control site is live in two to three weeks, including the service and city pages.",
  },
];

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Pest Control Websites",
        item: pageUrl,
      },
    ],
  },
  {
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: "Pest Control Lead Generation",
    serviceType: "Lead generation for pest control companies",
    description:
      "Lead generation for pest control and exterminator companies: managed Google Ads plus a website with click-to-call, service area pages, review walls, and booking forms, for one monthly price.",
    provider: { "@id": `${SITE}/#organization` },
    areaServed: "US",
    url: pageUrl,
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Layout
  title="Pest Control Lead Generation | Google Ads + Websites"
  description="More pest control calls: Google Ads that catch local pest searches, sent to a site with click-to-call, service area pages, reviews, and booking forms."
  canonical={pageUrl}
  og={{
    title: "Lead Generation for Pest Control Companies | Ali Samadi Agency",
    description:
      "When someone finds a roach at 11pm, they call the first company that looks legit on their phone. We run the ads and build the site that win that call.",
    url: pageUrl,
    twitterDescription:
      "Pest control marketing that makes the phone ring: Google Ads, click-to-call, city pages, reviews, booking. One monthly price.",
    image: "/og/pest-control.jpg",
  }}
  schema={schema}
  bodyClass=""
>
  <Fragment set:html={BODY} />
  <style is:global set:html={"html,body{background:rgb(13, 18, 15);}"} />
  <script type="application/json" id="faq-data" set:html={JSON.stringify(faqs)}
  ></script>
  <MockupScripts />
</Layout>
