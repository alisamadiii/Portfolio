---
// Restaurants industry page — self-contained bespoke design (own nav/footer,
// warm-cream theme). Uses Layout directly, not the shared light MockupLayout.
import Layout from "../layouts/Layout.astro";
import "../styles/restaurants.css";
import MockupScripts from "../components/MockupScripts.astro";
import RAW_BODY from "../html/restaurants.html?raw";
import { PLANS, FROM_PRICE, fmtPrice } from "../data/pricing";

const BODY = RAW_BODY.replaceAll("{{FROM_PRICE}}", fmtPrice(FROM_PRICE)).replaceAll(
  "{{TOP_PRICE}}",
  fmtPrice(PLANS[PLANS.length - 1].monthly)
);

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/restaurants`;
---

<Layout
  title="Restaurant Marketing & Websites | Orders, Bookings, Regulars"
  description="Restaurant marketing for Jacksonville and Florida: Google Ads, email that brings regulars back, and a website with fast menus, online ordering, and reservations."
  canonical={pageUrl}
  og={{
    title: "Restaurant Marketing & Websites | Ali Samadi Agency",
    description:
      "More covers, more orders, more regulars: ads, email, and a website with fast menus, online ordering, and reservations.",
    url: pageUrl,
    twitterDescription:
      "More covers, more orders, more regulars.",
  }}
  bodyClass=""
>
  <Fragment set:html={BODY} />
  <style is:global set:html={"html,body{background:rgb(251, 243, 228);}"} />
  <MockupScripts />
</Layout>
