---
// Feedback app (Client Hub): a client's public review link. Their customer
// taps 1 to 5 stars. 5 stars → a button to post the review on Google. 1 to 4
// → a private feedback form that lands in the client's hub (with a small
// "post on Google" link still offered, per Google's review policy: no gating).
// Business details come from the api (/api/review/<id>), branded with the
// client's own logo and name. Not indexed, not in the sitemap.
import Layout from "../../layouts/Layout.astro";

export const prerender = false;

// Dev talks to the local api (prod doesn't have unreleased routes).
const API_URL = import.meta.env.DEV
  ? "http://localhost:3000"
  : (process.env.API_URL ?? "https://api.alisamadii.com");
const { id = "" } = Astro.params;

type Business = {
  name: string;
  address: string | null;
  phone: string | null;
  logoUrl: string | null;
  websiteUrl: string | null;
  googleUrl: string;
};

let business: Business | null = null;
try {
  const res = await fetch(`${API_URL}/api/review/${encodeURIComponent(id)}`);
  if (res.ok) business = (await res.json()) as Business;
} catch {
  business = null;
}
if (!business) return Astro.rewrite("/404");

const endpoint = `${API_URL}/api/review/${encodeURIComponent(id)}`;
const initial = business.name.trim().charAt(0).toUpperCase();
const telHref = business.phone ? `tel:${business.phone.replace(/[^\d+]/g, "")}` : null;
---

<Layout
  title={`Rate ${business.name}`}
  description={`How was your experience with ${business.name}?`}
  robots="noindex, nofollow"
  bodyClass="bg-cream text-charcoal antialiased"
>
  <main class="flex min-h-dvh flex-col items-center px-4 py-10 sm:py-16">
    <div class="w-full max-w-[460px]">
      <div class="rv-in rounded-[20px] bg-white p-6 shadow-[0_0_0_1px_rgba(27,26,23,0.06),0_14px_34px_rgba(27,26,23,0.08)] sm:p-8">
        <header class="flex flex-col items-center gap-4 text-center">
          {
            business.logoUrl ? (
              <img
                src={business.logoUrl}
                alt={business.name}
                width="72"
                height="72"
                class="rv-in size-[72px] rounded-2xl bg-white object-contain" style="animation-delay:60ms"
              />
            ) : (
              <span style="animation-delay:60ms" class="rv-in flex size-[72px] items-center justify-center rounded-2xl bg-charcoal text-2xl font-semibold text-white">
                {initial}
              </span>
            )
          }
          <div class="rv-in flex flex-col gap-1" style="animation-delay:110ms">
            <h1 class="text-[22px] font-semibold tracking-tight">{business.name}</h1>
            {business.address && <p class="text-sm text-warmgray">{business.address}</p>}
          </div>
        </header>

        <!-- Step 1: rating -->
        <div class="step" data-step="rate" data-open data-settled>
          <div class="step-inner"><section class="pt-8 flex flex-col items-center gap-5 text-center">
          <p class="rv-in text-[17px] font-medium" style="animation-delay:160ms">How was your experience?</p>
          <div class="flex gap-1.5" role="radiogroup" aria-label="Your rating">
            {
              [1, 2, 3, 4, 5].map((n) => (
                <button
                  type="button"
                  data-star={n}
                  role="radio"
                  aria-checked="false"
                  aria-label={`${n} star${n > 1 ? "s" : ""}`}
                  style={`animation-delay:${180 + n * 45}ms`}
                  class="star rv-pop rounded-lg p-1 text-[#d9d4cc] transition-transform duration-150 hover:scale-110 focus-visible:outline-2 focus-visible:outline-accent"
                >
                  <svg viewBox="0 0 24 24" class="size-11 fill-current" aria-hidden="true">
                    <path
                      d="M12 3.5l2.6 5.35 5.9.85-4.27 4.15 1 5.85L12 16.95l-5.23 2.75 1-5.85L3.5 9.7l5.9-.85z"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
              ))
            }
          </div>
          <p class="rv-in text-xs text-muted" style="animation-delay:450ms">Tap a star</p>
        </section></div>
        </div>

        <!-- 5 stars -->
        <div class="step" data-step="google" inert>
          <div class="step-inner"><section class="pt-8 flex flex-col items-center gap-4 text-center">
          <p class="text-[19px] font-semibold">Thank you, that means a lot!</p>
          <p class="text-[15px] leading-relaxed text-warmgray">
            Would you share it on Google? It takes a minute and helps other people find {business.name}.
          </p>
          <a
            href={business.googleUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-google
            class="mt-1 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-accent px-6 text-[16px] font-medium text-charcoal"
          >
            Post your review on Google <span aria-hidden="true">↗</span>
          </a>
          <p class="text-xs text-muted">Opens Google in a new tab</p>
        </section></div>
        </div>

        <!-- 1 to 4 stars -->
        <div class="step" data-step="feedback" inert>
          <div class="step-inner"><section class="pt-8">
          <form class="flex flex-col gap-4" novalidate>
            <div class="flex flex-col gap-1 text-center">
              <p class="text-[19px] font-semibold">We're sorry it wasn't perfect</p>
              <p class="text-[15px] leading-relaxed text-warmgray">
                Tell us what happened. This goes straight to the {business.name} team.
              </p>
            </div>
            <label class="flex flex-col gap-1.5">
              <span class="text-sm font-medium">What could we do better?</span>
              <textarea
                name="message"
                rows="5"
                required
                maxlength="5000"
                class="rounded-xl border border-[#e4dfd7] bg-white px-3.5 py-3 text-[15px] outline-none focus:border-accent"
              ></textarea>
            </label>
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="flex flex-col gap-1.5">
                <span class="text-sm font-medium">Name <span class="font-normal text-muted">(optional)</span></span>
                <input
                  name="name"
                  maxlength="200"
                  autocomplete="name"
                  class="h-11 rounded-xl border border-[#e4dfd7] bg-white px-3.5 text-[15px] outline-none focus:border-accent"
                />
              </label>
              <label class="flex flex-col gap-1.5">
                <span class="text-sm font-medium">Email or phone <span class="font-normal text-muted">(optional)</span></span>
                <input
                  name="contact"
                  maxlength="200"
                  class="h-11 rounded-xl border border-[#e4dfd7] bg-white px-3.5 text-[15px] outline-none focus:border-accent"
                />
              </label>
            </div>
            <input type="text" name="hp" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
            <p data-error hidden class="text-sm text-accent-ink"></p>
            <button
              type="submit"
              class="inline-flex min-h-12 items-center justify-center rounded-xl bg-charcoal px-6 text-[16px] font-medium text-white disabled:opacity-60"
            >
              Send feedback
            </button>
            <p class="text-center text-[13px] text-muted">
              Prefer to post publicly?
              <a href={business.googleUrl} target="_blank" rel="noopener noreferrer" data-google class="underline underline-offset-2">
                Review on Google
              </a>
            </p>
          </form>
        </section></div>
        </div>

        <!-- After private feedback -->
        <div class="step" data-step="thanks" inert>
          <div class="step-inner"><section class="pt-8 flex flex-col items-center gap-2 text-center">
          <p class="text-[19px] font-semibold">Thank you for telling us</p>
          <p class="text-[15px] leading-relaxed text-warmgray">
            The {business.name} team will read it and follow up if you left your details.
          </p>
        </section></div>
        </div>
      </div>

      {
        (business.phone || business.websiteUrl) && (
          <p class="mt-5 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-[13px] text-warmgray">
            {business.phone && telHref && (
              <a href={telHref} class="hover:text-charcoal">
                {business.phone}
              </a>
            )}
            {business.websiteUrl && (
              <a href={business.websiteUrl} rel="noopener" class="hover:text-charcoal">
                {business.websiteUrl.replace(/^https?:\/\//, "").replace(/\/$/, "")}
              </a>
            )}
          </p>
        )
      }
    </div>
  </main>
</Layout>

<style is:global>
  @keyframes rv-in {
    from { opacity: 0; transform: translateY(10px); filter: blur(4px); }
  }
  @keyframes rv-pop {
    from { opacity: 0; transform: scale(0.6); filter: blur(3px); }
  }
  @keyframes rv-tap {
    40% { transform: scale(1.22); }
  }
  .rv-in { animation: rv-in 0.45s cubic-bezier(0.2, 0, 0, 1) backwards; }
  .rv-pop { animation: rv-pop 0.35s cubic-bezier(0.2, 0, 0, 1) backwards; }
  .rv-tap { animation: rv-tap 0.28s cubic-bezier(0.2, 0, 0, 1); }

  /* Steps expand open (grid rows 0fr to 1fr) instead of popping in. */
  .step {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    filter: blur(4px);
    transition:
      grid-template-rows 0.4s cubic-bezier(0.2, 0, 0, 1),
      opacity 0.3s ease,
      filter 0.3s ease;
  }
  .step[data-open] { grid-template-rows: 1fr; opacity: 1; filter: none; }
  .step-inner { min-height: 0; overflow: hidden; }
  .step[data-settled] > .step-inner { overflow: visible; }

  @media (prefers-reduced-motion: reduce) {
    .rv-in, .rv-pop, .rv-tap { animation: none; }
    .step { transition: none; }
  }
</style>

<script is:inline define:vars={{ endpoint }}>
  (() => {
    const loadedAt = Date.now();
    const steps = document.querySelectorAll("[data-step]");
    const show = (name) =>
      steps.forEach((el) => {
        // The rating stays visible next to the form so it can be changed.
        const open = el.dataset.step === name || (name !== "thanks" && el.dataset.step === "rate");
        if (open === el.hasAttribute("data-open")) return;
        el.toggleAttribute("data-open", open);
        el.toggleAttribute("data-settled", false);
        el.inert = !open;
      });
    // Content may overflow (focus rings) only once the expand has finished.
    steps.forEach((el) =>
      el.addEventListener("transitionend", (e) => {
        if (e.target === el && e.propertyName === "grid-template-rows" && el.hasAttribute("data-open")) {
          el.toggleAttribute("data-settled", true);
        }
      })
    );

    let feedbackId = null;
    let rating = 0;
    let pending = Promise.resolve();

    const post = (body) =>
      fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(feedbackId ? { ...body, feedbackId } : body),
        keepalive: true,
      }).then(async (res) => {
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || "Something went wrong. Please try again.");
        if (data.feedbackId) feedbackId = data.feedbackId;
        return data;
      });

    const stars = document.querySelectorAll("[data-star]");
    const paint = (n) =>
      stars.forEach((s) => {
        const on = Number(s.dataset.star) <= n;
        s.style.color = on ? "#fc8464" : "";
        s.setAttribute("aria-checked", String(Number(s.dataset.star) === n));
      });

    stars.forEach((star) => {
      star.addEventListener("mouseenter", () => paint(Number(star.dataset.star)));
      star.addEventListener("mouseleave", () => paint(rating));
      star.addEventListener("click", () => {
        rating = Number(star.dataset.star);
        paint(rating);
        star.classList.remove("rv-tap");
        void star.offsetWidth;
        star.classList.add("rv-tap");
        // Nothing is saved on tap: only a sent form or a Google click counts.
        show(rating === 5 ? "google" : "feedback");
      });
    });

    document.querySelectorAll("[data-google]").forEach((a) =>
      a.addEventListener("click", () => {
        // Chained so a double click never creates two rows.
        pending = pending.then(() => post({ rating, google: true })).catch(() => {});
      })
    );

    const form = document.querySelector("[data-step=feedback] form");
    const error = form.querySelector("[data-error]");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const message = String(fd.get("message") || "").trim();
      if (!message) {
        error.textContent = "Please tell us a little about what happened.";
        error.hidden = false;
        return;
      }
      error.hidden = true;
      const button = form.querySelector("button[type=submit]");
      button.disabled = true;
      try {
        await pending;
        await post({
          rating,
          message,
          name: String(fd.get("name") || ""),
          contact: String(fd.get("contact") || ""),
          hp: String(fd.get("hp") || ""),
          t: Date.now() - loadedAt,
        });
        show("thanks");
      } catch (err) {
        error.textContent = err.message;
        error.hidden = false;
        button.disabled = false;
      }
    });
  })();
</script>
