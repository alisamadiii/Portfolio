---
import Layout from "../layouts/Layout.astro";
import BackNav from "../components/BackNav.astro";
import HomeFooter from "../components/HomeFooter.astro";

const SITE = "https://agency.alisamadii.com";
const pageUrl = `${SITE}/contact`;

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Contact", item: pageUrl },
    ],
  },
];

const channels = [
  {
    label: "Email",
    value: "agency@alisamadii.com",
    href: "mailto:agency@alisamadii.com",
    note: "Best for project inquiries — we reply within a day.",
    external: false,
  },
  {
    label: "Schedule",
    value: "Book a Meeting",
    href: "https://cal.com/alisamadii",
    note: "Pick a time that works and we'll talk through your project.",
    external: true,
  },
  {
    label: "Phone",
    value: "+1 (971) 382-8969",
    href: "tel:+19713828969",
    note: "Call or text during US business hours.",
    external: false,
  },
  {
    label: "Location",
    value: "Jacksonville, FL",
    href: "https://maps.google.com/?q=Jacksonville,+FL",
    note: "Based in Florida, working with clients everywhere.",
    external: true,
  },
];
---

<Layout
  title="Contact — Ali Samadi Agency | Start Your Project"
  description="Get in touch with Ali Samadi Agency — email, book a call, or phone. Based in Jacksonville, FL, working with startups and small businesses everywhere."
  canonical={pageUrl}
  og={{
    title: "Contact — Ali Samadi Agency",
    description:
      "Get in touch — email, book a call, or phone. Based in Jacksonville, FL, working with clients everywhere.",
    url: pageUrl,
    twitterDescription:
      "Get in touch — email, book a call, or phone. Based in Jacksonville, FL.",
  }}
  schema={schema}
  pageType="ContactPage"
  bodyClass="noise bg-cream text-charcoal selection:bg-accent/20 selection:text-accent font-sans"
>
  <BackNav backHref="/" backLabel="Back to Home" fixed />

  <!-- ==================== HERO ==================== -->
  <section class="px-4 pt-32 pb-16 md:px-8 md:pt-40 md:pb-20">
    <div class="mx-auto max-w-[1200px]">
      <div
        class="mb-6 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] text-muted uppercase"
      >
        <span class="h-px w-[26px] bg-accent"></span>Get in Touch
      </div>
      <h1
        class="text-[clamp(38px,5.5vw,72px)] leading-[1.02] font-semibold tracking-[-0.035em]"
      >
        Let's create something <span class="text-accent">amazing</span>
      </h1>
      <p
        class="mt-6 max-w-[52ch] text-[17px] leading-[1.6] text-warmgray md:text-[18px]"
      >
        Ready to elevate your digital presence? Tell us about your project — the
        fastest way to start is an email or a quick call.
      </p>
      <div class="mt-9">
        <a
          href="mailto:agency@alisamadii.com"
          class="mag-btn inline-flex items-center gap-2.5 rounded-xl bg-accent px-[26px] py-[15px] text-base font-medium text-white shadow-[0_10px_30px_rgba(252,132,100,0.35)] hover:bg-charcoal"
        >
          Start a Conversation
          <span>&#8599;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== CHANNELS ==================== -->
  <section
    class="mx-auto max-w-[1200px] border-t border-charcoal/[0.08] px-6 py-[70px] md:px-10"
  >
    <div
      class="stagger grid grid-cols-1 gap-[22px] sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        channels.map((c) => (
          <a
            href={c.href}
            target={c.external ? "_blank" : undefined}
            rel={c.external ? "noopener noreferrer" : undefined}
            class="reveal group block rounded-[18px] border border-charcoal/[0.08] bg-white p-6"
          >
            <div class="font-mono text-[11.5px] tracking-[0.08em] text-[#a49d94] uppercase">
              {c.label}
            </div>
            <div class="mt-2.5 text-[17px] font-semibold tracking-[-0.01em] transition-colors duration-300 group-hover:text-accent">
              {c.value}
            </div>
            <p class="mt-2 text-[14px] leading-[1.55] text-warmgray">
              {c.note}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ==================== NEXT STEPS ==================== -->
  <section
    class="mx-auto max-w-[1200px] border-t border-charcoal/[0.08] px-6 py-[70px] md:px-10"
  >
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1fr_1.4fr] md:gap-14">
      <h2
        class="reveal text-[clamp(28px,3.2vw,42px)] leading-[1.1] font-semibold tracking-[-0.03em]"
      >
        What happens next
      </h2>
      <div class="space-y-5 text-[16.5px] leading-[1.65] text-warmgray">
        <p class="reveal">
          Tell us what you're building and we'll come back with a plan — scope,
          timeline, and a clear price. Most projects fit our
          <a href="/pricing" class="text-accent hover:underline"
            >standard pricing</a
          >; bigger ideas get a custom quote.
        </p>
        <p class="reveal">
          Not sure what you need yet? Browse
          <a href="/work" class="text-accent hover:underline">our work</a> or read
          <a href="/about" class="text-accent hover:underline"
            >about the studio</a
          > first — then reach out whenever you're ready.
        </p>
      </div>
    </div>
  </section>

  <HomeFooter />
</Layout>

<style is:global>
  html {
    scrollbar-gutter: stable;
  }
  .mag-btn {
    transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .mag-btn:active {
    transform: scale(0.97);
  }
</style>

<script is:inline data-astro-rerun>
  (() => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "-60px" }
    );
    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
  })();
</script>
