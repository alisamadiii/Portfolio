---
// Contact — migrated to the mockup design system (MockupLayout). Keeps the
// working QuoteForm and the contact channels. Dark CTA from the shared block.
import MockupLayout from "../layouts/MockupLayout.astro";
import QuoteForm from "../components/QuoteForm.astro";
import CTA from "../html/blocks/cta.html?raw";

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/contact`;

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Contact", item: pageUrl },
    ],
  },
];

const channels = [
  {
    label: "Email",
    value: "agency@alisamadii.com",
    href: "mailto:agency@alisamadii.com",
    note: "Best for project inquiries — we reply within a day.",
    external: false,
  },
  {
    label: "Schedule",
    value: "Book a Meeting",
    href: "#",
    note: "Pick a time that works and we'll talk through your project.",
    external: false,
    booking: true,
  },
  {
    label: "Phone",
    value: "+1 (971) 382-8969",
    href: "tel:+19713828969",
    note: "Call or text during US business hours.",
    external: false,
  },
];
---

<MockupLayout
  title="Contact Ali Samadi Agency | Get More Leads for Your Business"
  description="Get in touch with Ali Samadi Agency by email, call, or the form. Working with businesses everywhere to get more calls and booked jobs."
  canonical={pageUrl}
  og={{
    title: "Contact — Ali Samadi Agency",
    description:
      "Get in touch — email, book a call, or phone. Working with clients everywhere.",
    url: pageUrl,
    twitterDescription:
      "Get in touch — email, book a call, or phone.",
  }}
  schema={schema}
  pageType="ContactPage"
>
  <main id="top">
    <!-- Hero -->
    <section style="padding: 140px 0 32px;">
      <div class="wrap" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:22px;">
        <p class="eyebrow"><span></span>Contact</p>
        <h1 class="hero-h1" style="margin:0;max-width:16ch;font-size:clamp(40px,6vw,76px);line-height:1.02;font-weight:600;letter-spacing:-0.035em;">
          Let's get your phone <span style="color:rgb(194,69,31);font-style:italic;">ringing</span>
        </h1>
        <p style="margin:0;max-width:56ch;font-size:clamp(17px,1.6vw,20px);line-height:1.55;color:rgb(103,98,90);">
          Tell us your business and service area. We'll reply with a plan for
          more leads. The fastest way to start is the form below, an email, or a
          quick call.
        </p>
      </div>
    </section>

    <!-- Quote form -->
    <section id="quote" style="padding: 24px 0 72px; scroll-margin-top: 96px;">
      <div class="wrap">
        <div style="max-width:760px;margin-inline:auto;">
          <QuoteForm heading="Start the conversation" />
        </div>
      </div>
    </section>

    <!-- Channels -->
    <section style="padding: 72px 0; border-top: 1px solid rgba(27,26,23,0.06);">
      <div class="wrap" style="display:flex;flex-direction:column;gap:36px;">
        <div style="display:flex;flex-direction:column;gap:16px;max-width:640px;">
          <p class="eyebrow"><span></span>Other ways to reach us</p>
          <h2 style="margin:0;font-size:clamp(30px,3.6vw,44px);line-height:1.08;font-weight:600;letter-spacing:-0.025em;">
            Pick whatever's easiest
          </h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;">
          {
            channels.map((c) => {
              const inner = (
                <>
                  <p class="mono" style="margin:0;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:rgb(107,102,93);">
                    {c.label}
                  </p>
                  <p style="margin:0;font-size:18px;font-weight:600;letter-spacing:-0.01em;color:rgb(194,69,31);">
                    {c.value}
                  </p>
                  <p style="margin:0;font-size:14px;line-height:1.55;color:rgb(103,98,90);">
                    {c.note}
                  </p>
                </>
              );
              const cardStyle =
                "text-align:left;text-decoration:none;color:rgb(27,26,23);border-radius:18px;background:rgb(255,254,252);box-shadow:rgba(27,26,23,0.04) 0px 0px 0px 1px, rgba(27,26,23,0.08) 0px 10px 28px;padding:26px;display:flex;flex-direction:column;gap:10px;";
              return c.booking ? (
                <button type="button" data-booking class="lift" style={`${cardStyle}border:none;cursor:pointer;font:inherit;width:100%;`}>
                  {inner}
                </button>
              ) : (
                <a
                  href={c.href}
                  target={c.external ? "_blank" : undefined}
                  rel={c.external ? "noopener noreferrer" : undefined}
                  class="lift"
                  style={cardStyle}
                >
                  {inner}
                </a>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- Dark CTA -->
    <Fragment set:html={CTA} />
  </main>
</MockupLayout>
