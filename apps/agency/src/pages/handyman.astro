---
// Handyman industry page — self-contained bespoke design (own nav/footer,
// navy + grid theme). Uses Layout directly, not the shared light MockupLayout.
import Layout from "../layouts/Layout.astro";
import "../styles/handyman.css";
import MockupScripts from "../components/MockupScripts.astro";
import RAW_BODY from "../html/handyman.html?raw";
import { PLANS, FROM_PRICE, fmtPrice } from "../data/pricing";

const BODY = RAW_BODY.replaceAll("{{FROM_PRICE}}", fmtPrice(FROM_PRICE)).replaceAll(
  "{{TOP_PRICE}}",
  fmtPrice(PLANS[PLANS.length - 1].monthly)
);

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/handyman`;
---

<Layout
  title="Handyman Marketing & Lead Generation | Sites + Ads That Book Jobs"
  description="More estimate requests for handymen and home-repair pros: Google Ads that reach nearby homeowners and a site that shows your work and books jobs."
  canonical={pageUrl}
  og={{
    title: "Handyman Marketing & Lead Generation | Ali Samadi Agency",
    description:
      "You fix homes. We fill your schedule with Google Ads and a site that shows your work and sends estimate requests straight to your inbox.",
    url: pageUrl,
    twitterDescription:
      "Handyman marketing that books jobs: ads, a site that shows your work, and estimate requests while you're on the ladder.",
  }}
  bodyClass=""
>
  <Fragment set:html={BODY} />
  <style is:global set:html={"html,body{background:rgb(242, 239, 232);}"} />
  <MockupScripts />
</Layout>
