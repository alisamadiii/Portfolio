---
// Managed Newsletter offer page — faithful translation of the mockup frame.
// SEO/schema carried over from the previous hand-built version.
import MockupLayout from "../../layouts/MockupLayout.astro";
import MAIN from "../../html/main/newsletter.html?raw";

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/newsletter`;

const faqs = [
  {
    q: "What does it cost?",
    a: "A flat monthly amount quoted for your business — not a per-contact price that climbs every time someone subscribes. For a growing list it works out to a fraction of what Mailchimp or Klaviyo charge, and you get the number in writing before you commit to anything.",
  },
  {
    q: "Do I have to write the newsletter myself?",
    a: "Only if you want to. The editor is simple enough to send a monthly update in minutes — or you send us the news (a new offer, an event, a menu change) and we write, design, and send it for you.",
  },
  {
    q: "Can I bring my existing contact list?",
    a: "Yes. Send us the list you have — a spreadsheet, an export from another tool, even a stack of loyalty-card emails — and we import and clean it during setup.",
  },
  {
    q: "Is this just Mailchimp under the hood?",
    a: "No. It's a private email platform we run for you, branded with your business and sending from your own domain. There's no third-party logo in your emails and no shared platform address.",
  },
  {
    q: "Who owns the subscriber list?",
    a: "You do, always. Export it any time with one click — and it stays yours even if you cancel.",
  },
];

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Business Newsletter",
        item: pageUrl,
      },
    ],
  },
  {
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: "Managed Email Newsletter",
    serviceType: "Email newsletter management",
    description:
      "A branded email newsletter for businesses, sent from the business's own domain — setup, deliverability, writing, and sending managed by the agency for a flat monthly amount.",
    provider: { "@id": `${SITE}/#organization` },
    areaServed: "Worldwide",
    url: pageUrl,
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<MockupLayout
  title="Email Newsletter for Businesses, Managed for You | Ali Samadi Agency"
  description="A branded newsletter your customers actually read — sent from your own domain, tracked open by open. We set it up, keep it out of spam, and can even write it for you."
  canonical={pageUrl}
  og={{
    title: "A Newsletter for Your Business — Ali Samadi Agency",
    description:
      "Your customers already gave you their emails. We turn that into repeat visits — a branded newsletter on your own domain, set up and managed for a flat monthly amount.",
    url: pageUrl,
    twitterDescription:
      "A managed newsletter for your business — your domain, your brand, flat monthly quote.",
    image: "/og/newsletter.jpg",
  }}
  schema={schema}
>
  <Fragment set:html={MAIN} />

  <script is:inline data-astro-rerun>
    (() => {
      // Product tour: 6 tabs, each swaps the panel copy + real app screenshot.
      const TOUR = [
        {
          title: "See what's working",
          desc: "One dashboard shows every send, delivered, opened, and clicked. Bounce and complaint rates get flagged early.",
          img: "/newsletter-app/01-analytics.webp",
          alt: "Newsletter analytics dashboard showing delivery, open, and click rates for a client newsletter",
        },
        {
          title: "Write like a doc",
          desc: "The editor works like a plain document. Type, format, drop in your logo and a button, and it is ready. No clunky template builder.",
          img: "/newsletter-app/04-template-editor.webp",
          alt: "Newsletter template editor that works like a plain document",
        },
        {
          title: "Send in minutes",
          desc: "Pick a list, write or reuse a template, and send. Schedule it or send now. The whole thing takes a few minutes.",
          img: "/newsletter-app/08-campaigns.webp",
          alt: "Campaigns screen for building and sending a newsletter",
        },
        {
          title: "Your customers, organized",
          desc: "Every subscriber lives in one contact book. Import your list, see who is active, and group people without a spreadsheet.",
          img: "/newsletter-app/07-contact-book.webp",
          alt: "Contact book listing newsletter subscribers",
        },
        {
          title: "From your own domain",
          desc: "Email goes out from your own domain with SPF, DKIM, and DMARC set up, so it lands in the inbox instead of spam.",
          img: "/newsletter-app/11-domain-detail.webp",
          alt: "Sending domain settings with SPF, DKIM, and DMARC verified",
        },
        {
          title: "Every email, tracked",
          desc: "Open any send to see exactly what happened: delivered, opened, clicked, or bounced, down to each contact.",
          img: "/newsletter-app/16-email-detail.webp",
          alt: "Detail view of a single sent email with delivery and open status",
        },
      ];

      const tablist = document.querySelector(
        '[role="tablist"][aria-label="Product tour"]'
      );
      if (!tablist || tablist.dataset.tourBound) return;
      tablist.dataset.tourBound = "1";

      const tabs = [...tablist.querySelectorAll('[role="tab"]')];
      const panel = tablist.parentElement.querySelector('[role="tabpanel"]');
      if (!panel || tabs.length !== TOUR.length) return;

      const numEl = panel.querySelector(".mono");
      const titleEl = panel.querySelector("h3");
      const descEl = panel.querySelector("p");
      const imgEl = panel.querySelector("img");

      // Preload so switching is instant.
      TOUR.forEach((t) => {
        const im = new Image();
        im.src = t.img;
      });

      const select = (i) => {
        const t = TOUR[i];
        if (numEl)
          numEl.textContent = `${String(i + 1).padStart(2, "0")} / 06`;
        if (titleEl) titleEl.textContent = t.title;
        if (descEl) descEl.textContent = t.desc;
        if (imgEl) {
          imgEl.src = t.img;
          imgEl.alt = t.alt;
        }
        tabs.forEach((tab, j) => {
          const on = j === i;
          tab.setAttribute("aria-selected", on ? "true" : "false");
          tab.style.background = on ? "rgb(27, 26, 23)" : "rgba(27, 26, 23, 0.05)";
          tab.style.color = on ? "rgb(246, 245, 243)" : "rgb(27, 26, 23)";
        });
      };

      tabs.forEach((tab, i) =>
        tab.addEventListener("click", () => select(i))
      );
    })();
  </script>
</MockupLayout>
