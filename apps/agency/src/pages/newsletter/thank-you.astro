---
// Double-opt-in landing page — the confirm API route redirects here after
// adding the contact to the useSend contact book. ?status=invalid|error swaps
// the copy client-side (static page). Not indexed. Uses the mockup shell
// (shared nav/footer/styles) on top of Layout so robots=noindex is preserved
// (MockupLayout does not forward robots).
import Layout from "../../layouts/Layout.astro";
import "../../styles/mockup.css";
import MockupNav from "../../components/MockupNav.astro";
import MockupFooter from "../../components/MockupFooter.astro";
import MockupScripts from "../../components/MockupScripts.astro";
---

<Layout
  title="You're in — Ali Samadi Agency Newsletter"
  description="Subscription confirmed — welcome to the Ali Samadi Agency newsletter."
  robots="noindex, nofollow"
  bodyClass=""
>
  <div id="dc-root">
    <div class="sc-host" data-sc-name="mockup">
      <div
        style="position: relative; background: rgb(246, 245, 243); color: rgb(27, 26, 23); font-family: Geist, ui-sans-serif, system-ui, sans-serif; font-size: 17px; line-height: 1.55; overflow: hidden;"
      >
        <svg
          aria-hidden="true"
          style="position: absolute; inset: 0px; width: 100%; height: 100%; pointer-events: none; z-index: 60; opacity: 0.06; mix-blend-mode: multiply;"
        >
          <filter id="grainc">
            <feTurbulence
              type="fractalNoise"
              baseFrequency="0.9"
              numOctaves="3"
              stitchTiles="stitch"></feTurbulence>
            <feColorMatrix type="saturate" values="0"></feColorMatrix>
          </filter>
          <rect width="100%" height="100%" filter="url(#grainc)"></rect>
        </svg>

        <MockupNav />

        <main id="top">
          <section style="padding: 160px 0 120px;">
            <!-- Success -->
            <div class="nl-state-success">
              <div class="wrap" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:20px;max-width:620px;">
                <p class="eyebrow"><span></span>Newsletter</p>
                <h1 class="hero-h1" style="margin:0;max-width:14ch;font-size:clamp(40px,6vw,72px);line-height:1.02;font-weight:600;letter-spacing:-0.035em;">
                  You're <span style="color:rgb(194,69,31);font-style:italic;">in.</span>
                </h1>
                <p style="margin:0;max-width:52ch;font-size:clamp(17px,1.6vw,19px);line-height:1.6;color:rgb(103,98,90);">
                  Subscription confirmed — the next update lands straight in
                  your inbox. New launches, client showcases, product updates,
                  and lessons from running the studio.
                </p>
                <a href="/" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:10px;min-height:52px;padding:0 26px;border-radius:11px;background:rgb(252,132,100);color:rgb(27,26,23);font-size:16px;font-weight:500;text-decoration:none;box-shadow:rgba(252,132,100,0.32) 0px 8px 24px;margin-top:8px;">Back to the site <span aria-hidden="true">↗</span></a>
              </div>
            </div>

            <!-- Invalid / expired link -->
            <div class="nl-state-invalid" hidden>
              <div class="wrap" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:20px;max-width:620px;">
                <p class="eyebrow"><span></span>Newsletter</p>
                <h1 class="hero-h1" style="margin:0;max-width:16ch;font-size:clamp(36px,5vw,60px);line-height:1.05;font-weight:600;letter-spacing:-0.035em;">
                  This link has expired
                </h1>
                <p style="margin:0;max-width:52ch;font-size:clamp(17px,1.6vw,19px);line-height:1.6;color:rgb(103,98,90);">
                  Confirmation links are valid for 24 hours. No worries — sign up
                  again below and we'll send you a fresh one.
                </p>
                <a href="/#newsletter" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:10px;min-height:52px;padding:0 26px;border-radius:11px;background:rgb(252,132,100);color:rgb(27,26,23);font-size:16px;font-weight:500;text-decoration:none;box-shadow:rgba(252,132,100,0.32) 0px 8px 24px;margin-top:8px;">Sign up again <span aria-hidden="true">↗</span></a>
              </div>
            </div>
          </section>
        </main>

        <MockupFooter />
      </div>
    </div>
  </div>

  <MockupScripts />

  <script>
    import { track } from "@workspace/google-analytics/client";

    // Landing here from the confirm-email link = double opt-in completed.
    // ?status=invalid|error means the token failed — don't count those.
    const status = new URLSearchParams(location.search).get("status");
    if (status !== "invalid" && status !== "error")
      track("newsletter_confirmed");
  </script>

  <script is:inline data-astro-rerun>
    (() => {
      const status = new URLSearchParams(location.search).get("status");
      if (status === "invalid" || status === "error") {
        const ok = document.querySelector(".nl-state-success");
        const bad = document.querySelector(".nl-state-invalid");
        if (ok) ok.hidden = true;
        if (bad) bad.hidden = false;
      }
    })();
  </script>
</Layout>
