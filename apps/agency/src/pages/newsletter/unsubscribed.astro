---
// Unsubscribe landing page — the unsubscribe API route redirects here after
// marking the contact unsubscribed in useSend. Not indexed. Uses the mockup
// shell (shared nav/footer/styles) on top of Layout so robots=noindex is
// preserved (MockupLayout does not forward robots).
import Layout from "../../layouts/Layout.astro";
import "../../styles/mockup.css";
import MockupNav from "../../components/MockupNav.astro";
import MockupFooter from "../../components/MockupFooter.astro";
import MockupScripts from "../../components/MockupScripts.astro";
---

<Layout
  title="Unsubscribed — Ali Samadi Agency Newsletter"
  description="You've been unsubscribed from the Ali Samadi Agency newsletter."
  robots="noindex, nofollow"
  bodyClass=""
>
  <div id="dc-root">
    <div class="sc-host" data-sc-name="mockup">
      <div
        style="position: relative; background: rgb(246, 245, 243); color: rgb(27, 26, 23); font-family: Geist, ui-sans-serif, system-ui, sans-serif; font-size: 17px; line-height: 1.55; overflow: hidden;"
      >
        <svg
          aria-hidden="true"
          style="position: absolute; inset: 0px; width: 100%; height: 100%; pointer-events: none; z-index: 60; opacity: 0.06; mix-blend-mode: multiply;"
        >
          <filter id="grainc">
            <feTurbulence
              type="fractalNoise"
              baseFrequency="0.9"
              numOctaves="3"
              stitchTiles="stitch"></feTurbulence>
            <feColorMatrix type="saturate" values="0"></feColorMatrix>
          </filter>
          <rect width="100%" height="100%" filter="url(#grainc)"></rect>
        </svg>

        <MockupNav />

        <main id="top">
          <section style="padding: 160px 0 120px;">
            <div
              class="wrap"
              style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:20px;max-width:620px;"
            >
              <p class="eyebrow"><span></span>Newsletter</p>
              <h1 class="hero-h1" style="margin:0;max-width:16ch;font-size:clamp(36px,5vw,60px);line-height:1.05;font-weight:600;letter-spacing:-0.035em;">
                You're <span style="color:rgb(194,69,31);font-style:italic;">unsubscribed</span>
              </h1>
              <p style="margin:0;max-width:52ch;font-size:clamp(17px,1.6vw,19px);line-height:1.6;color:rgb(103,98,90);">
                Done — no more newsletter emails from us. Changed your mind? You
                can rejoin anytime from the signup form on our services page.
              </p>
              <div style="display:flex;flex-wrap:wrap;gap:14px;justify-content:center;margin-top:8px;">
                <a href="/services#newsletter" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:10px;min-height:52px;padding:0 26px;border-radius:11px;background:rgb(252,132,100);color:rgb(27,26,23);font-size:16px;font-weight:500;text-decoration:none;box-shadow:rgba(252,132,100,0.32) 0px 8px 24px;">Resubscribe <span aria-hidden="true">↗</span></a>
                <a href="/" class="tlink" style="display:inline-flex;align-items:center;min-height:52px;padding:0 12px;font-size:15px;font-weight:500;color:rgb(103,98,90);">Back to Home →</a>
              </div>
            </div>
          </section>
        </main>

        <MockupFooter />
      </div>
    </div>
  </div>

  <MockupScripts />
</Layout>
