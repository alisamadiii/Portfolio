---
import MockupLayout from "../../layouts/MockupLayout.astro";
import { cities, type City } from "../../data/cities";
import { services } from "../../data/services";
import { fmtPrice, FROM_PRICE, PLANS, TERMS } from "../../data/pricing";

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props as { city: City };

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/locations/${city.slug}`;

const schema: Record<string, unknown>[] = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Locations",
        item: `${SITE}/locations`,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: `${city.name}, FL`,
        item: pageUrl,
      },
    ],
  },
  {
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: `Lead Generation & Web Design in ${city.name}, FL`,
    serviceType: "Lead generation and web design",
    description: city.metaDescription,
    url: pageUrl,
    provider: { "@id": `${SITE}/#organization` },
    areaServed: {
      "@type": "City",
      name: city.name,
      sameAs: city.wikipediaUrl,
      containedInPlace: {
        "@type": "AdministrativeArea",
        name: city.county,
        containedInPlace: { "@type": "State", name: "Florida" },
      },
    },
  },
];

// The sitewide #organization node (Layout.astro) is dual-typed
// Organization + ProfessionalService with the Jacksonville NAP, so the
// HQ page no longer needs its own #localbusiness entity.

// Google retired FAQ rich results (May 2026), but AI answer engines
// (ChatGPT, Perplexity, AI Overviews) still parse FAQPage.
schema.push({
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  mainEntity: city.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
});

const nearbyCities = city.nearby
  .map((slug) => cities.find((c) => c.slug === slug))
  .filter(Boolean) as City[];

// ── Mockup helpers ──────────────────────────────────────────────
const titleCase = (s: string) => s.replace(/\b\w/g, (c) => c.toUpperCase());

// Hero h1: wrap the first occurrence of the city name in the accent span.
const h1Idx = city.h1.indexOf(city.name);
const h1Before = h1Idx >= 0 ? city.h1.slice(0, h1Idx) : "";
const h1Accent = h1Idx >= 0 ? city.name : city.h1;
const h1After = h1Idx >= 0 ? city.h1.slice(h1Idx + city.name.length) : "";

// Short per-service tagline from the mockup (service cards are static copy).
const serviceBlurbs: Record<string, string> = {
  "web-development": "Fast custom sites",
  "website-management": "Edit it yourself",
  "seo-analytics": "Get found locally",
  "brand-identity": "A look from your logo",
  "ui-ux-design": "Pages that convert",
  ecommerce: "Custom Shopify stores",
  "custom-web-apps": "Portals, dashboards, apps",
};
---

<MockupLayout
  title={city.seoTitle}
  description={city.metaDescription}
  canonical={pageUrl}
  og={{
    title: city.seoTitle,
    description: city.metaDescription,
    url: pageUrl,
    image: `/og/locations/${city.slug}.jpg`,
  }}
  schema={schema}
  pageType="Service"
>
  <main id="top">
    <!-- ==================== HERO ==================== -->
    <section style="position: relative; padding-top: 40px; padding-bottom: 88px;">
      <div
        aria-hidden="true"
        style="position: absolute; right: -8%; top: 0px; width: 720px; height: 560px; background-image: radial-gradient(rgba(27, 26, 23, 0.14) 1.1px, transparent 1.6px); background-size: 16px 16px; mask-image: radial-gradient(closest-side, rgb(0, 0, 0) 15%, transparent 100%); pointer-events: none;"
      >
      </div>
      <div class="wrap" style="position: relative; display: flex; flex-direction: column; gap: 40px;">
        <nav aria-label="Breadcrumb">
          <ol
            class="mono"
            style="margin: 0px; padding: 0px; list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(107, 102, 93);"
          >
            <li><a href="/" class="tlink" style="color: rgb(107, 102, 93);">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/locations" class="tlink" style="color: rgb(107, 102, 93);">Locations</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" style="color: rgb(27, 26, 23);">{city.name}</li>
          </ol>
        </nav>
        <div style="display: flex; flex-wrap: wrap; align-items: flex-start; gap: 48px 64px;">
          <div style="flex: 999 1 520px; min-width: 0px; display: flex; flex-direction: column; gap: 24px;">
            <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px;">
              <p class="eyebrow">
                <span style="width: 6px; height: 6px; border-radius: 9999px; background: rgb(252, 132, 100);"></span>
                {city.name} · {city.county}
              </p>
            </div>
            <h1
              class="hero-h1"
              style="margin: 0px; font-size: clamp(38px, 5vw, 64px); line-height: 1.04; font-weight: 600; letter-spacing: -0.035em;"
            >
              {h1Before}<span style="color: rgb(194, 69, 31); font-style: italic; padding-right: 0.06em;">{h1Accent}</span>{h1After}
            </h1>
            <p style="margin: 0px; max-width: 580px; font-size: clamp(17px, 1.5vw, 19px); line-height: 1.55; color: rgb(103, 98, 90);">
              {city.heroSub}
            </p>
            <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px;">
              <a
                href="/quote"
                class="btn btn-primary"
                style="display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0px 24px; border-radius: 11px; background: rgb(252, 132, 100); color: rgb(27, 26, 23); font-size: 15px; font-weight: 500; text-decoration: none; box-shadow: rgba(252, 132, 100, 0.32) 0px 8px 24px;"
                >Start a conversation ↗</a
              >
              <a href="/pricing" class="tlink" style="font-size: 15px; font-weight: 500; color: rgb(27, 26, 23);">See pricing →</a>
            </div>
          </div>
          <aside
            aria-label={`${city.name} at a glance`}
            class="frame"
            style="flex: 1 1 320px; max-width: 400px;"
          >
            <div class="inner" style="padding: 24px; display: flex; flex-direction: column; gap: 16px;">
              <p class="mono" style="margin: 0px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(107, 102, 93);">
                Serving {city.name}
              </p>
              <dl style="margin: 0px; display: flex; flex-direction: column; font-size: 15px;">
                <div style="display: flex; justify-content: space-between; gap: 16px; padding: 10px 0px; border-top: 1px solid rgba(27, 26, 23, 0.07);">
                  <dt style="color: rgb(107, 102, 93);">Region</dt>
                  <dd style="margin: 0px; font-weight: 600; text-align: right;">{city.region}</dd>
                </div>
                <div style="display: flex; justify-content: space-between; gap: 16px; padding: 10px 0px; border-top: 1px solid rgba(27, 26, 23, 0.07);">
                  <dt style="color: rgb(107, 102, 93);">County</dt>
                  <dd style="margin: 0px; font-weight: 600; text-align: right;">{city.county}</dd>
                </div>
                <div style="display: flex; justify-content: space-between; gap: 16px; padding: 10px 0px; border-top: 1px solid rgba(27, 26, 23, 0.07);">
                  <dt style="color: rgb(107, 102, 93);">Population</dt>
                  <dd style="margin: 0px; font-weight: 600; text-align: right;">{city.populationNote}</dd>
                </div>
                <div style="display: flex; justify-content: space-between; gap: 16px; padding: 10px 0px; border-top: 1px solid rgba(27, 26, 23, 0.07);">
                  <dt style="color: rgb(107, 102, 93);">Pricing</dt>
                  <dd style="margin: 0px; font-weight: 600; text-align: right;">Same flat rates statewide</dd>
                </div>
              </dl>
              <ul
                aria-label="Industries we build for"
                style="margin: 0px; padding: 14px 0px 0px; border-top: 1px solid rgba(27, 26, 23, 0.07); list-style: none; display: flex; flex-wrap: wrap; gap: 6px;"
              >
                {
                  city.industries.map((ind) => (
                    <li style="padding: 6px 12px; border-radius: 9999px; background: rgba(27, 26, 23, 0.05); font-size: 13px; font-weight: 500;">
                      {titleCase(ind)}
                    </li>
                  ))
                }
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ==================== AUDIENCE ==================== -->
    <section style="padding: 80px 0px; background: rgba(27, 26, 23, 0.03);">
      <div class="wrap" style="display: flex; flex-direction: column; gap: 36px;">
        <div style="display: flex; flex-wrap: wrap; gap: 24px 64px; align-items: flex-end;">
          <div style="flex: 1 1 320px; display: flex; flex-direction: column; gap: 16px;">
            <p class="eyebrow">
              <span style="width: 6px; height: 6px; border-radius: 9999px; background: rgb(252, 132, 100);"></span>
              Who we build for
            </p>
            <h2 style="margin: 0px; font-size: clamp(30px, 3.6vw, 44px); line-height: 1.08; font-weight: 600; letter-spacing: -0.025em;">
              Built for how {city.name} does business
            </h2>
          </div>
          <p style="flex: 1 1 420px; margin: 0px; font-size: 17px; line-height: 1.6; color: rgb(103, 98, 90);">
            {city.localContext}
          </p>
        </div>
        <ul style="margin: 0px; padding: 0px; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px;">
          {
            city.industries.map((ind) => (
              <li style="display: flex; align-items: center; gap: 12px; padding: 16px 18px; border-radius: 14px; background: rgb(255, 254, 252); box-shadow: rgba(27, 26, 23, 0.06) 0px 0px 0px 1px; font-size: 16px; font-weight: 600;">
                <span aria-hidden="true" style="color: rgb(194, 69, 31);">
                  ✦
                </span>
                {titleCase(ind)}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ==================== SERVICES ==================== -->
    <section style="padding: 88px 0px;">
      <div class="wrap" style="display: flex; flex-direction: column; gap: 36px;">
        <div style="display: flex; flex-direction: column; gap: 16px; max-width: 680px;">
          <p class="eyebrow">
            <span style="width: 6px; height: 6px; border-radius: 9999px; background: rgb(252, 132, 100);"></span>
            Services
          </p>
          <h2 style="margin: 0px; font-size: clamp(30px, 3.6vw, 44px); line-height: 1.08; font-weight: 600; letter-spacing: -0.025em;">
            Everything a {city.name} business needs to get more customers
          </h2>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px;">
          {
            services.map((s) => (
              <a
                href={`/services/${s.slug}`}
                class="frame lift tlink"
                style="color: rgb(27, 26, 23);"
              >
                <span class="inner" style="padding: 18px 20px; display: flex; justify-content: space-between; align-items: center; gap: 12px;">
                  <span style="display: flex; flex-direction: column;">
                    <span style="font-size: 16px; font-weight: 600;">{s.name}</span>
                    <span style="font-size: 13px; color: rgb(103, 98, 90);">
                      {serviceBlurbs[s.slug]}
                    </span>
                  </span>
                  <span aria-hidden="true">→</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ==================== HOW IT WORKS / PRICING ==================== -->
    <section id="pricing" style="padding: 88px 0px; background: rgba(27, 26, 23, 0.03);">
      <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 48px 64px; align-items: flex-start;">
        <div style="flex: 1 1 420px; display: flex; flex-direction: column; gap: 28px;">
          <p class="eyebrow">
            <span style="width: 6px; height: 6px; border-radius: 9999px; background: rgb(252, 132, 100);"></span>
            How it works
          </p>
          <h2 style="margin: 0px; font-size: clamp(30px, 3.6vw, 44px); line-height: 1.08; font-weight: 600; letter-spacing: -0.025em;">
            Three steps, wherever you are
          </h2>
          <ol style="margin: 0px; padding: 0px; list-style: none; display: flex; flex-direction: column; gap: 20px;">
            <li style="display: flex; gap: 16px;">
              <span class="mono" style="flex: 0 0 auto; width: 32px; height: 32px; border-radius: 9999px; background: rgb(27, 26, 23); color: rgb(246, 245, 243); display: flex; align-items: center; justify-content: center; font-size: 12px;">01</span>
              <span style="display: flex; flex-direction: column; gap: 2px;">
                <span style="font-size: 17px; font-weight: 600;">Talk it through</span>
                <span style="font-size: 15px; line-height: 1.55; color: rgb(103, 98, 90);">A video call about your services, your area, and your ad budget.</span>
              </span>
            </li>
            <li style="display: flex; gap: 16px;">
              <span class="mono" style="flex: 0 0 auto; width: 32px; height: 32px; border-radius: 9999px; background: rgb(27, 26, 23); color: rgb(246, 245, 243); display: flex; align-items: center; justify-content: center; font-size: 12px;">02</span>
              <span style="display: flex; flex-direction: column; gap: 2px;">
                <span style="font-size: 17px; font-weight: 600;">We build the site and launch the ads</span>
                <span style="font-size: 15px; line-height: 1.55; color: rgb(103, 98, 90);">A custom site built to get the call, with Google Ads sending local searches to it.</span>
              </span>
            </li>
            <li style="display: flex; gap: 16px;">
              <span class="mono" style="flex: 0 0 auto; width: 32px; height: 32px; border-radius: 9999px; background: rgb(27, 26, 23); color: rgb(246, 245, 243); display: flex; align-items: center; justify-content: center; font-size: 12px;">03</span>
              <span style="display: flex; flex-direction: column; gap: 2px;">
                <span style="font-size: 17px; font-weight: 600;">Track every lead, improve monthly</span>
                <span style="font-size: 15px; line-height: 1.55; color: rgb(103, 98, 90);">Every call and form tied to the search behind it. You own the site and the ad account.</span>
              </span>
            </li>
          </ol>
        </div>
        <div style="flex: 1 1 420px; display: flex; flex-direction: column; gap: 16px;">
          <div style="padding: 6px; border-radius: 24px; background: rgba(252, 132, 100, 0.14); box-shadow: rgba(252, 132, 100, 0.35) 0px 0px 0px 1px, rgba(27, 26, 23, 0.1) 0px 14px 34px;">
            <div style="border-radius: 18px; background: rgb(255, 254, 252); padding: 26px; display: flex; flex-direction: column; gap: 10px;">
              <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px;">
                <h3 style="margin: 0px; font-size: 19px; font-weight: 600;">Website + Google Ads</h3>
                <span class="mono" style="padding: 4px 9px; border-radius: 9999px; background: rgb(252, 132, 100); color: rgb(27, 26, 23); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase;">No setup fee</span>
              </div>
              <p style="margin: 0px; display: flex; align-items: baseline; gap: 6px;">
                <span class="mono" style="font-size: 14px; color: rgb(103, 98, 90);">from</span>
                <span style="font-size: 36px; line-height: 1; font-weight: 600; letter-spacing: -0.03em;">{fmtPrice(FROM_PRICE)}</span>
                <span class="mono" style="font-size: 14px; color: rgb(103, 98, 90);">/mo</span>
              </p>
              <p style="margin: 0px; font-size: 15px; line-height: 1.55; color: rgb(103, 98, 90);">A custom website plus fully managed Google Ads. {fmtPrice(TERMS.setup)} setup, ad spend billed by Google directly.</p>
            </div>
          </div>
          <div class="frame">
            <div class="inner" style="padding: 26px; display: flex; flex-direction: column; gap: 10px;">
              <h3 style="margin: 0px; font-size: 19px; font-weight: 600;">Plans by ad budget</h3>
              {
                PLANS.map((plan) => (
                  <p style="margin: 0px; display: flex; justify-content: space-between; gap: 12px; font-size: 15px;">
                    <span>
                      {plan.name}
                      <span style="color: rgb(103, 98, 90);">· ads up to {fmtPrice(plan.adSpendCap)}/mo</span>
                    </span>
                    <span class="mono">{fmtPrice(plan.monthly)}/mo</span>
                  </p>
                ))
              }
            </div>
          </div>
          <a href="/pricing" class="tlink" style="font-size: 15px; font-weight: 500;">Compare plans in detail →</a>
        </div>
      </div>
    </section>

    <!-- ==================== FAQ + NEARBY ==================== -->
    <section style="padding: 88px 0px;">
      <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: flex-start;">
        <div style="flex: 1 1 280px; display: flex; flex-direction: column; gap: 20px;">
          <p class="eyebrow">
            <span style="width: 6px; height: 6px; border-radius: 9999px; background: rgb(252, 132, 100);"></span>
            FAQ
          </p>
          <h2 style="margin: 0px; font-size: clamp(30px, 3.6vw, 44px); line-height: 1.08; font-weight: 600; letter-spacing: -0.025em;">
            Questions from {city.name} businesses
          </h2>
          <div style="display: flex; flex-direction: column; gap: 12px; padding-top: 8px;">
            <p class="mono" style="margin: 0px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(107, 102, 93);">Also serving nearby</p>
            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
              {
                nearbyCities.map((n) => (
                  <a
                    href={`/locations/${n.slug}`}
                    class="tlink"
                    style="display: inline-flex; align-items: center; min-height: 44px; padding: 0px 16px; border-radius: 9999px; background: rgb(255, 254, 252); box-shadow: rgba(27, 26, 23, 0.07) 0px 0px 0px 1px; color: rgb(27, 26, 23); font-size: 15px; font-weight: 500;"
                  >
                    {n.name}, FL
                  </a>
                ))
              }
              <a href="/locations" class="tlink" style="display: inline-flex; align-items: center; min-height: 44px; padding: 0px 8px; font-size: 15px; font-weight: 500;">All Florida cities →</a>
            </div>
          </div>
        </div>
        <div class="frame" style="flex: 999 1 560px; min-width: 0px;">
          <div class="inner" style="overflow: hidden;">
            {
              city.faqs.map((faq, i) => (
                <div
                  style={
                    i < city.faqs.length - 1
                      ? "border-bottom: 1px solid rgba(27, 26, 23, 0.07);"
                      : ""
                  }
                >
                  <button
                    type="button"
                    class="faq-q"
                    aria-expanded={i === 0 ? "true" : "false"}
                    style="width: 100%; text-align: left; border: 0px; background: transparent; cursor: pointer; font-family: inherit; min-height: 64px; padding: 20px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; font-size: 17px; font-weight: 600;"
                  >
                    {faq.q}
                    <span aria-hidden="true" class="mono pm" style="font-size: 20px; color: rgb(107, 102, 93);">
                      {i === 0 ? "−" : "+"}
                    </span>
                  </button>
                  <p
                    class="fade"
                    style={`margin: 0px; padding: 0px 24px 22px; font-size: 16px; line-height: 1.65; color: rgb(103, 98, 90);${i === 0 ? "" : " display: none;"}`}
                  >
                    {faq.a}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== DARK CTA ==================== -->
    <section id="contact" class="dark" style="padding: 96px 0px; background: rgb(23, 21, 18); color: rgb(236, 233, 226);">
      <div class="wrap" style="display: flex; flex-direction: column; align-items: flex-start; gap: 22px;">
        <p class="eyebrow">
          <span style="width: 6px; height: 6px; border-radius: 9999px; background: rgb(252, 132, 100);"></span>
          {city.name}, Florida
        </p>
        <h2 style="margin: 0px; max-width: 16ch; font-size: clamp(36px, 5vw, 64px); line-height: 1.02; font-weight: 600; letter-spacing: -0.035em;">
          Ready for more {city.name} customers?
        </h2>
        <p style="margin: 0px; max-width: 520px; font-size: 18px; line-height: 1.55; color: rgb(184, 178, 167);">
          Simple pricing and a real person on the other end — Ali replies directly.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px 16px; margin-top: 6px;">
          <a
            href="/quote"
            class="btn btn-primary"
            style="display: inline-flex; align-items: center; min-height: 52px; padding: 0px 24px; border-radius: 11px; background: rgb(252, 132, 100); color: rgb(27, 26, 23); font-size: 15px; font-weight: 500; text-decoration: none;"
            >Start a conversation ↗</a
          >
          <a
            href="/quote"
            class="btn btn-ghost"
            style="display: inline-flex; align-items: center; min-height: 52px; padding: 0px 22px; border-radius: 11px; background: rgba(236, 233, 226, 0.08); color: rgb(236, 233, 226); font-size: 15px; font-weight: 500; text-decoration: none;"
            >Ask a question</a
          >
        </div>
      </div>
    </section>
  </main>

  <script type="application/json" id="faq-data" set:html={JSON.stringify(city.faqs)}></script>
</MockupLayout>
