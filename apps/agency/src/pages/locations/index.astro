---
// Locations index — faithful translation of the mockup frame.
// SEO/schema carried over from the previous hand-built version.
import MockupLayout from "../../layouts/MockupLayout.astro";
import MAIN from "../../html/main/locations.html?raw";
import { cities } from "../../data/cities";

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/locations`;

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Locations", item: pageUrl },
    ],
  },
  {
    "@type": "ItemList",
    "@id": `${pageUrl}#cities`,
    name: "Florida Cities We Serve",
    itemListElement: cities.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `${c.name}, FL`,
      url: `${SITE}/locations/${c.slug}`,
    })),
  },
];
---

<MockupLayout
  title="Florida Web Design — Cities We Serve | Ali Samadi Agency"
  description="Web design and development across Florida — Jacksonville, Miami, Tampa, Orlando, and more. Custom-coded websites from a Jacksonville-based agency."
  canonical={pageUrl}
  pageType="CollectionPage"
  og={{
    title: "Florida Web Design — Cities We Serve | Ali Samadi Agency",
    description:
      "Custom-coded websites for businesses across Florida — from our Jacksonville headquarters to Miami, Tampa, Orlando, and beyond.",
    url: pageUrl,
    twitterDescription:
      "Web design for businesses across Florida — Jacksonville-based, serving the whole state.",
  }}
  schema={schema}
>
  <Fragment set:html={MAIN} />
</MockupLayout>
