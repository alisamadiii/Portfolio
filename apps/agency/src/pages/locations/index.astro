---
import Layout from "../../layouts/Layout.astro";
import BackNav from "../../components/BackNav.astro";
import SimpleFooter from "../../components/SimpleFooter.astro";
import { cities } from "../../data/cities";

const SITE = "https://agency.alisamadii.com";
const pageUrl = `${SITE}/locations`;

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Locations", item: pageUrl },
    ],
  },
  {
    "@type": "ItemList",
    "@id": `${pageUrl}#cities`,
    name: "Florida Cities We Serve",
    itemListElement: cities.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `${c.name}, FL`,
      url: `${SITE}/locations/${c.slug}`,
    })),
  },
];

// Group cities by region, keeping first-appearance order.
const regions = [...new Set(cities.map((c) => c.region))].map((region) => ({
  region,
  cities: cities.filter((c) => c.region === region),
}));
---

<Layout
  title="Florida Web Design — Cities We Serve | Ali Samadi Agency"
  description="Web design and development across Florida — Jacksonville, Miami, Tampa, Orlando, and more. Custom-coded websites from a Jacksonville-based agency serving the whole state."
  canonical={pageUrl}
  pageType="CollectionPage"
  og={{
    title: "Florida Web Design — Cities We Serve | Ali Samadi Agency",
    description:
      "Custom-coded websites for businesses across Florida — from our Jacksonville headquarters to Miami, Tampa, Orlando, and beyond.",
    url: pageUrl,
    twitterDescription:
      "Web design for businesses across Florida — Jacksonville-based, serving the whole state.",
  }}
  schema={schema}
  bodyClass="noise bg-cream text-charcoal selection:bg-accent/20 selection:text-accent font-sans"
>
  <BackNav backHref="/" backLabel="Back to Home" fixed />

  <section class="px-4 pt-32 pb-16 md:px-8 md:pt-40 md:pb-20">
    <div class="mx-auto max-w-[1200px]">
      <div
        class="mb-6 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] text-muted uppercase"
      >
        <span class="h-px w-[26px] bg-accent"></span>Locations
      </div>
      <h1
        class="text-[clamp(38px,5.5vw,72px)] leading-[1.02] font-semibold tracking-[-0.035em]"
      >
        Florida cities we <span class="text-accent">serve</span>
      </h1>
      <p
        class="mt-6 max-w-[58ch] text-[17px] leading-[1.6] text-warmgray md:text-[18px]"
      >
        Ali Samadi Agency is headquartered in Jacksonville and builds websites
        for businesses across Florida — remotely, over video calls and our
        Client Hub. Every city below gets the same team, the same custom code,
        and the same flat pricing.
      </p>
    </div>
  </section>

  {
    regions.map(({ region, cities: regionCities }) => (
      <section class="mx-auto max-w-[1200px] border-t border-charcoal/[0.08] px-6 py-[50px] md:px-10">
        <h2 class="font-mono text-[12.5px] tracking-[0.12em] text-muted uppercase">
          {region}
        </h2>
        <div class="stagger mt-7 grid grid-cols-1 gap-[18px] md:grid-cols-2 lg:grid-cols-3">
          {regionCities.map((c) => (
            <a
              href={`/locations/${c.slug}`}
              class="reveal group block rounded-[18px] border border-charcoal/[0.08] bg-white p-7 transition-colors duration-300 hover:border-accent/40"
            >
              <div class="flex items-center justify-between gap-4">
                <div class="font-mono text-[11.5px] tracking-[0.08em] text-[#a49d94] uppercase">
                  {c.county}
                </div>
                {c.isHeadquarters && (
                  <span class="inline-flex items-center gap-2 rounded-full border border-accent/40 bg-accent/10 px-3 py-1 font-mono text-[10.5px] tracking-[0.12em] text-accent uppercase">
                    HQ
                  </span>
                )}
              </div>
              <div class="mt-2.5 flex items-center justify-between gap-4">
                <h3 class="text-[20px] font-semibold tracking-[-0.02em]">
                  {c.name}, FL
                </h3>
                <span class="text-accent">&#8599;</span>
              </div>
              <p class="mt-2 text-[14.5px] leading-[1.6] text-warmgray">
                {c.heroSub}
              </p>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <section
    class="mx-auto max-w-[1200px] border-t border-charcoal/[0.08] px-6 py-[70px] md:px-10"
  >
    <div class="rounded-[22px] bg-ink p-9 text-center text-cream md:p-14">
      <h2
        class="text-[clamp(26px,3.2vw,42px)] leading-[1.1] font-semibold tracking-[-0.03em]"
      >
        Don't see your city?
      </h2>
      <p
        class="mx-auto mt-4 max-w-[46ch] text-[15.5px] leading-[1.6] text-cream/70"
      >
        We work with businesses anywhere in Florida — and beyond. Same process,
        same pricing, wherever you are.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/pricing"
          class="mag-btn inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3.5 text-[15px] font-medium text-white transition-all duration-300 hover:bg-cream hover:text-charcoal"
        >
          See pricing
        </a>
        <a
          href="/#contact"
          class="inline-flex min-h-11 items-center text-[15px] font-medium text-cream/80 transition-colors duration-300 hover:text-cream"
          >Get in touch</a
        >
      </div>
    </div>
  </section>

  <SimpleFooter />
</Layout>

<style is:global>
  html {
    scrollbar-gutter: stable;
  }
  .mag-btn {
    transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .mag-btn:active {
    transform: scale(0.97);
  }
</style>

<script is:inline data-astro-rerun>
  (() => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "-60px" }
    );
    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
  })();
</script>
