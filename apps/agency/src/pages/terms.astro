---
// Terms — migrated to the mockup design system (MockupLayout).
import MockupLayout from "../layouts/MockupLayout.astro";

const updated = "August 2025";
---

<MockupLayout
  title="Terms of Service — Ali Samadi Agency"
  description="The terms that govern your use of the Ali Samadi Agency website and the design and development services we provide."
  canonical="https://alisamadii.com/terms"
  og={{
    title: "Terms of Service — Ali Samadi Agency",
    description:
      "The terms that govern your use of the Ali Samadi Agency website and our services.",
    url: "https://alisamadii.com/terms",
    twitterDescription:
      "The terms that govern your use of the Ali Samadi Agency website and our services.",
  }}
>
  <main id="top">
    <!-- Hero -->
    <section style="padding: 140px 0 32px;">
      <div class="wrap" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:18px;">
        <p class="eyebrow"><span></span>Legal</p>
        <h1 class="hero-h1" style="margin:0;max-width:18ch;font-size:clamp(40px,6vw,76px);line-height:1.02;font-weight:600;letter-spacing:-0.035em;">
          Terms of <span style="color:rgb(194,69,31);font-style:italic;">Service</span>
        </h1>
        <p class="mono" style="margin:0;font-size:12.5px;letter-spacing:0.08em;text-transform:uppercase;color:rgb(107,102,93);">
          Last updated: {updated}
        </p>
      </div>
    </section>

    <!-- Body -->
    <section style="padding: 24px 0 96px; border-top: 1px solid rgba(27,26,23,0.06);">
      <div class="wrap" style="max-width:820px;">
        <div class="prose" style="padding-top:48px;">
          <p>
            These terms govern your use of <strong>alisamadii.com</strong> and
            the design and development services provided by Ali Samadi Agency
            ("we", "us", "our"). By using our site or engaging our services, you
            agree to these terms.
          </p>

          <h2>Services &amp; scope</h2>
          <p>
            We provide website design, development, and related services. The
            specific deliverables, timeline, and price for your project are
            confirmed in writing before any work begins. One-time builds are
            scoped and quoted per project, and terms and privacy pages are
            always included at no charge.
          </p>

          <h2>Payments</h2>
          <p>
            Payments are processed securely through Stripe. Monthly plans renew
            until cancelled; custom projects are billed as agreed in your quote.
            Applicable taxes may be added. Unless required by law or stated
            otherwise in your agreement, payments for completed work are
            non-refundable.
          </p>

          <h2>Intellectual property</h2>
          <p>
            Once a project is paid in full, you own the final deliverables for
            your website. We may retain the right to display the completed work
            in our portfolio unless you ask us not to. Third-party assets
            (fonts, libraries, stock media) remain subject to their own
            licenses.
          </p>

          <h2>Your responsibilities</h2>
          <p>
            You agree to provide content and feedback in a timely manner and to
            hold the rights to any materials you supply to us. Delays in
            providing what we need may affect agreed timelines.
          </p>

          <h2>Liability</h2>
          <p>
            Our services are provided with reasonable skill and care. To the
            extent permitted by law, our total liability for any claim relating
            to a project is limited to the amount you paid us for that project.
          </p>

          <h2>Contact</h2>
          <p>
            Questions about these terms? Reach us at
            <a href="mailto:agency@alisamadii.com">agency@alisamadii.com</a>, Ali
            Samadi Agency, USA.
          </p>
        </div>
      </div>
    </section>
  </main>
</MockupLayout>
