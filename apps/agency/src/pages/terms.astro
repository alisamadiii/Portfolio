---
import Layout from "../layouts/Layout.astro";
import BackNav from "../components/BackNav.astro";
import HomeFooter from "../components/HomeFooter.astro";

const updated = "August 2025";
---

<Layout
  title="Terms of Service — Ali Samadi Agency"
  description="The terms that govern your use of the Ali Samadi Agency website and the design and development services we provide."
  canonical="https://agency.alisamadii.com/terms"
  og={{
    title: "Terms of Service — Ali Samadi Agency",
    description:
      "The terms that govern your use of the Ali Samadi Agency website and our services.",
    url: "https://agency.alisamadii.com/terms",
    twitterDescription:
      "The terms that govern your use of the Ali Samadi Agency website and our services.",
  }}
  bodyClass="noise bg-cream text-charcoal selection:bg-accent/20 selection:text-accent font-sans"
>
  <BackNav backHref="/" backLabel="Back to Home" fixed />

  <main>
    <section class="px-4 pt-32 pb-20 md:px-8 md:pt-40 md:pb-28">
      <div class="mx-auto max-w-[720px]">
        <span
          class="mb-6 inline-block rounded-full bg-charcoal/5 px-3 py-1 font-mono text-[11.5px] tracking-[0.12em] text-warmgray uppercase"
          >Legal</span
        >
        <h1
          class="text-[clamp(34px,5vw,56px)] leading-[1.05] font-semibold tracking-[-0.03em]"
        >
          Terms of Service
        </h1>
        <p class="mt-4 font-mono text-[12.5px] text-muted">
          Last updated: {updated}
        </p>

        <div class="mt-10 space-y-8 text-[15px] leading-[1.7] text-warmgray">
          <p>
            These terms govern your use of <strong>agency.alisamadii.com</strong
            >
            and the design and development services provided by Ali Samadi Agency
            ("we", "us", "our"). By using our site or engaging our services, you agree
            to these terms.
          </p>

          <div>
            <h2 class="text-xl font-semibold tracking-[-0.01em] text-charcoal">
              Services &amp; scope
            </h2>
            <p class="mt-4">
              We provide website design, development, and related services. The
              specific deliverables, timeline, and price for your project are
              confirmed in writing before any work begins. One-time builds are
              scoped and quoted per project, and terms and privacy pages are
              always included at no charge.
            </p>
          </div>

          <div>
            <h2 class="text-xl font-semibold tracking-[-0.01em] text-charcoal">
              Payments
            </h2>
            <p class="mt-4">
              Payments are processed securely through Stripe. Monthly plans
              renew until cancelled; one-time builds are billed as agreed in
              your quote. Applicable taxes may be added. Unless required by law
              or stated otherwise in your agreement, payments for completed work
              are non-refundable.
            </p>
          </div>

          <div>
            <h2 class="text-xl font-semibold tracking-[-0.01em] text-charcoal">
              Intellectual property
            </h2>
            <p class="mt-4">
              Once a project is paid in full, you own the final deliverables for
              your website. We may retain the right to display the completed
              work in our portfolio unless you ask us not to. Third-party assets
              (fonts, libraries, stock media) remain subject to their own
              licenses.
            </p>
          </div>

          <div>
            <h2 class="text-xl font-semibold tracking-[-0.01em] text-charcoal">
              Your responsibilities
            </h2>
            <p class="mt-4">
              You agree to provide content and feedback in a timely manner and
              to hold the rights to any materials you supply to us. Delays in
              providing what we need may affect agreed timelines.
            </p>
          </div>

          <div>
            <h2 class="text-xl font-semibold tracking-[-0.01em] text-charcoal">
              Liability
            </h2>
            <p class="mt-4">
              Our services are provided with reasonable skill and care. To the
              extent permitted by law, our total liability for any claim
              relating to a project is limited to the amount you paid us for
              that project.
            </p>
          </div>

          <div>
            <h2 class="text-xl font-semibold tracking-[-0.01em] text-charcoal">
              Contact
            </h2>
            <p class="mt-4">
              Questions about these terms? Reach us at
              <a
                href="mailto:agency@alisamadii.com"
                class="text-charcoal underline decoration-accent/40 underline-offset-2"
                >agency@alisamadii.com</a
              >, Ali Samadi Agency, Jacksonville, FL, USA.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <HomeFooter />
</Layout>
