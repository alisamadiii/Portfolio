        >
      </div>
      <h1
        class="text-[clamp(38px,5.5vw,72px)] leading-[1.02] font-semibold tracking-[-0.035em]"
      >
        Build Your<br />
        <span class="text-accent">Project</span>
      </h1>
      <p
        class="reveal text-warmgray mt-6 max-w-[55ch] text-base leading-relaxed md:text-lg"
      >
        Pick the plan that fits — an all-inclusive monthly plan, a one-time
        upfront build with light monthly add-ons, or a fully custom project
        scoped together.
      </p>
      <div class="reveal mt-8">
        <div
          class="inline-flex items-center gap-3 rounded-full bg-emerald-50 px-5 py-2.5 ring-1 ring-emerald-200/60"
        >
          <svg
            class="h-5 w-5 shrink-0 text-emerald-600"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"
