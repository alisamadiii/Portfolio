---
import Layout from "../layouts/Layout.astro";
import BackNav from "../components/BackNav.astro";
import PricingCards from "../components/PricingCards.astro";
import HomeFooter from "../components/HomeFooter.astro";
import { PRICING, fmtPrice } from "../data/pricing";

// Prices are rendered into the HTML at build time so crawlers/LLMs see real
// numbers. public/pricing.js still mirrors these for runtime checkout.
const SITE = "https://agency.alisamadii.com";
// Page-specific structured data — prices sourced from src/data/pricing.ts so
// the schema can never drift from the visible page or from Stripe.
const pricingSchema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${SITE}/pricing#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Pricing",
        item: `${SITE}/pricing`,
      },
    ],
  },
  {
    "@type": "Service",
    "@id": `${SITE}/pricing#service`,
    name: "Website Design & Development",
    provider: { "@id": `${SITE}/#organization` },
    areaServed: "US",
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Pricing Plans",
      itemListElement: [
        {
          "@type": "Offer",
          name: "Monthly (All-Inclusive)",
          description:
            "Design, development, CMS, email, SEO, and hosting — fully managed.",
          price: String(PRICING.monthly),
          priceCurrency: "USD",
          priceSpecification: {
            "@type": "UnitPriceSpecification",
            price: String(PRICING.monthly),
            priceCurrency: "USD",
            unitCode: "MON",
          },
        },
        {
          "@type": "Offer",
          name: "Upfront (One-Time Build)",
          description: `First page ${fmtPrice(PRICING.upfront.basePrice)}, each additional page ${fmtPrice(PRICING.upfront.perExtraPage)}. Design, development, and SEO included.`,
          price: String(PRICING.upfront.basePrice),
          priceCurrency: "USD",
        },
        {
          "@type": "Offer",
          name: "Custom",
          description: "Fully custom-scoped project — contact for a quote.",
        },
      ],
    },
  },
];
---

<Layout
  title="Pricing — Ali Samadi | Creative Agency"
  description="Simple, transparent pricing. Choose an all-inclusive monthly plan, a one-time upfront build, or a fully custom project — web design, hosting, CMS, and more."
  canonical="https://agency.alisamadii.com/pricing"
  og={{
    title: "Pricing — Ali Samadi",
    description:
      "Simple, transparent pricing. Choose an all-inclusive monthly plan, a one-time upfront build, or a fully custom project.",
    url: "https://agency.alisamadii.com/pricing",
    twitterDescription:
      "Simple, transparent pricing. All-inclusive monthly, upfront build, or fully custom.",
  }}
  schema={pricingSchema}
  bodyClass="noise bg-cream text-charcoal selection:bg-accent/20 selection:text-accent font-sans"
>
  <BackNav backHref="/" backLabel="Back to Home" fixed />

  <!-- ==================== HERO ==================== -->
  <section id="heroSection" class="px-4 pt-32 pb-20 md:px-8 md:pt-40 md:pb-28">
    <div class="stagger mx-auto max-w-[1400px]">
      <div class="reveal">
        <span
          class="mb-6 inline-block rounded-full bg-charcoal/5 px-3 py-1 font-mono text-[11.5px] tracking-[0.12em] text-warmgray uppercase"
          >Pricing</span
        >
      </div>
      <h1
        class="text-[clamp(38px,5.5vw,72px)] leading-[1.02] font-semibold tracking-[-0.035em]"
      >
        Build Your<br />
        <span class="text-accent">Project</span>
      </h1>
      <p
        class="reveal mt-6 max-w-[55ch] text-base leading-relaxed text-warmgray md:text-lg"
      >
        Pick the plan that fits — an all-inclusive monthly plan, a one-time
        upfront build with light monthly add-ons, or a fully custom project
        scoped together.
      </p>
      <div class="reveal mt-8">
        <div
          class="inline-flex items-center gap-3 rounded-full bg-emerald-50 px-5 py-2.5 ring-1 ring-emerald-200/60"
        >
          <svg
            class="h-5 w-5 shrink-0 text-emerald-600"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"
            ></path>
          </svg>
          <span class="text-sm font-semibold text-emerald-800"
            >1-Day Delivery</span
          >
          <span class="text-xs text-emerald-600/80"
            >once your project is confirmed</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PLANS ==================== -->
  <section
    id="packageSelection"
    class="border-t border-charcoal/[0.06] px-4 py-20 md:px-8 md:py-28"
  >
    <div class="mx-auto max-w-[1400px]">
      <div class="stagger mb-12">
        <div class="reveal">
          <span
            class="mb-4 inline-block rounded-full bg-charcoal/5 px-3 py-1 font-mono text-[11.5px] tracking-[0.12em] text-warmgray uppercase"
            >Choose Your Path</span
          >
        </div>
        <h2
          class="reveal mt-2 text-[clamp(30px,3.6vw,48px)] leading-[1.08] font-semibold tracking-[-0.03em]"
        >
          How Would You Like<br />to
          <span class="text-accent">Get Started</span>?
        </h2>
        <p
          class="reveal mt-4 max-w-[55ch] text-base leading-relaxed text-warmgray"
        >
          Go all-inclusive with a managed monthly plan, own your build with a
          one-time payment, or reach out for something fully custom.
        </p>
      </div>

      <PricingCards />
    </div>
  </section>

  <HomeFooter />

  <!-- ==================== JAVASCRIPT ==================== -->
  <!-- data-astro-rerun + IIFE: re-runs after every ClientRouter swap without
       leaking top-level consts into the persistent global scope. -->
  <script is:inline data-astro-rerun>
    (() => {
      // Prices are server-rendered from src/data/pricing.ts and the checkout
      // action ships with <PricingCards /> — this block only wires reveals.

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: "-60px" }
      );

      document
        .querySelectorAll(".reveal")
        .forEach((el) => observer.observe(el));
    })();
  </script>
</Layout>

<style is:global>
  html {
    scrollbar-gutter: stable;
  }

  /* Stagger children */
  .stagger > .reveal:nth-child(1) {
    transition-delay: 0ms;
  }
  .stagger > .reveal:nth-child(2) {
    transition-delay: 120ms;
  }
  .stagger > .reveal:nth-child(3) {
    transition-delay: 240ms;
  }
  .stagger > .reveal:nth-child(4) {
    transition-delay: 360ms;
  }
  .stagger > .reveal:nth-child(5) {
    transition-delay: 480ms;
  }

  /* Magnetic button */
  .mag-btn {
    transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .mag-btn:active {
    transform: scale(0.97);
  }
</style>
