---
import Layout from "../layouts/Layout.astro";
import BackNav from "../components/BackNav.astro";
import SimpleFooter from "../components/SimpleFooter.astro";
import { PRICING, fmtPrice } from "../data/pricing";

// Prices are rendered into the HTML at build time so crawlers/LLMs see real
// numbers. public/pricing.js still mirrors these for runtime checkout.
const emailNote = `${PRICING.email.freePerMonth.toLocaleString("en-US")} emails/mo free, then ${fmtPrice(PRICING.email.perExtraThousand)} per 1,000`;

const SITE = "https://agency.alisamadii.com";
// Page-specific structured data — prices sourced from src/data/pricing.ts so
// the schema can never drift from the visible page or from Stripe.
const pricingSchema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${SITE}/pricing#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Pricing",
        item: `${SITE}/pricing`,
      },
    ],
  },
  {
    "@type": "Service",
    "@id": `${SITE}/pricing#service`,
    name: "Website Design & Development",
    provider: { "@id": `${SITE}/#organization` },
    areaServed: "US",
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Pricing Plans",
      itemListElement: [
        {
          "@type": "Offer",
          name: "Monthly (All-Inclusive)",
          description:
            "Design, development, CMS, email, SEO, and hosting — fully managed.",
          price: String(PRICING.monthly),
          priceCurrency: "USD",
          priceSpecification: {
            "@type": "UnitPriceSpecification",
            price: String(PRICING.monthly),
            priceCurrency: "USD",
            unitCode: "MON",
          },
        },
        {
          "@type": "Offer",
          name: "Upfront (One-Time Build)",
          description: `First page ${fmtPrice(PRICING.upfront.basePrice)}, each additional page ${fmtPrice(PRICING.upfront.perExtraPage)}. Design, development, and SEO included.`,
          price: String(PRICING.upfront.basePrice),
          priceCurrency: "USD",
        },
        {
          "@type": "Offer",
          name: "Custom",
          description: "Fully custom-scoped project — contact for a quote.",
        },
      ],
    },
  },
];
---

<Layout
  title="Pricing — Ali Samadi | Creative Agency"
  description="Simple, transparent pricing. Choose an all-inclusive monthly plan, a one-time upfront build, or a fully custom project — web design, hosting, CMS, and more."
  canonical="https://agency.alisamadii.com/pricing"
  og={{
    title: "Pricing — Ali Samadi",
    description:
      "Simple, transparent pricing. Choose an all-inclusive monthly plan, a one-time upfront build, or a fully custom project.",
    url: "https://agency.alisamadii.com/pricing",
    twitterDescription:
      "Simple, transparent pricing. All-inclusive monthly, upfront build, or fully custom.",
  }}
  schema={pricingSchema}
  bodyClass="noise bg-cream text-charcoal selection:bg-accent/20 selection:text-accent font-sans"
