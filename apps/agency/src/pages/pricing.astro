---
// Pricing — built in the mockup design system (MockupLayout), taking the hero,
// pricing-card, and dark-CTA patterns from the home/services pages. Prices come
// from src/data/pricing.ts so the page and schema never drift.
import MockupLayout from "../layouts/MockupLayout.astro";
import GrowthPlans from "../components/GrowthPlans.astro";
import { GUARANTEE, PLANS, TERMS, WEBSITE_ONLY, fmtPrice } from "../data/pricing";
import CTA from "../html/blocks/cta.html?raw";

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/pricing`;

const [launch, growth, scale] = PLANS;
const faqs = [
  {
    q: "Is ad spend included?",
    a: `No. Google bills ad spend to your card directly, so you see every dollar. Our monthly fee covers the website and managing your campaigns. Each tier covers a set amount of monthly spend: up to ${fmtPrice(launch.adSpendCap)} on ${launch.name}, ${fmtPrice(growth.adSpendCap)} on ${growth.name}, and ${fmtPrice(scale.adSpendCap)} on ${scale.name}.`,
  },
  {
    q: "Is there a setup fee?",
    a: `Not on growth plans. The custom website build is included, setup is ${fmtPrice(TERMS.setup)}, and you pay the monthly price from the first month. The website-only plan has a one-time ${fmtPrice(WEBSITE_ONLY.setup)} build fee.`,
  },
  {
    q: `Why is there a ${TERMS.minimumMonths}-month minimum?`,
    a: `Google Ads needs time to learn. The first months go into finding which searches turn into jobs, and the months after are where the cost per lead comes down. ${TERMS.minimumMonths} months gives the campaigns a fair run. After that it's month-to-month and you can cancel anytime. And if we miss the lead number we agreed on within ${GUARANTEE.days} days, you can leave early.`,
  },
  {
    q: "What's your guarantee?",
    a: `Two of them. ${GUARANTEE.leads} And ${GUARANTEE.process.charAt(0).toLowerCase()}${GUARANTEE.process.slice(1)} ${GUARANTEE.fine}`,
  },
  {
    q: "Which plan is right for me?",
    a: `Start from your ad budget. ${launch.name} fits one focused service with up to ${fmtPrice(launch.adSpendCap)}/mo in spend. ${growth.name} fits a business selling several services, with a landing page and campaign for each. ${scale.name} fits a business covering several cities or locations. We'll recommend one on the first call.`,
  },
  {
    q: "Can I get just a website, without ads?",
    a: `Yes. The website-only plan is ${fmtPrice(WEBSITE_ONLY.setup)} setup + ${fmtPrice(WEBSITE_ONLY.monthly)}/mo: custom design and build, hosting, care, and email from your own domain. You can add Google Ads later. Full details are on our Websites page.`,
  },
  {
    q: "What happens if I leave?",
    a: "Your code lives in your own GitHub, and your domain and Google Ads account are in your name from day one. After the minimum term, the site and the account go with you.",
  },
];

const pricingSchema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Pricing", item: pageUrl },
    ],
  },
  {
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: "Website + Google Ads Management",
    provider: { "@id": `${SITE}/#organization` },
    areaServed: "US",
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Growth Plans",
      itemListElement: PLANS.map((plan) => ({
        "@type": "Offer",
        name: plan.name,
        description: `${fmtPrice(plan.monthly)}/mo: ${plan.features.join(", ")}. Ad spend billed by Google directly.`,
        price: String(plan.monthly),
        priceCurrency: "USD",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: String(plan.monthly),
          priceCurrency: "USD",
          unitCode: "MON",
        },
      })).concat({
        "@type": "Offer",
        name: WEBSITE_ONLY.name,
        description: `${fmtPrice(WEBSITE_ONLY.setup)} setup + ${fmtPrice(WEBSITE_ONLY.monthly)}/mo: ${WEBSITE_ONLY.features.join(", ")}. No Google Ads.`,
        price: String(WEBSITE_ONLY.monthly),
        priceCurrency: "USD",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: String(WEBSITE_ONLY.monthly),
          priceCurrency: "USD",
          unitCode: "MON",
        },
      }),
    },
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<MockupLayout
  title="Pricing: Website + Google Ads Plans | Ali Samadi"
  description={`Growth plans from ${fmtPrice(launch.monthly)}/mo: a custom website plus fully managed Google Ads. No setup fee, ${TERMS.minimumMonths}-month minimum, then month-to-month.`}
  canonical={pageUrl}
  og={{
    title: "Pricing | Ali Samadi Agency",
    description: `Website + Google Ads from ${fmtPrice(launch.monthly)}/mo. No setup fee.`,
    url: pageUrl,
    twitterDescription:
      `Website + Google Ads from ${fmtPrice(launch.monthly)}/mo. No setup fee.`,
  }}
  schema={pricingSchema}
>
  <main id="top">
    <!-- Hero -->
    <section style="padding: 140px 0 48px;">
      <div class="wrap" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:22px;">
        <p class="eyebrow"><span></span>Pricing</p>
        <h1 class="hero-h1" style="margin:0;max-width:16ch;font-size:clamp(40px,6vw,76px);line-height:1.02;font-weight:600;letter-spacing:-0.035em;">
          One price for the site <span style="color:rgb(194,69,31);font-style:italic;">and the ads</span>
        </h1>
        <p style="margin:0;max-width:60ch;font-size:clamp(17px,1.6vw,20px);line-height:1.55;color:rgb(103,98,90);">
          Every growth plan includes a custom website and fully managed Google Ads.
          Pick the tier that matches your ad budget. No setup fee.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:14px;justify-content:center;margin-top:8px;">
          <a href="/quote" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:10px;min-height:52px;padding:0 26px;border-radius:11px;background:rgb(252,132,100);color:rgb(27,26,23);font-size:16px;font-weight:500;text-decoration:none;box-shadow:rgba(252,132,100,0.32) 0px 8px 24px;">Start a Project <span aria-hidden="true">↗</span></a>
          <a href="/services/google-ads" class="tlink" style="display:inline-flex;align-items:center;min-height:52px;padding:0 12px;font-size:15px;font-weight:500;color:rgb(103,98,90);">How we run your ads →</a>
        </div>
      </div>
    </section>

    <!-- Pricing cards -->
    <section style="padding: 24px 0 72px;">
      <div class="wrap">
        <GrowthPlans />
        <p style="margin:16px 0 0;text-align:center;font-size:14px;color:rgb(107,102,93);">
          Selling online? See our <a href="/ecommerce" class="tlink">Shopify storefront</a> offer.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section style="padding: 72px 0; border-top: 1px solid rgba(27,26,23,0.06);">
      <div class="wrap" style="display:grid;grid-template-columns:1fr;gap:40px;">
        <div style="display:flex;flex-direction:column;gap:16px;max-width:640px;">
          <p class="eyebrow"><span></span>FAQ</p>
          <h2 style="margin:0;font-size:clamp(30px,3.6vw,44px);line-height:1.08;font-weight:600;letter-spacing:-0.025em;">
            Pricing questions
          </h2>
        </div>
        <div style="display:flex;flex-direction:column;border-top:1px solid rgba(27,26,23,0.07);">
          {
            faqs.map((f, i) => (
              <div style="border-bottom:1px solid rgba(27,26,23,0.07);">
                <button
                  type="button"
                  class="faq-q"
                  aria-expanded={i === 0 ? "true" : "false"}
                  style="width:100%;min-height:64px;padding:20px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;border:0;background:transparent;cursor:pointer;text-align:left;font-family:inherit;font-size:17px;font-weight:600;color:rgb(27,26,23);"
                >
                  {f.q}
                  <span aria-hidden="true" class="mono" style="font-size:20px;color:rgb(107,102,93);">
                    <span>{i === 0 ? "−" : "+"}</span>
                  </span>
                </button>
                {i === 0 && (
                  <p class="fade" style="margin:0;padding:0 24px 24px;max-width:68ch;font-size:16px;line-height:1.65;color:rgb(103,98,90);">
                    {f.a}
                  </p>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Dark CTA -->
    <Fragment set:html={CTA} />
  </main>

  <script
    type="application/json"
    id="faq-data"
    set:html={JSON.stringify(faqs)}
  ></script>
</MockupLayout>
