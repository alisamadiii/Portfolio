  <SimpleFooter />

  <!-- ==================== JAVASCRIPT ==================== -->
  <script is:inline>
    // ─── PRICE INJECTION (from pricing.js) ───────────────────────

    document.querySelectorAll(".price-monthly").forEach((el) => {
      el.textContent = fmtPrice(PRICING.monthly);
    });
    document.querySelectorAll(".price-upfront").forEach((el) => {
      el.textContent = fmtPrice(PRICING.upfront.basePrice);
    });
    document.querySelectorAll(".price-upfront-extra").forEach((el) => {
      el.textContent = `+ ${fmtPrice(PRICING.upfront.perExtraPage)} per extra page`;
    });
    document.querySelectorAll(".price-hosting-note").forEach((el) => {
      el.textContent = `— ${fmtPrice(PRICING.hosting)}/mo`;
    });
    document.querySelectorAll(".price-cms-note").forEach((el) => {
      el.textContent = `— ${fmtPrice(PRICING.cms)}/mo`;
    });
    document.querySelectorAll(".email-note").forEach((el) => {
      el.textContent = `${PRICING.email.freePerMonth.toLocaleString("en-US")} emails/mo free, then ${fmtPrice(PRICING.email.perExtraThousand)} per 1,000`;
    });

    // ─── ACTIONS ─────────────────────────────────────────────────

    const startMonthly = async () => {
      const btn = document.getElementById("monthlyStartBtn");
      const label = document.getElementById("monthlyStartLabel");
      btn.disabled = true;
      label.textContent = "Redirecting…";
      try {
        await createCheckout({ plan: "monthly" });
      } catch (e) {
        btn.disabled = false;
        label.textContent = "Start";
        alert("Something went wrong starting checkout. Please try again.");
      }
    };

    // ─── SCROLL REVEAL OBSERVER ──────────────────────────────────

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "-60px" }
    );

    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
  </script>

  <!-- Disclaimer Dialog -->
  <div id="disclaimerBackdrop" class="disclaimer-backdrop hidden">
    <div class="disclaimer-dialog">
      <h2
        style="
          font-size: 1.875rem;
          font-weight: 700;
          letter-spacing: -0.02em;
          line-height: 1.2;
          color: #1a1a1a;
          max-width: 20ch;
        "
      >
        You pay per page.<br />$500 base, $200 each after.
      </h2>
      <p
        style="
          margin-top: 1rem;
          font-size: 0.875rem;
          line-height: 1.7;
          color: #8a8577;
          max-width: 45ch;
        "
      >
        A page is anything with its own address — Home, About, Contact, and so
        on; a long scrolling page still counts as one. Your first page is $500,
        and each page after that is $200. Terms &amp; privacy pages are always
        free and don't count. You confirm the final page count at checkout
        before any work begins.
      </p>
      <button id="disclaimerBtn" class="disclaimer-btn">
        <div id="disclaimerFill" class="disclaimer-btn-fill"></div>
        <span class="disclaimer-btn-label">I understand</span>
      </button>
    </div>
  </div>

  <script is:inline>
    (function () {
      if (localStorage.getItem("estimate_disclaimer_seen")) return;

      const backdrop = document.getElementById("disclaimerBackdrop");
      const btn = document.getElementById("disclaimerBtn");
      const fill = document.getElementById("disclaimerFill");

      setTimeout(() => {
        backdrop.classList.remove("hidden");
        backdrop.offsetHeight;
        backdrop.classList.add("visible");
        fill.classList.add("animate");

        // Enable button after fill animation (2s)
        setTimeout(() => {
          btn.classList.add("ready");
        }, 2000);
      }, 2000);

      function dismiss() {
        if (!btn.classList.contains("ready")) return;
        backdrop.classList.remove("visible");
        setTimeout(() => {
          backdrop.classList.add("hidden");
        }, 600);
        localStorage.setItem("estimate_disclaimer_seen", "true");
      }

      btn.addEventListener("click", dismiss);
    })();
  </script>
</Layout>

<style is:global>
  html {
    scrollbar-gutter: stable;
  }

  /* Stagger children */
  .stagger > .reveal:nth-child(1) {
    transition-delay: 0ms;
  }
  .stagger > .reveal:nth-child(2) {
    transition-delay: 120ms;
  }
  .stagger > .reveal:nth-child(3) {
    transition-delay: 240ms;
  }
  .stagger > .reveal:nth-child(4) {
    transition-delay: 360ms;
  }
  .stagger > .reveal:nth-child(5) {
    transition-delay: 480ms;
  }

  /* Magnetic button */
  .mag-btn {
    transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .mag-btn:active {
    transform: scale(0.97);
  }

  /* Package cards */
  .package-card {
    transition: all 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .package-card:hover {
    transform: translateY(-2px);
  }

  /* Estimate disclaimer dialog */
  .disclaimer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .disclaimer-backdrop.visible {
    opacity: 1;
  }
  .disclaimer-backdrop.hidden {
    pointer-events: none;
    display: none;
  }
  .disclaimer-dialog {
    max-width: 480px;
    width: calc(100% - 2rem);
    background: white;
    border-radius: 1.25rem;
    border: 1px solid rgba(0, 0, 0, 0.06);
    padding: 2rem;
    position: relative;
    transform: scale(0.96) translateY(10px);
    transition: transform 0.7s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .disclaimer-backdrop.visible .disclaimer-dialog {
    transform: scale(1) translateY(0);
  }
  .disclaimer-btn {
    position: relative;
    width: 100%;
    height: 48px;
    margin-top: 1.5rem;
    border-radius: 9999px;
    border: none;
    background: rgba(0, 0, 0, 0.06);
    overflow: hidden;
    cursor: not-allowed;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.4s ease;
  }
  .disclaimer-btn.ready {
    cursor: pointer;
    background: #fc8464;
  }
  .disclaimer-btn.ready:hover {
    background: #e0734f;
  }
  .disclaimer-btn-label {
    position: relative;
    z-index: 1;
    font-size: 0.875rem;
    font-weight: 600;
    color: #1a1a1a;
    opacity: 0.4;
    transition: opacity 0.3s ease;
  }
  .disclaimer-btn.ready .disclaimer-btn-label {
    opacity: 1;
    color: white;
  }
  .disclaimer-btn-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
