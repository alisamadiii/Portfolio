---
// Pricing — built in the mockup design system (MockupLayout), taking the hero,
// pricing-card, and dark-CTA patterns from the home/services pages. Prices come
// from src/data/pricing.ts so the page and schema never drift.
import MockupLayout from "../layouts/MockupLayout.astro";
import { PRICING, fmtPrice } from "../data/pricing";
import PRICING_CARDS from "../html/blocks/pricing-cards.html?raw";
import CTA from "../html/blocks/cta.html?raw";

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/pricing`;

const faqs = [
  {
    q: "What's included in the monthly plan?",
    a: `For ${fmtPrice(PRICING.setup)} + ${fmtPrice(PRICING.monthly)}/month you get design, development, hosting, email, unlimited content updates, SEO basics, and support — one flat fee, cancel anytime, no hidden costs. This plan is for local and small businesses; pricing varies with scope, but for most projects this is the price.`,
  },
  {
    q: "Why is custom quote-only?",
    a: "Admin panels, user accounts, databases, and integrations vary too much to list a single price. We scope the work with you and send one fair, fixed quote before anything starts — no surprises later.",
  },
  {
    q: "Can I cancel anytime?",
    a: "Yes. The monthly plan has no lock-in. Your code lives in your own GitHub and your domain and hosting are in your name, so you keep the site and can take it anywhere if you ever leave.",
  },
  {
    q: "Are there any hidden fees?",
    a: "No. The setup fee and monthly price cover design, development, hosting, email, SEO basics, and ongoing updates. Larger scopes are quoted upfront in writing before we begin.",
  },
];

const pricingSchema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Pricing", item: pageUrl },
    ],
  },
  {
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: "Website Design & Development",
    provider: { "@id": `${SITE}/#organization` },
    areaServed: "US",
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Pricing Plans",
      itemListElement: [
        {
          "@type": "Offer",
          name: "Website as a Service (All-Inclusive)",
          description: `${fmtPrice(PRICING.setup)} + ${fmtPrice(PRICING.monthly)}/mo — design, development, CMS, email, SEO, and hosting, fully managed.`,
          price: String(PRICING.monthly),
          priceCurrency: "USD",
          priceSpecification: {
            "@type": "UnitPriceSpecification",
            price: String(PRICING.monthly),
            priceCurrency: "USD",
            unitCode: "MON",
          },
        },
        {
          "@type": "Offer",
          name: "Custom",
          description: "Fully custom-scoped project — contact for a quote.",
        },
      ],
    },
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<MockupLayout
  title="Pricing — Simple, Transparent Website Plans | Ali Samadi"
  description="Transparent pricing from Ali Samadi Agency: an all-inclusive Website as a Service plan plus custom projects quoted fairly. No hidden fees, cancel anytime."
  canonical={pageUrl}
  og={{
    title: "Pricing — Ali Samadi Agency",
    description:
      "An all-inclusive monthly website plan plus custom projects quoted fairly. No hidden fees, cancel anytime.",
    url: pageUrl,
    twitterDescription:
      "Simple, transparent website pricing — no hidden fees, cancel anytime.",
  }}
  schema={pricingSchema}
>
  <main id="top">
    <!-- Hero -->
    <section style="padding: 140px 0 48px;">
      <div class="wrap" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:22px;">
        <p class="eyebrow"><span></span>Pricing</p>
        <h1 class="hero-h1" style="margin:0;max-width:16ch;font-size:clamp(40px,6vw,76px);line-height:1.02;font-weight:600;letter-spacing:-0.035em;">
          Simple, <span style="color:rgb(194,69,31);font-style:italic;">transparent</span> pricing
        </h1>
        <p style="margin:0;max-width:60ch;font-size:clamp(17px,1.6vw,20px);line-height:1.55;color:rgb(103,98,90);">
          One all-inclusive monthly plan or a fully custom project. No hidden
          fees, cancel anytime, and you own everything from day one.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:14px;justify-content:center;margin-top:8px;">
          <a href="/quote" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:10px;min-height:52px;padding:0 26px;border-radius:11px;background:rgb(252,132,100);color:rgb(27,26,23);font-size:16px;font-weight:500;text-decoration:none;box-shadow:rgba(252,132,100,0.32) 0px 8px 24px;">Get a Quote <span aria-hidden="true">↗</span></a>
          <a href="/services" class="tlink" style="display:inline-flex;align-items:center;min-height:52px;padding:0 12px;font-size:15px;font-weight:500;color:rgb(103,98,90);">See what's included →</a>
        </div>
      </div>
    </section>

    <!-- Pricing cards -->
    <section style="padding: 24px 0 72px;">
      <div class="wrap">
        <Fragment set:html={PRICING_CARDS} />
        <p style="margin:28px 0 0;text-align:center;font-size:14px;color:rgb(107,102,93);">
          Prices are anchors for most projects. Final scope is confirmed in
          writing before anything starts.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section style="padding: 72px 0; border-top: 1px solid rgba(27,26,23,0.06);">
      <div class="wrap" style="display:grid;grid-template-columns:1fr;gap:40px;">
        <div style="display:flex;flex-direction:column;gap:16px;max-width:640px;">
          <p class="eyebrow"><span></span>FAQ</p>
          <h2 style="margin:0;font-size:clamp(30px,3.6vw,44px);line-height:1.08;font-weight:600;letter-spacing:-0.025em;">
            Pricing questions
          </h2>
        </div>
        <div style="display:flex;flex-direction:column;border-top:1px solid rgba(27,26,23,0.07);">
          {
            faqs.map((f, i) => (
              <div style="border-bottom:1px solid rgba(27,26,23,0.07);">
                <button
                  type="button"
                  class="faq-q"
                  aria-expanded={i === 0 ? "true" : "false"}
                  style="width:100%;min-height:64px;padding:20px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;border:0;background:transparent;cursor:pointer;text-align:left;font-family:inherit;font-size:17px;font-weight:600;color:rgb(27,26,23);"
                >
                  {f.q}
                  <span aria-hidden="true" class="mono" style="font-size:20px;color:rgb(107,102,93);">
                    <span>{i === 0 ? "−" : "+"}</span>
                  </span>
                </button>
                {i === 0 && (
                  <p class="fade" style="margin:0;padding:0 24px 24px;max-width:68ch;font-size:16px;line-height:1.65;color:rgb(103,98,90);">
                    {f.a}
                  </p>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Dark CTA -->
    <Fragment set:html={CTA} />
  </main>

  <script
    type="application/json"
    id="faq-data"
    set:html={JSON.stringify(faqs)}
  ></script>
</MockupLayout>
