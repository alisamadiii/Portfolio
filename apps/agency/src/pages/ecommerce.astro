---
// Offer page for the E-commerce Storefront plan — a custom headless storefront
// on the client's existing Shopify. Distinct from /services/ecommerce (the SEO
// service page): this one sells the productized plan. Pricing comes from
// src/data/pricing.ts; every CTA routes to /quote?plan=ecommerce until the
// Stripe subscription is wired up. Migrated to the mockup design system.
import MockupLayout from "../layouts/MockupLayout.astro";
import ShopifyLogo from "../components/ShopifyLogo.astro";
import { PRICING, fmtPrice } from "../data/pricing";

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/ecommerce`;

const setup = fmtPrice(PRICING.ecommerce.setup);
const monthly = fmtPrice(PRICING.ecommerce.monthly);

const faqs = [
  {
    q: "Do I have to leave Shopify?",
    a: "No — that's the point. Shopify keeps managing your products, inventory, orders, and checkout. We only replace the storefront your customers see with a custom-built, faster website connected to your existing store.",
  },
  {
    q: "Does checkout change?",
    a: "No. Customers still pay through Shopify's secure checkout — the same payment methods, shipping rules, and taxes you have configured today. We hand the cart to Shopify at the moment of purchase.",
  },
  {
    q: "What does it cost?",
    a: `A one-time ${setup} setup covers the design and build, then ${monthly}/month covers hosting, monitoring, and maintenance. Larger catalogs or custom features are quoted before we start.`,
  },
  {
    q: "How long does it take?",
    a: "Most storefronts launch in three to four weeks: about a week of design, one to two weeks of build and Shopify integration, and a final week of content, testing, and launch.",
  },
];

const themeCons = [
  "Same layout as thousands of other Shopify stores",
  "Full page reload on every click — browsing feels slow",
  "Brand squeezed into someone else's design decisions",
  "Theme apps stacking scripts that slow the store further",
];

const customPros = [
  "Designed from scratch around your brand",
  "Instant navigation — the next page loads before the click",
  "Shopify keeps powering checkout, inventory & orders",
  "Popups, reviews & sections built in — no script soup",
];

const steps = [
  {
    n: "01",
    h: "You keep Shopify",
    p: "Products, prices, inventory, orders, and apps stay in the Shopify admin you already know. No migration, no re-entering data.",
  },
  {
    n: "02",
    h: "We build the storefront",
    p: "A custom website connected straight to your store's catalog — product pages, collections, search, cart, and customer accounts, all designed around your brand.",
  },
  {
    n: "03",
    h: "Checkout stays Shopify",
    p: "At the moment of purchase, the cart hands off to Shopify's secure checkout — same payment methods, shipping rules, and taxes as today.",
  },
];

const perf = [
  {
    h: "Pages ready before the click",
    p: "Product pages are pre-rendered and preloaded while shoppers browse, so moving between products feels like swiping through an app — no white flash, no waiting.",
  },
  {
    h: "Images in next-gen formats",
    p: "Product photos are served as AVIF and WebP, automatically sized for each screen — sharp on a desktop monitor, light on a phone connection.",
  },
  {
    h: "A cart that never makes you wait",
    p: "Add to cart, change quantities, remove items — the interface responds instantly while the update syncs to Shopify in the background.",
  },
  {
    h: "Core Web Vitals as a requirement",
    p: "Google's speed metrics affect both rankings and conversion. We treat passing them as part of launch — and you can verify the scores yourself.",
  },
];

const planFeatures = [
  "Custom storefront design matched to your brand",
  "Product pages, collections, search & accounts",
  "Shopify keeps checkout, inventory & orders",
  "Hosting, monitoring & maintenance included",
  "Content & section edits included",
];

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "E-commerce Storefront",
        item: pageUrl,
      },
    ],
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<MockupLayout
  title="Custom Shopify Storefront Design | Ali Samadi Agency"
  description={`Swap your Shopify theme for a fast, custom storefront. Shopify still runs checkout and inventory. ${setup} setup + ${monthly}/mo.`}
  canonical={pageUrl}
  og={{
    title: "Unique Website for Your Shopify — Ali Samadi Agency",
    description:
      "We replace your Shopify theme with a custom-built, genuinely fast storefront. Shopify keeps powering checkout, inventory, and orders.",
    url: pageUrl,
    twitterDescription:
      "A custom storefront on your existing Shopify — instant navigation, your brand, same secure checkout.",
  }}
  schema={schema}
>
  <main id="top">
    <!-- Hero -->
    <section style="padding: 140px 0 48px;">
      <div class="wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));align-items:center;gap:48px;">
        <div style="display:flex;flex-direction:column;align-items:flex-start;gap:22px;">
          <p class="eyebrow"><span></span>E-commerce Storefront</p>
          <h1 class="hero-h1" style="margin:0;max-width:15ch;font-size:clamp(40px,6vw,72px);line-height:1.02;font-weight:600;letter-spacing:-0.035em;">
            A unique website for your <span style="color:rgb(94,142,62);font-style:italic;">Shopify</span> store
          </h1>
          <p style="margin:0;max-width:52ch;font-size:clamp(17px,1.6vw,20px);line-height:1.55;color:rgb(103,98,90);">
            Your Shopify keeps running products, inventory, and secure checkout.
            We replace the theme your customers see with a custom-designed
            storefront that matches your brand and feels instant to browse.
          </p>
          <div style="display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-top:4px;">
            <a href="/quote?plan=ecommerce" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:10px;min-height:52px;padding:0 26px;border-radius:11px;background:rgb(252,132,100);color:rgb(27,26,23);font-size:16px;font-weight:500;text-decoration:none;box-shadow:rgba(252,132,100,0.32) 0px 8px 24px;">Get a Quote <span aria-hidden="true">↗</span></a>
            <a href="#pricing" class="tlink" style="display:inline-flex;align-items:center;min-height:52px;padding:0 12px;font-size:15px;font-weight:500;color:rgb(103,98,90);">See pricing ↓</a>
          </div>
          <p class="mono" style="margin:0;font-size:12.5px;letter-spacing:0.06em;color:rgb(107,102,93);">
            {setup} setup &middot; {monthly}/mo &middot; live in 3&ndash;4 weeks
          </p>
        </div>

        <!-- Big Shopify mark -->
        <div style="position:relative;display:flex;aspect-ratio:1/1;align-items:center;justify-content:center;overflow:hidden;border-radius:26px;background:linear-gradient(135deg,#a5cc5d,#95BF47,#7fa93c);box-shadow:rgba(149,191,71,0.4) 0px 24px 60px;">
          <ShopifyLogo
            variant="mono"
            class="h-[52%] w-[52%] text-white"
          />
          <span class="mono" style="position:absolute;bottom:20px;font-size:11.5px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.85);">Built on your Shopify</span>
        </div>
      </div>
    </section>

    <!-- Theme vs Custom -->
    <section style="padding: 48px 0; border-top: 1px solid rgba(27,26,23,0.06);">
      <div class="wrap" style="display:flex;flex-direction:column;gap:40px;">
        <div style="display:flex;flex-direction:column;gap:16px;max-width:680px;">
          <p class="eyebrow"><span></span>The difference</p>
          <h2 style="margin:0;font-size:clamp(30px,3.6vw,44px);line-height:1.08;font-weight:600;letter-spacing:-0.025em;">
            Themes look like everyone. Custom looks like <span style="color:rgb(94,142,62);font-style:italic;">you</span>
          </h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px;">
          <!-- Theme store -->
          <div style="border-radius:18px;background:rgba(27,26,23,0.03);box-shadow:rgba(27,26,23,0.04) 0px 0px 0px 1px;padding:30px;display:flex;flex-direction:column;gap:20px;">
            <p class="mono" style="margin:0;font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:rgb(107,102,93);">
              Your store on a theme
            </p>
            <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:16px;">
              {
                themeCons.map((item) => (
                  <li style="display:flex;align-items:flex-start;gap:12px;font-size:15px;line-height:1.55;color:rgb(103,98,90);">
                    <span class="mono" style="color:rgb(168,162,150);font-size:15px;">×</span>
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Custom storefront -->
          <div style="border-radius:18px;background:linear-gradient(135deg,#a5cc5d,#95BF47,#7fa93c);box-shadow:rgba(149,191,71,0.28) 0px 14px 34px;padding:30px;color:rgb(27,26,23);display:flex;flex-direction:column;gap:20px;">
            <p class="mono" style="margin:0;font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(27,26,23,0.7);">
              Your store, custom-built
            </p>
            <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:16px;">
              {
                customPros.map((item) => (
                  <li style="display:flex;align-items:flex-start;gap:12px;font-size:15px;line-height:1.55;color:rgba(27,26,23,0.88);">
                    <svg style="margin-top:2px;width:16px;height:16px;flex-shrink:0;color:white;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section style="padding: 48px 0; border-top: 1px solid rgba(27,26,23,0.06);">
      <div class="wrap" style="display:flex;flex-direction:column;gap:40px;">
        <div style="display:flex;flex-direction:column;gap:16px;max-width:680px;">
          <p class="eyebrow"><span></span>How it works</p>
          <h2 style="margin:0;font-size:clamp(30px,3.6vw,44px);line-height:1.08;font-weight:600;letter-spacing:-0.025em;">
            Shopify stays the engine
          </h2>
          <p style="margin:0;font-size:16px;line-height:1.6;color:rgb(103,98,90);">
            Nothing changes about how you run your store. Your team keeps working
            in the same Shopify admin — we connect a new storefront in front of
            it.
          </p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:22px;">
          {
            steps.map((s) => (
              <div style="border-radius:18px;background:rgb(255,254,252);box-shadow:rgba(27,26,23,0.04) 0px 0px 0px 1px, rgba(27,26,23,0.08) 0px 10px 28px;padding:28px;display:flex;flex-direction:column;gap:14px;">
                <span class="mono" style="font-size:32px;font-weight:500;color:rgb(94,142,62);">{s.n}</span>
                <h3 style="margin:0;font-size:19px;font-weight:600;letter-spacing:-0.02em;">{s.h}</h3>
                <p style="margin:0;font-size:14.5px;line-height:1.55;color:rgb(103,98,90);">{s.p}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Performance -->
    <section style="padding: 48px 0; border-top: 1px solid rgba(27,26,23,0.06);">
      <div class="wrap" style="display:flex;flex-direction:column;gap:40px;">
        <div style="display:flex;flex-direction:column;gap:16px;max-width:680px;">
          <p class="eyebrow"><span></span>Speed that sells</p>
          <h2 style="margin:0;font-size:clamp(30px,3.6vw,44px);line-height:1.08;font-weight:600;letter-spacing:-0.025em;">
            Built to feel <span style="color:rgb(94,142,62);font-style:italic;">instant</span>
          </h2>
          <p style="margin:0;font-size:16px;line-height:1.6;color:rgb(103,98,90);">
            Slow stores lose sales — shoppers leave before the page finishes
            loading. Every technique below ships as standard, not as an add-on.
          </p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:36px 56px;">
          {
            perf.map((item) => (
              <div style="display:flex;flex-direction:column;gap:10px;">
                <h3 style="margin:0;font-size:17px;font-weight:600;letter-spacing:-0.01em;">{item.h}</h3>
                <p style="margin:0;font-size:15px;line-height:1.65;color:rgb(103,98,90);">{item.p}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" style="padding: 48px 0 72px; border-top: 1px solid rgba(27,26,23,0.06); scroll-margin-top:96px;">
      <div class="wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:40px;align-items:start;">
        <div style="display:flex;flex-direction:column;gap:20px;">
          <p class="eyebrow"><span></span>Pricing</p>
          <h2 style="margin:0;max-width:20ch;font-size:clamp(30px,3.6vw,44px);line-height:1.08;font-weight:600;letter-spacing:-0.025em;">
            One setup, one flat monthly
          </h2>
          <p style="margin:0;max-width:52ch;font-size:15.5px;line-height:1.6;color:rgb(103,98,90);">
            The setup covers design and the full storefront build on your
            existing Shopify. The monthly covers everything after launch —
            hosting, monitoring, and maintenance. Larger catalogs or custom
            features are quoted in writing before we start.
          </p>
          <p style="margin:0;max-width:52ch;font-size:15.5px;line-height:1.6;color:rgb(103,98,90);">
            Your Shopify subscription stays with Shopify — this replaces your
            theme, not your store.
          </p>
        </div>

        <div class="lift" style="border-radius:18px;background:rgba(149,191,71,0.1);box-shadow:rgba(149,191,71,0.35) 0px 0px 0px 1px;padding:6px;">
          <div style="position:relative;overflow:hidden;border-radius:14px;background:linear-gradient(135deg,#a5cc5d,#95BF47,#7fa93c);padding:32px;color:rgb(27,26,23);display:flex;flex-direction:column;">
            <ShopifyLogo
              variant="mono"
              class="pointer-events-none absolute -top-6 -right-5 h-32 w-32 text-white/[0.25]"
            />
            <span class="mono" style="align-self:flex-start;display:inline-flex;align-items:center;gap:8px;border-radius:9999px;border:1px solid rgba(255,255,255,0.4);background:rgba(255,255,255,0.3);padding:5px 12px;font-size:11.5px;letter-spacing:0.1em;text-transform:uppercase;color:rgb(27,26,23);margin-bottom:24px;">
              <ShopifyLogo variant="mono" class="h-3.5 w-3.5 text-charcoal" /> For Shopify stores
            </span>
            <h3 style="margin:0;font-size:24px;font-weight:600;letter-spacing:-0.02em;">E-commerce Storefront</h3>
            <div style="margin-top:12px;display:flex;flex-wrap:wrap;align-items:baseline;gap:8px;">
              <span style="font-size:30px;font-weight:700;letter-spacing:-0.02em;">{setup}</span>
              <span style="font-size:16px;color:rgba(27,26,23,0.6);">setup</span>
              <span style="color:rgba(27,26,23,0.6);">+</span>
              <span style="font-size:30px;font-weight:700;letter-spacing:-0.02em;">{monthly}</span>
              <span style="font-size:16px;color:rgba(27,26,23,0.6);">/mo</span>
            </div>
            <ul style="position:relative;margin:24px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:12px;font-size:14px;color:rgba(27,26,23,0.85);">
              {
                planFeatures.map((f) => (
                  <li style="display:flex;align-items:flex-start;gap:12px;">
                    <svg style="margin-top:2px;width:16px;height:16px;flex-shrink:0;color:white;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                    {f}
                  </li>
                ))
              }
            </ul>
            <div style="position:relative;margin-top:auto;padding-top:28px;">
              <a href="/quote?plan=ecommerce" style="display:inline-flex;width:100%;align-items:center;justify-content:center;gap:8px;border-radius:9999px;background:rgb(27,26,23);padding:14px 20px;font-size:14px;font-weight:500;color:rgb(246,245,243);text-decoration:none;">
                Get a Quote <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section style="padding: 72px 0; border-top: 1px solid rgba(27,26,23,0.06);">
      <div class="wrap" style="display:flex;flex-direction:column;gap:36px;">
        <div style="display:flex;flex-direction:column;gap:16px;max-width:640px;">
          <p class="eyebrow"><span></span>FAQ</p>
          <h2 style="margin:0;font-size:clamp(30px,3.6vw,44px);line-height:1.08;font-weight:600;letter-spacing:-0.025em;">
            Common questions
          </h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:36px 56px;">
          {
            faqs.map((faq) => (
              <div style="display:flex;flex-direction:column;gap:10px;">
                <h3 style="margin:0;font-size:17px;font-weight:600;letter-spacing:-0.01em;">{faq.q}</h3>
                <p style="margin:0;font-size:15px;line-height:1.65;color:rgb(103,98,90);">{faq.a}</p>
              </div>
            ))
          }
        </div>
        <p style="margin:0;font-size:15px;color:rgb(103,98,90);">
          More detail on the service itself?
          <a href="/services/ecommerce" class="tlink" style="color:rgb(94,142,62);">Read about our e-commerce website development →</a>
        </p>
      </div>
    </section>

    <!-- Dark CTA -->
    <section id="contact" class="dark" style="padding: 104px 0px 96px; background: rgb(23, 21, 18); color: rgb(236, 233, 226);">
      <div class="wrap" style="display:flex;flex-direction:column;align-items:flex-start;gap:24px;max-width:760px;">
        <p class="eyebrow"><span style="width:6px;height:6px;border-radius:9999px;background:rgb(149,191,71);"></span>Get started</p>
        <h2 style="margin:0;max-width:18ch;font-size:clamp(40px,5.6vw,72px);line-height:1;font-weight:600;letter-spacing:-0.035em;">
          Your store deserves better than a <span style="color:rgb(149,191,71);font-style:italic;">theme</span>
        </h2>
        <p style="margin:0;max-width:560px;font-size:19px;line-height:1.55;color:rgb(184,178,167);">
          Send us your store's link — we'll reply with what a custom storefront
          would look like for your brand, and a clear price in writing.
        </p>
        <a href="/quote?plan=ecommerce" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:8px;min-height:52px;padding:0 24px;border-radius:11px;background:rgb(252,132,100);color:rgb(27,26,23);font-size:15px;font-weight:500;text-decoration:none;box-shadow:rgba(252,132,100,0.28) 0px 8px 24px;">Get a Quote <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
</MockupLayout>
