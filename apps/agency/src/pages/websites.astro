---
// /websites: the website-only offer for businesses (no ads).
// Design from the Claude Design canvas, standalone like the homepage: own
// <html>/<head>, fonts and global styles, no ClientRouter. Prices come from
// WEBSITE_ONLY in src/data/pricing.ts, project cards from the real client
// entries in src/data/projects.ts, reviews from the Elfsight Google reviews
// widget. Every CTA routes to /quote?plan=website.
import Analytics from "../components/Analytics.astro";
import GoogleReviews from "../components/GoogleReviews.astro";
import { PRICING, WEBSITE_ONLY, fmtPrice } from "../data/pricing";
import { PROJECTS } from "../data/projects";

const SITE = 'https://www.alisamadii.com';
const PATH = '/websites';
const url = new URL(PATH, SITE).href;
const setup = fmtPrice(WEBSITE_ONLY.setup);
const monthly = fmtPrice(WEBSITE_ONLY.monthly);
const ecomSetup = fmtPrice(PRICING.ecommerce.setup);
const ecomMonthly = fmtPrice(PRICING.ecommerce.monthly);
const title = 'Web Design for Small Businesses | Ali Samadi Agency';
const description = `Custom, hand-coded websites for businesses anywhere. Easy to edit yourself, yours to keep. ${setup} + ${monthly}/mo.`;
const ogImage = '/og/websites.jpg';
const quoteHref = '/quote?plan=website';

const projects = ['fla2z-construction', 'mohammad-samadi', 'hazara-oregon']
  .map((slug) => PROJECTS.find((p) => p.slug === slug))
  .filter((p) => p !== undefined);

const faqs = [
  {
    q: "What's included in the monthly plan?",
    a: `Client Hub: edit text, images, and pages by chatting with AI, preview the change, then publish. Analytics, speed reports, and support are included, all for ${monthly}/mo. Your domain, hosting, and code are set up in your own accounts, so you own everything.`,
  },
  {
    q: 'How fast can my site go live?',
    a: 'Simple sites launch the day after you approve the design. Larger multi-page sites take one to two weeks.',
  },
  {
    q: 'I already have a website. Can you redesign it?',
    a: "Yes. We rebuild it, move your content over, and redirect old pages so you keep the rankings you've earned.",
  },
  {
    q: 'Who owns the website?',
    a: 'You do: domain, code, and content. The code lives in a repository you own.',
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE}/` },
        { "@type": "ListItem", "position": 2, "name": "Websites", "item": url },
      ],
    },
    {
      "@type": "Service",
      "name": "Website design for small businesses",
      "serviceType": "Web design and development",
      "provider": { "@id": `${SITE}/#organization` },
      "areaServed": "Worldwide",
      "url": url,
      "offers": [{
        "@type": "Offer",
        "name": WEBSITE_ONLY.name,
        "price": String(WEBSITE_ONLY.setup),
        "priceCurrency": "USD",
        "description": `${setup} setup + ${monthly}/mo: ${WEBSITE_ONLY.features.join(", ")}.`,
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": String(WEBSITE_ONLY.monthly),
          "priceCurrency": "USD",
          "unitText": "MONTH",
        },
      }, {
        "@type": "Offer",
        "name": "E-commerce Storefront",
        "price": String(PRICING.ecommerce.setup),
        "priceCurrency": "USD",
        "description": `${ecomSetup} setup + ${ecomMonthly}/mo: a custom storefront on your existing Shopify.`,
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": String(PRICING.ecommerce.monthly),
          "priceCurrency": "USD",
          "unitText": "MONTH",
        },
      }],
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
