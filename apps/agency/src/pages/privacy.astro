---
// Privacy — migrated to the mockup design system (MockupLayout).
import MockupLayout from "../layouts/MockupLayout.astro";

const updated = "August 2025";
---

<MockupLayout
  title="Privacy Policy — Ali Samadi Agency"
  description="How Ali Samadi Agency collects, uses, and protects the personal information you share through our website, contact forms, and checkout."
  canonical="https://alisamadii.com/privacy"
  og={{
    title: "Privacy Policy — Ali Samadi Agency",
    description:
      "How Ali Samadi Agency collects, uses, and protects your personal information.",
    url: "https://alisamadii.com/privacy",
    twitterDescription:
      "How Ali Samadi Agency collects, uses, and protects your personal information.",
  }}
>
  <main id="top">
    <!-- Hero -->
    <section style="padding: 140px 0 32px;">
      <div class="wrap" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:18px;">
        <p class="eyebrow"><span></span>Legal</p>
        <h1 class="hero-h1" style="margin:0;max-width:18ch;font-size:clamp(40px,6vw,76px);line-height:1.02;font-weight:600;letter-spacing:-0.035em;">
          Privacy <span style="color:rgb(194,69,31);font-style:italic;">Policy</span>
        </h1>
        <p class="mono" style="margin:0;font-size:12.5px;letter-spacing:0.08em;text-transform:uppercase;color:rgb(107,102,93);">
          Last updated: {updated}
        </p>
      </div>
    </section>

    <!-- Body -->
    <section style="padding: 24px 0 96px; border-top: 1px solid rgba(27,26,23,0.06);">
      <div class="wrap" style="max-width:820px;">
        <div class="prose" style="padding-top:48px;">
          <p>
            Ali Samadi Agency ("we", "us", "our") operates
            <strong>alisamadii.com</strong>. This policy explains what
            personal information we collect, why we collect it, and how you can
            control it. We keep data collection to the minimum needed to respond
            to you and deliver our services.
          </p>

          <h2>Information we collect</h2>
          <ul>
            <li>
              <strong>Contact details</strong> you submit through our contact or
              onboarding forms — such as your name, email address, and message.
            </li>
            <li>
              <strong>Billing information</strong> when you start a project. Payments
              are processed by Stripe; we never see or store your full card details.
            </li>
            <li>
              <strong>Basic usage data</strong> (e.g. pages visited) collected by
              privacy-respecting analytics to help us improve the site.
            </li>
          </ul>

          <h2>How we use your information</h2>
          <p>
            We use your information to reply to enquiries, prepare quotes,
            deliver and support projects, process payments, and meet our legal
            and accounting obligations. We do not sell your personal
            information, and we do not use it for advertising.
          </p>

          <h2>Third-party services</h2>
          <p>
            We rely on a small number of trusted providers to run our business
            — including <strong>Stripe</strong> for payments and our hosting and
            email providers for delivering the site and communicating with you.
            Each processes data only as needed to provide their service.
          </p>

          <h2>Your rights</h2>
          <p>
            You can ask us to access, correct, or delete the personal
            information we hold about you at any time. To make a request, email
            <a href="mailto:agency@alisamadii.com">agency@alisamadii.com</a> and
            we'll respond promptly.
          </p>

          <h2>Contact</h2>
          <p>
            Questions about this policy? Reach us at
            <a href="mailto:agency@alisamadii.com">agency@alisamadii.com</a>, Ali
            Samadi Agency, USA.
          </p>
        </div>
      </div>
    </section>
  </main>
</MockupLayout>
