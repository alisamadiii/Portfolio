---
import Layout from "../layouts/Layout.astro";
import HomeNav from "../components/HomeNav.astro";
import HomeFooter from "../components/HomeFooter.astro";
import PricingCards from "../components/PricingCards.astro";
import QuoteForm from "../components/QuoteForm.astro";
import Testimonial from "../components/Testimonial.astro";
import ClientResults from "../components/ClientResults.astro";
import { CLIENT_PROJECTS, CONCEPT_PROJECTS } from "../data/projects";
import { cities } from "../data/cities";
import { PRICING, fmtPrice } from "../data/pricing";

const SITE = "https://agency.alisamadii.com";

const faqs = [
  {
    q: "How much does a website cost?",
    a: `Choose the all-inclusive plan from ${fmtPrice(PRICING.monthly)}/month — where most projects land — covering design, development, hosting, and ongoing updates. Or go with a one-time build you own outright, priced per project after we scope it together.`,
  },
  {
    q: "How long does it take to launch?",
    a: "Most single-page sites go from concept to launch in one day. Larger multi-page sites and web apps typically take one to two weeks, since one team handles design and development without hand-offs.",
  },
  {
    q: "Do you only work with Jacksonville businesses?",
    a: "No. We're headquartered in Jacksonville and serve businesses across Florida — Miami, Tampa, Orlando, and beyond — as well as remote clients anywhere in the US. Everything is handled online if you prefer.",
  },
  {
    q: "Why custom code instead of a website builder?",
    a: "Every site is hand-built with Next.js and React — no WordPress, Wix, or templates. Custom code loads faster, scores better on Google's Core Web Vitals, and can grow into a full web app without a rebuild.",
  },
  {
    q: "What's included in the monthly plan?",
    a: `From ${fmtPrice(PRICING.monthly)}/month you get design, development, hosting, unlimited content updates, SEO basics, and support — one flat fee, cancel anytime, no hidden costs. Pricing varies with scope, but for most projects this is the price.`,
  },
];

const schema = [
  {
    "@type": "FAQPage",
    "@id": `${SITE}/#faq`,
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];

const hq = cities.find((c) => c.isHeadquarters);
const otherCities = cities.filter((c) => !c.isHeadquarters);
---

<Layout
  title="Jacksonville Web Design & Development Agency | Ali Samadi"
  description="Ali Samadi Agency builds custom-coded websites and web apps for Jacksonville, FL businesses. Design + development in-house, transparent pricing."
  canonical="https://agency.alisamadii.com"
  og={{
    title: "Jacksonville Web Design & Development — Ali Samadi Agency",
    description:
      "Custom websites and web apps for businesses in Jacksonville and across Florida. One team owns design, code, SEO, and hosting — fast, transparent, no templates.",
    url: "https://agency.alisamadii.com",
    twitterDescription:
      "Custom websites and web apps for Jacksonville, FL businesses — design and development under one roof.",
  }}
  schema={schema}
  bodyClass="noise bg-cream text-charcoal selection:bg-accent/25 font-sans"
>
  <HomeNav />

  <main>
    <!-- ==================== HERO ==================== -->
    <section
      id="hero"
      class="mx-auto max-w-[1200px] px-6 pt-[128px] pb-20 md:px-10"
    >
      <div
        class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.25fr_1fr] lg:gap-16"
      >
        <div class="stagger">
          <div
            class="reveal mb-8 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] text-muted uppercase"
          >
            <span class="h-px w-[26px] bg-accent"></span>01 &mdash; Web Design
            Agency &middot; Jacksonville, FL
          </div>
          <h1
            class="max-w-[14ch] text-[clamp(44px,7vw,92px)] leading-[0.98] font-semibold tracking-[-0.035em]"
          >
            <span
              class="mb-4 block font-mono text-[13px] font-normal tracking-[0.12em] text-muted uppercase"
              >Jacksonville web design &amp; development</span
            >
            We build digital
            <span class="text-accent" id="scrambleTarget">experiences</span
            ><span class="scramble-cursor"></span>
          </h1>
          <p
            class="reveal mt-[30px] max-w-[52ch] text-[17px] leading-[1.55] text-warmgray md:text-[19px]"
          >
            A Jacksonville, FL web design and development agency creating brand
            identities, custom websites, and web apps that drive real,
            measurable results.
          </p>
          <div class="reveal mt-10 flex flex-wrap items-center gap-3.5">
            <a
              href="https://cal.com/alisamadii"
              target="_blank"
              rel="noopener noreferrer"
              class="mag-btn inline-flex items-center gap-2.5 rounded-[11px] bg-accent px-6 py-3.5 text-[15.5px] font-medium text-charcoal shadow-[0_8px_24px_rgba(252,132,100,0.32)] hover:bg-charcoal hover:text-cream"
            >
              Start a Project
              <span>&#8599;</span>
            </a>
            <a
              href="https://hub.alisamadii.com"
              target="_blank"
              rel="noopener noreferrer"
              class="mag-btn px-2 py-3.5 text-[15px] text-warmgray hover:text-charcoal"
              >I am a customer</a
            >
          </div>
        </div>
        <div>
          <QuoteForm compact />
        </div>
      </div>
    </section>

    <!-- ==================== MARQUEE ==================== -->
    <div
      class="overflow-hidden border-y border-charcoal/[0.08] bg-[#f1efec] py-[18px]"
    >
      <div class="marquee-track flex w-max whitespace-nowrap">
        <span class="font-mono text-[15px] tracking-[0.02em] text-[#6b665d]">
          Design&nbsp;&nbsp;/&nbsp;&nbsp;Develop&nbsp;&nbsp;/&nbsp;&nbsp;Deliver&nbsp;&nbsp;/&nbsp;&nbsp;Brand&nbsp;&nbsp;/&nbsp;&nbsp;Strategy&nbsp;&nbsp;/&nbsp;&nbsp;Innovate&nbsp;&nbsp;/&nbsp;&nbsp;Design&nbsp;&nbsp;/&nbsp;&nbsp;Develop&nbsp;&nbsp;/&nbsp;&nbsp;Deliver&nbsp;&nbsp;/&nbsp;&nbsp;Brand&nbsp;&nbsp;/&nbsp;&nbsp;Strategy&nbsp;&nbsp;/&nbsp;&nbsp;Innovate&nbsp;&nbsp;/&nbsp;&nbsp;
        </span>
        <span class="font-mono text-[15px] tracking-[0.02em] text-[#6b665d]">
          Design&nbsp;&nbsp;/&nbsp;&nbsp;Develop&nbsp;&nbsp;/&nbsp;&nbsp;Deliver&nbsp;&nbsp;/&nbsp;&nbsp;Brand&nbsp;&nbsp;/&nbsp;&nbsp;Strategy&nbsp;&nbsp;/&nbsp;&nbsp;Innovate&nbsp;&nbsp;/&nbsp;&nbsp;Design&nbsp;&nbsp;/&nbsp;&nbsp;Develop&nbsp;&nbsp;/&nbsp;&nbsp;Deliver&nbsp;&nbsp;/&nbsp;&nbsp;Brand&nbsp;&nbsp;/&nbsp;&nbsp;Strategy&nbsp;&nbsp;/&nbsp;&nbsp;Innovate&nbsp;&nbsp;/&nbsp;&nbsp;
        </span>
      </div>
    </div>

    <!-- ==================== STATS ==================== -->
    <section class="mx-auto max-w-[1200px] px-6 py-14 md:px-10">
      <div class="stagger grid grid-cols-2 gap-6 md:grid-cols-4">
        <div class="reveal py-2">
          <div
            class="text-[44px] leading-none font-semibold tracking-[-0.03em]"
          >
            8<span class="text-accent">+</span>
          </div>
          <div class="mt-2.5 text-sm text-warmgray">Projects Delivered</div>
        </div>
        <div class="reveal py-2">
          <div
            class="text-[44px] leading-none font-semibold tracking-[-0.03em]"
          >
            100<span class="text-accent">%</span>
          </div>
          <div class="mt-2.5 text-sm text-warmgray">
            Custom-Built, No Templates
          </div>
        </div>
        <div class="reveal py-2">
          <div
            class="text-[44px] leading-none font-semibold tracking-[-0.03em]"
          >
            5<span class="text-accent">+</span>
          </div>
          <div class="mt-2.5 text-sm text-warmgray">Years Experience</div>
        </div>
        <div class="reveal py-2">
          <div
            class="text-[44px] leading-none font-semibold tracking-[-0.03em]"
          >
            1
          </div>
          <div class="mt-2.5 text-sm text-warmgray">Focused Team</div>
        </div>
      </div>
    </section>

    <!-- ==================== ABOUT ==================== -->
    <section
      id="about"
      class="mx-auto max-w-[1200px] border-t border-charcoal/[0.08] px-6 py-[70px] md:px-10"
    >
      <div
        class="reveal mb-8 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] text-muted uppercase"
      >
        <span class="h-px w-[26px] bg-accent"></span>02 &mdash; About Us
      </div>
      <div
        class="grid grid-cols-1 items-end gap-10 md:grid-cols-[1.2fr_1fr] md:gap-14"
      >
        <h2
          class="reveal text-[clamp(30px,3.6vw,48px)] leading-[1.08] font-semibold tracking-[-0.03em]"
        >
          We craft digital products that people
          <span class="text-accent">love</span> to use
        </h2>
        <div>
          <p class="reveal text-[17px] leading-[1.6] text-warmgray">
            Ali Samadi Agency is a small, focused studio based in Jacksonville,
            Florida, building websites and web apps for startups and small
            businesses. We design and develop every project from scratch on a
            modern stack — Next.js, React, and Postgres — so your site is fast,
            custom, and genuinely yours, never a recycled template. From brand
            and UI design through development, SEO, and hosting, one team owns
            the whole build, which keeps the work consistent and the timeline
            short.
          </p>
          <a
            href="/about"
            class="reveal mt-5 inline-flex items-center gap-2 text-[15px] font-medium transition-colors duration-300 hover:text-accent"
          >
            More about the studio
            <span class="text-accent">&#8599;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ==================== SERVICES ==================== -->
    <section
      id="services"
      class="mx-auto max-w-[1200px] border-t border-charcoal/[0.08] px-6 py-[70px] md:px-10"
    >
      <div
        class="reveal mb-9 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] text-muted uppercase"
      >
        <span class="h-px w-[26px] bg-accent"></span>03 &mdash; Our Services
      </div>

      <div
        class="grid grid-cols-1 gap-[18px] md:auto-rows-[minmax(210px,auto)] md:grid-cols-6"
      >
        <!-- Brand Identity -->
        <div
          data-spot
          class="reveal relative overflow-hidden rounded-[18px] border border-charcoal/[0.08] bg-white p-[30px] md:col-span-3"
        >
          <div
            data-glow
            class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
          >
          </div>
          <div class="relative flex h-full flex-col">
            <div
              class="inline-flex size-11 items-center justify-center rounded-xl bg-accent/[0.12] text-accent"
            >
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
                <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
                <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
                <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
                <path
                  d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2Z"
                ></path>
              </svg>
            </div>
            <h3
              class="mt-auto pt-8 text-[23px] font-semibold tracking-[-0.02em]"
            >
              Brand Identity
            </h3>
            <p
              class="mt-2.5 max-w-[38ch] text-[15px] leading-[1.55] text-warmgray"
            >
              Crafting distinctive visual identities that resonate with your
              audience and set you apart from the competition.
            </p>
            <a
              href="/services/brand-identity"
              class="mt-4 inline-flex items-center gap-1.5 text-[14px] font-medium text-accent transition-colors duration-300 hover:text-charcoal"
              >Learn more <span>&rarr;</span></a
            >
          </div>
        </div>

        <!-- Web Development -->
        <div
          data-spot
          class="reveal relative overflow-hidden rounded-[18px] border border-charcoal/[0.08] bg-white p-[30px] md:col-span-3"
        >
          <div
            data-glow
            class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
          >
          </div>
          <div class="relative flex h-full flex-col">
            <div
              class="inline-flex size-11 items-center justify-center rounded-xl bg-accent/[0.12] text-accent"
            >
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m16 18 6-6-6-6"></path>
                <path d="m8 6-6 6 6 6"></path>
              </svg>
            </div>
            <h3
              class="mt-auto pt-8 text-[23px] font-semibold tracking-[-0.02em]"
            >
              Web Development
            </h3>
            <p
              class="mt-2.5 max-w-[38ch] text-[15px] leading-[1.55] text-warmgray"
            >
              Clean, fast websites built on Next.js, React, and Postgres &mdash;
              production-grade code, not page-builder templates. Everything a
              simple site needs, nothing it doesn't.
            </p>
            <a
              href="/services/web-development"
              class="mt-4 inline-flex items-center gap-1.5 text-[14px] font-medium text-accent transition-colors duration-300 hover:text-charcoal"
              >Learn more <span>&rarr;</span></a
            >
          </div>
        </div>

        <!-- UI/UX Design -->
        <div
          data-spot
          class="reveal relative overflow-hidden rounded-[18px] border border-charcoal/[0.08] bg-white p-7 md:col-span-2"
        >
          <div
            data-glow
            class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
          >
          </div>
          <div class="relative flex h-full flex-col">
            <div
              class="inline-flex size-[42px] items-center justify-center rounded-xl bg-accent/[0.12] text-accent"
            >
              <svg
                width="21"
                height="21"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m12 19 7-7 3 3-7 7-3-3z"></path>
                <path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
                <path d="m2 2 7.586 7.586"></path>
                <circle cx="11" cy="11" r="2"></circle>
              </svg>
            </div>
            <h3
              class="mt-auto pt-8 text-[21px] font-semibold tracking-[-0.02em]"
            >
              UI/UX Design
            </h3>
            <p class="mt-2.5 text-[14.5px] leading-[1.55] text-warmgray">
              Intuitive, user-centered interfaces that drive engagement and
              conversions.
            </p>
            <a
              href="/services/ui-ux-design"
              class="mt-4 inline-flex items-center gap-1.5 text-[13.5px] font-medium text-accent transition-colors duration-300 hover:text-charcoal"
              >Learn more <span>&rarr;</span></a
            >
          </div>
        </div>

        <!-- SEO & Analytics -->
        <div
          data-spot
          class="reveal relative overflow-hidden rounded-[18px] border border-charcoal/[0.08] bg-white p-7 md:col-span-2"
        >
          <div
            data-glow
            class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
          >
          </div>
          <div class="relative flex h-full flex-col">
            <div class="flex items-start justify-between gap-4">
              <div
                class="inline-flex size-[42px] items-center justify-center rounded-xl bg-accent/[0.12] text-accent"
              >
                <svg
                  width="21"
                  height="21"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M3 3v16a2 2 0 0 0 2 2h16"></path>
                  <path d="m19 9-5 5-4-4-3 3"></path>
                </svg>
              </div>
              <span
                class="inline-flex items-center gap-2 rounded-full border border-amber-300/60 bg-amber-50 px-3 py-1 font-mono text-[10.5px] tracking-[0.12em] text-amber-700 uppercase"
              >
                <span class="size-1.5 animate-pulse rounded-full bg-amber-500"
                ></span>
                Experimenting
              </span>
            </div>
            <h3
              class="mt-auto pt-8 text-[21px] font-semibold tracking-[-0.02em]"
            >
              SEO &amp; Analytics
            </h3>
            <p class="mt-2.5 text-[14.5px] leading-[1.55] text-warmgray">
              Data-driven optimization to boost visibility and traffic —
              including local SEO for Jacksonville and Florida businesses.
            </p>
            <a
              href="/services/seo-analytics"
              class="mt-4 inline-flex items-center gap-1.5 text-[13.5px] font-medium text-accent transition-colors duration-300 hover:text-charcoal"
              >Learn more <span>&rarr;</span></a
            >
          </div>
        </div>

        <!-- Edit Your Own Site -->
        <div
          data-spot
          class="reveal relative overflow-hidden rounded-[18px] border border-charcoal/[0.08] bg-white p-7 md:col-span-2"
        >
          <div
            data-glow
            class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
          >
          </div>
          <div class="relative flex h-full flex-col">
            <div
              class="inline-flex size-[42px] items-center justify-center rounded-xl bg-accent/[0.12] text-accent"
            >
              <svg
                width="21"
                height="21"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"
                ></path>
                <path d="m15 5 4 4"></path>
              </svg>
            </div>
            <h3
              class="mt-auto pt-8 text-[21px] font-semibold tracking-[-0.02em]"
            >
              Edit Your Own Site
            </h3>
            <p class="mt-2.5 text-[14.5px] leading-[1.55] text-warmgray">
              CMS access plus a GitHub collaborator invite &mdash; update text,
              images, and pages yourself, anytime.
            </p>
            <a
              href="/services/website-management"
              class="mt-4 inline-flex items-center gap-1.5 text-[13.5px] font-medium text-accent transition-colors duration-300 hover:text-charcoal"
              >Learn more <span>&rarr;</span></a
            >
          </div>
        </div>

        <!-- Need Something Custom? (wide, dark) -->
        <div
          data-spot
          class="reveal relative overflow-hidden rounded-[18px] border border-white/[0.08] bg-ink p-[34px] text-cream md:col-span-6"
        >
          <div
            data-glow
            class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
          >
          </div>
          <div
            class="relative flex flex-wrap items-center justify-between gap-10"
          >
            <div class="max-w-[52ch]">
              <div
                class="inline-flex size-11 items-center justify-center rounded-xl bg-accent/[0.18] text-accent"
              >
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"
                  ></path>
                  <path
                    d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"
                  ></path>
                  <path
                    d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"
                  ></path>
                </svg>
              </div>
              <h3
                class="mt-[18px] text-[26px] font-semibold tracking-[-0.02em]"
              >
                Need Something Custom?
              </h3>
              <p class="mt-2.5 text-[15.5px] leading-[1.6] text-[#b8b2a9]">
                Looking for more than a landing page? We also build fully custom
                websites — authentication, databases, admin dashboards, web apps
                — scoped and priced per project.
                <a
                  href="/services/custom-web-apps"
                  class="text-accent transition-colors duration-300 hover:text-white"
                  >About custom web apps &rarr;</a
                >
                <a
                  href="#contact"
                  class="text-accent transition-colors duration-300 hover:text-white"
                  >Get in touch &rarr;</a
                >
              </p>
            </div>
            <div class="flex max-w-[280px] flex-wrap gap-2.5">
              <span
                class="flex items-center rounded-full border border-white/[0.14] px-3.5 py-2 font-mono text-[12.5px] text-[#d9d3ca]"
              >
                Authentication
              </span>
              <span
                class="flex items-center rounded-full border border-white/[0.14] px-3.5 py-2 font-mono text-[12.5px] text-[#d9d3ca]"
              >
                Database
              </span>
              <span
                class="flex items-center rounded-full border border-white/[0.14] px-3.5 py-2 font-mono text-[12.5px] text-[#d9d3ca]"
              >
                Admin Panel
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== PROCESS ==================== -->
    <section
      class="mx-auto max-w-[1200px] border-t border-charcoal/[0.08] px-6 py-[70px] md:px-10"
    >
      <div
        class="reveal mb-11 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] text-muted uppercase"
      >
        <span class="h-px w-[26px] bg-accent"></span>04 &mdash; Our Process
      </div>

      <div
        class="stagger grid grid-cols-1 gap-[22px] sm:grid-cols-2 md:grid-cols-4"
      >
        <!-- Step 1 -->
        <div class="reveal flex flex-col">
          <div
            class="img-wrap relative aspect-[4/3] overflow-hidden rounded-[14px] border border-charcoal/[0.08]"
          >
            <img
              src="https://cdn.alisamadii.com/marketing/discovery.png"
              alt="Discovery phase illustration"
              width="1200"
              height="896"
              class="h-full w-full object-cover"
              loading="lazy"
            />
            <span
              class="absolute right-3.5 bottom-3 font-mono text-[32px] font-medium text-white/70"
              >01</span
            >
          </div>
          <h3 class="mt-[18px] text-[19px] font-semibold tracking-[-0.02em]">
            Discovery
          </h3>
          <p class="mt-2 text-[14.5px] leading-[1.55] text-warmgray">
            Understanding your goals, audience, and competitive landscape
            through deep research.
          </p>
        </div>
        <!-- Step 2 -->
        <div class="reveal flex flex-col">
          <div
            class="img-wrap relative aspect-[4/3] overflow-hidden rounded-[14px] border border-charcoal/[0.08]"
          >
            <img
              src="https://cdn.alisamadii.com/marketing/strategy.png"
              alt="Strategy phase illustration"
              width="1200"
