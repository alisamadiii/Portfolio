---
// Homepage: custom websites for businesses. The growth partnership (Google
// Ads + website) lives on /lead-generation, and /websites 301s here.
// Design from the Claude Design canvas, standalone like /lead-generation: own
// <html>/<head>, fonts and global styles, no ClientRouter. Prices are hidden
// while SHOW_PRICING is false: the page lists every feature we can build in
// category columns (featureGroups) and routes to a free consultation or a
// custom quote. Flip the flag to bring back the WEBSITE_PLANS / CARE /
// NEWSLETTER cards, the priced Offer schema and the "From $" lines. Project
// cards come from src/data/projects.ts, reviews from the Elfsight widget.
import Analytics from "../components/Analytics.astro";
import FormSubmit from "../components/FormSubmit.astro";
import GoogleReviews from "../components/GoogleReviews.astro";
import { CARE, NEWSLETTER, WEBSITE_FROM, WEBSITE_PLANS, fmtPrice } from "../data/pricing";
import { PROJECTS } from "../data/projects";

const SHOW_PRICING = false;
const SITE = 'https://www.alisamadii.com';
const PATH = '/';
const url = new URL(PATH, SITE).href;
const setup = fmtPrice(WEBSITE_FROM.setup);
const monthly = fmtPrice(WEBSITE_FROM.monthly);
const care = fmtPrice(CARE.monthly);
// Horizontal add-on rows under the plan cards, same layout for each (priced mode only).
const addOns = [
  { ...CARE, title: `${CARE.name} plan`, tag: `${care}/mo instead of ${fmtPrice(WEBSITE_FROM.monthly)}/mo · optional`, cta: "Add Care" },
  { ...NEWSLETTER, title: NEWSLETTER.name, tag: `${fmtPrice(NEWSLETTER.monthly)}/mo · optional add-on`, fine: undefined, cta: "Add Newsletter" },
];
const title = SHOW_PRICING
  ? 'Web Design for Small Businesses | Ali Samadi Agency'
  : 'Custom Website Design & Development for Small Businesses | Ali Samadi Agency';
const description = SHOW_PRICING
  ? `Custom, hand-coded websites for businesses anywhere. Easy to edit yourself, yours to keep. From ${setup} + ${monthly}/mo.`
  : 'Custom-designed, hand-coded websites you edit yourself with AI. Custom sites on your Shopify, Wix or Square, web apps, AI receptionists, local SEO and reviews, all in your own accounts. Free consultation.';
const ogImage = '/og/websites.jpg';
const quoteHref = '/quote?plan=website';
// "custom" pre-checks the "Not sure yet" chip on the quote form.
const customQuoteHref = '/quote?plan=custom';

const projects = ['fla2z-construction', 'mohammad-samadi', 'hazara-oregon']
  .map((slug) => PROJECTS.find((p) => p.slug === slug))
  .filter((p) => p !== undefined);

// Everything we can build, grouped in the columns the features section
// renders. Column order matters: the big builds come first. The same array
// feeds the OfferCatalog schema so markup and UI never drift.
type Feature = { icon: keyof typeof icons; name: string; note?: string; isNew?: boolean };
type FeatureGroup = { label: string; title: string; dark?: boolean; features: Feature[] };

// 20px lucide-style stroke icons, inline so the page stays dependency-free.
const icons = {
