---
import Layout from "../layouts/Layout.astro";
import HomeNav from "../components/HomeNav.astro";
import HomeFooter from "../components/HomeFooter.astro";
---

<Layout
  title="Ali Samadi — Creative Agency | Web Design & Development"
  description="Creative agency specializing in brand identity, web development, and digital strategy. We build digital experiences that drive results."
  canonical="https://agency.alisamadii.com"
  og={{
    title: "Ali Samadi — Creative Agency",
    description:
      "Creative agency specializing in brand identity, web development, and digital strategy. We build digital experiences that drive results.",
    url: "https://agency.alisamadii.com",
    twitterDescription:
      "Creative agency specializing in brand identity, web development, and digital strategy.",
  }}
  bodyClass="noise bg-cream text-charcoal selection:bg-accent/25 font-sans"
>
  <!-- TrustBox script -->
  <script
    is:inline
    slot="head"
    type="text/javascript"
    src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js"
    async></script>
  <!-- End TrustBox script -->

  <HomeNav />

  <!-- ==================== HERO ==================== -->
  <section
    id="hero"
    class="mx-auto max-w-[1200px] px-6 pt-[128px] pb-20 md:px-10"
  >
    <div class="stagger">
      <div
        class="reveal text-muted mb-8 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] uppercase"
      >
        <span class="bg-accent h-px w-[26px]"></span>01 &mdash; Creative Agency
      </div>
      <h1
        class="reveal max-w-[14ch] text-[clamp(44px,7vw,92px)] leading-[0.98] font-semibold tracking-[-0.035em]"
      >
        We build digital
        <span class="text-accent" id="scrambleTarget">experiences</span><span
          class="scramble-cursor"></span>
      </h1>
      <p
        class="reveal text-warmgray mt-[30px] max-w-[52ch] text-[17px] leading-[1.55] md:text-[19px]"
      >
        A creative agency specializing in brand identity, web development, and
        digital strategy that drives real, measurable results.
      </p>
      <div class="reveal mt-10 flex flex-wrap items-center gap-3.5">
        <a
          href="https://cal.com/alisamadii"
          target="_blank"
          class="mag-btn bg-accent hover:bg-charcoal inline-flex items-center gap-2.5 rounded-[11px] px-6 py-3.5 text-[15.5px] font-medium text-white shadow-[0_8px_24px_rgba(252,132,100,0.32)]"
        >
          Start a Project
          <span>&#8599;</span>
        </a>
        <a
          href="/pricing"
          class="mag-btn border-charcoal/[0.16] hover:border-accent hover:text-accent inline-flex items-center gap-2.5 rounded-[11px] border px-6 py-3.5 text-[15.5px] font-medium"
        >
          Pricing
        </a>
        <a
          href="https://portal.alisamadii.com/agency"
          target="_blank"
          class="mag-btn text-warmgray hover:text-charcoal px-2 py-3.5 text-[15px]"
          >I am a customer</a
        >
      </div>
    </div>
  </section>

  <!-- ==================== MARQUEE ==================== -->
  <div
    class="border-charcoal/[0.08] overflow-hidden border-y bg-[#f1efec] py-[18px]"
  >
    <div class="marquee-track flex w-max whitespace-nowrap">
      <span class="font-mono text-[15px] tracking-[0.02em] text-[#a49d94]">
        Design&nbsp;&nbsp;/&nbsp;&nbsp;Develop&nbsp;&nbsp;/&nbsp;&nbsp;Deliver&nbsp;&nbsp;/&nbsp;&nbsp;Brand&nbsp;&nbsp;/&nbsp;&nbsp;Strategy&nbsp;&nbsp;/&nbsp;&nbsp;Innovate&nbsp;&nbsp;/&nbsp;&nbsp;Design&nbsp;&nbsp;/&nbsp;&nbsp;Develop&nbsp;&nbsp;/&nbsp;&nbsp;Deliver&nbsp;&nbsp;/&nbsp;&nbsp;Brand&nbsp;&nbsp;/&nbsp;&nbsp;Strategy&nbsp;&nbsp;/&nbsp;&nbsp;Innovate&nbsp;&nbsp;/&nbsp;&nbsp;
      </span>
      <span class="font-mono text-[15px] tracking-[0.02em] text-[#a49d94]">
        Design&nbsp;&nbsp;/&nbsp;&nbsp;Develop&nbsp;&nbsp;/&nbsp;&nbsp;Deliver&nbsp;&nbsp;/&nbsp;&nbsp;Brand&nbsp;&nbsp;/&nbsp;&nbsp;Strategy&nbsp;&nbsp;/&nbsp;&nbsp;Innovate&nbsp;&nbsp;/&nbsp;&nbsp;Design&nbsp;&nbsp;/&nbsp;&nbsp;Develop&nbsp;&nbsp;/&nbsp;&nbsp;Deliver&nbsp;&nbsp;/&nbsp;&nbsp;Brand&nbsp;&nbsp;/&nbsp;&nbsp;Strategy&nbsp;&nbsp;/&nbsp;&nbsp;Innovate&nbsp;&nbsp;/&nbsp;&nbsp;
      </span>
    </div>
  </div>

  <!-- ==================== STATS ==================== -->
  <section class="mx-auto max-w-[1200px] px-6 py-14 md:px-10">
    <div class="stagger grid grid-cols-2 gap-6 md:grid-cols-4">
      <div class="reveal py-2">
        <div class="text-[44px] leading-none font-semibold tracking-[-0.03em]">
          8<span class="text-accent">+</span>
        </div>
        <div class="text-warmgray mt-2.5 text-sm">Projects Delivered</div>
      </div>
      <div class="reveal py-2">
        <div class="text-[44px] leading-none font-semibold tracking-[-0.03em]">
          99<span class="text-accent">%</span>
        </div>
        <div class="text-warmgray mt-2.5 text-sm">Client Satisfaction</div>
      </div>
      <div class="reveal py-2">
        <div class="text-[44px] leading-none font-semibold tracking-[-0.03em]">
          5<span class="text-accent">+</span>
        </div>
        <div class="text-warmgray mt-2.5 text-sm">Years Experience</div>
      </div>
      <div class="reveal py-2">
        <div class="text-[44px] leading-none font-semibold tracking-[-0.03em]">
          1
        </div>
        <div class="text-warmgray mt-2.5 text-sm">Focused Team</div>
      </div>
    </div>
  </section>

  <!-- ==================== ABOUT ==================== -->
  <section
    id="about"
    class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[70px] md:px-10"
  >
    <div
      class="reveal text-muted mb-8 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] uppercase"
    >
      <span class="bg-accent h-px w-[26px]"></span>02 &mdash; About Us
    </div>
    <div
      class="grid grid-cols-1 items-end gap-10 md:grid-cols-[1.2fr_1fr] md:gap-14"
    >
      <h2
        class="reveal text-[clamp(30px,3.6vw,48px)] leading-[1.08] font-semibold tracking-[-0.03em]"
      >
        We craft digital products that people
        <span class="text-accent">love</span> to use
      </h2>
      <p class="reveal text-warmgray text-[17px] leading-[1.6]">
        Founded with a passion for pixel-perfect design and clean code, we help
        brands transform their digital presence. Our approach blends creativity
        with data-driven strategy to deliver experiences that matter.
      </p>
    </div>
  </section>

  <!-- ==================== SERVICES ==================== -->
  <section
    id="services"
    class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[70px] md:px-10"
  >
    <div
      class="reveal text-muted mb-9 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] uppercase"
    >
      <span class="bg-accent h-px w-[26px]"></span>03 &mdash; Our Services
    </div>

    <div
      class="grid grid-cols-1 gap-[18px] md:auto-rows-[minmax(210px,auto)] md:grid-cols-6"
    >
      <!-- Brand Identity -->
      <div
        data-spot
        class="reveal border-charcoal/[0.08] relative overflow-hidden rounded-[18px] border bg-white p-[30px] md:col-span-3"
      >
        <div
          data-glow
          class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
        >
        </div>
        <div class="relative flex h-full flex-col">
          <div
            class="bg-accent/[0.12] text-accent inline-flex size-11 items-center justify-center rounded-xl"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
              <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
              <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
              <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
              <path
                d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2Z"
              ></path>
            </svg>
          </div>
          <h3 class="mt-auto pt-8 text-[23px] font-semibold tracking-[-0.02em]">
            Brand Identity
          </h3>
          <p
            class="text-warmgray mt-2.5 max-w-[38ch] text-[15px] leading-[1.55]"
          >
            Crafting distinctive visual identities that resonate with your
            audience and set you apart from the competition.
          </p>
        </div>
      </div>

      <!-- Web Development -->
      <div
        data-spot
        class="reveal border-charcoal/[0.08] relative overflow-hidden rounded-[18px] border bg-white p-[30px] md:col-span-3"
      >
        <div
          data-glow
          class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
        >
        </div>
        <div class="relative flex h-full flex-col">
          <div
            class="bg-accent/[0.12] text-accent inline-flex size-11 items-center justify-center rounded-xl"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m16 18 6-6-6-6"></path>
              <path d="m8 6-6 6 6 6"></path>
            </svg>
          </div>
          <h3 class="mt-auto pt-8 text-[23px] font-semibold tracking-[-0.02em]">
            Web Development
          </h3>
          <p
            class="text-warmgray mt-2.5 max-w-[38ch] text-[15px] leading-[1.55]"
          >
            Clean, fast landing pages for local businesses &mdash; everything a
            simple site needs, nothing it doesn't.
          </p>
        </div>
      </div>

      <!-- UI/UX Design -->
      <div
        data-spot
        class="reveal border-charcoal/[0.08] relative overflow-hidden rounded-[18px] border bg-white p-7 md:col-span-2"
      >
        <div
          data-glow
          class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
        >
        </div>
        <div class="relative flex h-full flex-col">
          <div
            class="bg-accent/[0.12] text-accent inline-flex size-[42px] items-center justify-center rounded-xl"
          >
            <svg
              width="21"
              height="21"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m12 19 7-7 3 3-7 7-3-3z"></path>
              <path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
              <path d="m2 2 7.586 7.586"></path>
              <circle cx="11" cy="11" r="2"></circle>
            </svg>
          </div>
          <h3 class="mt-auto pt-8 text-[21px] font-semibold tracking-[-0.02em]">
            UI/UX Design
          </h3>
          <p class="text-warmgray mt-2.5 text-[14.5px] leading-[1.55]">
            Intuitive, user-centered interfaces that drive engagement and
            conversions.
          </p>
        </div>
      </div>

      <!-- SEO & Analytics -->
      <div
        data-spot
        class="reveal border-charcoal/[0.08] relative overflow-hidden rounded-[18px] border bg-white p-7 md:col-span-2"
      >
        <div
          data-glow
          class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
        >
        </div>
        <div class="relative flex h-full flex-col">
          <div
            class="bg-accent/[0.12] text-accent inline-flex size-[42px] items-center justify-center rounded-xl"
          >
            <svg
              width="21"
              height="21"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 3v16a2 2 0 0 0 2 2h16"></path>
              <path d="m19 9-5 5-4-4-3 3"></path>
            </svg>
          </div>
          <h3 class="mt-auto pt-8 text-[21px] font-semibold tracking-[-0.02em]">
            SEO &amp; Analytics
          </h3>
          <p class="text-warmgray mt-2.5 text-[14.5px] leading-[1.55]">
            Data-driven optimization to boost visibility, traffic and meaningful
            engagement.
          </p>
        </div>
      </div>

      <!-- Edit Your Own Site -->
      <div
        data-spot
        class="reveal border-charcoal/[0.08] relative overflow-hidden rounded-[18px] border bg-white p-7 md:col-span-2"
      >
        <div
          data-glow
          class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
        >
        </div>
        <div class="relative flex h-full flex-col">
          <div
            class="bg-accent/[0.12] text-accent inline-flex size-[42px] items-center justify-center rounded-xl"
          >
            <svg
              width="21"
              height="21"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"
              ></path>
              <path d="m15 5 4 4"></path>
            </svg>
          </div>
          <h3 class="mt-auto pt-8 text-[21px] font-semibold tracking-[-0.02em]">
            Edit Your Own Site
          </h3>
          <p class="text-warmgray mt-2.5 text-[14.5px] leading-[1.55]">
            CMS access plus a GitHub collaborator invite &mdash; update text,
            images, and pages yourself, anytime.
          </p>
        </div>
      </div>

      <!-- Need Something Custom? (wide, dark) -->
      <div
        data-spot
        class="reveal bg-ink text-cream relative overflow-hidden rounded-[18px] border border-white/[0.08] p-[34px] md:col-span-6"
      >
        <div
          data-glow
          class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
        >
        </div>
        <div class="relative flex flex-wrap items-center justify-between gap-10">
          <div class="max-w-[52ch]">
            <div
              class="bg-accent/[0.18] text-accent inline-flex size-11 items-center justify-center rounded-xl"
            >
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"
                ></path>
                <path
                  d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"
                ></path>
                <path
                  d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"
                ></path>
              </svg>
            </div>
            <h3 class="mt-[18px] text-[26px] font-semibold tracking-[-0.02em]">
              Need Something Custom?
            </h3>
            <p class="mt-2.5 text-[15.5px] leading-[1.6] text-[#b8b2a9]">
              Looking for more than a landing page? We also build fully custom
              websites — authentication, databases, admin dashboards, web apps —
              scoped and priced per project.
              <a
                href="#contact"
                class="text-accent transition-colors duration-300 hover:text-white"
                >Get in touch &rarr;</a
              >
            </p>
          </div>
          <div class="flex max-w-[280px] flex-wrap gap-2.5">
            <span
              class="flex items-center rounded-full border border-white/[0.14] px-3.5 py-2 font-mono text-[12.5px] text-[#d9d3ca]"
            >
              Authentication
            </span>
            <span
              class="flex items-center rounded-full border border-white/[0.14] px-3.5 py-2 font-mono text-[12.5px] text-[#d9d3ca]"
            >
              Database
            </span>
            <span
              class="flex items-center rounded-full border border-white/[0.14] px-3.5 py-2 font-mono text-[12.5px] text-[#d9d3ca]"
            >
              Admin Panel
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PROCESS ==================== -->
  <section
    class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[70px] md:px-10"
  >
    <div
      class="reveal text-muted mb-11 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] uppercase"
    >
      <span class="bg-accent h-px w-[26px]"></span>04 &mdash; Our Process
    </div>

    <div
      class="stagger grid grid-cols-1 gap-[22px] sm:grid-cols-2 md:grid-cols-4"
    >
      <!-- Step 1 -->
      <div class="reveal flex flex-col">
        <div
          class="img-wrap border-charcoal/[0.08] relative aspect-[4/3] overflow-hidden rounded-[14px] border"
        >
          <img
            src="https://cdn.alisamadii.com/marketing/discovery.png"
            alt="Discovery phase illustration"
            class="h-full w-full object-cover"
            loading="lazy"
          />
          <span
            class="absolute right-3.5 bottom-3 font-mono text-[32px] font-medium text-white/70"
            >01</span
          >
        </div>
        <h3 class="mt-[18px] text-[19px] font-semibold tracking-[-0.02em]">
          Discovery
        </h3>
        <p class="text-warmgray mt-2 text-[14.5px] leading-[1.55]">
          Understanding your goals, audience, and competitive landscape through
          deep research.
        </p>
      </div>
      <!-- Step 2 -->
      <div class="reveal flex flex-col">
        <div
          class="img-wrap border-charcoal/[0.08] relative aspect-[4/3] overflow-hidden rounded-[14px] border"
        >
          <img
            src="https://cdn.alisamadii.com/marketing/strategy.png"
            alt="Strategy phase illustration"
            class="h-full w-full object-cover"
            loading="lazy"
          />
          <span
            class="absolute right-3.5 bottom-3 font-mono text-[32px] font-medium text-white/70"
            >02</span
          >
        </div>
        <h3 class="mt-[18px] text-[19px] font-semibold tracking-[-0.02em]">
          Strategy
        </h3>
        <p class="text-warmgray mt-2 text-[14.5px] leading-[1.55]">
          Defining the roadmap, architecture, and creative direction for maximum
          impact.
        </p>
      </div>
      <!-- Step 3 -->
      <div class="reveal flex flex-col">
        <div
          class="img-wrap border-charcoal/[0.08] relative aspect-[4/3] overflow-hidden rounded-[14px] border"
        >
          <img
            src="https://cdn.alisamadii.com/marketing/execution.png"
            alt="Execution phase illustration"
            class="h-full w-full object-cover"
            loading="lazy"
          />
          <span
            class="absolute right-3.5 bottom-3 font-mono text-[32px] font-medium text-white/70"
            >03</span
          >
        </div>
        <h3 class="mt-[18px] text-[19px] font-semibold tracking-[-0.02em]">
          Execution
        </h3>
        <p class="text-warmgray mt-2 text-[14.5px] leading-[1.55]">
          Bringing the vision to life with meticulous design and robust
          engineering.
        </p>
      </div>
      <!-- Step 4 -->
      <div class="reveal flex flex-col">
        <div
          class="img-wrap border-charcoal/[0.08] relative aspect-[4/3] overflow-hidden rounded-[14px] border"
        >
          <img
            src="https://cdn.alisamadii.com/marketing/launch-scale.png"
            alt="Launch phase illustration"
            class="h-full w-full object-cover"
            loading="lazy"
          />
          <span
            class="absolute right-3.5 bottom-3 font-mono text-[32px] font-medium text-white/70"
            >04</span
          >
        </div>
        <h3 class="mt-[18px] text-[19px] font-semibold tracking-[-0.02em]">
          Launch &amp; Scale
        </h3>
        <p class="text-warmgray mt-2 text-[14.5px] leading-[1.55]">
          Deploying, monitoring, and iterating to ensure sustained growth and
          performance.
        </p>
      </div>
    </div>
  </section>

  <!-- ==================== WORK ==================== -->
  <section
    id="work"
    class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[70px] md:px-10"
  >
    <div
      class="reveal text-muted mb-8 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] uppercase"
    >
      <span class="bg-accent h-px w-[26px]"></span>05 &mdash; Our Work
    </div>
    <div
      class="mb-11 grid grid-cols-1 items-end gap-10 md:grid-cols-[1.1fr_1fr] md:gap-12"
    >
      <h2
        class="reveal text-[clamp(30px,3.6vw,48px)] leading-[1.08] font-semibold tracking-[-0.03em]"
      >
        Selected projects
      </h2>
      <div class="reveal">
        <p class="text-warmgray text-[15.5px] leading-[1.6]">
          Every project is built from scratch — no templates, no shortcuts.
          These mock-ups showcase our capabilities; your project will be fully
          custom to your brand and goals.
        </p>
        <div
          class="mt-5 inline-flex items-center gap-3 rounded-full border border-emerald-200/60 bg-emerald-50 px-4 py-2"
        >
          <svg
            class="size-4 shrink-0 text-emerald-600"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"
            ></path>
          </svg>
          <span class="text-[13.5px] font-medium text-emerald-800"
            >1-Day Delivery</span
          >
          <span class="font-mono text-[11.5px] text-emerald-600/80"
            >concept &rarr; launch</span
          >
        </div>
      </div>
    </div>

    <div class="stagger grid grid-cols-1 gap-[22px] md:grid-cols-2">
      <!-- Project 1 -->
      <a
        href="https://demo-booking-gray.vercel.app/"
        target="_blank"
        rel="noopener noreferrer"
        data-tilt
        class="reveal img-wrap border-charcoal/[0.08] group block overflow-hidden rounded-[18px] border bg-white"
      >
        <div class="aspect-[16/10] overflow-hidden">
          <img
            src="/meridian.webp"
            alt="Meridian Studio project"
            class="h-full w-full object-cover"
            loading="lazy"
          />
