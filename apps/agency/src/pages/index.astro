<!-- HOW -->
<section id="how" style="position: relative; padding: 100px 0">
<div class="wrap" style="display: flex; flex-direction: column; gap: 56px">
<div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px">
<p class="pill cap" style="margin: 0; color: #3d3833"><span aria-hidden="true" style="color: #fc8464">✦</span>How it works</p>
<h2 class="h2" style="max-width: 16ch">From search to booked job, one team runs it all</h2>
</div>
