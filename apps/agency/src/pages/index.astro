---
import Layout from "../layouts/Layout.astro";
import HomeNav from "../components/HomeNav.astro";
import HomeFooter from "../components/HomeFooter.astro";
import home from "../data/home.json";

// One marquee run = the word list twice, "  /  "-separated, with a trailing
// separator — matches the original hand-written banner text exactly.
const marqueeSep = "  /  ";
const marqueeText =
  [...home.marquee.words, ...home.marquee.words].join(marqueeSep) + marqueeSep;
---

<Layout
  title={home.seo.title}
  description={home.seo.description}
  canonical="https://agency.alisamadii.com"
  og={{
    title: home.seo.title,
    description: home.seo.description,
    url: "https://agency.alisamadii.com",
    twitterDescription: home.seo.description,
  }}
  bodyClass="noise bg-cream text-charcoal selection:bg-accent/25 font-sans"
>
  <!-- TrustBox script -->
  <script
    is:inline
    slot="head"
    type="text/javascript"
    src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js"
    async></script>
  <!-- End TrustBox script -->

  <HomeNav />

  <!-- ==================== HERO ==================== -->
  <section
    id="hero"
    class="mx-auto max-w-[1200px] px-6 pt-[128px] pb-20 md:px-10"
  >
    <div class="stagger">
      <div
        class="reveal text-muted mb-8 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] uppercase"
        data-cms-field="hero.eyebrow"
      >
        <span class="bg-accent h-px w-[26px]"></span>{home.hero.eyebrow}
      </div>
      <h1
        class="reveal max-w-[14ch] text-[clamp(44px,7vw,92px)] leading-[0.98] font-semibold tracking-[-0.035em]"
        data-cms-field="hero.heading"
      >
        {home.hero.heading}
        <span
          class="text-accent"
          id="scrambleTarget"
          data-cms-field="hero.scrambleWords"
          data-words={JSON.stringify(home.hero.scrambleWords)}
          >{home.hero.scrambleWords[0]}</span
        ><span class="scramble-cursor"></span>
      </h1>
      <p
        class="reveal text-warmgray mt-[30px] max-w-[52ch] text-[17px] leading-[1.55] md:text-[19px]"
        data-cms-field="hero.text"
      >
        {home.hero.text}
      </p>
      <div class="reveal mt-10 flex flex-wrap items-center gap-3.5">
        <a
          href={home.hero.primaryCta.href}
          target="_blank"
          class="mag-btn bg-accent hover:bg-charcoal inline-flex items-center gap-2.5 rounded-[11px] px-6 py-3.5 text-[15.5px] font-medium text-white shadow-[0_8px_24px_rgba(252,132,100,0.32)]"
          data-cms-field="hero.primaryCta"
        >
          {home.hero.primaryCta.label}
          <span>&#8599;</span>
        </a>
        <a
          href={home.hero.secondaryCta.href}
          class="mag-btn border-charcoal/[0.16] hover:border-accent hover:text-accent inline-flex items-center gap-2.5 rounded-[11px] border px-6 py-3.5 text-[15.5px] font-medium"
          data-cms-field="hero.secondaryCta"
        >
          {home.hero.secondaryCta.label}
        </a>
        <a
          href={home.hero.tertiaryCta.href}
          target="_blank"
          class="mag-btn text-warmgray hover:text-charcoal px-2 py-3.5 text-[15px]"
          data-cms-field="hero.tertiaryCta"
          >{home.hero.tertiaryCta.label}</a
        >
      </div>
    </div>
  </section>

  <!-- ==================== MARQUEE ==================== -->
  <div
    class="border-charcoal/[0.08] overflow-hidden border-y bg-[#f1efec] py-[18px]"
  >
    <div class="marquee-track flex w-max whitespace-nowrap">
      <span
        class="font-mono text-[15px] tracking-[0.02em] text-[#a49d94]"
        data-cms-field="marquee.words"
      >
        {marqueeText}
      </span>
      <span class="font-mono text-[15px] tracking-[0.02em] text-[#a49d94]">
        {marqueeText}
      </span>
    </div>
  </div>

  <!-- ==================== STATS ==================== -->
  <section class="mx-auto max-w-[1200px] px-6 py-14 md:px-10">
    <div class="stagger grid grid-cols-2 gap-6 md:grid-cols-4">
      {
        home.stats.map((stat, i) => (
          <div class="reveal py-2" data-cms-field={`stats.${i}`}>
            <div
              class="text-[44px] leading-none font-semibold tracking-[-0.03em]"
              data-cms-field={`stats.${i}.value`}
            >
              {stat.value}
              {stat.suffix && <span class="text-accent">{stat.suffix}</span>}
            </div>
            <div
              class="text-warmgray mt-2.5 text-sm"
              data-cms-field={`stats.${i}.label`}
            >
              {stat.label}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ==================== ABOUT ==================== -->
  <section
    id="about"
    class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[70px] md:px-10"
  >
    <div
      class="reveal text-muted mb-8 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] uppercase"
      data-cms-field="about.eyebrow"
    >
      <span class="bg-accent h-px w-[26px]"></span>{home.about.eyebrow}
    </div>
    <div
      class="grid grid-cols-1 items-end gap-10 md:grid-cols-[1.2fr_1fr] md:gap-14"
    >
      <h2
        class="reveal text-[clamp(30px,3.6vw,48px)] leading-[1.08] font-semibold tracking-[-0.03em]"
        data-cms-field="about.heading"
      >
        {home.about.heading}
        <span class="text-accent" data-cms-field="about.headingAccent"
          >{home.about.headingAccent}</span
        >
        <span data-cms-field="about.headingEnd">{home.about.headingEnd}</span>
      </h2>
      <p
        class="reveal text-warmgray text-[17px] leading-[1.6]"
        data-cms-field="about.text"
      >
        {home.about.text}
      </p>
    </div>
  </section>

  <!-- ==================== SERVICES ==================== -->
  <section
    id="services"
    class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[70px] md:px-10"
  >
    <div
      class="reveal text-muted mb-9 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] uppercase"
      data-cms-field="services.eyebrow"
    >
      <span class="bg-accent h-px w-[26px]"></span>{home.services.eyebrow}
    </div>

    <div
      class="grid grid-cols-1 gap-[18px] md:auto-rows-[minmax(210px,auto)] md:grid-cols-6"
    >
      <!-- Brand Identity -->
      <div
        data-spot
        class="reveal border-charcoal/[0.08] relative overflow-hidden rounded-[18px] border bg-white p-[30px] md:col-span-3"
      >
        <div
          data-glow
          class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
        >
        </div>
        <div class="relative flex h-full flex-col">
          <div
            class="bg-accent/[0.12] text-accent inline-flex size-11 items-center justify-center rounded-xl"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
              <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
              <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
              <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
              <path
                d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2Z"
              ></path>
            </svg>
          </div>
          <h3
            class="mt-auto pt-8 text-[23px] font-semibold tracking-[-0.02em]"
            data-cms-field="services.brandIdentity.title"
          >
            {home.services.brandIdentity.title}
          </h3>
          <p
            class="text-warmgray mt-2.5 max-w-[38ch] text-[15px] leading-[1.55]"
            data-cms-field="services.brandIdentity.text"
          >
            {home.services.brandIdentity.text}
          </p>
        </div>
      </div>

      <!-- Web Development -->
      <div
        data-spot
        class="reveal border-charcoal/[0.08] relative overflow-hidden rounded-[18px] border bg-white p-[30px] md:col-span-3"
      >
        <div
          data-glow
          class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
        >
        </div>
        <div class="relative flex h-full flex-col">
          <div
            class="bg-accent/[0.12] text-accent inline-flex size-11 items-center justify-center rounded-xl"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m16 18 6-6-6-6"></path>
              <path d="m8 6-6 6 6 6"></path>
            </svg>
          </div>
          <h3
            class="mt-auto pt-8 text-[23px] font-semibold tracking-[-0.02em]"
            data-cms-field="services.webDevelopment.title"
          >
            {home.services.webDevelopment.title}
          </h3>
          <p
            class="text-warmgray mt-2.5 max-w-[38ch] text-[15px] leading-[1.55]"
            data-cms-field="services.webDevelopment.text"
          >
            {home.services.webDevelopment.text}
          </p>
        </div>
      </div>

      <!-- UI/UX Design -->
      <div
        data-spot
        class="reveal border-charcoal/[0.08] relative overflow-hidden rounded-[18px] border bg-white p-7 md:col-span-2"
      >
        <div
          data-glow
          class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
        >
        </div>
        <div class="relative flex h-full flex-col">
          <div
            class="bg-accent/[0.12] text-accent inline-flex size-[42px] items-center justify-center rounded-xl"
          >
            <svg
              width="21"
              height="21"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m12 19 7-7 3 3-7 7-3-3z"></path>
              <path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
              <path d="m2 2 7.586 7.586"></path>
              <circle cx="11" cy="11" r="2"></circle>
            </svg>
          </div>
          <h3
            class="mt-auto pt-8 text-[21px] font-semibold tracking-[-0.02em]"
            data-cms-field="services.uiUxDesign.title"
          >
            {home.services.uiUxDesign.title}
          </h3>
          <p
            class="text-warmgray mt-2.5 text-[14.5px] leading-[1.55]"
            data-cms-field="services.uiUxDesign.text"
          >
            {home.services.uiUxDesign.text}
          </p>
        </div>
      </div>

      <!-- SEO & Analytics -->
      <div
        data-spot
        class="reveal border-charcoal/[0.08] relative overflow-hidden rounded-[18px] border bg-white p-7 md:col-span-2"
      >
        <div
          data-glow
          class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
        >
        </div>
        <div class="relative flex h-full flex-col">
          <div
            class="bg-accent/[0.12] text-accent inline-flex size-[42px] items-center justify-center rounded-xl"
          >
            <svg
              width="21"
              height="21"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 3v16a2 2 0 0 0 2 2h16"></path>
              <path d="m19 9-5 5-4-4-3 3"></path>
            </svg>
          </div>
          <h3
            class="mt-auto pt-8 text-[21px] font-semibold tracking-[-0.02em]"
            data-cms-field="services.seoAnalytics.title"
          >
            {home.services.seoAnalytics.title}
          </h3>
          <p
            class="text-warmgray mt-2.5 text-[14.5px] leading-[1.55]"
            data-cms-field="services.seoAnalytics.text"
          >
            {home.services.seoAnalytics.text}
          </p>
        </div>
      </div>

      <!-- Edit Your Own Site -->
      <div
        data-spot
        class="reveal border-charcoal/[0.08] relative overflow-hidden rounded-[18px] border bg-white p-7 md:col-span-2"
      >
        <div
          data-glow
          class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
        >
        </div>
        <div class="relative flex h-full flex-col">
          <div
            class="bg-accent/[0.12] text-accent inline-flex size-[42px] items-center justify-center rounded-xl"
          >
            <svg
              width="21"
              height="21"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"
              ></path>
              <path d="m15 5 4 4"></path>
            </svg>
          </div>
          <h3
            class="mt-auto pt-8 text-[21px] font-semibold tracking-[-0.02em]"
            data-cms-field="services.editYourSite.title"
          >
            {home.services.editYourSite.title}
          </h3>
          <p
            class="text-warmgray mt-2.5 text-[14.5px] leading-[1.55]"
            data-cms-field="services.editYourSite.text"
          >
            {home.services.editYourSite.text}
          </p>
        </div>
      </div>

      <!-- Need Something Custom? (wide, dark) -->
      <div
        data-spot
        class="reveal bg-ink text-cream relative overflow-hidden rounded-[18px] border border-white/[0.08] p-[34px] md:col-span-6"
      >
        <div
          data-glow
          class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400"
        >
        </div>
        <div class="relative flex flex-wrap items-center justify-between gap-10">
          <div class="max-w-[52ch]">
            <div
              class="bg-accent/[0.18] text-accent inline-flex size-11 items-center justify-center rounded-xl"
            >
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"
                ></path>
                <path
                  d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"
                ></path>
                <path
                  d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"
                ></path>
              </svg>
            </div>
            <h3
              class="mt-[18px] text-[26px] font-semibold tracking-[-0.02em]"
              data-cms-field="services.custom.title"
            >
              {home.services.custom.title}
            </h3>
            <p
              class="mt-2.5 text-[15.5px] leading-[1.6] text-[#b8b2a9]"
              data-cms-field="services.custom.text"
            >
              {home.services.custom.text}
              <a
                href={home.services.custom.link.href}
                class="text-accent transition-colors duration-300 hover:text-white"
                data-cms-field="services.custom.link"
                >{home.services.custom.link.label} &rarr;</a
              >
            </p>
          </div>
          <div class="flex max-w-[280px] flex-wrap gap-2.5">
            {
              home.services.custom.tags.map((tag, i) => (
                <span
                  class="flex items-center rounded-full border border-white/[0.14] px-3.5 py-2 font-mono text-[12.5px] text-[#d9d3ca]"
                  data-cms-field={`services.custom.tags.${i}`}
                >
                  {tag}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PROCESS ==================== -->
  <section
    class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[70px] md:px-10"
  >
    <div
      class="reveal text-muted mb-11 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] uppercase"
      data-cms-field="process.eyebrow"
    >
      <span class="bg-accent h-px w-[26px]"></span>{home.process.eyebrow}
    </div>

    <div
      class="stagger grid grid-cols-1 gap-[22px] sm:grid-cols-2 md:grid-cols-4"
    >
      {
        home.process.steps.map((step, i) => (
          <div class="reveal flex flex-col" data-cms-field={`process.steps.${i}`}>
            <div class="img-wrap border-charcoal/[0.08] relative aspect-[4/3] overflow-hidden rounded-[14px] border">
              <img
                src={step.image}
                alt={`${step.title} phase illustration`}
                class="h-full w-full object-cover"
                loading="lazy"
                data-cms-field={`process.steps.${i}.image`}
              />
              <span class="absolute right-3.5 bottom-3 font-mono text-[32px] font-medium text-white/70">
                {String(i + 1).padStart(2, "0")}
              </span>
            </div>
            <h3
              class="mt-[18px] text-[19px] font-semibold tracking-[-0.02em]"
              data-cms-field={`process.steps.${i}.title`}
            >
              {step.title}
            </h3>
            <p
              class="text-warmgray mt-2 text-[14.5px] leading-[1.55]"
              data-cms-field={`process.steps.${i}.text`}
            >
              {step.text}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ==================== WORK ==================== -->
  <section
    id="work"
    class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[70px] md:px-10"
  >
    <div
      class="reveal text-muted mb-8 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] uppercase"
      data-cms-field="work.eyebrow"
    >
      <span class="bg-accent h-px w-[26px]"></span>{home.work.eyebrow}
    </div>
    <div
      class="mb-11 grid grid-cols-1 items-end gap-10 md:grid-cols-[1.1fr_1fr] md:gap-12"
    >
      <h2
        class="reveal text-[clamp(30px,3.6vw,48px)] leading-[1.08] font-semibold tracking-[-0.03em]"
        data-cms-field="work.heading"
      >
        {home.work.heading}
      </h2>
      <div class="reveal">
        <p
          class="text-warmgray text-[15.5px] leading-[1.6]"
          data-cms-field="work.text"
        >
          {home.work.text}
        </p>
        <div
          class="mt-5 inline-flex items-center gap-3 rounded-full border border-emerald-200/60 bg-emerald-50 px-4 py-2"
        >
          <svg
            class="size-4 shrink-0 text-emerald-600"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"
            ></path>
          </svg>
          <span
            class="text-[13.5px] font-medium text-emerald-800"
            data-cms-field="work.badge.label">{home.work.badge.label}</span
          >
          <span
            class="font-mono text-[11.5px] text-emerald-600/80"
            data-cms-field="work.badge.note">{home.work.badge.note}</span
          >
        </div>
      </div>
    </div>

    <div class="stagger grid grid-cols-1 gap-[22px] md:grid-cols-2">
      {
        home.work.projects.map((project, i) => (
          <a
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
            data-tilt
            class="reveal img-wrap border-charcoal/[0.08] group block overflow-hidden rounded-[18px] border bg-white"
            data-cms-field={`work.projects.${i}`}
          >
            <div class="aspect-[16/10] overflow-hidden">
              <img
                src={project.image}
                alt={`${project.title} project`}
                class="h-full w-full object-cover"
                loading="lazy"
                data-cms-field={`work.projects.${i}.image`}
              />
            </div>
            <div class="p-6">
              <div
                class="font-mono text-[11.5px] tracking-[0.08em] text-[#a49d94] uppercase"
                data-cms-field={`work.projects.${i}.category`}
              >
                {project.category}
              </div>
              <div class="mt-2.5 flex items-center justify-between gap-4">
                <h3
                  class="text-[22px] font-semibold tracking-[-0.02em]"
                  data-cms-field={`work.projects.${i}.title`}
                >
                  {project.title}
                </h3>
                <span class="text-accent">&#8599;</span>
              </div>
              <p
                class="text-warmgray mt-2 text-[14.5px] leading-[1.55]"
                data-cms-field={`work.projects.${i}.text`}
              >
                {project.text}
              </p>
            </div>
          </a>
        ))
      }
    </div>

    <div class="reveal mt-9 text-center">
      <a
        href={home.work.cta.href}
        class="mag-btn border-charcoal/[0.16] hover:border-accent hover:text-accent inline-flex items-center gap-2.5 rounded-[11px] border px-6 py-3.5 text-[15px] font-medium"
        data-cms-field="work.cta"
      >
        {home.work.cta.label}
        <span class="text-accent">&#8599;</span>
      </a>
    </div>
  </section>

  <!-- ==================== PRICING ==================== -->
  <section
    id="pricing"
    class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[70px] md:px-10"
  >
    <div
      class="reveal text-muted mb-9 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] uppercase"
      data-cms-field="pricing.eyebrow"
    >
      <span class="bg-accent h-px w-[26px]"></span>{home.pricing.eyebrow}
