    <script>
      import type { Plan } from '@workspace/google-analytics/client';

      // Mobile menu
      const menuBtn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-menu');
      const setMenu = (open: boolean) => {
        if (!menuBtn || !menu) return;
        menu.hidden = !open;
        menuBtn.setAttribute('aria-expanded', String(open));
        menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };
      menuBtn?.addEventListener('click', () => setMenu(menu?.hidden ?? false));
      document.querySelectorAll('[data-close-menu]').forEach((el) => el.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
      matchMedia('(min-width: 901px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });

      // Pricing buttons preselect the plan in the quote form (?plan= works too)
      const planSelect = document.getElementById('quote-plan') as HTMLSelectElement | null;
      const qp = new URLSearchParams(location.search).get('plan');
      if (planSelect && qp && [...planSelect.options].some((o) => o.value === qp)) planSelect.value = qp;
      document.querySelectorAll<HTMLElement>('[data-plan]').forEach((el) =>
        el.addEventListener('click', () => { if (planSelect && el.dataset.plan) planSelect.value = el.dataset.plan; })
      );

      // Quote form: same API + events as QuoteForm.astro. generate_lead also
      // fires the Google Ads "Request quote" conversion (google-analytics lib).
      const API_BASE =
        location.hostname === '127.0.0.1' || location.hostname === 'localhost'
          ? 'http://localhost:3000'
          : 'https://api.alisamadii.com';
      const form = document.getElementById('quote-form') as HTMLFormElement | null;
      const sent = document.getElementById('quote-sent');
      const errEl = document.getElementById('quote-error');
      const submitBtn = document.getElementById('quote-submit') as HTMLButtonElement | null;
      const showError = (msg: string) => {
        if (sent) sent.hidden = true;
        if (errEl) { errEl.textContent = msg; errEl.hidden = false; }
      };
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const name = String(data.get('name') ?? '').trim();
        const email = String(data.get('email') ?? '').trim();
        const message = String(data.get('goals') ?? '').trim();
        const plan = String(data.get('plan') ?? 'custom') as Plan;
        if (!name) return showError('Please enter your name.');
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showError('Please enter a valid email address.');
        if (!message) return showError('Tell us a little about your business.');
        if (errEl) errEl.hidden = true;
        window.track?.('quote_form_submit', { plan });
        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }
        try {
          const res = await fetch(`${API_BASE}/api/agency/quote`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email, message, plan }),
          });
          if (res.status === 429) {
            window.track?.('quote_form_error', { plan, reason: 'rate_limited' });
            return showError("Looks like you've sent a few requests already. Give it a little while, or email agency@alisamadii.com.");
          }
          const payload = await res.json().catch(() => null);
          if (!res.ok || !payload?.ok) throw new Error('failed');
          window.track?.('generate_lead', { plan });
          form.reset();
          if (planSelect) planSelect.value = 'launch';
          if (sent) sent.hidden = false;
        } catch {
          window.track?.('quote_form_error', { plan, reason: 'request_failed' });
          showError('Something went wrong sending your request. Please try again, or email agency@alisamadii.com.');
        } finally {
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Request a Quote'; }
        }
      });

      // Video dialog
      const dlg = document.getElementById('video-dialog') as HTMLDialogElement | null;
      const vid = dlg?.querySelector('video');
      document.querySelectorAll('[data-video-open]').forEach((b) =>
        b.addEventListener('click', (e) => {
          if (!dlg) return;
          e.preventDefault();
          dlg.showModal();
          vid?.play().catch(() => {});
        })
      );

      // Scroll reveal: fade + blur up once, as each block enters the viewport.
      // Content stays visible without JS (the hidden state needs .js-reveal).
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('js-reveal');
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => {
            if (!en.isIntersecting) return;
            en.target.classList.add('in');
            io.unobserve(en.target);
          });
        }, { rootMargin: '0px 0px -12% 0px' });
        document.querySelectorAll('.reveal, main > section:not(.hero):not(#video) > .wrap').forEach((el) => {
          el.classList.add('reveal');
          io.observe(el);
        });
      }
      dlg?.querySelector('[data-video-close]')?.addEventListener('click', () => dlg.close());
      dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      dlg?.addEventListener('close', () => vid?.pause());
    </script>
  </body>
</html>

