  <!-- ==================== SCRIPTS ==================== -->
  <script is:inline>
    // Scroll reveal via IntersectionObserver
    function initReveals() {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );

      document
        .querySelectorAll(".reveal:not(#menuOverlay .reveal)")
        .forEach((el) => observer.observe(el));
    }
    initReveals();

    // Bento card spotlight + lift
    document.querySelectorAll("[data-spot]").forEach((card) => {
      const glow = card.querySelector("[data-glow]");
      const dark = card.classList.contains("bg-ink");
      card.addEventListener("mousemove", (ev) => {
        const r = card.getBoundingClientRect();
        const x = ev.clientX - r.left;
        const y = ev.clientY - r.top;
        if (glow) {
          glow.style.background = `radial-gradient(${dark ? 480 : 400}px circle at ${x}px ${y}px, rgba(252,132,100,${dark ? 0.22 : 0.16}), transparent 70%)`;
        }
      });
      card.addEventListener("mouseenter", () => {
        if (glow) glow.style.opacity = "1";
        card.style.transform = "translateY(-4px)";
        card.style.boxShadow = "0 20px 50px rgba(27,26,23,0.10)";
        card.style.borderColor = "rgba(252,132,100,0.4)";
      });
      card.addEventListener("mouseleave", () => {
        if (glow) glow.style.opacity = "0";
        card.style.transform = "translateY(0)";
        card.style.boxShadow = "none";
        card.style.borderColor = "";
      });
    });

    // Project card lift
    document.querySelectorAll("[data-tilt]").forEach((card) => {
      card.addEventListener("mouseenter", () => {
        card.style.transform = "translateY(-6px)";
        card.style.boxShadow = "0 22px 50px rgba(27,26,23,0.12)";
      });
      card.addEventListener("mouseleave", () => {
        card.style.transform = "translateY(0)";
        card.style.boxShadow = "none";
      });
    });

    // Text scramble effect — words come from the CMS (data-words attribute)
    const scrambleEl = document.getElementById("scrambleTarget");
    const words = JSON.parse(scrambleEl?.dataset.words || "[]");
    const chars = "abcdefghijklmnopqrstuvwxyz";
    let wordIndex = 0;

    function scrambleTo(newWord) {
      const oldWord = scrambleEl.textContent;
      const length = Math.max(oldWord.length, newWord.length);
      let frame = 0;
      const totalFrames = 12;

      function update() {
        let output = "";
        for (let i = 0; i < length; i++) {
          if (i < newWord.length) {
            if (frame >= totalFrames * (i / length)) {
              output += newWord[i];
            } else {
              output += chars[Math.floor(Math.random() * chars.length)];
            }
          }
        }
        scrambleEl.textContent = output;
        frame++;
        if (frame <= totalFrames) {
          requestAnimationFrame(update);
        } else {
          scrambleEl.textContent = newWord;
        }
      }
      update();
    }

    if (scrambleEl && words.length > 1) {
      setInterval(() => {
        wordIndex = (wordIndex + 1) % words.length;
        scrambleTo(words[wordIndex]);
      }, 5000);
    }

    // Mobile menu
    const menuToggle = document.getElementById("menuToggle");
    const menuOverlay = document.getElementById("menuOverlay");
    const line1 = document.getElementById("line1");
    const line2 = document.getElementById("line2");
    let menuOpen = false;

    function closeMenu() {
      menuOpen = false;
      menuOverlay.classList.remove("open");
      line1.style.transform = "";
      line2.style.transform = "";
      document.body.style.overflow = "";
      menuOverlay
        .querySelectorAll(".reveal")
        .forEach((el) => el.classList.remove("visible"));
    }

    menuToggle.addEventListener("click", () => {
      menuOpen = !menuOpen;
      if (menuOpen) {
        menuOverlay.classList.add("open");
        line1.style.transform = "rotate(45deg) translateY(3px)";
        line2.style.transform = "rotate(-45deg) translateY(-3px)";
        document.body.style.overflow = "hidden";
        setTimeout(() => {
          menuOverlay
            .querySelectorAll(".reveal")
            .forEach((el) => el.classList.add("visible"));
        }, 200);
      } else {
        closeMenu();
      }
    });

    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener("click", function (e) {
        const href = this.getAttribute("href");
        if (href === "#") {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: "smooth" });
          return;
        }
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    });

    // Floating welcome video — slides up on load, exits when finished
    (function initWelcomeVideo() {
      const wrap = document.getElementById("welcomeVideo");
      if (!wrap) return;
      const video = wrap.querySelector("video");
      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (reduced) {
        wrap.remove();
        return;
      }

      function exit() {
        wrap.classList.add("translate-y-[130%]", "opacity-0");
        setTimeout(() => wrap.remove(), 700);
      }

      video.addEventListener("ended", exit);

      setTimeout(() => {
        wrap.classList.remove("translate-y-[130%]", "opacity-0");
        const played = video.play();
        if (played && typeof played.catch === "function") {
          played.catch(() => wrap.remove());
        }
      }, 800);
    })();
  </script>
