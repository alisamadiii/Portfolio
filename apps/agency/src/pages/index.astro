const faqs = [
  {
    q: "How much does a website cost?",
    a: SHOW_PRICING
      ? `Websites start at ${setup} setup + ${monthly}/mo. Shopify stores, web apps and integrations are quoted per project after a short call.`
      : "It depends on the features you pick. Every project is scoped on a free call and priced in writing before any work starts, so there are no surprises later.",
  },
  {
    q: "What's included after launch?",
    a: SHOW_PRICING
      ? `Client Hub: edit text, images, and pages by chatting with AI, preview the change, then publish. Analytics, speed reports, and support are included, all for ${monthly}/mo. Rather have us make the edits? The ${care}/mo Care plan adds monitoring, a monthly report, and up to an hour of edits done for you. Your domain, hosting, and code are set up in your own accounts, and once the project is paid in full, everything is yours.`
      : "Client Hub: edit text, images, and pages by chatting with AI, preview the change, then publish. Analytics, speed reports, and support come with it. Rather have us make the edits? The Care plan adds monitoring, a monthly report, and edits done for you. Your domain, hosting, and code are set up in your own accounts, and once the project is paid in full, everything is yours.",
