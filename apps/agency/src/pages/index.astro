---
// Home — faithful translation of the "concise landing page" design mockup.
// Chrome (nav/footer/grain) + shared JS come from MockupLayout; this page
// supplies the hero + section <main> and fills its data-driven blocks.
import MockupLayout from "../layouts/MockupLayout.astro";
import QuoteForm from "../components/QuoteForm.astro";
import GoogleReviews from "../components/GoogleReviews.astro";
import GrowthPlans from "../components/GrowthPlans.astro";
import MAIN from "../html/main/home.html?raw";
import { PROJECTS } from "../data/projects";
import { GUARANTEE, PLANS, TERMS, WEBSITE_ONLY, fmtPrice } from "../data/pricing";

const SITE = "https://www.alisamadii.com";

// Hidden while the growth-partner offer has no ad-results proof yet.
// Flip back to true to restore the sections.
const SHOW_CLIENT_WORK = false;
const SHOW_REVIEWS = false;
const SHOW_PROOF = false; // stats, testimonial, Lighthouse strip

// FAQ copy: rendered into the mockup's FAQ card below and the FAQPage schema.
const [launch, growth, scale] = PLANS;
const faqs = [
  {
    q: "What exactly do I get?",
    a: "More leads. We run your Google Ads so the right local searches find you, send them to a website built to turn clicks into calls, and track every lead to the keyword that drove it. We handle the campaigns, the site, hosting, and monthly reporting. You answer the phone.",
  },
  {
    q: "Is ad spend included?",
    a: `No. Google bills ad spend to your card directly, so you see every dollar. Our monthly fee covers the website and managing your campaigns. Each tier covers a set amount of monthly spend: up to ${fmtPrice(launch.adSpendCap)} on ${launch.name}, ${fmtPrice(growth.adSpendCap)} on ${growth.name}, and ${fmtPrice(scale.adSpendCap)} on ${scale.name}.`,
  },
  {
    q: `Why is there a ${TERMS.minimumMonths}-month minimum?`,
    a: `Google Ads needs time to learn. The first months go into finding which searches turn into jobs, and the months after are where the cost per lead comes down. ${TERMS.minimumMonths} months gives the campaigns a fair run. After that it's month-to-month.`,
  },
  {
    q: "What's your guarantee?",
    a: `Two of them. ${GUARANTEE.leads} And ${GUARANTEE.process.charAt(0).toLowerCase()}${GUARANTEE.process.slice(1)} ${GUARANTEE.fine}`,
  },
  {
    q: "Do I own the website?",
    a: "Yes. Your code lives in your own GitHub, and your domain and Google Ads account are in your name from day one. If you ever leave after the minimum term, the site and the account go with you.",
  },
  {
    q: "What if I already have a website?",
    a: "We'll look at it on the first call. Usually we rebuild it, because a site built to convert makes every ad dollar go further, and the build is included in every growth plan at no extra cost.",
  },
  {
    q: "Can I get just a website, without ads?",
    a: `Yes. Our website-only plan is ${fmtPrice(WEBSITE_ONLY.setup)} setup + ${fmtPrice(WEBSITE_ONLY.monthly)}/mo: custom design and build, hosting, care, and email from your own domain. You can add Google Ads later.`,
  },
  {
    q: "Do you only work with Jacksonville businesses?",
    a: "No. We're based in Jacksonville and work with businesses across Florida, including Miami, Tampa, and Orlando, as well as anywhere in the US. Everything can be handled online.",
  },
];

const esc = (t: string) =>
  t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const faqItemsHtml = faqs
  .map(
    (f, i) =>
      `<div${i < faqs.length - 1 ? ' style="border-bottom: 1px solid rgba(27, 26, 23, 0.07);"' : ""}><button type="button" class="faq-q" aria-expanded="${i === 0}" style="width: 100%; min-height: 64px; padding: 20px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; border: 0px; background: transparent; cursor: pointer; text-align: left; font-family: inherit; font-size: 17px; font-weight: 600; color: rgb(27, 26, 23);">${esc(f.q)}<span aria-hidden="true" class="mono" style="font-size: 20px; color: rgb(107, 102, 93);"><span class="sc-interp">${i === 0 ? "−" : "+"}</span></span></button><p class="fade" style="margin: 0px; padding: 0px 24px 24px; max-width: 68ch; font-size: 16px; line-height: 1.65; color: rgb(103, 98, 90);">${esc(f.a)}</p></div>`
  )
  .join("");

const schema = [
  {
    "@type": "FAQPage",
    "@id": `${SITE}/#faq`,
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];

// ── Inject real data into the ported mockup (placeholders → projects.ts) ───
let body = MAIN.replace("<!--FAQ_ITEMS-->", faqItemsHtml);

// 1) Lighthouse strip — Mohammad Samadi's live mobile scores (same client as
//    the testimonial quote directly above the strip).
const lhProject = PROJECTS.find((p) => p.slug === "mohammad-samadi");
if (lhProject?.lighthouse) {
  const lh = lhProject.lighthouse;
  const order = [lh.performance, lh.accessibility, lh.bestPractices, lh.seo];
  let si = 0;
  body = body.replace(/">\[ \]<\/span>/g, () =>
    si < order.length ? `">${order[si++]}</span>` : '">[ ]</span>'
  );
  const tested = new Date(lh.testedOn + "T00:00:00Z").toLocaleDateString(
    "en-US",
    { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }
  );
  body = body.replace("Tested [date] · mobile", `Tested ${tested} · mobile`);
}

// 2) Client Work cards — swap the `[Site screenshot]` placeholder for the real
//    screenshot and point each card at the live site. Matched by card heading.
const projectByName = new Map(PROJECTS.map((p) => [p.name, p]));
body = body.replace(
  /<a href="\/work" class="lift"([^>]*)>([\s\S]*?)<\/a>/g,
  (full, attrs, inner) => {
    const nameMatch = inner.match(/<h3[^>]*>\s*([^<]+?)\s*<span/);
    const name = nameMatch?.[1]?.trim();
    const project = name ? projectByName.get(name) : undefined;
    if (!project?.image) return full;
    const img = `<div class="zoom" style="border-radius: 10px; overflow: hidden;"><img src="${project.image.src}" alt="${project.image.alt}" width="1120" height="700" loading="lazy" class="zi" style="aspect-ratio: 8 / 5; width: 100%; height: auto; object-fit: cover; display: block;" /></div>`;
    const withImg = inner.replace(
      /<div class="zoom"[\s\S]*?<\/div>\s*<\/div>/,
      img
    );
    return `<a href="${project.url}" target="_blank" rel="noopener noreferrer" class="lift"${attrs}>${withImg}</a>`;
  }
);

// 3) The dark "Get in Touch" CTA is rebuilt in Astro below so it can carry the
//    real QuoteForm. Strip the <main> wrapper + the original CTA section here.
body = body
  .replace(/^\s*<main id="top">/, "")
  .replace(/<\/main>\s*$/, "")
  .replace(/<section id="contact" class="dark"[^>]*>[\s\S]*<\/section>\s*$/, "");

// 3a) Proof strip (stats, testimonial, Lighthouse), hidden behind SHOW_PROOF.
if (!SHOW_PROOF) {
  body = body.replace(/<section aria-label="Proof"[\s\S]*?<\/section>/, "");
}
// 3b) Client Work section, hidden behind SHOW_CLIENT_WORK.
if (!SHOW_CLIENT_WORK) {
  body = body.replace(/<section id="work"[\s\S]*?<\/section>/, "");
}

// 4) Google reviews slot in between Client Work and Pricing; the pricing
//    cards render from <GrowthPlans/> at the placeholder.
const pricingAt = body.indexOf('<section id="pricing"');
const bodyBeforeReviews = body.slice(0, pricingAt);
const [bodyBeforePlans, bodyAfterPlans] = body
  .slice(pricingAt)
  .split("<!--GROWTH_PLANS-->");
---

<MockupLayout
  title="Jacksonville Lead Generation Agency | Google Ads + Websites"
  description="More calls and booked jobs for local service businesses: managed Google Ads, a website built to convert, and every lead tracked. One monthly price."
  canonical="https://www.alisamadii.com"
  og={{
    title: "Lead Generation Agency for Local Businesses | Ali Samadi Agency",
    description:
      "Google Ads, a website that converts, and email that brings customers back, for local service businesses in Jacksonville and across Florida. Every lead tracked.",
    url: "https://www.alisamadii.com",
    twitterDescription:
      "More calls, more booked jobs, more revenue. Google Ads plus a website built to convert.",
  }}
  schema={schema}
>
  <main id="top">
    <Fragment set:html={bodyBeforeReviews} />
    {SHOW_REVIEWS && <GoogleReviews />}
    <Fragment set:html={bodyBeforePlans} />
    <GrowthPlans />
    <Fragment set:html={bodyAfterPlans} />

    <!-- Get in Touch — original CTA copy + contacts, now with the quote form. -->
    <section
      id="contact"
      class="dark"
      style="padding: 104px 0px 96px; background: rgb(23, 21, 18); color: rgb(236, 233, 226);"
    >
      <div
        class="wrap"
        style="display:grid; grid-template-columns:repeat(auto-fit, minmax(340px, 1fr)); gap:48px; align-items:start;"
      >
        <div
          style="display:flex; flex-direction:column; align-items:flex-start; gap:22px; max-width:620px;"
        >
          <p class="eyebrow" style="color:rgb(201,160,141);">
            <span></span>Get in Touch
          </p>
          <h2
            style="margin:0; font-size:clamp(36px,5vw,64px); line-height:1.02; font-weight:600; letter-spacing:-0.035em;"
          >
            Let's get your phone ringing
          </h2>
          <p
            style="margin:0; max-width:46ch; font-size:17px; line-height:1.55; color:rgb(184,178,169);"
          >
            Tell us about your business and your area. We'll reply with a plan
            for your site and your ads.
          </p>
          <div
            style="display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:22px 32px; margin-top:8px; width:100%; max-width:460px;"
          >
            <div>
              <p
                style="margin:0 0 6px; font-family:'Geist Mono Variable','Geist Mono',ui-monospace,monospace; font-size:11.5px; letter-spacing:0.08em; text-transform:uppercase; color:rgb(138,130,122);"
              >
                Email
              </p>
              <a
                href="mailto:agency@alisamadii.com"
                style="color:rgb(236,233,226); text-decoration:none; font-size:15.5px;"
                >agency@alisamadii.com</a
              >
            </div>
            <div>
              <p
                style="margin:0 0 6px; font-family:'Geist Mono Variable','Geist Mono',ui-monospace,monospace; font-size:11.5px; letter-spacing:0.08em; text-transform:uppercase; color:rgb(138,130,122);"
              >
                Schedule
              </p>
              <a
                href="https://cal.com/alisamadii"
                target="_blank"
                rel="noopener noreferrer"
                style="color:rgb(236,233,226); text-decoration:none; font-size:15.5px;"
                >Book a Meeting ↗</a
              >
            </div>
            <div>
              <p
                style="margin:0 0 6px; font-family:'Geist Mono Variable','Geist Mono',ui-monospace,monospace; font-size:11.5px; letter-spacing:0.08em; text-transform:uppercase; color:rgb(138,130,122);"
              >
                Phone
              </p>
              <a
                href="tel:+19713828969"
                style="color:rgb(236,233,226); text-decoration:none; font-size:15.5px;"
                >+1 (971) 382-8969</a
              >
            </div>
            <div>
              <p
                style="margin:0 0 6px; font-family:'Geist Mono Variable','Geist Mono',ui-monospace,monospace; font-size:11.5px; letter-spacing:0.08em; text-transform:uppercase; color:rgb(138,130,122);"
              >
                Location
              </p>
              <p style="margin:0; color:rgb(236,233,226); font-size:15.5px;">
                Jacksonville, FL
              </p>
            </div>
          </div>
        </div>

        <QuoteForm compact heading="Tell us about your project" />
      </div>
    </section>
  </main>

  <script type="application/json" id="faq-data" set:html={JSON.stringify(faqs)}
  ></script>
</MockupLayout>
