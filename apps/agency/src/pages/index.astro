---
// Homepage: the growth partnership (Google Ads + website) landing page.
// Design from the Claude Design canvas ("option C"), standalone: it renders
// its own <html>/<head>, fonts and global styles instead of Layout.astro, so
// it has no ClientRouter (links into it do a full page load). Analytics comes
// from the shared <Analytics />; the quote form posts to the same API as
// QuoteForm.astro and fires the same GA4 / Google Ads events.
import HeroFlow from "../components/HeroFlow.astro";
import Analytics from "../components/Analytics.astro";

const SITE = 'https://www.alisamadii.com';
const PATH = '/';
const url = new URL(PATH, SITE).href;
const title = 'Lead Generation Agency | Google Ads + Websites';
const description =
  'More calls and booked jobs for your business, wherever you sell: managed Google Ads, a website built to convert, and every lead tracked back to its source.';
const showShippedStrip = false;
// Prices are off the homepage for now. Flip to true to render the pricing
// section, nav links, Offer schema and priced form labels again.
const SHOW_PRICING = false;
const ogImage = '/images/agency/hero-leads.webp';
const videoSrc = '/hero-video.mp4';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "https://www.alisamadii.com/#organization",
      "name": "Ali Samadi Agency",
      "legalName": "Ali Samadii LLC",
      "url": "https://www.alisamadii.com",
      "logo": "https://www.alisamadii.com/images/agency/logo.png",
      "email": "agency@alisamadii.com",
      "telephone": "+1-971-382-8969",
      "areaServed": "Worldwide"
    },
    {
      "@type": "Service",
      "name": "Google Ads management + conversion website",
      "serviceType": "Lead generation",
      "provider": {
        "@id": "https://www.alisamadii.com/#organization"
      },
      "areaServed": "Worldwide",
      "url": url,
      ...(SHOW_PRICING ? { "offers": [
        {
          "@type": "Offer",
          "name": "Launch",
          "price": "1200",
          "priceCurrency": "USD",
          "description": "One Google Ads campaign managing up to $3k/mo in ads, custom website, hosting & care, conversion tracking, monthly report.",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": 1200,
            "priceCurrency": "USD",
            "unitText": "MONTH"
          }
        }
      ] } : {})
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What exactly do I get?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "More leads. We run your Google Ads so the right searches find you, send them to a website built to turn clicks into calls, and track every lead to the keyword that drove it. We handle the campaigns, the site, hosting, and monthly reporting. You answer the phone."
          }
        },
        {
          "@type": "Question",
          "name": "Is ad spend included?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Google bills ad spend to your card directly, so you see every dollar. Our monthly fee covers the website and managing your campaigns. The Launch plan covers up to $3,000 in monthly ad spend."
          }
        },
        {
          "@type": "Question",
          "name": "What's your guarantee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Before launch we agree in writing on how many qualified leads your campaigns should bring in. If we miss it within 90 days, walk away and keep your website and Google Ads account. A qualified lead is a tracked call of 60+ seconds or a real form inquiry. Applies while ad spend stays at the agreed level and leads are answered in business hours."
          }
        },
        {
          "@type": "Question",
          "name": "Do I own the website?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Your code lives in your own GitHub, and your domain and Google Ads account are in your name from day one. If you ever leave, the site and the account go with you."
          }
        },
        {
          "@type": "Question",
          "name": "What if I already have a website?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We'll look at it on the first call. Usually we rebuild it, because a site built to convert makes every ad dollar go further, and the build is included at no extra cost."
          }
        },
        {
          "@type": "Question",
          "name": "Can I get just a website, without ads?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": SHOW_PRICING
              ? "Yes. Our website-only plan is $1,299 setup + $100/mo: custom design and build, hosting, care, and email from your own domain. You can add Google Ads later. Full details are on our Websites page."
              : "Yes. Our website-only plan covers custom design and build, hosting, care, and email from your own domain. You can add Google Ads later. Full details are on our Websites page."
          }
        },
        {
          "@type": "Question",
          "name": "Where do you work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Anywhere. We work with businesses in every city and region, and everything is handled online: calls, campaigns, the website, and reporting."
          }
        }
      ]
    }
  ]
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE}${ogImage}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fffdfb" />
