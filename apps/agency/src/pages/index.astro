---
// Home — faithful translation of the "concise landing page" design mockup.
// Chrome (nav/footer/grain) + shared JS come from MockupLayout; this page
// supplies the hero + section <main> and fills its data-driven blocks.
import MockupLayout from "../layouts/MockupLayout.astro";
import MAIN from "../html/main/home.html?raw";
import { PROJECTS } from "../data/projects";

const SITE = "https://www.alisamadii.com";

// FAQ copy (questions match the mockup; the static mockup ships only the first
// answer, so all four live here for the accordion + FAQPage schema).
const faqs = [
  {
    q: "How long does it take to launch?",
    a: "Most single-page sites go from concept to launch in one day. Larger multi-page sites and web apps typically take one to two weeks, since one team handles design and development without hand-offs.",
  },
  {
    q: "Why custom code instead of a website builder?",
    a: "Every site is hand-built — no WordPress, Wix, or templates. Most local business sites run on Astro, which ships almost no JavaScript, so pages load fast and score high on Google's Core Web Vitals. When you need a custom API, user login, or an admin and client dashboard, we build on Next.js and React — the same custom foundation, scaled up to a full web app without a rebuild.",
  },
  {
    q: "What's included in the monthly plan?",
    a: "For $1,299 + $100/month you get design, development, hosting, email, unlimited content updates, SEO basics, and support — one flat fee, cancel anytime, no hidden costs. This plan is for local and small businesses; pricing varies with scope, but for most projects this is the price.",
  },
  {
    q: "Do you only work with Jacksonville businesses?",
    a: "No. We're headquartered in Jacksonville and serve businesses across Florida — Miami, Tampa, Orlando, and beyond — as well as remote clients anywhere in the US. Everything is handled online if you prefer.",
  },
];

const schema = [
  {
    "@type": "FAQPage",
    "@id": `${SITE}/#faq`,
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];

// ── Inject real data into the ported mockup (placeholders → projects.ts) ───
let body = MAIN;

// 1) Lighthouse strip — Mohammad Samadi's live mobile scores (same client as
//    the testimonial quote directly above the strip).
const lhProject = PROJECTS.find((p) => p.slug === "mohammad-samadi");
if (lhProject?.lighthouse) {
  const lh = lhProject.lighthouse;
  const order = [lh.performance, lh.accessibility, lh.bestPractices, lh.seo];
  let si = 0;
  body = body.replace(/">\[ \]<\/span>/g, () =>
    si < order.length ? `">${order[si++]}</span>` : '">[ ]</span>'
  );
  const tested = new Date(lh.testedOn + "T00:00:00Z").toLocaleDateString(
    "en-US",
    { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }
  );
  body = body.replace("Tested [date] · mobile", `Tested ${tested} · mobile`);
}

// 2) Client Work cards — swap the `[Site screenshot]` placeholder for the real
//    screenshot and point each card at the live site. Matched by card heading.
const projectByName = new Map(PROJECTS.map((p) => [p.name, p]));
body = body.replace(
  /<a href="\/work" class="lift"([^>]*)>([\s\S]*?)<\/a>/g,
  (full, attrs, inner) => {
    const nameMatch = inner.match(/<h3[^>]*>\s*([^<]+?)\s*<span/);
    const name = nameMatch?.[1]?.trim();
    const project = name ? projectByName.get(name) : undefined;
    if (!project?.image) return full;
    const img = `<div class="zoom" style="border-radius: 10px; overflow: hidden;"><img src="${project.image.src}" alt="${project.image.alt}" width="1120" height="840" loading="lazy" class="zi" style="aspect-ratio: 4 / 3; width: 100%; height: 100%; object-fit: cover; display: block;" /></div>`;
    const withImg = inner.replace(
      /<div class="zoom"[\s\S]*?<\/div>\s*<\/div>/,
      img
    );
    return `<a href="${project.url}" target="_blank" rel="noopener noreferrer" class="lift"${attrs}>${withImg}</a>`;
  }
);
---

<MockupLayout
  title="Jacksonville Web Design & Development Agency | Ali Samadi"
  description="Ali Samadi Agency builds custom-coded websites and web apps for Jacksonville, FL businesses. Design + development in-house, transparent pricing."
  canonical="https://www.alisamadii.com"
  og={{
    title: "Jacksonville Web Design & Development — Ali Samadi Agency",
    description:
      "Custom websites and web apps for businesses in Jacksonville and across Florida. One team owns design, code, SEO, and hosting — fast, transparent, no templates.",
    url: "https://www.alisamadii.com",
    twitterDescription:
      "Custom websites and web apps for Jacksonville, FL businesses — design and development under one roof.",
  }}
  schema={schema}
>
  <Fragment set:html={body} />
  <script type="application/json" id="faq-data" set:html={JSON.stringify(faqs)}
  ></script>
</MockupLayout>
