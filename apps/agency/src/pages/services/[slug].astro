---
import Layout from "../../layouts/Layout.astro";
import BackNav from "../../components/BackNav.astro";
import SimpleFooter from "../../components/SimpleFooter.astro";
import { services, type Service } from "../../data/services";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props as { service: Service };

const SITE = "https://agency.alisamadii.com";
const pageUrl = `${SITE}/services/${service.slug}`;

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Services",
        item: `${SITE}/services`,
      },
      { "@type": "ListItem", position: 3, name: service.name, item: pageUrl },
    ],
  },
  {
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: service.name,
    serviceType: service.keyword,
    description: service.metaDescription,
    url: pageUrl,
    provider: { "@id": `${SITE}/#organization` },
    areaServed: "US",
  },
];

const relatedServices = service.related
  .map((slug) => services.find((s) => s.slug === slug))
  .filter(Boolean) as Service[];
---

<Layout
  title={service.seoTitle}
  description={service.metaDescription}
  canonical={pageUrl}
  og={{
    title: service.seoTitle,
    description: service.metaDescription,
    url: pageUrl,
    twitterDescription: service.metaDescription,
  }}
  schema={schema}
  bodyClass="noise bg-cream text-charcoal selection:bg-accent/20 selection:text-accent font-sans"
>
  <BackNav backHref="/services" backLabel="All Services" fixed />

  <!-- ==================== HERO ==================== -->
  <section class="px-4 pt-32 pb-16 md:px-8 md:pt-40 md:pb-20">
    <div class="mx-auto max-w-[1200px]">
      <div
        class="text-muted mb-6 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] uppercase"
      >
        <span class="bg-accent h-px w-[26px]"></span>{service.eyebrow} &mdash; {
          service.name
        }
      </div>
      <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-2 md:gap-14">
        <div>
          {
            service.experimenting && (
              <span class="mb-5 inline-flex items-center gap-2 rounded-full border border-amber-300/60 bg-amber-50 px-3.5 py-1.5 font-mono text-[11.5px] tracking-[0.12em] text-amber-700 uppercase">
                <span class="size-1.5 animate-pulse rounded-full bg-amber-500" />
                Experimenting
              </span>
            )
          }
          <h1
            class="text-[clamp(34px,4.6vw,60px)] leading-[1.05] font-semibold tracking-[-0.03em]"
          >
            {service.h1}
          </h1>
          <p
            class="text-warmgray mt-6 max-w-[52ch] text-[17px] leading-[1.6] md:text-[18px]"
          >
            {service.heroSub}
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={service.cta.href}
              class="mag-btn bg-charcoal text-cream hover:bg-accent inline-flex items-center gap-2 rounded-full px-6 py-3.5 text-[15px] font-medium transition-all duration-300"
            >
              {service.cta.label}
              <svg
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
              </svg>
            </a>
            <a
              href="/pricing"
              class="text-warmgray hover:text-charcoal inline-flex min-h-11 items-center text-[15px] font-medium transition-colors duration-300"
              >View pricing</a
            >
          </div>
        </div>
        <figure>
          <div
            class="img-wrap border-charcoal/[0.08] aspect-[16/10] overflow-hidden rounded-[18px] border"
          >
            <img
              src={service.image.src}
              alt={service.image.alt}
              width="1600"
              height="1000"
              class="h-full w-full object-cover"
              fetchpriority="high"
            />
          </div>
          <figcaption class="text-muted mt-2 text-right text-[11.5px]">
            Photo by
            <a
              href={service.image.credit.url}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-charcoal underline underline-offset-2 transition-colors duration-300"
              >{service.image.credit.name}</a
            >
            on
            <a
              href={service.image.credit.pexelsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-charcoal underline underline-offset-2 transition-colors duration-300"
              >Pexels</a
            >
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ==================== EXPERIMENTING (honest-signal banner) ==================== -->
  {
    service.experimenting && (
      <section class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[60px] md:px-10">
        <div class="rounded-[22px] border border-amber-300/50 bg-amber-50/60 p-8 md:p-11">
          <div class="mb-4 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] text-amber-700 uppercase">
            <span class="h-px w-[26px] bg-amber-500" />
            Full Transparency
          </div>
          <h2 class="text-[clamp(34px,5vw,64px)] leading-[1.02] font-semibold tracking-[-0.035em] text-amber-600">
            Experimenting
          </h2>
          <p class="text-warmgray mt-5 max-w-[68ch] text-[16.5px] leading-[1.65]">
            Honest note: analytics is a solid part of our workflow, but SEO is
            a craft we're still building deep experience in. We're actively
            running SEO for local-business clients right now — measuring what
            moves rankings, keeping what works, and dropping what doesn't. You
            get real effort and real data, not overpromises.
          </p>
        </div>
      </section>
    )
  }

  <!-- ==================== INTRO ==================== -->
  <section
    class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[60px] md:px-10"
  >
    <p
      class="text-warmgray max-w-[70ch] text-[17px] leading-[1.7] md:text-[18px]"
    >
      {service.intro}
    </p>
  </section>

  <!-- ==================== NOTICE (prominent amber banner) ==================== -->
  {
    service.notice && (
      <section class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[60px] md:px-10">
        <div class="rounded-[22px] border border-amber-300/50 bg-amber-50/60 p-8 md:p-11">
          <div class="mb-4 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] text-amber-700 uppercase">
            <span class="h-px w-[26px] bg-amber-500" />
            {service.notice.label}
          </div>
          <h2 class="text-[clamp(34px,5vw,64px)] leading-[1.02] font-semibold tracking-[-0.035em] text-amber-600">
            {service.notice.title}
          </h2>
          <p class="text-warmgray mt-5 max-w-[68ch] text-[16.5px] leading-[1.65]">
            {service.notice.text}
          </p>
        </div>
      </section>
    )
  }

  <!-- ==================== BENEFITS ==================== -->
  <section
    class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[70px] md:px-10"
  >
    <h2
      class="reveal text-[clamp(26px,3vw,40px)] leading-[1.1] font-semibold tracking-[-0.03em]"
    >
      What you get with our {service.name.toLowerCase()}
    </h2>
    <div class="stagger mt-10 grid grid-cols-1 gap-[18px] md:grid-cols-2">
      {
        service.benefits.map((b) => (
          <div class="reveal border-charcoal/[0.08] rounded-[18px] border bg-white p-7">
            <h3 class="text-[19px] font-semibold tracking-[-0.02em]">
              {b.title}
            </h3>
            <p class="text-warmgray mt-2.5 text-[15px] leading-[1.6]">
              {b.text}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ==================== SHOWCASE (product screenshots, optional) ==================== -->
  {
    service.showcase && (
      <section class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[70px] md:px-10">
        <h2 class="reveal text-[clamp(26px,3vw,40px)] leading-[1.1] font-semibold tracking-[-0.03em]">
          {service.showcase.heading}
        </h2>
        {service.showcase.sub && (
          <p class="text-warmgray reveal mt-4 max-w-[60ch] text-[16px] leading-[1.65]">
            {service.showcase.sub}
          </p>
        )}
        <div class="mt-12 space-y-16 md:space-y-20">
          {service.showcase.items.map((item, i) => (
            <div
              class={`reveal grid grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-14 ${
                i % 2 === 1 ? "md:[&>div:first-child]:order-2" : ""
              }`}
            >
              <div>
                <div class="text-accent font-mono text-[13px] tracking-[0.08em]">
                  0{i + 1}
                </div>
                <h3 class="mt-2 text-[21px] font-semibold tracking-[-0.02em]">
                  {item.title}
                </h3>
                <p class="text-warmgray mt-3 max-w-[48ch] text-[15.5px] leading-[1.65]">
                  {item.text}
                </p>
              </div>
              <div class="img-wrap border-charcoal/[0.08] aspect-[16/10] overflow-hidden rounded-[18px] border bg-white">
                <img
                  src={item.image.src}
                  alt={item.image.alt}
                  width="1600"
                  height="1000"
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- ==================== PROCESS (optional) ==================== -->
  {
    service.process && (
      <section class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[70px] md:px-10">
        <h2 class="reveal text-[clamp(26px,3vw,40px)] leading-[1.1] font-semibold tracking-[-0.03em]">
          How it works
        </h2>
        <div class="stagger mt-10 grid grid-cols-1 gap-[18px] md:grid-cols-4">
          {service.process.map((step, i) => (
            <div class="reveal">
              <div class="text-accent font-mono text-[13px] tracking-[0.08em]">
                0{i + 1}
              </div>
              <h3 class="mt-2 text-[17px] font-semibold tracking-[-0.01em]">
                {step.title}
              </h3>
              <p class="text-warmgray mt-2 text-[14.5px] leading-[1.6]">
                {step.text}
              </p>
            </div>
          ))}
        </div>
        {service.processCta && (
          <a
            href={service.processCta.href}
            class="text-accent hover:text-charcoal reveal mt-10 inline-flex min-h-11 items-center gap-2 text-[15px] font-medium transition-colors duration-300"
          >
            {service.processCta.label}
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
              />
            </svg>
          </a>
        )}
      </section>
    )
  }

  <!-- ==================== FAQ ==================== -->
  <section
    class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[70px] md:px-10"
  >
    <h2
      class="reveal text-[clamp(26px,3vw,40px)] leading-[1.1] font-semibold tracking-[-0.03em]"
    >
      Common questions
    </h2>
    <div class="mt-10 grid grid-cols-1 gap-x-14 gap-y-9 md:grid-cols-2">
      {
        service.faqs.map((faq) => (
          <div>
            <h3 class="text-[17px] font-semibold tracking-[-0.01em]">
              {faq.q}
            </h3>
            <p class="text-warmgray mt-2.5 text-[15px] leading-[1.65]">
              {faq.a}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ==================== RESOURCES + RELATED ==================== -->
  <section
    class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[60px] md:px-10"
  >
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2">
      <div>
        <h2
          class="text-muted font-mono text-[12.5px] tracking-[0.12em] uppercase"
        >
          Helpful resources
        </h2>
        <ul class="mt-5 space-y-3">
          {
            service.externalLinks.map((link) => (
              <li>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-warmgray hover:text-accent inline-flex min-h-8 items-center gap-2 text-[15px] transition-colors duration-300"
                >
                  {link.label}
                  <span class="text-accent text-[12px]">&#8599;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2
          class="text-muted font-mono text-[12.5px] tracking-[0.12em] uppercase"
        >
          Related services
        </h2>
        <ul class="mt-5 space-y-3">
          {
            relatedServices.map((rel) => (
              <li>
                <a
                  href={`/services/${rel.slug}`}
                  class="text-warmgray hover:text-accent inline-flex min-h-8 items-center gap-2 text-[15px] transition-colors duration-300"
                >
                  {rel.name}
                  <span class="text-accent text-[12px]">&rarr;</span>
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/pricing"
              class="text-warmgray hover:text-accent inline-flex min-h-8 items-center gap-2 text-[15px] transition-colors duration-300"
            >
              Pricing
              <span class="text-accent text-[12px]">&rarr;</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ==================== FINAL CTA ==================== -->
  <section
    class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[70px] md:px-10"
  >
    <div
      class="bg-ink text-cream rounded-[22px] p-9 text-center md:p-14"
    >
      <h2
        class="text-[clamp(26px,3.2vw,42px)] leading-[1.1] font-semibold tracking-[-0.03em]"
      >
        Ready to get started?
      </h2>
      <p class="text-cream/70 mx-auto mt-4 max-w-[46ch] text-[15.5px] leading-[1.6]">
        Simple, transparent pricing — and a real person on the other end.
        Simple sites ship in one day once your project is confirmed.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href={service.cta.href}
          class="mag-btn bg-accent hover:bg-cream hover:text-charcoal inline-flex items-center gap-2 rounded-full px-6 py-3.5 text-[15px] font-medium text-white transition-all duration-300"
        >
          {service.cta.label}
        </a>
        <a
          href="/#contact"
          class="text-cream/80 hover:text-cream inline-flex min-h-11 items-center text-[15px] font-medium transition-colors duration-300"
          >Ask a question</a
        >
      </div>
    </div>
  </section>

  <SimpleFooter />
</Layout>

<style is:global>
  html {
    scrollbar-gutter: stable;
  }
  .mag-btn {
    transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .mag-btn:active {
    transform: scale(0.97);
  }
</style>

<script is:inline data-astro-rerun>
  (() => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "-60px" }
    );
    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
  })();
</script>
