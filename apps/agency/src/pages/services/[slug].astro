---
import MockupLayout from "../../layouts/MockupLayout.astro";
import { services, type Service } from "../../data/services";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props as { service: Service };

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/services/${service.slug}`;

const schema: Record<string, unknown>[] = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Services",
        item: `${SITE}/services`,
      },
      { "@type": "ListItem", position: 3, name: service.name, item: pageUrl },
    ],
  },
  {
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: service.name,
    serviceType: service.keyword,
    description: service.metaDescription,
    url: pageUrl,
    provider: { "@id": `${SITE}/#organization` },
    areaServed: "US",
  },
];

// Google retired FAQ rich results (May 2026), but AI answer engines
// (ChatGPT, Perplexity, AI Overviews) still parse FAQPage.
schema.push({
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  mainEntity: service.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
});

const relatedServices = service.related
  .map((slug) => services.find((s) => s.slug === slug))
  .filter(Boolean) as Service[];

// --- View helpers (mockup-driven, data-filled) -------------------------------
// Accent the final word of the headline, like the mockup's italic span.
const h1Words = service.h1.trim().split(/\s+/);
const h1Last = h1Words.length > 1 ? h1Words.pop()! : "";
const h1Head = h1Words.join(" ");

// Simple glyphs cycled across benefit cards, matching the mockup.
const glyphs = ["→", "◐", "◎", "✓", "✦", "●"];

// "At a glance" rows are the same for every service.
const glance = [
  { k: "Team", v: "One team designs & builds" },
  { k: "Stack", v: "Astro, Next.js, React" },
  { k: "Hand-off", v: "None, same team ships it" },
  { k: "Timeline", v: "Most launch in 1 day to 2 weeks" },
];

const num = (i: number) => String(i + 1).padStart(2, "0");
---

<MockupLayout
  title={service.seoTitle}
  description={service.metaDescription}
  canonical={pageUrl}
  og={{
    title: service.seoTitle,
    description: service.metaDescription,
    url: pageUrl,
  }}
  schema={schema}
  pageType="Service"
>
  <main id="top">
    <!-- ==================== HERO ==================== -->
    <section style="position: relative; padding-top: 40px; padding-bottom: 88px;">
      <div class="wrap" style="display: flex; flex-direction: column; gap: 40px;">
        <nav aria-label="Breadcrumb">
          <ol
            class="mono"
            style="margin: 0px; padding: 0px; list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(107, 102, 93);"
          >
            <li>
              <a href="/" class="tlink" style="color: rgb(107, 102, 93);">Home</a>
            </li>
            <li aria-hidden="true">/</li>
            <li>
              <a href="/services" class="tlink" style="color: rgb(107, 102, 93);"
                >Services</a
              >
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" style="color: rgb(27, 26, 23);">
              {service.name}
            </li>
          </ol>
        </nav>
        <div style="display: flex; flex-wrap: wrap; align-items: flex-start; gap: 48px 64px;">
          <div
            style="flex: 999 1 520px; min-width: 0px; display: flex; flex-direction: column; gap: 24px;"
          >
            <p class="eyebrow">
              <span
                style="width: 6px; height: 6px; border-radius: 9999px; background: rgb(252, 132, 100);"
              ></span>{service.eyebrow} · {service.name}
            </p>
            {
              service.experimenting && (
                <span style="display: inline-flex; align-self: flex-start; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 9999px; border: 1px solid rgba(180, 120, 40, 0.35); background: rgba(240, 190, 110, 0.14); font-family: 'Geist Mono', ui-monospace, monospace; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(161, 98, 7);">
                  <span style="width: 6px; height: 6px; border-radius: 9999px; background: rgb(217, 119, 6);" />
                  Experimenting
                </span>
              )
            }
            <h1
              class="hero-h1"
              style="margin: 0px; font-size: clamp(38px, 5vw, 64px); line-height: 1.04; font-weight: 600; letter-spacing: -0.035em;"
            >
              {h1Head}{" "}<span
                style="color: rgb(194, 69, 31); font-style: italic; padding-right: 0.06em;"
                >{h1Last}</span
              >
            </h1>
            <p
              style="margin: 0px; max-width: 560px; font-size: clamp(17px, 1.5vw, 19px); line-height: 1.55; color: rgb(103, 98, 90);"
            >
              {service.heroSub}
            </p>
            <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px;">
              <a
                href="/quote"
                class="btn btn-primary"
                style="display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0px 24px; border-radius: 11px; background: rgb(252, 132, 100); color: rgb(27, 26, 23); font-size: 15px; font-weight: 500; text-decoration: none; box-shadow: rgba(252, 132, 100, 0.32) 0px 8px 24px;"
                >Start a project ↗</a
              >
              <a
                href="/pricing"
                class="tlink"
                style="font-size: 15px; font-weight: 500; color: rgb(27, 26, 23);"
                >View pricing →</a
              >
            </div>
          </div>
          <aside
            aria-label="At a glance"
            class="frame"
            style="flex: 1 1 320px; max-width: 400px; padding: 6px; border-radius: 18px; background: rgba(27, 26, 23, 0.03); box-shadow: rgba(27, 26, 23, 0.04) 0px 0px 0px 1px;"
          >
            <div
              class="inner"
              style="border-radius: 14px; background: rgb(255, 254, 252); padding: 24px; display: flex; flex-direction: column; gap: 16px;"
            >
              <p
                class="mono"
                style="margin: 0px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(107, 102, 93);"
              >
                At a glance
              </p>
              <dl style="margin: 0px; display: flex; flex-direction: column; font-size: 15px;">
                {
                  glance.map((row) => (
                    <div style="display: flex; justify-content: space-between; gap: 16px; padding: 10px 0px; border-top: 1px solid rgba(27, 26, 23, 0.07);">
                      <dt style="color: rgb(107, 102, 93);">{row.k}</dt>
                      <dd style="margin: 0px; font-weight: 600; text-align: right;">
                        {row.v}
                      </dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ==================== BENEFITS ==================== -->
    <section style="padding: 80px 0px; background: rgba(27, 26, 23, 0.03);">
      <div class="wrap" style="display: flex; flex-direction: column; gap: 40px;">
        <div style="display: flex; flex-wrap: wrap; gap: 24px 64px; align-items: flex-end;">
          <div style="flex: 1 1 320px; display: flex; flex-direction: column; gap: 16px;">
            <p class="eyebrow">
              <span
                style="width: 6px; height: 6px; border-radius: 9999px; background: rgb(252, 132, 100);"
              ></span>What you get
            </p>
            <h2
              style="margin: 0px; font-size: clamp(30px, 3.6vw, 44px); line-height: 1.08; font-weight: 600; letter-spacing: -0.025em;"
            >
              Why {service.name} matters
            </h2>
          </div>
          <p
            style="flex: 1 1 420px; margin: 0px; font-size: 17px; line-height: 1.6; color: rgb(103, 98, 90);"
          >
            {service.intro}
          </p>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
          {
            service.benefits.map((b, i) => (
              <article
                class="frame lift"
                style="padding: 6px; border-radius: 18px; background: rgba(27, 26, 23, 0.03); box-shadow: rgba(27, 26, 23, 0.04) 0px 0px 0px 1px, rgba(27, 26, 23, 0.1) 0px 14px 34px; display: flex;"
              >
                <div
                  class="inner"
                  style="flex: 1 1 0%; border-radius: 14px; background: rgb(255, 254, 252); padding: 24px; display: flex; flex-direction: column; gap: 10px;"
                >
                  <span
                    aria-hidden="true"
                    style="width: 40px; height: 40px; border-radius: 9999px; background: rgba(27, 26, 23, 0.05); display: flex; align-items: center; justify-content: center;"
                  >
                    {glyphs[i % glyphs.length]}
                  </span>
                  <h3 style="margin: 6px 0px 0px; font-size: 19px; font-weight: 600;">
                    {b.title}
                  </h3>
                  <p style="margin: 0px; font-size: 15px; line-height: 1.55; color: rgb(103, 98, 90);">
                    {b.text}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ==================== HOW IT WORKS (optional) ==================== -->
    {
      service.process && (
        <section style="padding: 88px 0px;">
          <div class="wrap" style="display: flex; flex-direction: column; gap: 40px;">
            <div style="display: flex; flex-direction: column; gap: 16px;">
              <p class="eyebrow">
                <span style="width: 6px; height: 6px; border-radius: 9999px; background: rgb(252, 132, 100);" />
                How it works
              </p>
              <h2 style="margin: 0px; font-size: clamp(30px, 3.6vw, 44px); line-height: 1.08; font-weight: 600; letter-spacing: -0.025em;">
                How we deliver {service.name.toLowerCase()}
              </h2>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 32px 40px;">
              {service.process.map((step, i) => (
                <div style="display: flex; flex-direction: column; gap: 10px;">
                  <p
                    class="mono"
                    style="margin: 0px; font-size: 13px; letter-spacing: 0.12em; color: rgb(194, 69, 31);"
                  >
                    {num(i)}
                  </p>
                  <h3 style="margin: 0px; font-size: 19px; font-weight: 600;">
                    {step.title}
                  </h3>
                  <p style="margin: 0px; font-size: 15px; line-height: 1.55; color: rgb(103, 98, 90);">
                    {step.text}
                  </p>
                </div>
              ))}
            </div>
            {service.processCta && (
              <a
                href={service.processCta.href}
                class="tlink"
                style="align-self: flex-start; font-size: 15px; font-weight: 500; color: rgb(194, 69, 31);"
              >
                {service.processCta.label} →
              </a>
            )}
          </div>
        </section>
      )
    }

    <!-- ==================== SHOWCASE (optional) ==================== -->
    {
      service.showcase && (
        <section style="padding: 88px 0px; background: rgba(27, 26, 23, 0.03);">
          <div class="wrap" style="display: flex; flex-direction: column; gap: 48px;">
            <div style="display: flex; flex-direction: column; gap: 16px; max-width: 640px;">
              <p class="eyebrow">
                <span style="width: 6px; height: 6px; border-radius: 9999px; background: rgb(252, 132, 100);" />
                Walkthrough
              </p>
              <h2 style="margin: 0px; font-size: clamp(30px, 3.6vw, 44px); line-height: 1.08; font-weight: 600; letter-spacing: -0.025em;">
                {service.showcase.heading}
              </h2>
              {service.showcase.sub && (
                <p style="margin: 0px; font-size: 17px; line-height: 1.6; color: rgb(103, 98, 90);">
                  {service.showcase.sub}
                </p>
              )}
            </div>
            <div style="display: flex; flex-direction: column; gap: 48px;">
              {service.showcase.items.map((item, i) => (
                <div style="display: flex; flex-wrap: wrap; gap: 32px 56px; align-items: center;">
                  <div
                    class="frame"
                    style={`order: ${i % 2 === 0 ? 1 : 2}; flex: 1 1 420px; min-width: 0px; padding: 6px; border-radius: 18px; background: rgba(27, 26, 23, 0.03); box-shadow: rgba(27, 26, 23, 0.04) 0px 0px 0px 1px;`}
                  >
                    <div
                      class="inner"
                      style="border-radius: 14px; overflow: hidden; background: rgb(255, 254, 252);"
                    >
                      <img
                        src={item.image.src}
                        alt={item.image.alt}
                        width="1600"
                        height="1000"
                        loading="lazy"
                        style="display: block; width: 100%; height: auto;"
                      />
                    </div>
                  </div>
                  <div
                    style={`order: ${i % 2 === 0 ? 2 : 1}; flex: 1 1 360px; min-width: 0px; display: flex; flex-direction: column; gap: 12px;`}
                  >
                    <p
                      class="mono"
                      style="margin: 0px; font-size: 13px; letter-spacing: 0.12em; color: rgb(194, 69, 31);"
                    >
                      {num(i)}
                    </p>
                    <h3 style="margin: 0px; font-size: 21px; font-weight: 600;">
                      {item.title}
                    </h3>
                    <p style="margin: 0px; max-width: 48ch; font-size: 15.5px; line-height: 1.6; color: rgb(103, 98, 90);">
                      {item.text}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- ==================== NOTICE (optional) ==================== -->
    {
      service.notice && (
        <section style="padding: 80px 0px;">
          <div class="wrap">
            <div style="padding: 32px; border-radius: 18px; border: 1px solid rgba(180, 120, 40, 0.3); background: rgba(240, 190, 110, 0.12); display: flex; flex-direction: column; gap: 14px;">
              <p
                class="mono"
                style="margin: 0px; display: flex; align-items: center; gap: 10px; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(161, 98, 7);"
              >
                <span style="width: 6px; height: 6px; border-radius: 9999px; background: rgb(217, 119, 6);" />
                {service.notice.label}
              </p>
              <h2 style="margin: 0px; font-size: clamp(24px, 3vw, 32px); line-height: 1.1; font-weight: 600; letter-spacing: -0.02em;">
                {service.notice.title}
              </h2>
              <p style="margin: 0px; max-width: 68ch; font-size: 16px; line-height: 1.65; color: rgb(103, 98, 90);">
                {service.notice.text}
              </p>
            </div>
          </div>
        </section>
      )
    }

    <!-- ==================== FAQ ==================== -->
    <section style="padding: 88px 0px;">
      <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: flex-start;">
        <div style="flex: 1 1 280px; display: flex; flex-direction: column; gap: 16px;">
          <p class="eyebrow">
            <span
              style="width: 6px; height: 6px; border-radius: 9999px; background: rgb(252, 132, 100);"
            ></span>FAQ
          </p>
          <h2
            style="margin: 0px; font-size: clamp(30px, 3.6vw, 44px); line-height: 1.08; font-weight: 600; letter-spacing: -0.025em;"
          >
            {service.name} questions
          </h2>
        </div>
        <div
          class="frame"
          style="flex: 999 1 560px; min-width: 0px; padding: 6px; border-radius: 18px; background: rgba(27, 26, 23, 0.03); box-shadow: rgba(27, 26, 23, 0.04) 0px 0px 0px 1px;"
        >
          <div
            class="inner"
            style="border-radius: 14px; background: rgb(255, 254, 252); overflow: hidden;"
          >
            {
              service.faqs.map((faq, i) => (
                <div style="border-bottom: 1px solid rgba(27, 26, 23, 0.07);">
                  <button
                    type="button"
                    class="faq-q"
                    aria-expanded={i === 0 ? "true" : "false"}
                    style="width: 100%; min-height: 64px; padding: 20px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; border: 0px; background: transparent; cursor: pointer; text-align: left; font-family: inherit; font-size: 17px; font-weight: 600; color: rgb(27, 26, 23);"
                  >
                    {faq.q}
                    <span
                      aria-hidden="true"
                      class="mono"
                      style="font-size: 20px; color: rgb(107, 102, 93);"
                    >
                      {i === 0 ? "−" : "+"}
                    </span>
                  </button>
                  <p
                    class="fade"
                    style={`margin: 0px; padding: 0px 24px 24px; max-width: 68ch; font-size: 16px; line-height: 1.65; color: rgb(103, 98, 90); display: ${i === 0 ? "block" : "none"};`}
                  >
                    {faq.a}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== PAIRS WELL WITH ==================== -->
    <section style="padding: 80px 0px; background: rgba(27, 26, 23, 0.03);">
      <div class="wrap" style="display: flex; flex-direction: column; gap: 28px;">
        <h2
          class="mono"
          style="margin: 0px; font-size: 13px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(107, 102, 93);"
        >
          Pairs well with
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px;">
          {
            relatedServices.map((rel) => (
              <a
                href={`/services/${rel.slug}`}
                class="frame lift tlink"
                style="color: rgb(27, 26, 23); padding: 6px; border-radius: 18px; background: rgba(27, 26, 23, 0.03); box-shadow: rgba(27, 26, 23, 0.04) 0px 0px 0px 1px, rgba(27, 26, 23, 0.1) 0px 14px 34px; text-decoration: none;"
              >
                <span
                  class="inner"
                  style="border-radius: 14px; background: rgb(255, 254, 252); padding: 22px; display: flex; justify-content: space-between; align-items: center; gap: 12px;"
                >
                  <span style="display: flex; flex-direction: column;">
                    <span style="font-size: 18px; font-weight: 600;">
                      {rel.name}
                    </span>
                    <span style="font-size: 14px; color: rgb(103, 98, 90);">
                      {rel.eyebrow}
                    </span>
                  </span>
                  <span aria-hidden="true">→</span>
                </span>
              </a>
            ))
          }
          <a
            href="/pricing"
            class="frame lift tlink"
            style="color: rgb(27, 26, 23); padding: 6px; border-radius: 18px; background: rgba(27, 26, 23, 0.03); box-shadow: rgba(27, 26, 23, 0.04) 0px 0px 0px 1px, rgba(27, 26, 23, 0.1) 0px 14px 34px; text-decoration: none;"
          >
            <span
              class="inner"
              style="border-radius: 14px; background: rgb(255, 254, 252); padding: 22px; display: flex; justify-content: space-between; align-items: center; gap: 12px;"
            >
              <span style="display: flex; flex-direction: column;">
                <span style="font-size: 18px; font-weight: 600;">Pricing</span>
                <span style="font-size: 14px; color: rgb(103, 98, 90);"
                  >Simple, transparent plans</span
                >
              </span>
              <span aria-hidden="true">→</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- ==================== DARK CTA ==================== -->
    <section
      id="contact"
      class="dark"
      style="padding: 96px 0px; background: rgb(23, 21, 18); color: rgb(236, 233, 226);"
    >
      <div class="wrap" style="display: flex; flex-direction: column; align-items: flex-start; gap: 22px;">
        <p class="eyebrow">
          <span
            style="width: 6px; height: 6px; border-radius: 9999px; background: rgb(252, 132, 100);"
          ></span>Ready to get started?
        </p>
        <h2
          style="margin: 0px; max-width: 16ch; font-size: clamp(36px, 5vw, 64px); line-height: 1.02; font-weight: 600; letter-spacing: -0.035em;"
        >
          Make the next step obvious.
        </h2>
        <p
          style="margin: 0px; max-width: 520px; font-size: 18px; line-height: 1.55; color: rgb(184, 178, 167);"
        >
          Transparent pricing and a real person to talk to. Ali replies
          directly.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px 16px; margin-top: 6px;">
          <a
            href={service.cta.href}
            class="btn btn-primary"
            style="display: inline-flex; align-items: center; min-height: 52px; padding: 0px 24px; border-radius: 11px; background: rgb(252, 132, 100); color: rgb(27, 26, 23); font-size: 15px; font-weight: 500; text-decoration: none;"
            >{service.cta.label}</a
          >
          <a
            href="/quote"
            class="btn btn-ghost"
            style="display: inline-flex; align-items: center; min-height: 52px; padding: 0px 22px; border-radius: 11px; background: rgba(236, 233, 226, 0.08); color: rgb(236, 233, 226); font-size: 15px; font-weight: 500; text-decoration: none;"
            >Ask a question</a
          >
        </div>
      </div>
    </section>
  </main>

  <script
    type="application/json"
    id="faq-data"
    set:html={JSON.stringify(service.faqs)}
  />
</MockupLayout>
</content>
</invoke>
