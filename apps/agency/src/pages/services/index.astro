---
// Services index — faithful translation of the mockup frame.
// SEO/schema carried over from the previous hand-built version.
import MockupLayout from "../../layouts/MockupLayout.astro";
import RAW_MAIN from "../../html/main/services.html?raw";
import { FROM_PRICE, fmtPrice } from "../../data/pricing";
import { services } from "../../data/services";

const MAIN = RAW_MAIN.replaceAll("{{FROM_PRICE}}", fmtPrice(FROM_PRICE));
const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/services`;

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Services", item: pageUrl },
    ],
  },
  {
    "@type": "ItemList",
    "@id": `${pageUrl}#services`,
    name: "Services",
    itemListElement: services.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: s.name,
      url: `${SITE}/services/${s.slug}`,
    })),
  },
];
---

<MockupLayout
  title="Lead Generation & Web Services in Jacksonville, FL | Ali Samadi"
  description="Everything we offer to bring in more customers: Google Ads management, websites that convert, SEO & analytics, email newsletters, and more."
  canonical={pageUrl}
  og={{
    title: "Services — Ali Samadi Agency",
    description:
      "Google Ads, websites that convert, SEO, email newsletters, and more, for local businesses that want more leads.",
    url: pageUrl,
    twitterDescription:
      "Google Ads, websites that convert, SEO, and email for local businesses that want more leads.",
  }}
  schema={schema}
>
  <Fragment set:html={MAIN} />
</MockupLayout>
