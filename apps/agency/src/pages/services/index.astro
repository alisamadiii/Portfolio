---
// Services index — faithful translation of the mockup frame.
// SEO/schema carried over from the previous hand-built version.
import MockupLayout from "../../layouts/MockupLayout.astro";
import MAIN from "../../html/main/services.html?raw";
import { services } from "../../data/services";

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/services`;

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Services", item: pageUrl },
    ],
  },
  {
    "@type": "ItemList",
    "@id": `${pageUrl}#services`,
    name: "Services",
    itemListElement: services.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: s.name,
      url: `${SITE}/services/${s.slug}`,
    })),
  },
];
---

<MockupLayout
  title="Web Design & Development Services in Jacksonville, FL | Ali Samadi Agency"
  description="Everything Ali Samadi Agency offers: brand identity, Next.js web development, UI/UX design, SEO & analytics, website management, and custom web apps."
  canonical={pageUrl}
  og={{
    title: "Services — Ali Samadi Agency",
    description:
      "Brand identity, Next.js web development, UI/UX design, SEO & analytics, website management, and custom web apps.",
    url: pageUrl,
    twitterDescription:
      "Brand identity, web development, UI/UX, SEO, website management, and custom web apps.",
  }}
  schema={schema}
>
  <Fragment set:html={MAIN} />
</MockupLayout>
