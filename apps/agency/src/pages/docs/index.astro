---
import Layout from "../../layouts/Layout.astro";
import BackNav from "../../components/BackNav.astro";
import HomeFooter from "../../components/HomeFooter.astro";
import { getDocsTree } from "../../data/docs";

const tree = await getDocsTree();

const SITE = "https://agency.alisamadii.com";
const pageUrl = `${SITE}/docs`;

const description =
  "Guides to your Client Hub, our build process, and what you own: everything about working with us, in plain language.";

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Docs", item: pageUrl },
    ],
  },
  {
    "@type": "CollectionPage",
    "@id": `${pageUrl}#docs`,
    name: "Docs · How Everything Works",
    description,
    url: pageUrl,
    isPartOf: { "@id": `${SITE}/#website` },
    hasPart: tree.flatMap((g) =>
      g.docs.map((doc) => ({
        "@type": "TechArticle",
        headline: doc.data.title,
        description: doc.data.description,
        url: `${SITE}/docs/${doc.id}`,
        articleSection: g.label,
      })),
    ),
  },
];
---

<Layout
  title="Docs · How Everything Works"
  description={description}
  canonical={pageUrl}
  og={{
    title: "Docs · How Everything Works",
    description,
    url: pageUrl,
    twitterDescription: description,
  }}
  schema={schema}
  bodyClass="noise bg-cream text-charcoal selection:bg-accent/20 selection:text-accent font-sans"
>
  <BackNav backHref="/" backLabel="Back to Home" fixed />

  <main class="px-4 pt-32 pb-16 md:px-8 md:pt-40 md:pb-24">
    <div class="mx-auto max-w-[900px]">
      <p
        class="font-mono text-[12.5px] tracking-[0.12em] text-accent-ink uppercase"
      >
        Docs
      </p>
      <h1
        class="mt-4 max-w-[18ch] text-[clamp(32px,4.4vw,54px)] leading-[1.08] font-semibold tracking-[-0.03em]"
      >
        How everything works.
      </h1>
      <p class="mt-5 max-w-[52ch] text-[17px] leading-[1.6] text-warmgray">
        Plain-language guides to your Client Hub, the way we build and hand
        over websites, and what you own at every step.
      </p>

      <div class="mt-14 space-y-12">
        {
          tree.map(({ label, docs }) => (
            <section>
              <h2 class="font-mono text-[12.5px] tracking-[0.1em] text-muted uppercase">
                {label}
              </h2>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                {docs.map((doc) => (
                  <a
                    href={`/docs/${doc.id}`}
                    class="group rounded-[16px] border border-charcoal/[0.08] bg-white/60 p-6 transition-colors duration-300 hover:border-charcoal/20"
                  >
                    <h3 class="text-[17px] font-semibold tracking-[-0.01em] text-charcoal group-hover:text-accent-ink">
                      {doc.data.title}
                    </h3>
                    <p class="mt-2 text-[14.5px] leading-[1.55] text-warmgray">
                      {doc.data.description}
                    </p>
                  </a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </main>
  <HomeFooter />
</Layout>
