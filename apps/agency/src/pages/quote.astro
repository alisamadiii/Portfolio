---
// Get a Quote — rebuilt in the mockup design system (MockupLayout). Keeps the
// working QuoteForm (relays to the quote API) and the floating welcome video.
import MockupLayout from "../layouts/MockupLayout.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { FROM_PRICE, fmtPrice } from "../data/pricing";

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/quote`;

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Get a Quote", item: pageUrl },
    ],
  },
];
---

<MockupLayout
  title="Get a Quote | Free Lead Generation Plan | Ali Samadi Agency"
  description={`Tell us about your business and get a plan for your website and Google Ads, usually within a day. Growth plans from ${fmtPrice(FROM_PRICE)}/mo, no setup fee.`}
  canonical={pageUrl}
  og={{
    title: "Get a Quote — Ali Samadi Agency",
    description:
      "Tell us about your business and get a plan for your website and Google Ads, usually within a day.",
    url: pageUrl,
    twitterDescription:
      "Get a plan for your website and Google Ads, usually within a day.",
  }}
  schema={schema}
>
  <main id="top">
    <!-- Hero -->
    <section style="padding: 140px 0 32px;">
      <div class="wrap" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:22px;">
        <p class="eyebrow"><span></span>Get a quote</p>
        <h1 class="hero-h1" style="margin:0;max-width:16ch;font-size:clamp(40px,6vw,76px);line-height:1.02;font-weight:600;letter-spacing:-0.035em;">
          Let's plan your <span style="color:rgb(194,69,31);font-style:italic;">growth</span>
        </h1>
        <p style="margin:0;max-width:56ch;font-size:clamp(17px,1.6vw,20px);line-height:1.55;color:rgb(103,98,90);">
          Share a few details about your business and we'll come back with a
          plan for more leads and a clear price in writing, usually within a
          day. No calls required, no obligation.
        </p>
      </div>
    </section>

    <!-- Form -->
    <section id="quote" style="padding: 24px 0 72px; scroll-margin-top: 96px;">
      <div class="wrap">
        <div style="max-width:760px;margin-inline:auto;">
          <QuoteForm />
        </div>
      </div>
    </section>

    <!-- What happens next -->
    <section style="padding: 72px 0; border-top: 1px solid rgba(27,26,23,0.06);">
      <div class="wrap" style="display:grid;grid-template-columns:1fr;gap:32px;">
        <div style="display:flex;flex-direction:column;gap:16px;max-width:640px;">
          <p class="eyebrow"><span></span>What happens next</p>
          <h2 style="margin:0;font-size:clamp(30px,3.6vw,44px);line-height:1.08;font-weight:600;letter-spacing:-0.025em;">
            A plan the same day
          </h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;max-width:960px;font-size:16px;line-height:1.65;color:rgb(103,98,90);">
          <p style="margin:0;">
            We read your request the same day and reply with a plan: where your
            leads should come from, what the site needs, and a clear price. Most
            businesses fit one of our
            <a href="/pricing" class="tlink" style="color:rgb(194,69,31);">growth plans</a>;
            custom projects get a written number before any work starts.
          </p>
          <p style="margin:0;">
            Prefer to talk it through?
            <button type="button" data-booking class="tlink" style="color:rgb(194,69,31);background:none;border:none;padding:0;font:inherit;cursor:pointer;">Book a meeting</button>
            or email
            <a href="mailto:agency@alisamadii.com" class="tlink" style="color:rgb(194,69,31);">agency@alisamadii.com</a>
            directly.
          </p>
        </div>
      </div>
    </section>
  </main>

  <!-- Floating welcome video -->
  <div
    id="welcomeVideo"
    style="position:fixed;right:16px;bottom:16px;z-index:40;width:min(240px,46vw);transform:translateY(130%);opacity:0;overflow:hidden;border-radius:18px;border:1px solid rgba(27,26,23,0.08);box-shadow:rgba(27,26,23,0.18) 0px 20px 50px;transition:transform .7s cubic-bezier(.2,.7,.2,1),opacity .7s cubic-bezier(.2,.7,.2,1);"
  >
    <video
      src="https://cdn.alisamadii.com/media/welcome-video.mp4"
      muted
      playsinline
      preload="none"
      style="display:block;width:100%;height:100%;object-fit:cover;"></video>
  </div>

  <script is:inline data-astro-rerun>
    (function initWelcomeVideo() {
      const wrap = document.getElementById("welcomeVideo");
      if (!wrap) return;
      const video = wrap.querySelector("video");
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        wrap.remove();
        return;
      }
      const exit = () => {
        wrap.style.transform = "translateY(130%)";
        wrap.style.opacity = "0";
        setTimeout(() => wrap.remove(), 700);
      };
      video.addEventListener("ended", exit);
      setTimeout(() => {
        wrap.style.transform = "translateY(0)";
        wrap.style.opacity = "1";
        const played = video.play();
        if (played && typeof played.catch === "function") {
          played.catch(() => wrap.remove());
        }
      }, 800);
    })();
  </script>
</MockupLayout>
