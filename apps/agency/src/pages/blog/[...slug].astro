---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BackNav from "../../components/BackNav.astro";
import SimpleFooter from "../../components/SimpleFooter.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;

const SITE = "https://agency.alisamadii.com";
const pageUrl = `${SITE}/blog/${post.id}`;

// Reading time from the raw markdown body (~200 wpm).
const words = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(words / 200));

const dateFmt = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE}/blog` },
      { "@type": "ListItem", position: 3, name: data.title, item: pageUrl },
    ],
  },
  {
    "@type": "BlogPosting",
    "@id": `${pageUrl}#post`,
    headline: data.title,
    description: data.description,
    image: `${SITE}${data.heroImage}`,
    datePublished: data.publishDate.toISOString(),
    dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
    author: { "@id": `${SITE}/#person-ali` },
    publisher: { "@id": `${SITE}/#organization` },
    mainEntityOfPage: pageUrl,
    keywords: data.keyword,
  },
];
---

<Layout
  title={`${data.title} — Ali Samadi Agency`}
  description={data.description}
  canonical={pageUrl}
  og={{
    title: data.title,
    description: data.description,
    url: pageUrl,
    twitterDescription: data.description,
    image: data.heroImage,
  }}
  schema={schema}
  bodyClass="noise bg-cream text-charcoal selection:bg-accent/20 selection:text-accent font-sans"
>
  <BackNav backHref="/blog" backLabel="All Posts" fixed />

  <article class="px-4 pt-32 pb-16 md:px-8 md:pt-40 md:pb-20">
    <div class="mx-auto max-w-[760px]">
      <!-- Meta -->
      <div
        class="text-muted mb-6 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[12.5px] tracking-[0.08em] uppercase"
      >
        <time datetime={data.publishDate.toISOString()}
          >{dateFmt(data.publishDate)}</time
        >
        <span class="text-accent">&middot;</span>
        <span>{readingTime} min read</span>
      </div>

      <h1
        class="text-[clamp(30px,4.4vw,52px)] leading-[1.08] font-semibold tracking-[-0.03em]"
      >
        {data.title}
      </h1>
      <p class="text-warmgray mt-5 text-[18px] leading-[1.55]">
        {data.description}
      </p>
    </div>

    <!-- Hero image -->
    <figure class="mx-auto mt-10 max-w-[980px]">
      <div
        class="border-charcoal/[0.08] aspect-[16/9] overflow-hidden rounded-[20px] border"
      >
        <img
          src={data.heroImage}
          alt={data.heroImageAlt}
          width="1600"
          height="900"
          class="h-full w-full object-cover"
          fetchpriority="high"
        />
      </div>
      {
        data.heroCredit && (
          <figcaption class="text-muted mt-2 text-right text-[11.5px]">
            Photo by{" "}
            <a
              href={data.heroCredit.url}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-charcoal underline underline-offset-2"
            >
              {data.heroCredit.name}
            </a>{" "}
            on{" "}
            <a
              href={data.heroCredit.pexelsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-charcoal underline underline-offset-2"
            >
              Pexels
            </a>
          </figcaption>
        )
      }
    </figure>

    <!-- Body -->
    <div class="prose mx-auto mt-12 max-w-[760px]">
      <Content />
    </div>

    <!-- Tags -->
    {
      data.tags.length > 0 && (
        <div class="mx-auto mt-12 flex max-w-[760px] flex-wrap gap-2">
          {data.tags.map((tag) => (
            <span class="bg-charcoal/5 text-warmgray rounded-full px-3 py-1 font-mono text-[11.5px] tracking-[0.06em] uppercase">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </article>

  <!-- CTA -->
  <section
    class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[70px] md:px-10"
  >
    <div class="bg-ink text-cream rounded-[22px] p-9 text-center md:p-14">
      <h2
        class="text-[clamp(26px,3.2vw,42px)] leading-[1.1] font-semibold tracking-[-0.03em]"
      >
        Want a website built this way?
      </h2>
      <p
        class="text-cream/70 mx-auto mt-4 max-w-[46ch] text-[15.5px] leading-[1.6]"
      >
        Simple, transparent pricing — and a real person on the other end. Simple
        sites ship in one day once your project is confirmed.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/pricing"
          class="mag-btn bg-accent hover:bg-cream hover:text-charcoal inline-flex items-center gap-2 rounded-full px-6 py-3.5 text-[15px] font-medium text-white transition-all duration-300"
        >
          See pricing
        </a>
        <a
          href="/#contact"
          class="text-cream/80 hover:text-cream inline-flex min-h-11 items-center text-[15px] font-medium transition-colors duration-300"
          >Start a project</a
        >
      </div>
    </div>
  </section>

  <SimpleFooter />
</Layout>

<style is:global>
  html {
    scrollbar-gutter: stable;
  }
  .mag-btn {
    transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .mag-btn:active {
    transform: scale(0.97);
  }
</style>
