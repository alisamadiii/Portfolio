---
// Blog list — migrated to the mockup design system (MockupLayout). Cards reuse
// the work.astro lift-card pattern. Content query, sorting, and schema kept.
import { getCollection } from "astro:content";
import MockupLayout from "../../layouts/MockupLayout.astro";

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/blog`;

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const dateFmt = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: pageUrl },
    ],
  },
  {
    "@type": "Blog",
    "@id": `${pageUrl}#blog`,
    name: "Ali Samadi Agency Blog",
    url: pageUrl,
    publisher: { "@id": `${SITE}/#organization` },
    blogPost: posts.map((p) => ({
      "@type": "BlogPosting",
      headline: p.data.title,
      url: `${SITE}/blog/${p.id}`,
      datePublished: p.data.publishDate.toISOString(),
    })),
  },
];
---

<MockupLayout
  title="Blog — Web Design, Development & SEO Tips | Ali Samadi"
  description="Practical articles on how websites get built — design process, development, SEO, and managing your own site — from Ali Samadi Agency."
  canonical={pageUrl}
  og={{
    title: "Blog — Ali Samadi Agency",
    description:
      "Practical articles on how websites get built — design, development, SEO, and managing your own site.",
    url: pageUrl,
    twitterDescription:
      "How websites get built — design, development, SEO, and managing your own site.",
  }}
  schema={schema}
  pageType="CollectionPage"
>
  <main id="top">
    <!-- Hero -->
    <section style="padding: 140px 0 48px;">
      <div class="wrap" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:22px;">
        <p class="eyebrow"><span></span>Blog</p>
        <h1 class="hero-h1" style="margin:0;max-width:18ch;font-size:clamp(40px,6vw,76px);line-height:1.02;font-weight:600;letter-spacing:-0.035em;">
          Notes on building <span style="color:rgb(194,69,31);font-style:italic;">better websites</span>
        </h1>
        <p style="margin:0;max-width:60ch;font-size:clamp(17px,1.6vw,20px);line-height:1.55;color:rgb(103,98,90);">
          How websites actually get built — process, development, SEO, and how
          to run your own site once it's live. Written from real projects, no
          fluff.
        </p>
      </div>
    </section>

    <!-- Posts -->
    <section style="padding: 48px 0 72px; border-top: 1px solid rgba(27,26,23,0.06);">
      <div class="wrap">
        {
          posts.length === 0 ? (
            <p style="margin:0;font-size:16px;color:rgb(103,98,90);">
              No posts yet — check back soon.
            </p>
          ) : (
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:24px;">
              {posts.map((post) => (
                <a
                  href={`/blog/${post.id}`}
                  class="lift"
                  style="text-decoration:none;color:rgb(27,26,23);padding:6px;border-radius:18px;background:rgba(27,26,23,0.03);box-shadow:rgba(27,26,23,0.04) 0px 0px 0px 1px, rgba(27,26,23,0.1) 0px 14px 34px;display:flex;"
                >
                  <div style="flex:1 1 0%;border-radius:14px;background:rgb(255,254,252);padding:8px 8px 24px;display:flex;flex-direction:column;gap:20px;">
                    <div class="zoom" style="border-radius:10px;overflow:hidden;">
                      <img
                        src={post.data.heroImage}
                        alt={post.data.heroImageAlt}
                        width="1600"
                        height="900"
                        loading="lazy"
                        class="zi"
                        style="aspect-ratio:16/9;width:100%;height:100%;object-fit:cover;display:block;"
                      />
                    </div>
                    <div style="padding:0 16px;display:flex;flex-direction:column;gap:8px;">
                      <p class="mono" style="margin:0;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:rgb(107,102,93);">
                        {dateFmt(post.data.publishDate)}
                      </p>
                      <h2 style="margin:0;font-size:22px;line-height:1.25;font-weight:600;letter-spacing:-0.02em;">
                        {post.data.title}{" "}
                        <span aria-hidden="true" style="color:rgb(133,128,117);">
                          ↗
                        </span>
                      </h2>
                      <p style="margin:0;font-size:15px;line-height:1.55;color:rgb(103,98,90);">
                        {post.data.description}
                      </p>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </section>
  </main>
</MockupLayout>
