---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BackNav from "../../components/BackNav.astro";
import SimpleFooter from "../../components/SimpleFooter.astro";

const SITE = "https://agency.alisamadii.com";
const pageUrl = `${SITE}/blog`;

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const dateFmt = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: pageUrl },
    ],
  },
  {
    "@type": "Blog",
    "@id": `${pageUrl}#blog`,
    name: "Ali Samadi Agency Blog",
    url: pageUrl,
    publisher: { "@id": `${SITE}/#organization` },
    blogPost: posts.map((p) => ({
      "@type": "BlogPosting",
      headline: p.data.title,
      url: `${SITE}/blog/${p.id}`,
      datePublished: p.data.publishDate.toISOString(),
    })),
  },
];
---

<Layout
  title="Blog — Web Design, Development & SEO Tips | Ali Samadi Agency"
  description="Practical articles on how websites get built — design process, development, SEO, and managing your own site — from Ali Samadi Agency."
  canonical={pageUrl}
  og={{
    title: "Blog — Ali Samadi Agency",
    description:
      "Practical articles on how websites get built — design, development, SEO, and managing your own site.",
    url: pageUrl,
    twitterDescription:
      "How websites get built — design, development, SEO, and managing your own site.",
  }}
  schema={schema}
  bodyClass="noise bg-cream text-charcoal selection:bg-accent/20 selection:text-accent font-sans"
>
  <BackNav backHref="/" backLabel="Back to Home" fixed />

  <section class="px-4 pt-32 pb-16 md:px-8 md:pt-40 md:pb-20">
    <div class="mx-auto max-w-[1200px]">
      <div
        class="text-muted mb-6 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] uppercase"
      >
        <span class="bg-accent h-px w-[26px]"></span>Blog
      </div>
      <h1
        class="text-[clamp(38px,5.5vw,72px)] leading-[1.02] font-semibold tracking-[-0.035em]"
      >
        Notes on building <span class="text-accent">better websites</span>
      </h1>
      <p
        class="text-warmgray mt-6 max-w-[58ch] text-[17px] leading-[1.6] md:text-[18px]"
      >
        How websites actually get built — process, development, SEO, and how to
        run your own site once it's live. Written from real projects, no fluff.
      </p>
    </div>
  </section>

  <section
    class="border-charcoal/[0.08] mx-auto max-w-[1200px] border-t px-6 py-[70px] md:px-10"
  >
    {
      posts.length === 0 ? (
        <p class="text-warmgray">No posts yet — check back soon.</p>
      ) : (
        <div class="grid grid-cols-1 gap-[22px] md:grid-cols-2">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="img-wrap border-charcoal/[0.08] group block overflow-hidden rounded-[18px] border bg-white"
            >
              <div class="aspect-[16/9] overflow-hidden">
                <img
                  src={post.data.heroImage}
                  alt={post.data.heroImageAlt}
                  width="1600"
                  height="900"
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="p-7">
                <div class="text-muted font-mono text-[11.5px] tracking-[0.08em] uppercase">
                  {dateFmt(post.data.publishDate)}
                </div>
                <div class="mt-2.5 flex items-start justify-between gap-4">
                  <h2 class="text-[22px] leading-[1.2] font-semibold tracking-[-0.02em]">
                    {post.data.title}
                  </h2>
                  <span class="text-accent shrink-0">&#8599;</span>
                </div>
                <p class="text-warmgray mt-2.5 text-[14.5px] leading-[1.6]">
                  {post.data.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </section>

  <SimpleFooter />
</Layout>

<style is:global>
  html {
    scrollbar-gutter: stable;
  }
</style>
