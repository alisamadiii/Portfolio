---
import Layout from "../layouts/Layout.astro";
import BackNav from "../components/BackNav.astro";
import HomeFooter from "../components/HomeFooter.astro";
import Testimonial from "../components/Testimonial.astro";
import { PROJECTS, CLIENT_PROJECTS, CONCEPT_PROJECTS } from "../data/projects";

const SITE = "https://agency.alisamadii.com";
const pageUrl = `${SITE}/work`;

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Work", item: pageUrl },
    ],
  },
  {
    "@type": "ItemList",
    "@id": `${pageUrl}#projects`,
    name: "Projects",
    itemListElement: PROJECTS.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: p.name,
      url: p.url,
    })),
  },
];
---

<Layout
  title="Our Work — Client Websites & Concept Projects | Ali Samadi Agency"
  description="Live websites we've built for real clients — nonprofits, contractors, and personal brands — plus concept projects that show what we can do. All custom-coded."
  canonical={pageUrl}
  og={{
    title: "Our Work — Ali Samadi Agency",
    description:
      "Live websites built for real clients plus concept projects that show what we can do. All custom-coded, no templates.",
    url: pageUrl,
    twitterDescription:
      "Live client websites and concept projects — all custom-coded, no templates.",
  }}
  schema={schema}
  pageType="CollectionPage"
  bodyClass="noise bg-cream text-charcoal selection:bg-accent/20 selection:text-accent font-sans"
>
  <BackNav backHref="/" backLabel="Back to Home" fixed />

  <!-- ==================== HERO ==================== -->
  <section class="px-4 pt-32 pb-16 md:px-8 md:pt-40 md:pb-20">
    <div class="mx-auto max-w-[1200px]">
      <div
        class="mb-6 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] text-muted uppercase"
      >
        <span class="h-px w-[26px] bg-accent"></span>Our Work
      </div>
      <h1
        class="text-[clamp(38px,5.5vw,72px)] leading-[1.02] font-semibold tracking-[-0.035em]"
      >
        Work that's <span class="text-accent">live</span> and in use
      </h1>
      <p
        class="mt-6 max-w-[58ch] text-[17px] leading-[1.6] text-warmgray md:text-[18px]"
      >
        Real websites we've designed and built for real businesses, plus concept
        projects that show our range. Every one is custom-coded from scratch —
        no templates, no page builders.
      </p>
    </div>
  </section>

  <!-- ==================== FAST-TRACK BANNER ==================== -->
  <section class="px-4 pb-16 md:px-8 md:pb-20">
    <div
      class="reveal mx-auto max-w-[1200px] rounded-[22px] bg-accent px-7 py-12 text-cream md:px-14 md:py-16"
    >
      <div
        class="mb-5 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] text-cream/80 uppercase"
      >
        <span class="h-px w-[26px] bg-cream"></span>Fast Track
      </div>
      <h2
        class="max-w-[24ch] text-[clamp(28px,3.8vw,52px)] leading-[1.08] font-semibold tracking-[-0.03em]"
      >
        Small business? Skip the process.
      </h2>
      <p
        class="mt-5 max-w-[62ch] text-[16px] leading-[1.65] text-cream/90 md:text-[17px]"
      >
        If you're a small business looking for a fast landing page with a great
        design, we don't need to go through all four steps &mdash; Discovery,
        Strategy, Execution, Launch. Tell us what you do, and we'll ship a
        clean, custom-coded page fast.
      </p>
      <a
        href="/pricing"
        class="mag-btn mt-8 inline-flex items-center gap-2 rounded-full bg-charcoal px-6 py-3.5 text-[15px] font-medium text-cream transition-all duration-300 hover:bg-cream hover:text-charcoal"
      >
        Get a fast landing page
        <span>&#8599;</span>
      </a>
    </div>
  </section>

  <!-- ==================== CLIENT WORK ==================== -->
  <section
    class="mx-auto max-w-[1200px] border-t border-charcoal/[0.08] px-6 py-[70px] md:px-10"
  >
    <div
      class="mb-11 grid grid-cols-1 items-end gap-10 md:grid-cols-[1.1fr_1fr] md:gap-12"
    >
      <h2
        class="reveal text-[clamp(30px,3.6vw,48px)] leading-[1.08] font-semibold tracking-[-0.03em]"
      >
        Real projects, real clients
      </h2>
      <p class="reveal text-[15.5px] leading-[1.6] text-warmgray">
        A selection of live websites we've designed and built for real
        businesses &mdash; each one shipped, launched, and in use today.
      </p>
    </div>

    <div class="stagger grid grid-cols-1 gap-[22px] md:grid-cols-3">
      {
        CLIENT_PROJECTS.map((project) => (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="reveal img-wrap group block overflow-hidden rounded-[18px] border border-charcoal/[0.08] bg-white"
          >
            <div class="aspect-[16/10] overflow-hidden">
              <img
                src={project.image!.src}
                alt={project.image!.alt}
                width="1120"
                height="700"
                class="h-full w-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <div class="font-mono text-[11.5px] tracking-[0.08em] text-[#a49d94] uppercase">
                {project.category}
              </div>
              <div class="mt-2.5 flex items-center justify-between gap-4">
                <h3 class="text-[19px] font-semibold tracking-[-0.02em]">
                  {project.name}
                </h3>
                <span class="text-accent">&#8599;</span>
              </div>
              <p class="mt-2 text-[14.5px] leading-[1.55] text-warmgray">
                {project.description}
              </p>
            </div>
          </a>
        ))
      }
    </div>

    <Testimonial />
  </section>

  <!-- ==================== CONCEPT PROJECTS ==================== -->
  <section
    class="mx-auto max-w-[1200px] border-t border-charcoal/[0.08] px-6 py-[70px] md:px-10"
  >
    <div
      class="mb-11 grid grid-cols-1 items-end gap-10 md:grid-cols-[1.1fr_1fr] md:gap-12"
    >
      <h2
        class="reveal text-[clamp(30px,3.6vw,48px)] leading-[1.08] font-semibold tracking-[-0.03em]"
      >
        Concept projects
      </h2>
      <div class="reveal">
        <p class="text-[15.5px] leading-[1.6] text-warmgray">
          Every project is built from scratch — no templates, no shortcuts.
          These mock-ups showcase our capabilities; your project will be fully
          custom to your brand and goals.
        </p>
        <div
          class="mt-5 inline-flex items-center gap-3 rounded-full border border-emerald-200/60 bg-emerald-50 px-4 py-2"
        >
          <svg
            class="size-4 shrink-0 text-emerald-600"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"
            ></path>
          </svg>
          <span class="text-[13.5px] font-medium text-emerald-800"
            >1-Day Delivery</span
          >
          <span class="font-mono text-[11.5px] text-emerald-600/80"
            >concept &rarr; launch</span
          >
        </div>
      </div>
    </div>

    <div class="stagger grid grid-cols-1 gap-[22px] md:grid-cols-2">
      {
        CONCEPT_PROJECTS.map((project) => (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="reveal img-wrap group block overflow-hidden rounded-[18px] border border-charcoal/[0.08] bg-white"
          >
            <div class="aspect-[16/10] overflow-hidden">
              <img
                src={project.image!.src}
                alt={project.image!.alt}
                width="1120"
                height="700"
                class="h-full w-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <div class="font-mono text-[11.5px] tracking-[0.08em] text-[#a49d94] uppercase">
                {project.category}
              </div>
              <div class="mt-2.5 flex items-center justify-between gap-4">
                <h3 class="text-[22px] font-semibold tracking-[-0.02em]">
                  {project.name}
                </h3>
                <span class="text-accent">&#8599;</span>
              </div>
              <p class="mt-2 text-[14.5px] leading-[1.55] text-warmgray">
                {project.description}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ==================== CTA ==================== -->
  <section
    class="mx-auto max-w-[1200px] border-t border-charcoal/[0.08] px-6 py-[70px] text-center md:px-10"
  >
    <h2
      class="reveal text-[clamp(28px,3.2vw,42px)] leading-[1.1] font-semibold tracking-[-0.03em]"
    >
      Want a site like these?
    </h2>
    <div class="reveal mt-8 flex flex-wrap justify-center gap-3.5">
      <a
        href="/pricing"
        class="mag-btn inline-flex items-center gap-2 rounded-full bg-charcoal px-6 py-3.5 text-[15px] font-medium text-cream transition-all duration-300 hover:bg-accent"
      >
        View pricing
        <span>&#8599;</span>
      </a>
      <a
        href="/contact"
        class="mag-btn inline-flex items-center rounded-full border border-charcoal/[0.16] px-6 py-3.5 text-[15px] font-medium hover:border-accent hover:text-accent"
      >
        Get in touch
      </a>
    </div>
  </section>

  <HomeFooter />
</Layout>

<style is:global>
  html {
    scrollbar-gutter: stable;
  }
  .mag-btn {
    transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .mag-btn:active {
    transform: scale(0.97);
  }
  .img-wrap img {
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .img-wrap:hover img {
    transform: scale(1.04);
  }
</style>

<script is:inline data-astro-rerun>
  (() => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "-60px" }
    );
    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
  })();
</script>
