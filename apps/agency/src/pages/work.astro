---
// Work — built in the mockup design system (MockupLayout), reusing the home
// client-work card pattern. Projects come from src/data/projects.ts.
import MockupLayout from "../layouts/MockupLayout.astro";
import { PROJECTS, CLIENT_PROJECTS, CONCEPT_PROJECTS } from "../data/projects";
import CTA from "../html/blocks/cta.html?raw";

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/work`;

const schema = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Work", item: pageUrl },
    ],
  },
  {
    "@type": "ItemList",
    "@id": `${pageUrl}#projects`,
    itemListElement: PROJECTS.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: p.name,
      url: p.url,
    })),
  },
];
---

<MockupLayout
  title="Our Work — Client Websites & Concept Projects | Ali Samadi"
  description="Live websites we've built for real clients — nonprofits, contractors, and personal brands — plus concepts that show what we can do. All custom-coded."
  canonical={pageUrl}
  og={{
    title: "Our Work — Ali Samadi Agency",
    description:
      "Live websites built for real clients plus concept projects that show what we can do. All custom-coded, no templates.",
    url: pageUrl,
    twitterDescription:
      "Live client websites and concept projects — all custom-coded, no templates.",
  }}
  schema={schema}
  pageType="CollectionPage"
>
  <main id="top">
    <!-- Hero -->
    <section style="padding: 140px 0 48px;">
      <div class="wrap" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:22px;">
        <p class="eyebrow"><span></span>Our work</p>
        <h1 class="hero-h1" style="margin:0;max-width:17ch;font-size:clamp(40px,6vw,76px);line-height:1.02;font-weight:600;letter-spacing:-0.035em;">
          Real projects, <span style="color:rgb(194,69,31);font-style:italic;">real clients</span>
        </h1>
        <p style="margin:0;max-width:60ch;font-size:clamp(17px,1.6vw,20px);line-height:1.55;color:rgb(103,98,90);">
          Live websites we've designed and built for real businesses, plus
          concept builds that show what we can do. Every one custom-coded, no
          templates.
        </p>
        <a href="/quote" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:10px;min-height:52px;padding:0 26px;border-radius:11px;background:rgb(252,132,100);color:rgb(27,26,23);font-size:16px;font-weight:500;text-decoration:none;box-shadow:rgba(252,132,100,0.32) 0px 8px 24px;margin-top:8px;">Start a Project <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <!-- Live client work -->
    <section style="padding: 48px 0 24px; border-top: 1px solid rgba(27,26,23,0.06);">
      <div class="wrap" style="display:flex;flex-direction:column;gap:40px;">
        <div style="display:flex;flex-direction:column;gap:16px;max-width:640px;">
          <p class="eyebrow"><span></span>Client work</p>
          <h2 style="margin:0;font-size:clamp(30px,3.6vw,44px);line-height:1.08;font-weight:600;letter-spacing:-0.025em;">
            Live sites, shipped and in use
          </h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;">
          {
            CLIENT_PROJECTS.map((p) => (
              <a
                href={p.url}
                target="_blank"
                rel="noopener noreferrer"
                class="lift"
                style="text-decoration:none;color:rgb(27,26,23);padding:6px;border-radius:18px;background:rgba(27,26,23,0.03);box-shadow:rgba(27,26,23,0.04) 0px 0px 0px 1px, rgba(27,26,23,0.1) 0px 14px 34px;display:flex;"
              >
                <div style="flex:1 1 0%;border-radius:14px;background:rgb(255,254,252);padding:8px 8px 24px;display:flex;flex-direction:column;gap:20px;">
                  <div class="zoom" style="border-radius:10px;overflow:hidden;">
                    <img
                      src={p.image!.src}
                      alt={p.image!.alt}
                      width="1120"
                      height="840"
                      loading="lazy"
                      class="zi"
                      style="aspect-ratio:4/3;width:100%;height:100%;object-fit:cover;display:block;"
                    />
                  </div>
                  <div style="padding:0 16px;display:flex;flex-direction:column;gap:6px;">
                    <p class="mono" style="margin:0;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:rgb(107,102,93);">
                      {p.category}
                    </p>
                    <h3 style="margin:0;font-size:20px;line-height:1.4;font-weight:600;">
                      {p.name}{" "}
                      <span aria-hidden="true" style="color:rgb(133,128,117);">↗</span>
                    </h3>
                    <p style="margin:0;font-size:15px;line-height:1.55;color:rgb(103,98,90);">
                      {p.description}
                    </p>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Testimonial -->
    <section style="padding: 64px 0;">
      <div class="wrap">
        <figure style="margin:0;max-width:900px;margin-inline:auto;text-align:center;display:flex;flex-direction:column;gap:20px;align-items:center;">
          <p class="mono" style="margin:0;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:rgb(252,132,100);">★★★★★</p>
          <blockquote style="margin:0;font-size:clamp(20px,2.4vw,28px);line-height:1.4;font-weight:500;letter-spacing:-0.01em;">
            &ldquo;Ali did an amazing job creating our website. He paid
            attention to details and got us the website we wanted — professional,
            modern, and eye-catching. Highly recommend him!&rdquo;
          </blockquote>
          <figcaption class="mono" style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:rgb(107,102,93);">
            — Alitech
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Concept builds -->
    <section style="padding: 24px 0 48px; border-top: 1px solid rgba(27,26,23,0.06);">
      <div class="wrap" style="display:flex;flex-direction:column;gap:40px;">
        <div style="display:flex;flex-direction:column;gap:16px;max-width:640px;">
          <p class="eyebrow"><span></span>Concept builds</p>
          <h2 style="margin:0;font-size:clamp(30px,3.6vw,44px);line-height:1.08;font-weight:600;letter-spacing:-0.025em;">
            Demos that show the range
          </h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;">
          {
            CONCEPT_PROJECTS.map((p) => (
              <a
                href={p.url}
                target="_blank"
                rel="noopener noreferrer"
                class="lift"
                style="text-decoration:none;color:rgb(27,26,23);padding:6px;border-radius:18px;background:rgba(27,26,23,0.03);box-shadow:rgba(27,26,23,0.04) 0px 0px 0px 1px, rgba(27,26,23,0.1) 0px 14px 34px;display:flex;"
              >
                <div style="flex:1 1 0%;border-radius:14px;background:rgb(255,254,252);padding:8px 8px 24px;display:flex;flex-direction:column;gap:20px;">
                  <div class="zoom" style="border-radius:10px;overflow:hidden;">
                    <img
                      src={p.image!.src}
                      alt={p.image!.alt}
                      width="1120"
                      height="840"
                      loading="lazy"
                      class="zi"
                      style="aspect-ratio:4/3;width:100%;height:100%;object-fit:cover;display:block;"
                    />
                  </div>
                  <div style="padding:0 16px;display:flex;flex-direction:column;gap:6px;">
                    <p class="mono" style="margin:0;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:rgb(107,102,93);">
                      {p.category}
                    </p>
                    <h3 style="margin:0;font-size:20px;line-height:1.4;font-weight:600;">
                      {p.name}{" "}
                      <span aria-hidden="true" style="color:rgb(133,128,117);">↗</span>
                    </h3>
                    <p style="margin:0;font-size:15px;line-height:1.55;color:rgb(103,98,90);">
                      {p.description}
                    </p>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Dark CTA -->
    <Fragment set:html={CTA} />
  </main>
</MockupLayout>
