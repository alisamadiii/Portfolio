---
import Layout from "../layouts/Layout.astro";
import BackNav from "../components/BackNav.astro";
import HomeFooter from "../components/HomeFooter.astro";

const SITE = "https://agency.alisamadii.com";
const pageUrl = `${SITE}/leave-a-review`;
const TRUSTPILOT_URL = "https://www.trustpilot.com/review/alisamadii.com";

const guidelines = [
  {
    title: "Write it yourself",
    text: "Your words, your tone. Two honest sentences beat five polished paragraphs. Short is completely fine.",
  },
  {
    title: "Be specific",
    text: "Mention what we actually built together — the website, the CMS, the email setup — how communication went, and what changed for your business.",
  },
  {
    title: "Be honest",
    text: "Include what could've been better, too. A balanced review is far more credible than five stars with no substance.",
  },
  {
    title: "Rate what you experienced",
    text: "There's no obligation to give five stars. Pick the rating that matches how the project actually felt.",
  },
  {
    title: "Keep it clean",
    text: "No personal contact details, no third-party names, no links or promo codes — Trustpilot removes reviews that include them.",
  },
];

const prompts = [
  "What problem did you come to me with?",
  "What was working together actually like?",
  "Was there anything that surprised you?",
  "What changed for your business after launch?",
  "Would you recommend me — and to whom?",
];

const steps = [
  {
    title: "Open Trustpilot",
    text: "Click the button below — it takes you straight to the review page for alisamadii.com.",
  },
  {
    title: "Sign in",
    text: "Use your Google account or email. Takes about thirty seconds if you don't have an account yet.",
  },
  {
    title: "Rate, write, publish",
    text: "Pick your stars, write a few honest sentences, and hit post. About three minutes total.",
  },
  {
    title: "Verify your identity",
    text: 'Trustpilot will ask you to verify your account with a photo ID — a quick check through their secure partner. Your review only counts once it\'s done, and it gets a "Verified" badge.',
  },
];
---

<Layout
  title="Leave a Review — Ali Samadi Agency"
  description="A short guide for clients on writing an honest, human review of our work together on Trustpilot."
  canonical={pageUrl}
  robots="noindex, nofollow"
  bodyClass="noise bg-cream text-charcoal selection:bg-accent/20 selection:text-accent font-sans"
>
  <BackNav backHref="/" backLabel="Back to Home" fixed />

  <!-- ==================== HERO ==================== -->
  <section class="px-4 pt-32 pb-16 md:px-8 md:pt-40 md:pb-20">
    <div class="mx-auto max-w-[1200px]">
      <div
        class="mb-6 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] text-muted uppercase"
      >
        <span class="h-px w-[26px] bg-accent"></span>For Clients
      </div>
      <h1
        class="text-[clamp(38px,5.5vw,72px)] leading-[1.02] font-semibold tracking-[-0.035em]"
      >
        Your honest words,<br />in <span class="text-accent"
          >your own voice</span
        >
      </h1>
      <p
        class="mt-6 max-w-[58ch] text-[17px] leading-[1.6] text-warmgray md:text-[18px]"
      >
        We just wrapped a project together — thank you. If you have three
        minutes, a review on Trustpilot genuinely helps this studio grow. This
        page explains how to write one that's actually useful, in your own
        words.
      </p>
    </div>
  </section>

  <!-- ==================== THE ONE BIG RULE ==================== -->
  <section
    class="mx-auto max-w-[1200px] border-t border-charcoal/[0.08] px-6 py-[70px] md:px-10"
  >
    <div
      class="reveal rounded-[22px] border border-accent/40 bg-white p-8 md:p-11"
    >
      <div
        class="mb-4 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] text-muted uppercase"
      >
        <span class="h-px w-[26px] bg-accent"></span>The one big rule
      </div>
      <h2
        class="max-w-[24ch] text-[clamp(24px,2.8vw,36px)] leading-[1.12] font-semibold tracking-[-0.03em]"
      >
        Please don't use AI to write your review
      </h2>
      <div
        class="mt-5 max-w-[62ch] space-y-4 text-[16px] leading-[1.65] text-warmgray"
      >
        <p>
          No ChatGPT, no "make this sound professional." AI-written reviews all
          read the same — generic, polished, and weightless — and Trustpilot
          actively flags and removes reviews that look machine-generated.
        </p>
        <p>
          One real, slightly imperfect sentence from you is worth more than any
          amount of polished filler. Typos are fine. Casual is fine.
          <span class="font-medium text-charcoal">Your voice is the point.</span
          >
        </p>
      </div>
    </div>
  </section>

  <!-- ==================== GUIDELINES ==================== -->
  <section
    class="mx-auto max-w-[1200px] border-t border-charcoal/[0.08] px-6 py-[70px] md:px-10"
  >
    <h2
      class="reveal mb-10 text-[clamp(28px,3.2vw,42px)] leading-[1.1] font-semibold tracking-[-0.03em]"
    >
      What makes a great review
    </h2>
    <div
      class="stagger grid grid-cols-1 gap-[22px] md:grid-cols-2 lg:grid-cols-3"
    >
      {
        guidelines.map((g, i) => (
          <div class="reveal rounded-[18px] border border-charcoal/[0.08] bg-white p-6">
            <div class="font-mono text-[13px] tracking-[0.08em] text-accent">
              0{i + 1}
            </div>
            <h3 class="mt-3 text-[18px] font-semibold tracking-[-0.02em]">
              {g.title}
            </h3>
            <p class="mt-2 text-[14.5px] leading-[1.6] text-warmgray">
              {g.text}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ==================== PROMPTS ==================== -->
  <section
    class="mx-auto max-w-[1200px] border-t border-charcoal/[0.08] px-6 py-[70px] md:px-10"
  >
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1fr_1.4fr] md:gap-14">
      <div>
        <h2
          class="reveal text-[clamp(28px,3.2vw,42px)] leading-[1.1] font-semibold tracking-[-0.03em]"
        >
          Not sure what to write?
        </h2>
        <p class="reveal mt-4 text-[15.5px] leading-[1.6] text-warmgray">
          Answer two or three of these in plain sentences and the review writes
          itself.
        </p>
      </div>
      <ul class="stagger space-y-3.5">
        {
          prompts.map((q, i) => (
            <li class="reveal flex items-baseline gap-4 rounded-[14px] border border-charcoal/[0.08] bg-white px-5 py-4">
              <span class="font-mono text-[12.5px] tracking-[0.08em] text-accent">
                0{i + 1}
              </span>
              <span class="text-[15.5px] leading-[1.55]">{q}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ==================== HOW IT WORKS ==================== -->
  <section
    class="mx-auto max-w-[1200px] border-t border-charcoal/[0.08] px-6 py-[70px] md:px-10"
  >
    <h2
      class="reveal mb-10 text-[clamp(28px,3.2vw,42px)] leading-[1.1] font-semibold tracking-[-0.03em]"
    >
      How it works
    </h2>
    <div
      class="stagger grid grid-cols-1 gap-[22px] md:grid-cols-2 lg:grid-cols-4"
    >
      {
        steps.map((step, i) => (
          <div class="reveal rounded-[18px] border border-charcoal/[0.08] bg-white p-6">
            <div class="font-mono text-[13px] tracking-[0.08em] text-accent">
              0{i + 1}
            </div>
            <h3 class="mt-3 text-[18px] font-semibold tracking-[-0.02em]">
              {step.title}
            </h3>
            <p class="mt-2 text-[14.5px] leading-[1.6] text-warmgray">
              {step.text}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ==================== CTA ==================== -->
  <section
    class="mx-auto max-w-[1200px] border-t border-charcoal/[0.08] px-6 py-[70px] text-center md:px-10"
  >
    <h2
      class="reveal text-[clamp(28px,3.2vw,42px)] leading-[1.1] font-semibold tracking-[-0.03em]"
    >
      Ready when you are
    </h2>
    <p
      class="reveal mx-auto mt-4 max-w-[48ch] text-[16px] leading-[1.6] text-warmgray"
    >
      Three minutes, a few honest sentences — that's all it takes.
    </p>
    <div class="reveal mt-8 flex flex-wrap justify-center gap-3.5">
      <a
        href={TRUSTPILOT_URL}
        target="_blank"
        rel="noopener"
        class="mag-btn inline-flex items-center gap-2 rounded-full bg-charcoal px-6 py-3.5 text-[15px] font-medium text-cream transition-all duration-300 hover:bg-accent"
      >
        Leave a review on Trustpilot
        <span>&#8599;</span>
      </a>
      <a
        href="/contact"
        class="mag-btn inline-flex items-center rounded-full border border-charcoal/[0.16] px-6 py-3.5 text-[15px] font-medium hover:border-accent hover:text-accent"
      >
        Prefer to tell me directly first?
      </a>
    </div>
  </section>

  <HomeFooter />
</Layout>

<style is:global>
  html {
    scrollbar-gutter: stable;
  }
  .mag-btn {
    transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .mag-btn:active {
    transform: scale(0.97);
  }
</style>

<script is:inline data-astro-rerun>
  (() => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "-60px" }
    );
    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
  })();
</script>
