---
// Client review page — share this link with clients after a project. Guides
// them to write a genuine, specific Google review in their own words (no AI),
// then sends them to the Google "write a review" link. Not indexed.
import MockupLayout from "../layouts/MockupLayout.astro";

// ⚠️ REPLACE with your Google "write a review" link once the Business Profile
// listing is live. From Google Business Profile → "Ask for reviews" → copy the
// short link, which looks like https://g.page/r/XXXXXXXX/review  (or the long
// form https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID).
const REVIEW_URL = "https://g.page/r/REPLACE_WITH_YOUR_PLACE_ID/review";

const SITE = "https://www.alisamadii.com";
const pageUrl = `${SITE}/review`;

const tips = [
  {
    n: "01",
    title: "Say what we built",
    text: "Name the actual project: a new website, a Shopify storefront, a redesign, a web app. A specific “what” makes the review real.",
  },
  {
    n: "02",
    title: "Share what changed",
    text: "What is better now? More calls, a faster site, something that finally works, time saved. One concrete result says more than ten adjectives.",
  },
  {
    n: "03",
    title: "Add one real detail",
    text: "The part that stood out to you: the speed, the communication, a feature you love, how easy it was to get started. Small details read as honest.",
  },
  {
    n: "04",
    title: "Keep it in your own words",
    text: "A few plain, honest sentences beat anything polished. Please skip AI tools and templates. People can tell, and your real voice is what helps most.",
  },
];

const prompts = [
  "What did we build for you, and why did you reach out?",
  "What was the biggest problem it solved?",
  "What was working together actually like?",
  "Would you recommend us, and to what kind of business?",
];
---

<MockupLayout
  title="Leave a Review — Ali Samadi Agency"
  description="Thanks for working with us. Here is a quick guide to writing a genuine Google review in your own words."
  canonical={pageUrl}
  robots="noindex, nofollow"
>
  <main id="top">
    <!-- Hero -->
    <section style="padding: 140px 0 32px;">
      <div class="wrap" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:22px;">
        <p class="eyebrow"><span></span>Thank you</p>
        <h1 class="hero-h1" style="margin:0;max-width:17ch;font-size:clamp(40px,6vw,76px);line-height:1.02;font-weight:600;letter-spacing:-0.035em;">
          Would you leave us a <span style="color:rgb(194,69,31);font-style:italic;">quick review?</span>
        </h1>
        <p style="margin:0;max-width:58ch;font-size:clamp(17px,1.6vw,20px);line-height:1.55;color:rgb(103,98,90);">
          It takes about two minutes and it genuinely helps a small studio like
          ours get found by the next business that needs a site. Below is a short
          guide so it is easy to write, and sounds like you.
        </p>
        <a href={REVIEW_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:10px;min-height:52px;padding:0 26px;border-radius:11px;background:rgb(252,132,100);color:rgb(27,26,23);font-size:16px;font-weight:500;text-decoration:none;box-shadow:rgba(252,132,100,0.32) 0px 8px 24px;margin-top:8px;">
          Write your review on Google <span aria-hidden="true">↗</span>
        </a>
        <p class="mono" style="margin:0;font-size:12px;letter-spacing:0.06em;text-transform:uppercase;color:rgb(107,102,93);">
          Opens Google in a new tab
        </p>
      </div>
    </section>

    <!-- Warning -->
    <section style="padding: 16px 0 8px;">
      <div class="wrap">
        <div style="max-width:880px;margin-inline:auto;display:flex;gap:18px;align-items:flex-start;padding:24px 26px;border-radius:18px;background:rgba(252,132,100,0.09);box-shadow:inset 0 0 0 1.5px rgba(252,132,100,0.55);">
          <span aria-hidden="true" style="flex:0 0 auto;width:44px;height:44px;border-radius:12px;background:rgb(252,132,100);color:rgb(27,26,23);display:flex;align-items:center;justify-content:center;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
          </span>
          <div style="display:flex;flex-direction:column;gap:10px;">
            <p class="mono" style="margin:0;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:rgb(194,69,31);">Please read this first</p>
            <h2 style="margin:0;font-size:clamp(21px,2.4vw,26px);font-weight:600;letter-spacing:-0.015em;">
              Please do not use AI to write your review
            </h2>
            <p style="margin:0;font-size:16px;line-height:1.65;color:rgb(74,70,63);">
              This is the one real ask. A short review in your own words is worth
              far more than anything a chatbot writes. AI reviews all sound the
              same, Google can flag them as fake and remove them, and other
              business owners can spot them instantly. We would genuinely rather
              have three honest sentences from you than a perfect paragraph from
              a machine.
            </p>
            <p style="margin:0;font-size:15px;line-height:1.6;color:rgb(103,98,90);">
              No pressure on length, grammar, or polish. Just tell the truth in
              your own voice. That is the kind of review that actually helps, and
              the only kind we want.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Tips -->
    <section style="padding: 56px 0; border-top: 1px solid rgba(27,26,23,0.06);">
      <div class="wrap" style="display:flex;flex-direction:column;gap:40px;">
        <div style="display:flex;flex-direction:column;gap:16px;max-width:640px;">
          <p class="eyebrow"><span></span>How to write it</p>
          <h2 style="margin:0;font-size:clamp(30px,3.6vw,44px);line-height:1.08;font-weight:600;letter-spacing:-0.025em;">
            What makes a review land
          </h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;">
          {
            tips.map((t) => (
              <div class="lift" style="padding:6px;border-radius:18px;background:rgba(27,26,23,0.03);box-shadow:rgba(27,26,23,0.04) 0px 0px 0px 1px, rgba(27,26,23,0.1) 0px 14px 34px;display:flex;">
                <div style="flex:1 1 0%;border-radius:14px;background:rgb(255,254,252);padding:24px;display:flex;flex-direction:column;gap:10px;">
                  <span class="mono" style="font-size:12.5px;letter-spacing:0.12em;color:rgb(194,69,31);">{t.n}</span>
                  <h3 style="margin:0;font-size:19px;font-weight:600;letter-spacing:-0.01em;">{t.title}</h3>
                  <p style="margin:0;font-size:15px;line-height:1.6;color:rgb(103,98,90);">{t.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Prompts -->
    <section style="padding: 56px 0;">
      <div class="wrap" style="display:grid;grid-template-columns:1fr;gap:28px;max-width:860px;">
        <div style="display:flex;flex-direction:column;gap:14px;">
          <p class="eyebrow"><span></span>Not sure where to start</p>
          <h2 style="margin:0;font-size:clamp(26px,3vw,38px);line-height:1.1;font-weight:600;letter-spacing:-0.025em;">
            Answer any one of these in a sentence or two
          </h2>
        </div>
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;">
          {
            prompts.map((p) => (
              <li style="display:flex;gap:12px;align-items:flex-start;font-size:17px;line-height:1.5;color:rgb(27,26,23);">
                <span aria-hidden="true" style="color:rgb(252,132,100);font-weight:600;">&#8594;</span>
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
        <p style="margin:0;font-size:15px;line-height:1.6;color:rgb(103,98,90);">
          There is no wrong answer and no length to hit. Three honest sentences
          are perfect. Please write it yourself rather than using an AI tool, so
          it reads like a real person, because that is exactly what helps.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section id="contact" class="dark" style="margin: 24px 12px; border-radius: 26px; padding: 64px clamp(20px,5vw,56px); background: rgb(23,21,18); color: rgb(246,245,243);">
      <div style="max-width:1100px;margin-inline:auto;display:flex;flex-direction:column;gap:20px;">
        <p class="eyebrow" style="color:rgb(201,160,141);"><span></span>Ready</p>
        <h2 style="margin:0;max-width:18ch;font-size:clamp(34px,5vw,64px);line-height:1.04;font-weight:600;letter-spacing:-0.03em;">
          Thank you, truly.
        </h2>
        <p style="margin:0;max-width:52ch;font-size:17px;line-height:1.55;color:rgb(184,178,169);">
          Your review means a lot. If anything about your site needs attention,
          reply to our last email or reach us any time and we will handle it.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:8px;">
          <a href={REVIEW_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:10px;min-height:52px;padding:0 26px;border-radius:11px;background:rgb(252,132,100);color:rgb(27,26,23);font-size:16px;font-weight:500;text-decoration:none;">
            Write your review on Google <span aria-hidden="true">↗</span>
          </a>
          <a href="mailto:agency@alisamadii.com" class="btn" style="display:inline-flex;align-items:center;gap:8px;min-height:52px;padding:0 22px;border-radius:11px;background:rgba(246,245,243,0.08);color:rgb(246,245,243);font-size:15px;font-weight:500;text-decoration:none;">
            Email us instead
          </a>
        </div>
      </div>
    </section>
  </main>
</MockupLayout>
