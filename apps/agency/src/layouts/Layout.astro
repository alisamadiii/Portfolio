---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Analytics from "../components/Analytics.astro";

import SearchPalette from "../components/SearchPalette.astro";

interface Props {
  title: string;
  description: string;
  robots?: string;
  canonical?: string;
  /** Rendered only when set — onboarding has no OG/Twitter block. */
  og?: {
    title: string;
    description: string;
    url?: string;
    twitterDescription: string;
    /** Per-page social image (absolute path); falls back to the site OG image. */
    image?: string;
  };
  /** Extra JSON-LD @graph nodes for a page (e.g. BreadcrumbList, Service). */
  schema?: Record<string, unknown>[];
  /** Schema.org type of the page's WebPage node. */
  pageType?: "WebPage" | "AboutPage" | "CollectionPage" | "ContactPage";
  bodyClass: string;
}

const {
  title,
  description,
  robots = "index, follow",
  canonical,
  og,
  schema = [],
  pageType = "WebPage",
  bodyClass,
} = Astro.props;

const SITE = "https://www.alisamadii.com";
const OG_IMAGE = `${SITE}/og-image.png`;

// Hub lead-capture + booking scripts, pointed at the local api in dev.
const apiBase = import.meta.env.DEV
  ? "http://localhost:3000"
  : "https://api.alisamadii.com";
const captureScripts =
  `<script src="${apiBase}/leads.js" data-key="1769183881145" defer></script>` +
  `<script src="${apiBase}/booking.js" data-key="1769183881145" defer></script>`;

// The page's own URL/@id — falls back to SITE for the home page.
const pageUrl = canonical ?? SITE;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": `${SITE}/#organization`,
      name: "Ali Samadi Agency",
      legalName: "Ali Samadii LLC",
      url: SITE,
      logo: {
        "@type": "ImageObject",
        url: `${SITE}/icon-512.png`,
        width: 512,
        height: 512,
      },
      description:
        "Lead generation agency for businesses everywhere. We run the Google Ads that make the phone ring, build the website that turns clicks into booked jobs, and bring past customers back with email.",
      slogan: "More calls. More booked jobs.",
      knowsAbout: [
        "Lead generation",
        "Google Ads",
        "Local Services Ads",
        "Conversion rate optimization",
        "Email marketing",
        "Web development",
      ],
      email: "agency@alisamadii.com",
      telephone: "+19713828969",
      priceRange: "$$$",
      areaServed: "Worldwide",
      founder: { "@id": `${SITE}/#person-ali` },
      sameAs: ["https://www.instagram.com/alisamadiillc/"],
    },
    {
      "@type": "Person",
      "@id": `${SITE}/#person-ali`,
      name: "Ali Samadi",
      jobTitle: "Founder",
      worksFor: { "@id": `${SITE}/#organization` },
      sameAs: [
        "https://x.com/alisamadii_",
        "https://github.com/alisamadiii",
        "https://www.linkedin.com/in/alireza17/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: SITE,
      name: "Ali Samadi Agency",
      publisher: { "@id": `${SITE}/#organization` },
    },
    {
      "@type": pageType,
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      isPartOf: { "@id": `${SITE}/#website` },
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ali Samadi" />
    <meta name="robots" content={robots} />

    <!-- Favicon / app icons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f6f5f3" />

    {
      og && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:title" content={og.title} />
          <meta property="og:description" content={og.description} />
          {og.url && <meta property="og:url" content={og.url} />}
          <meta
            property="og:image"
            content={og.image ? `${SITE}${og.image}` : OG_IMAGE}
          />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={og.title} />
          <meta property="og:site_name" content="Ali Samadi Agency" />

          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={og.title} />
          <meta name="twitter:description" content={og.twitterDescription} />
          <meta
            name="twitter:image"
            content={og.image ? `${SITE}${og.image}` : OG_IMAGE}
          />
          <meta name="twitter:creator" content="@alisamadii_" />
        </>
      )
    }

    {canonical && <link rel="canonical" href={canonical} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Geist / Geist Mono are self-hosted via @fontsource-variable (imported
         in the frontmatter) — no render-blocking Google Fonts request. -->

    <Analytics />

    <ClientRouter />
    <script is:inline>
      // scroll-smooth would animate ClientRouter's scroll reset on every
      // navigation — strip it during the swap, restore after.
      document.addEventListener("astro:before-swap", (e) => {
        e.newDocument.documentElement.classList.remove("scroll-smooth");
      });
      document.addEventListener("astro:page-load", () => {
        document.documentElement.classList.add("scroll-smooth");
      });
    </script>

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <slot />
    <SearchPalette />

    {
      /*
      Lead capture + booking, loaded site-wide:
      - leads.js keeps the ad click (gclid/UTM) in a cookie so a quote submitted on
        any page is credited to the ad that brought the visitor.
      - booking.js turns any [data-booking] element into the appointment dialog.
      set:html so the tags are real parser-inserted scripts (their
      document.currentScript lookup needs that); both re-bind on Astro soft
      navigations via their own astro:page-load handlers.
    */
    }
    <Fragment set:html={captureScripts} />
  </body>
</html>
