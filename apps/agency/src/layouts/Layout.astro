---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  robots?: string;
  canonical?: string;
  /** Rendered only when set — onboarding has no OG/Twitter block. */
  og?: {
    title: string;
    description: string;
    url?: string;
    twitterDescription: string;
  };
  bodyClass: string;
}

const { title, description, robots = "index, follow", canonical, og, bodyClass } = Astro.props;

const SITE = "https://agency.alisamadii.com";
const OG_IMAGE = `${SITE}/og-image.png`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE}/#organization`,
      name: "Ali Samadi Agency",
      url: SITE,
      logo: `${SITE}/icon-512.png`,
      description:
        "Creative agency specializing in brand identity, web development, and digital strategy.",
      email: "agency@alisamadii.com",
      telephone: "+19713828969",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Portland",
        addressRegion: "OR",
        addressCountry: "US",
      },
      sameAs: [
        "https://x.com/alisamadii_",
        "https://github.com/alisamadiii",
        "https://www.linkedin.com/in/alireza17/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: SITE,
      name: "Ali Samadi Agency",
      publisher: { "@id": `${SITE}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ali Samadi" />
    <meta name="robots" content={robots} />

    <!-- Favicon / app icons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f6f5f3" />

    {
      og && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:title" content={og.title} />
          <meta property="og:description" content={og.description} />
          {og.url && <meta property="og:url" content={og.url} />}
          <meta property="og:image" content={OG_IMAGE} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content="Ali Samadi Agency logo" />
          <meta property="og:site_name" content="Ali Samadi Agency" />

          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={og.title} />
          <meta name="twitter:description" content={og.twitterDescription} />
          <meta name="twitter:image" content={OG_IMAGE} />
          <meta name="twitter:creator" content="@alisamadii_" />
        </>
      )
    }

    {canonical && <link rel="canonical" href={canonical} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
    <!-- Loaded on every page: ClientRouter runs swapped-in external scripts
         async, so a per-page include races the rerun inline scripts that
         read PRICING/fmtPrice. Loading it here guarantees the globals exist
         before any client-side navigation. -->
    <script is:inline src="/pricing.js"></script>
    <script is:inline>
      // scroll-smooth would animate ClientRouter's scroll reset on every
      // navigation — strip it during the swap, restore after.
      document.addEventListener("astro:before-swap", (e) => {
        e.newDocument.documentElement.classList.remove("scroll-smooth");
      });
      document.addEventListener("astro:page-load", () => {
        document.documentElement.classList.add("scroll-smooth");
      });
    </script>

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <slot />
  </body>
</html>
