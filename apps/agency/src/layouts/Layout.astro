---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

import SearchPalette from "../components/SearchPalette.astro";

interface Props {
  title: string;
  description: string;
  robots?: string;
  canonical?: string;
  /** Rendered only when set — onboarding has no OG/Twitter block. */
  og?: {
    title: string;
    description: string;
    url?: string;
    twitterDescription: string;
    /** Per-page social image (absolute path); falls back to the site OG image. */
    image?: string;
  };
  /** Extra JSON-LD @graph nodes for a page (e.g. BreadcrumbList, Service). */
  schema?: Record<string, unknown>[];
  /** Schema.org type of the page's WebPage node. */
  pageType?: "WebPage" | "AboutPage" | "CollectionPage" | "ContactPage";
  bodyClass: string;
}

const {
  title,
  description,
  robots = "index, follow",
  canonical,
  og,
  schema = [],
  pageType = "WebPage",
  bodyClass,
} = Astro.props;

// PostHog web analytics (pageviews only). The project token is a write-only
// key, safe to ship in the client — hardcoded, no env needed.
const POSTHOG_KEY = "phc_we6jLrFNts7UDKkTYpbypWtFQrJX2mFszkkRbEgd7Mzc";
const POSTHOG_HOST = "https://us.i.posthog.com";

const SITE = "https://agency.alisamadii.com";
const OG_IMAGE = `${SITE}/og-image.png`;

// The page's own URL/@id — falls back to SITE for the home page.
const pageUrl = canonical ?? SITE;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": `${SITE}/#organization`,
      name: "Ali Samadi Agency",
      url: SITE,
      logo: {
        "@type": "ImageObject",
        url: `${SITE}/icon-512.png`,
        width: 512,
        height: 512,
      },
      description:
        "Web design and development agency in Jacksonville, FL building custom websites and web apps for businesses across Florida.",
      email: "agency@alisamadii.com",
      telephone: "+19713828969",
      priceRange: "$$",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Jacksonville",
        addressRegion: "FL",
        addressCountry: "US",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: 30.3322,
        longitude: -81.6557,
      },
      areaServed: [
        {
          "@type": "City",
          name: "Jacksonville",
          sameAs: "https://en.wikipedia.org/wiki/Jacksonville,_Florida",
        },
        { "@type": "State", name: "Florida" },
      ],
      founder: { "@id": `${SITE}/#person-ali` },
    },
    {
      "@type": "Person",
      "@id": `${SITE}/#person-ali`,
      name: "Ali Samadi",
      jobTitle: "Founder",
      worksFor: { "@id": `${SITE}/#organization` },
      sameAs: [
        "https://x.com/alisamadii_",
        "https://github.com/alisamadiii",
        "https://www.linkedin.com/in/alireza17/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: SITE,
      name: "Ali Samadi Agency",
      publisher: { "@id": `${SITE}/#organization` },
    },
    {
      "@type": pageType,
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      isPartOf: { "@id": `${SITE}/#website` },
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ali Samadi" />
    <meta name="robots" content={robots} />

    <!-- Favicon / app icons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f6f5f3" />

    {
      og && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:title" content={og.title} />
          <meta property="og:description" content={og.description} />
          {og.url && <meta property="og:url" content={og.url} />}
          <meta
            property="og:image"
            content={og.image ? `${SITE}${og.image}` : OG_IMAGE}
          />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={og.title} />
          <meta property="og:site_name" content="Ali Samadi Agency" />

          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={og.title} />
          <meta name="twitter:description" content={og.twitterDescription} />
          <meta
            name="twitter:image"
            content={og.image ? `${SITE}${og.image}` : OG_IMAGE}
          />
          <meta name="twitter:creator" content="@alisamadii_" />
        </>
      )
    }

    {canonical && <link rel="canonical" href={canonical} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Geist / Geist Mono are self-hosted via @fontsource-variable (imported
         in the frontmatter) — no render-blocking Google Fonts request. -->

    <script
      is:inline
      set:html={`
!function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init me ws ge fs capture De calculateEventProperties Ai $s register register_once register_for_session unregister unregister_for_session Is getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSurveysLoaded onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey canRenderSurveyAsync identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty Ts $b createPersonProfile Ps bs opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing Cs debug ks getPageViewId captureTraceFeedback captureTraceMetric".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
posthog.init(${JSON.stringify(POSTHOG_KEY)},{api_host:${JSON.stringify(POSTHOG_HOST)},capture_pageview:false,capture_pageleave:true,autocapture:false,disable_session_recording:true,disable_surveys:true});
document.addEventListener("astro:page-load",function(){window.posthog&&posthog.capture("$pageview")});
`}
    />

    <ClientRouter />
    <script is:inline>
      // scroll-smooth would animate ClientRouter's scroll reset on every
      // navigation — strip it during the swap, restore after.
      document.addEventListener("astro:before-swap", (e) => {
        e.newDocument.documentElement.classList.remove("scroll-smooth");
      });
      document.addEventListener("astro:page-load", () => {
        document.documentElement.classList.add("scroll-smooth");
      });
    </script>

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <slot />
    <SearchPalette />
  </body>
</html>
