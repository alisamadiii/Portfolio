---
// Grouped docs nav — sticky column on xl, collapsible <details> on smaller
// screens. Groups come from folders in src/content/docs (see data/docs.ts).
import type { DocsGroup } from "../data/docs";

interface Props {
  tree: DocsGroup[];
  activeId?: string;
}

const { tree, activeId } = Astro.props;
---

<!-- Mobile / tablet: collapsible nav above the content -->
<details class="mb-10 rounded-[14px] border border-charcoal/[0.08] xl:hidden">
  <summary
    class="cursor-pointer list-none px-5 py-3.5 font-mono text-[12.5px] tracking-[0.08em] text-muted uppercase select-none"
  >
    Browse docs
  </summary>
  <nav class="space-y-6 border-t border-charcoal/[0.08] px-5 py-5">
    {
      tree.map(({ label, docs }) => (
        <div>
          <p class="font-mono text-[11.5px] tracking-[0.1em] text-muted uppercase">
            {label}
          </p>
          <ul class="mt-2.5 space-y-2">
            {docs.map((doc) => (
              <li>
                <a
                  href={`/docs/${doc.id}`}
                  class={
                    doc.id === activeId
                      ? "text-[15px] font-medium text-accent-ink"
                      : "text-[15px] text-warmgray transition-colors duration-200 hover:text-accent"
                  }
                >
                  {doc.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
</details>

<!-- Desktop: sticky sidebar -->
<aside class="hidden xl:block">
  <nav class="sticky top-28 space-y-8">
    {
      tree.map(({ label, docs }) => (
        <div>
          <p class="font-mono text-[11.5px] tracking-[0.1em] text-muted uppercase">
            {label}
          </p>
          <ul class="mt-3 space-y-2.5 border-l border-charcoal/[0.08]">
            {docs.map((doc) => (
              <li>
                <a
                  href={`/docs/${doc.id}`}
                  class={
                    doc.id === activeId
                      ? "-ml-px block border-l-2 border-accent pl-3.5 text-[14.5px] leading-snug font-medium text-charcoal"
                      : "-ml-px block border-l-2 border-transparent pl-3.5 text-[14.5px] leading-snug text-warmgray transition-colors duration-200 hover:border-charcoal/20 hover:text-charcoal"
                  }
                >
                  {doc.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
</aside>
