<style is:global>
  .si-illus {
    display: block;
  }
  /* one-time draw-in, fired by the page's IntersectionObserver via .reveal */
  .si-illus [data-draw] {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }
  .reveal.visible .si-illus [data-draw] {
    animation: si-draw 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  @keyframes si-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  /* ambient loops */
  @keyframes si-pulse-kf {
    from {
      opacity: 0.55;
    }
    to {
      opacity: 1;
    }
  }
  .si-pulse {
    animation: si-pulse-kf 2.2s cubic-bezier(0.2, 0.7, 0.2, 1) infinite
      alternate;
  }
  @keyframes si-float-kf {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-5px);
    }
  }
  .si-float {
    animation: si-float-kf 5s ease-in-out infinite alternate;
  }
  @keyframes si-dash-kf {
    to {
      stroke-dashoffset: -56;
    }
  }
  .si-dash {
    animation: si-dash-kf 5s linear infinite;
  }
  @keyframes si-blink-kf {
    0%,
    45% {
      opacity: 1;
    }
    55%,
    100% {
      opacity: 0;
    }
  }
  .si-blink {
    animation: si-blink-kf 1.1s step-end infinite;
  }
  @keyframes si-slide-kf {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-30px);
    }
  }
  .si-slide {
    animation: si-slide-kf 2.6s cubic-bezier(0.2, 0.7, 0.2, 1) infinite
      alternate;
    animation-delay: 1s;
  }
  @keyframes si-drift-cursor-kf {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(-14px, -10px);
    }
  }
  .si-drift-cursor {
    animation: si-drift-cursor-kf 3.4s ease-in-out infinite alternate;
  }
  @keyframes si-spin-slow-kf {
    to {
      transform: rotate(360deg);
    }
  }
