          opacity="0.35"
        />
        <rect {...line} x="548" y="92" width="38" height="38" rx="10" />
      </g>
      {/* button */}
      <g class="si-float" style="animation-delay:.6s">
        <rect x="404" y="177" width="150" height="46" rx="23" fill={CORAL} />
        <path
          d="M436 200h66"
