---
// Animated abstract-geometric hero illustration, one composition per service.
// Replaces the Pexels hero photo on /services/<slug>. Charcoal (currentColor)
// + coral (#fc8464) line art on the white hero card. Pure CSS animation:
// [data-draw] strokes draw in once when the surrounding .reveal gets .visible
// (existing IntersectionObserver); ambient loops (pulse/float/dash) run on
// their own. Everything stops under prefers-reduced-motion.
interface Props {
  slug: string;
}
const { slug } = Astro.props;

const CORAL = "#fc8464";

const svgAttrs = {
  class: "si-illus h-full w-full",
  viewBox: "0 0 640 400",
  width: "640",
  height: "400",
  fill: "none",
  role: "img",
  preserveAspectRatio: "xMidYMid meet",
};
const line = {
  stroke: "currentColor",
  "stroke-width": "2",
  "stroke-linecap": "round" as const,
  "stroke-linejoin": "round" as const,
};
---

