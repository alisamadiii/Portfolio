<header style="position: sticky; top: 0px; z-index: 50; padding: 12px clamp(12px, 3vw, 24px) 0px;"><div style="max-width: 1080px; margin: 0px auto; border-radius: 18px; background: rgba(246, 245, 243, 0.72); backdrop-filter: blur(14px); box-shadow: rgba(27, 26, 23, 0.07) 0px 0px 0px 1px, rgba(27, 26, 23, 0.07) 0px 6px 16px;"><nav aria-label="Main" style="height: 60px; padding: 0px 8px 0px 16px; display: flex; align-items: center; justify-content: space-between; gap: 24px;"><a href="/" class="tlink" style="display: flex; align-items: center; gap: 10px; color: rgb(27, 26, 23); text-decoration: none;"><img src="/home/hero-icon.png" alt="Ali Samadi Agency logo" style="width: 28px; height: 28px; display: block;"><span style="font-size: 18px; font-weight: 600; letter-spacing: -0.02em;">alisamadii</span></a><div class="hide-sm" style="display: flex; align-items: center; gap: 32px; font-size: 15px; font-weight: 500;"><a href="/services" class="tlink" style="color: rgb(103, 98, 90);">Services</a><a href="/work" class="tlink" style="color: rgb(103, 98, 90);">Work</a><a href="/about" class="tlink" style="color: rgb(103, 98, 90);">About</a><a href="/pricing" class="tlink" style="color: rgb(103, 98, 90);">Pricing</a></div><div style="display: flex; align-items: center; gap: 8px;"><button type="button" data-search-open aria-label="Search" class="btn btn-tertiary" style="width: 44px; height: 44px; border-radius: 11px; background: rgba(27, 26, 23, 0.05); color: rgb(27, 26, 23); display: inline-flex; align-items: center; justify-content: center;"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"></path></svg></button><a href="/quote" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0px 18px; border-radius: 11px; background: rgb(27, 26, 23); color: rgb(246, 245, 243); font-size: 15px; font-weight: 500; text-decoration: none; box-shadow: rgba(27, 26, 23, 0.22) 0px 8px 24px;">Start a Project</a><button type="button" class="btn btn-tertiary show-sm" aria-label="Open menu" aria-expanded="false" style="width: 44px; height: 44px; border-radius: 11px; background: rgba(27, 26, 23, 0.05); color: rgb(27, 26, 23); align-items: center; justify-content: center;"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></button></div></nav></div></header>
