      </h4>
      <p class="text-warmgray mb-4 text-[13.5px] leading-[1.6]">
        Currently accepting new projects. Reach out to discuss your ideas.
      </p>
      <a
        href="mailto:agency@alisamadii.com"
        class="mag-btn bg-charcoal hover:bg-accent inline-flex items-center gap-2 rounded-[9px] px-[17px] py-[9px] text-[13.5px] font-medium text-white"
      >
        Get in Touch
        <span class="text-[12px]">&#8599;</span>
      </a>
    </div>
  </div>

  <!-- Bottom bar -->
  <div
    class="border-charcoal/[0.08] text-muted mt-12 flex flex-wrap items-center justify-between gap-4 border-t pt-7 font-mono text-[12.5px]"
  >
    <span>&copy; {year} Ali Samadi Agency</span>
    <div class="flex items-center gap-5">
      <a
        href="/privacy"
        class="hover:text-accent transition-colors duration-300">Privacy</a
      >
      <a href="/terms" class="hover:text-accent transition-colors duration-300"
        >Terms</a
      >
      <span>Jacksonville, FL</span>
    </div>
