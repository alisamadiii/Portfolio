---
import home from "../data/home.json";

const { footer } = home;
---

<footer class="mx-auto max-w-[1200px] px-6 pt-9 pb-14 md:px-10">
  <div class="grid grid-cols-2 gap-10 md:grid-cols-4">
    <!-- Brand -->
    <div class="col-span-2 md:col-span-1">
      <div class="flex items-center gap-2.5 font-medium">
        <img
          src="https://cdn.alisamadii.com/company/business-logo-soft-rounded.png"
          alt="alisamadii logo"
          class="h-[22px] w-[22px]"
        />
        <span data-cms-field="footer.brand">{footer.brand}</span>
      </div>
      <p
        class="text-warmgray mt-4 max-w-[35ch] text-[13.5px] leading-[1.6]"
        data-cms-field="footer.blurb"
      >
        {footer.blurb}
      </p>
      <div class="text-warmgray mt-5 flex gap-5 text-[13.5px]">
        {
          footer.socials.map((social, i) => (
            <a
              href={social.href}
              target="_blank"
              class="hover:text-accent transition-colors duration-300"
              data-cms-field={`footer.socials.${i}`}
            >
              {social.label}
            </a>
          ))
        }
      </div>

      <!-- TrustBox widget - Review Collector -->
      <div
        class="trustpilot-widget mt-6"
        data-locale="en-US"
        data-template-id="56278e9abfbbba0bdcd568bc"
        data-businessunit-id="6a5c4109105cd997a6a88f07"
        data-style-height="52px"
        data-style-width="100%"
        data-token="f84feb9e-8e2f-48bc-bbec-38d71da27964"
      >
        <a
          href="https://www.trustpilot.com/review/alisamadii.com"
          target="_blank"
          rel="noopener"
          >Trustpilot</a
        >
      </div>
      <!-- End TrustBox widget -->
    </div>

    <!-- Navigation -->
    <div>
      <h4
        class="text-muted mb-3.5 font-mono text-[11.5px] tracking-[0.08em] uppercase"
        data-cms-field="footer.navHeading"
      >
        {footer.navHeading}
      </h4>
      <ul class="text-warmgray space-y-2.5 text-[13.5px]">
        {
          footer.navLinks.map((link, i) => (
            <li>
              <a
                href={link.href}
                class="hover:text-accent transition-colors duration-300"
                data-cms-field={`footer.navLinks.${i}`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Services -->
    <div>
      <h4
        class="text-muted mb-3.5 font-mono text-[11.5px] tracking-[0.08em] uppercase"
        data-cms-field="footer.servicesHeading"
      >
        {footer.servicesHeading}
      </h4>
      <ul class="text-warmgray space-y-2.5 text-[13.5px]">
        {
          footer.serviceLinks.map((link, i) => (
            <li>
              <a
                href={link.href}
                class="hover:text-accent transition-colors duration-300"
                data-cms-field={`footer.serviceLinks.${i}`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Availability -->
    <div>
      <h4
        class="text-muted mb-3.5 font-mono text-[11.5px] tracking-[0.08em] uppercase"
        data-cms-field="footer.availabilityHeading"
      >
        {footer.availabilityHeading}
      </h4>
      <p
        class="text-warmgray mb-4 text-[13.5px] leading-[1.6]"
        data-cms-field="footer.availabilityText"
      >
        {footer.availabilityText}
      </p>
      <a
        href={footer.availabilityCta.href}
        class="mag-btn bg-charcoal hover:bg-accent inline-flex items-center gap-2 rounded-[9px] px-[17px] py-[9px] text-[13.5px] font-medium text-white"
        data-cms-field="footer.availabilityCta"
      >
        {footer.availabilityCta.label}
        <span class="text-[12px]">&#8599;</span>
      </a>
    </div>
  </div>

  <!-- Bottom bar -->
  <div
    class="border-charcoal/[0.08] text-muted mt-12 flex flex-wrap items-center justify-between gap-4 border-t pt-7 font-mono text-[12.5px]"
  >
    <span data-cms-field="footer.copyright">{footer.copyright}</span>
    <span data-cms-field="footer.location">{footer.location}</span>
  </div>
</footer>
