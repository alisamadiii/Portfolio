---
const year = new Date().getFullYear();
---

<footer class="mx-auto max-w-[1200px] px-6 pt-9 pb-14 md:px-10">
  <div class="grid grid-cols-2 gap-10 md:grid-cols-4">
    <!-- Brand -->
    <div class="col-span-2 md:col-span-1">
      <div class="flex items-center gap-2.5 font-medium">
        <img
          src="https://cdn.alisamadii.com/company/business-logo-soft-rounded.png"
          alt="alisamadii logo"
          class="h-[22px] w-[22px]"
        />
        alisamadii
      </div>
      <p class="text-warmgray mt-4 max-w-[35ch] text-[13.5px] leading-[1.6]">
        A creative agency focused on building exceptional digital experiences
        that drive real results.
      </p>
      <div class="text-warmgray mt-5 flex gap-5 text-[13.5px]">
        <a
          href="https://x.com/alisamadii_"
          target="_blank"
          class="hover:text-accent transition-colors duration-300"
          >Twitter</a
        >
        <a
          href="https://github.com/alisamadiii"
          target="_blank"
          class="hover:text-accent transition-colors duration-300"
          >GitHub</a
        >
        <a
          href="https://www.linkedin.com/in/alireza17/"
          target="_blank"
          class="hover:text-accent transition-colors duration-300"
          >LinkedIn</a
        >
      </div>

      <!-- TrustBox widget - Review Collector -->
      <div
        class="trustpilot-widget mt-6"
        data-locale="en-US"
        data-template-id="56278e9abfbbba0bdcd568bc"
        data-businessunit-id="6a5c4109105cd997a6a88f07"
        data-style-height="52px"
        data-style-width="100%"
        data-token="f84feb9e-8e2f-48bc-bbec-38d71da27964"
      >
        <a
          href="https://www.trustpilot.com/review/alisamadii.com"
          target="_blank"
          rel="noopener"
          >Trustpilot</a
        >
      </div>
      <!-- End TrustBox widget -->
    </div>

    <!-- Navigation -->
    <div>
      <h4
        class="text-muted mb-3.5 font-mono text-[11.5px] tracking-[0.08em] uppercase"
      >
        Navigation
      </h4>
      <ul class="text-warmgray space-y-2.5 text-[13.5px]">
        <li>
          <a href="#hero" class="hover:text-accent transition-colors duration-300"
            >Home</a
          >
        </li>
        <li>
          <a
            href="#services"
            class="hover:text-accent transition-colors duration-300"
            >Services</a
          >
        </li>
        <li>
          <a
            href="#about"
            class="hover:text-accent transition-colors duration-300"
            >About</a
          >
        </li>
        <li>
          <a href="#work" class="hover:text-accent transition-colors duration-300"
            >Work</a
          >
        </li>
        <li>
          <a href="/blog" class="hover:text-accent transition-colors duration-300"
            >Blog</a
          >
        </li>
        <li>
          <a
            href="#contact"
            class="hover:text-accent transition-colors duration-300"
            >Contact</a
          >
        </li>
      </ul>
    </div>

    <!-- Services -->
    <div>
      <h4
        class="text-muted mb-3.5 font-mono text-[11.5px] tracking-[0.08em] uppercase"
      >
        Services
      </h4>
      <ul class="text-warmgray space-y-2.5 text-[13.5px]">
        <li>
          <a
            href="/services/web-development"
            class="hover:text-accent transition-colors duration-300"
            >Web Development</a
          >
        </li>
        <li>
          <a
            href="/services/ui-ux-design"
