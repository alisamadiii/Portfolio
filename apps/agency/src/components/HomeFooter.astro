---
// The single site-wide footer — used on the homepage and every inner page.
import NewsletterBand from "./NewsletterBand.astro";
import { services } from "../data/services";

const year = new Date().getFullYear();
---

<NewsletterBand />

<footer class="mx-auto max-w-[1200px] px-6 pt-9 pb-14 md:px-10">
  <div class="grid grid-cols-2 gap-10 md:grid-cols-4">
    <!-- Brand -->
    <div class="col-span-2 md:col-span-1">
      <div class="flex items-center gap-2.5 font-medium">
        <img
          src="https://cdn.alisamadii.com/company/business-logo-soft-rounded.png"
          alt="alisamadii logo"
          width="22"
          height="22"
          loading="lazy"
          class="h-[22px] w-[22px]"
        />
        alisamadii
      </div>
      <p class="mt-4 max-w-[35ch] text-[13.5px] leading-[1.6] text-warmgray">
        A creative agency focused on building exceptional digital experiences
        that drive real results.
      </p>
      <div class="mt-5 flex gap-5 text-[13.5px] text-warmgray">
        <a
          href="https://x.com/alisamadii_"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors duration-300 hover:text-accent">Twitter</a
        >
        <a
          href="https://github.com/alisamadiii"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors duration-300 hover:text-accent">GitHub</a
        >x
        <a
          href="https://www.linkedin.com/in/alireza17/"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors duration-300 hover:text-accent">LinkedIn</a
        >
        <a
          href="https://www.instagram.com/alisamadiillc/"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors duration-300 hover:text-accent">Instagram</a
        >
      </div>
    </div>

    <!-- Navigation -->
    <div>
      <h4
        class="mb-3.5 font-mono text-[11.5px] tracking-[0.08em] text-muted uppercase"
      >
        Navigation
      </h4>
      <ul class="space-y-2.5 text-[13.5px] text-warmgray">
        <li>
          <a href="/" class="transition-colors duration-300 hover:text-accent"
            >Home</a
          >
        </li>
        <li>
          <a
            href="/services"
            class="transition-colors duration-300 hover:text-accent">Services</a
          >
        </li>
        <li>
          <a
            href="/pricing"
            class="transition-colors duration-300 hover:text-accent">Pricing</a
          >
        </li>
        <li>
          <a
            href="/about"
            class="transition-colors duration-300 hover:text-accent">About</a
          >
        </li>
        <li>
          <a
            href="/work"
            class="transition-colors duration-300 hover:text-accent">Work</a
          >
        </li>
        <li>
          <a
            href="/blog"
            class="transition-colors duration-300 hover:text-accent">Blog</a
          >
        </li>
        <li>
          <a
            href="/locations"
            class="transition-colors duration-300 hover:text-accent"
            >Locations</a
          >
        </li>
        <li>
          <a
            href="/contact"
            class="transition-colors duration-300 hover:text-accent">Contact</a
          >
        </li>
      </ul>
    </div>

    <!-- Services -->
    <div>
      <h4
        class="mb-3.5 font-mono text-[11.5px] tracking-[0.08em] text-muted uppercase"
      >
        Services
      </h4>
      <ul class="space-y-2.5 text-[13.5px] text-warmgray">
        {
          services.map((s) => (
            <li>
              <a
                href={`/services/${s.slug}`}
                class="transition-colors duration-300 hover:text-accent"
              >
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Availability -->
    <div>
      <h4
        class="mb-3.5 font-mono text-[11.5px] tracking-[0.08em] text-muted uppercase"
      >
        Availability
      </h4>
      <p class="mb-4 text-[13.5px] leading-[1.6] text-warmgray">
        Currently accepting new projects. Reach out to discuss your ideas.
      </p>
      <a
        href="mailto:agency@alisamadii.com"
        class="mag-btn inline-flex items-center gap-2 rounded-[9px] bg-charcoal px-[17px] py-[9px] text-[13.5px] font-medium text-cream hover:bg-accent"
      >
        Get in Touch
        <span class="text-[12px]">&#8599;</span>
      </a>
    </div>
  </div>

  <!-- Bottom bar -->
  <div
    class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-charcoal/[0.08] pt-7 font-mono text-[12.5px] text-muted"
  >
    <span>&copy; {year} Ali Samadi Agency</span>
    <div class="flex items-center gap-5">
      <a
        href="/privacy"
        class="transition-colors duration-300 hover:text-accent">Privacy</a
      >
      <a href="/terms" class="transition-colors duration-300 hover:text-accent"
        >Terms</a
      >
      <span>Jacksonville, FL</span>
    </div>
  </div>
</footer>
