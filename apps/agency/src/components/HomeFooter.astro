            class="hover:text-accent transition-colors duration-300"
            >Brand Identity</a
          >
        </li>
        <li>
          <a
            href="/services/seo-analytics"
            class="hover:text-accent transition-colors duration-300"
            >SEO &amp; Analytics</a
          >
        </li>
        <li>
          <a
            href="/services/website-management"
            class="hover:text-accent transition-colors duration-300"
            >Website Management</a
          >
        </li>
        <li>
