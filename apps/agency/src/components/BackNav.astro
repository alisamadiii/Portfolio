---
import SearchTrigger from "./SearchTrigger.astro";

interface Props {
  backHref: string;
  backLabel: string;
  /** pricing's nav is fixed; onboarding's sits in the flow. */
  fixed?: boolean;
}

const { backHref, backLabel, fixed = false } = Astro.props;
---

<nav
  class={fixed
    ? "fixed top-0 right-0 left-0 z-40 px-4 py-5 md:px-8"
    : "px-4 py-5 md:px-8"}
>
  <div class="mx-auto flex max-w-[1400px] items-center justify-between">
    <a href="/" class="group flex items-center gap-3">
      <div
        class="flex h-10 w-10 items-center justify-center rounded-full bg-charcoal"
      >
        <span class="text-sm font-bold text-cream">AS</span>
      </div>
      <span
        class="text-sm font-medium text-warmgray transition-colors duration-300 group-hover:text-charcoal"
        >Ali Samadi</span
      >
    </a>
    <div class="flex items-center gap-3 md:gap-5">
      <span class="hidden sm:block"><SearchTrigger /></span>
      <span class="sm:hidden"><SearchTrigger variant="mobile" /></span>
      <a
        href={backHref}
        class="mag-btn -my-2 flex min-h-11 items-center gap-2 py-2 text-sm text-warmgray transition-colors duration-300 hover:text-charcoal"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
        </svg>
        {backLabel}
      </a>
    </div>
  </div>
</nav>
