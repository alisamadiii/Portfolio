---
interface Props {
  backHref: string;
  backLabel: string;
  /** pricing's nav is fixed; onboarding's sits in the flow. */
  fixed?: boolean;
}

const { backHref, backLabel, fixed = false } = Astro.props;
---

<nav class={fixed ? "fixed top-0 right-0 left-0 z-40 px-4 py-5 md:px-8" : "px-4 py-5 md:px-8"}>
  <div class="mx-auto flex max-w-[1400px] items-center justify-between">
    <a href="/" class="group flex items-center gap-3">
      <div
        class="bg-charcoal flex h-10 w-10 items-center justify-center rounded-full"
      >
        <span class="text-cream text-sm font-bold">AS</span>
      </div>
      <span
        class="text-warmgray group-hover:text-charcoal text-sm font-medium transition-colors duration-300"
        >Ali Samadi</span
      >
    </a>
    <a
      href={backHref}
      class="mag-btn text-warmgray hover:text-charcoal flex items-center gap-2 text-sm transition-colors duration-300"
    >
      <svg
        class="h-4 w-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"
        />
      </svg>
      {backLabel}
    </a>
  </div>
</nav>
