          class="mag-btn inline-flex w-full items-center justify-center gap-2 rounded-full bg-charcoal/5 px-6 py-3 text-sm font-medium text-charcoal transition-all duration-300 hover:bg-charcoal hover:text-cream lg:w-auto"
