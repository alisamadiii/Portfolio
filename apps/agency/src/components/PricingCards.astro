---
// The three plan cards (Website-as-a-Service / Own-it build / Custom) — single
// source of truth, rendered on /pricing and the homepage #pricing section. The
// monthly anchor comes from src/data/pricing.ts at build time. Every card CTA
// routes to the "Get a Quote" form (/contact#quote) — no self-serve checkout.
import { PRICING, fmtPrice } from "../data/pricing";

const emailNote = `${PRICING.email.freePerMonth.toLocaleString("en-US")} emails/mo free, then ${fmtPrice(PRICING.email.perExtraThousand)} per 1,000`;
---

<div
  class:list={["stagger grid grid-cols-1 gap-6 lg:grid-cols-2 xl:grid-cols-3"]}
>
  <!-- Monthly Card -->
  <div class="reveal">
    <div
      class="package-card flex h-full flex-col rounded-[18px] bg-charcoal/[0.03] p-1.5 ring-1 ring-charcoal/[0.04]"
    >
      <div class="flex flex-1 flex-col rounded-[14px] bg-white p-8">
        <div class="mb-6 flex items-center gap-3">
          <span
            class="inline-block rounded-full bg-accent px-3 py-1 font-mono text-[11.5px] tracking-[0.12em] text-charcoal uppercase"
            >Recommended</span
          >
        </div>
        <h3 class="text-2xl font-semibold tracking-[-0.02em]">
          Website-as-a-Service
        </h3>
        <div class="mt-3">
          <span class="text-xs text-warmgray">from</span>
          <span class="price-monthly text-3xl font-bold tracking-tight"
            >{fmtPrice(PRICING.monthly)}</span
          >
          <span class="text-base font-normal text-warmgray">/mo</span>
        </div>
        <p class="mt-1 text-xs text-warmgray">
          Pricing varies with scope, but for most projects this is where we
          land.
        </p>
        <p class="mt-3 max-w-[40ch] text-sm leading-relaxed text-warmgray">
          Everything included, one flat price — design, development, CMS, email,
          SEO, and hosting. Fully managed for you.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-warmgray">
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-accent"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
            Custom design &amp; development
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-accent"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
            Full CMS access — edit anything
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-accent"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
            Email &amp; contact forms included
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-accent"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
            <span
              >Essential SEO included
              <span class="block text-xs text-muted"
                >Titles, meta descriptions, AI-ready schema markup, keyword
                checks &amp; blog setup</span
              ></span
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-accent"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
            Managed hosting &amp; maintenance
          </li>
        </ul>
        <div class="mt-auto pt-8">
          <a
            href="/quote?plan=waas"
            class="mag-btn inline-flex w-full items-center justify-center gap-2 rounded-full bg-charcoal px-5 py-3 text-sm font-medium text-cream transition-all duration-300 hover:bg-accent"
          >
            Get a Quote
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Own-it Build Card -->
  <div class="reveal">
    <div
      class="package-card flex h-full flex-col rounded-[18px] bg-charcoal/[0.03] p-1.5 ring-1 ring-charcoal/[0.04]"
    >
      <div class="flex flex-1 flex-col rounded-[14px] bg-white p-8">
        <div class="mb-6 flex items-center gap-3">
          <span
            class="inline-block rounded-full bg-charcoal/5 px-3 py-1 font-mono text-[11.5px] tracking-[0.12em] text-warmgray uppercase"
            >One-time</span
          >
        </div>
        <h3 class="text-2xl font-semibold tracking-[-0.02em]">Own-it Build</h3>
        <div class="mt-3">
          <span class="text-3xl font-bold tracking-tight"
            >Priced per project</span
          >
        </div>
        <p class="mt-3 max-w-[40ch] text-sm leading-relaxed text-warmgray">
          A one-time build you own outright — includes 5 months of hosting, then
          optional renewal. Scoped and priced around your project.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-warmgray">
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-accent"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
            Custom design &amp; development
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-accent"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
            <span
              >You own the site — code, content, everything
              <span class="block text-xs text-muted"
                >Clean handover, no lock-in</span
              ></span
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-accent"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
            <span
              >Essential SEO included
              <span class="block text-xs text-muted"
                >Titles, meta descriptions, AI-ready schema markup &amp; keyword
                checks</span
              ></span
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-accent"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
            <span
              >5 months of managed hosting included
              <span class="block text-xs text-muted"
                >Optional renewal after that</span
              ></span
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-accent"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
            <span>CMS access included — edit anything</span>
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-accent"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="email-note">{emailNote}</span>
          </li>
        </ul>
        <div class="mt-auto pt-8">
          <a
            href="/quote?plan=onetime"
            class="mag-btn inline-flex w-full items-center justify-center gap-2 rounded-full bg-charcoal/5 px-5 py-3 text-sm font-medium text-charcoal transition-all duration-300 hover:bg-charcoal hover:text-cream"
          >
            Get a Quote
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Custom Card -->
  <div class:list={["reveal"]}>
    <div
      class="package-card flex h-full flex-col rounded-[18px] bg-charcoal/[0.03] p-1.5 ring-1 ring-charcoal/[0.04]"
    >
      <div class="flex flex-1 flex-col rounded-[14px] bg-white p-8">
        <div class="mb-6 flex items-center gap-3">
          <span
            class="inline-block rounded-full bg-charcoal/5 px-3 py-1 font-mono text-[11.5px] tracking-[0.12em] text-warmgray uppercase"
            >Tailored</span
          >
        </div>
        <h3 class="text-2xl font-semibold tracking-[-0.02em]">Custom</h3>
        <div class="mt-3">
          <span class="text-3xl font-bold tracking-tight">Let's talk</span>
        </div>
        <p class="mt-3 max-w-[40ch] text-sm leading-relaxed text-warmgray">
          Bigger scope? Admin panels, user accounts, databases, or something
          unique — we scope it together and quote it fairly.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-warmgray">
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-accent"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
            Fully bespoke scope
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-accent"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
            Admin panel, auth &amp; database available
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-accent"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
            One-time and recurring options
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-accent"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
            Personal quote, no surprises
          </li>
        </ul>
        <div class="mt-auto pt-8">
          <a
            href="/quote?plan=custom"
            class="mag-btn inline-flex w-full items-center justify-center gap-2 rounded-full bg-charcoal/5 px-5 py-3 text-sm font-medium text-charcoal transition-all duration-300 hover:bg-charcoal hover:text-cream"
          >
            Get a Quote
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .package-card {
    transition: all 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .package-card:hover {
    transform: translateY(-2px);
  }
</style>
