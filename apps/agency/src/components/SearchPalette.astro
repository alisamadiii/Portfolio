---
// Site-wide search palette (⌘K). Rendered once in Layout.astro so it exists
// on every page. The script is a bundled module — it executes once per
// browser session while ClientRouter swaps the DOM on every navigation, so
// every listener is delegated on `document` and palette elements are looked
// up lazily inside handlers. The index is a build-time endpoint
// (src/pages/search-index.json.ts), fetched on first open and cached.
// Styling matches the mockup "Site search palette" frame.
---

<dialog id="search-palette" class="search-dialog">
  <div class="search-panel">
    <div class="search-inputrow">
      <svg
        class="search-magnifier"
        width="20"
        height="20"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"
        ></path>
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="Search pages, services, work, blog…"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        class="search-field"
      />
      <span class="kbd">esc</span>
    </div>

    <div
      id="search-results"
      role="listbox"
      aria-label="Search results"
      class="search-results"
    >
    </div>

    <div class="search-footer">
      <span class="search-hints">
        <span class="search-hint"
          ><span class="kbd">&#8593;</span><span class="kbd">&#8595;</span
          >navigate</span
        >
        <span class="search-hint"><span class="kbd">&#8629;</span>open</span>
        <span class="search-hint"><span class="kbd">esc</span>close</span>
      </span>
      <span>Index rebuilt on every deploy</span>
    </div>
  </div>
</dialog>

<style is:global>
  .search-dialog {
    margin: 10vh auto auto;
    padding: 6px;
    width: min(640px, calc(100vw - 2rem));
    border: 0;
    border-radius: 24px;
    background: rgba(27, 26, 23, 0.04);
    box-shadow:
      rgba(27, 26, 23, 0.06) 0px 0px 0px 1px,
      rgba(27, 26, 23, 0.45) 0px 40px 120px -30px,
      rgba(27, 26, 23, 0.1) 0px 12px 32px;
    backdrop-filter: blur(6px);
    color: #1b1a17;
    overflow: visible;
  }
  .search-panel {
    display: flex;
    flex-direction: column;
    max-height: min(74vh, 640px);
    border-radius: 18px;
    background: rgb(255, 254, 252);
    overflow: hidden;
  }
  .search-inputrow {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 60px;
    padding: 0 16px 0 20px;
    border-bottom: 1px solid rgba(27, 26, 23, 0.07);
  }
  .search-magnifier {
    flex: 0 0 auto;
    color: rgb(107, 102, 93);
  }
  .search-field {
    flex: 1 1 0%;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: none;
    font-size: 16px;
    color: #1b1a17;
  }
  .search-field:focus,
  .search-field:focus-visible {
    outline: none;
    box-shadow: none;
    border: 0;
  }
  .search-field::placeholder {
    color: #9a948b;
  }
  .search-results {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .search-group {
    padding: 12px 12px 4px;
    font-family:
      "Geist Mono Variable", "Geist Mono", ui-monospace, "SF Mono", Menlo,
      monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(107, 102, 93);
  }
  .search-result {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 12px 8px 8px;
    border-radius: 14px;
    cursor: pointer;
    background: transparent;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.12s ease;
  }
  .search-result[aria-selected="true"] {
    background: rgba(27, 26, 23, 0.05);
  }
  .sr-tile {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: rgba(27, 26, 23, 0.04);
    color: rgb(27, 26, 23);
    box-shadow: rgba(27, 26, 23, 0.05) 0px 0px 0px 1px inset;
  }
  .search-result[aria-selected="true"] .sr-tile {
    background: rgb(27, 26, 23);
    color: rgb(246, 245, 243);
    box-shadow: none;
  }
  .sr-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sr-text {
    flex: 1 1 0%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sr-title {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #1b1a17;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sr-desc {
    font-size: 13px;
    color: rgb(103, 98, 90);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sr-enter {
    flex: 0 0 auto;
    opacity: 0;
    transition: opacity 0.12s ease;
  }
  .search-result[aria-selected="true"] .sr-enter {
    opacity: 1;
  }
  .search-empty {
    padding: 28px 16px;
    text-align: center;
  }
  .search-empty-title {
    font-size: 14px;
    color: rgb(103, 98, 90);
  }
  .search-empty-sub {
    margin-top: 4px;
    font-family:
      "Geist Mono Variable", "Geist Mono", ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(107, 102, 93);
  }
  .search-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 16px;
    border-top: 1px solid rgba(27, 26, 23, 0.07);
    background: rgb(246, 245, 243);
    font-family:
      "Geist Mono Variable", "Geist Mono", ui-monospace, "SF Mono", Menlo,
      monospace;
    font-size: 11px;
    color: rgb(107, 102, 93);
  }
  .search-hints {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .search-hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    padding: 2px 6px;
    border: 1px solid rgba(27, 26, 23, 0.12);
    border-radius: 6px;
    background: #fff;
    font-family:
      "Geist Mono Variable", "Geist Mono", ui-monospace, "SF Mono", Menlo,
      monospace;
    font-size: 11px;
    line-height: 1;
    color: rgb(107, 102, 93);
  }
  /* Hide the footer hint bar on narrow screens where keys don't apply. */
  @media (max-width: 640px) {
    .search-footer {
      display: none;
    }
    .search-inputrow .kbd {
      display: none;
    }
  }

  .search-dialog::backdrop {
    background: rgba(246, 245, 243, 0.8);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }
  .search-dialog[open] {
    animation: search-pop 0.18s ease;
  }
  @keyframes search-pop {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .search-dialog[open] {
      animation: none;
    }
  }
</style>

<script>
  import MiniSearch from "minisearch";

  type SearchDoc = {
    id: string;
    type: "page" | "service" | "project" | "blog" | "location";
    title: string;
    description: string;
    url: string;
    image?: string;
    external?: boolean;
    keywords: string[];
  };

  const GROUPS: { type: SearchDoc["type"]; label: string }[] = [
    { type: "page", label: "Pages" },
    { type: "service", label: "Services" },
    { type: "project", label: "Work" },
    { type: "blog", label: "Blog" },
    { type: "location", label: "Locations" },
  ];

  const ICONS: Record<SearchDoc["type"], string> = {
    page: "M3.75 6A2.25 2.25 0 016 3.75h12A2.25 2.25 0 0120.25 6v12A2.25 2.25 0 0118 20.25H6A2.25 2.25 0 013.75 18V6zM3.75 9h16.5",
    service:
      "M11.42 15.17L17.25 21A2.65 2.65 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085",
    project:
      "M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25",
    blog: "M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125",
    location:
      "M15 10.5a3 3 0 11-6 0 3 3 0 016 0zM19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z",
  };

  let mini: MiniSearch<SearchDoc> | null = null;
  let docs: SearchDoc[] | null = null;
  let loading: Promise<void> | null = null;
  let activeIndex = 0;
  let lastFocused: HTMLElement | null = null;
  let debounceTimer: number | undefined;

  const dialog = () =>
    document.getElementById("search-palette") as HTMLDialogElement | null;
  const input = () =>
    document.getElementById("search-input") as HTMLInputElement | null;
  const resultsBox = () => document.getElementById("search-results");

  function loadIndex(): Promise<void> {
    if (docs) return Promise.resolve();
    loading ??= fetch("/search-index.json")
      .then((r) => r.json())
      .then((data: SearchDoc[]) => {
        docs = data;
        mini = new MiniSearch<SearchDoc>({
          fields: ["title", "keywords", "description"],
          storeFields: [
            "type",
            "title",
            "description",
            "url",
            "image",
            "external",
          ],
          extractField: (doc, field) => {
            const v = doc[field as keyof SearchDoc];
            return Array.isArray(v) ? v.join(" ") : String(v ?? "");
          },
          searchOptions: {
            prefix: true,
            fuzzy: 0.25,
            boost: { title: 3, keywords: 2.5, description: 1 },
            combineWith: "OR",
          },
        });
        mini.addAll(docs);
      })
      .catch(() => {
        loading = null;
      });
    return loading;
  }

  function search(query: string): SearchDoc[] {
    if (!mini) return [];
    let hits = mini.search(query);
    // Typo-rescue pass: nothing matched, loosen the edit-distance budget.
    if (hits.length === 0) hits = mini.search(query, { fuzzy: 0.4 });
    return hits as unknown as SearchDoc[];
  }

  // ── Rendering (createElement only — result text is never injected as HTML) ──

  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className: string,
    text?: string
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  function iconTile(type: SearchDoc["type"]): HTMLElement {
    const tile = el("span", "sr-tile");
    tile.setAttribute("aria-hidden", "true");
    tile.innerHTML = `<svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="${ICONS[type]}"></path></svg>`;
    return tile;
  }

  function resultRow(doc: SearchDoc): HTMLAnchorElement {
    const a = el("a", "search-result");
    a.href = doc.url;
    a.setAttribute("role", "option");
    a.setAttribute("aria-selected", "false");
    if (doc.external) {
      a.target = "_blank";
      a.rel = "noopener";
    }

    if (doc.image) {
      const tile = el("span", "sr-tile");
      tile.setAttribute("aria-hidden", "true");
      const img = el("img", "");
      img.src = doc.image;
      img.alt = "";
      img.loading = "lazy";
      tile.appendChild(img);
      a.appendChild(tile);
    } else {
      a.appendChild(iconTile(doc.type));
    }

    const text = el("span", "sr-text");
    const title = el("span", "sr-title", doc.title);
    if (doc.external) {
      title.appendChild(el("span", "", " ↗"));
    }
    text.appendChild(title);
    text.appendChild(el("span", "sr-desc", doc.description));
    a.appendChild(text);

    const enter = el("span", "sr-enter");
    enter.innerHTML = '<span class="kbd">&#8629;</span>';
    a.appendChild(enter);
    return a;
  }

  function groupLabel(label: string): HTMLElement {
    return el("div", "search-group", label);
  }

  function renderGroups(box: HTMLElement, results: SearchDoc[], perGroup = 4) {
    for (const group of GROUPS) {
      const items = results
        .filter((r) => r.type === group.type)
        .slice(0, perGroup);
      if (items.length === 0) continue;
      box.appendChild(groupLabel(group.label));
      for (const item of items) box.appendChild(resultRow(item));
    }
  }

  function renderDefault(box: HTMLElement) {
    box.textContent = "";
    if (!docs) return;
    box.appendChild(groupLabel("Quick links"));
    const pages = docs.filter(
      (d) => d.type === "page" && !["/terms", "/privacy", "/"].includes(d.url)
    );
    for (const page of pages.slice(0, 5)) box.appendChild(resultRow(page));
    const posts = docs.filter((d) => d.type === "blog").slice(0, 3);
    if (posts.length > 0) {
      box.appendChild(groupLabel("Latest from the blog"));
      for (const post of posts) box.appendChild(resultRow(post));
    }
    setActive(0);
  }

  function renderResults(query: string) {
    const box = resultsBox();
    if (!box) return;
    if (!query.trim()) {
      renderDefault(box);
      return;
    }
    const results = search(query.trim());
    box.textContent = "";
    if (results.length === 0) {
      const empty = el("div", "search-empty");
      empty.appendChild(
        el("p", "search-empty-title", `No results for “${query.trim()}”`)
      );
      empty.appendChild(el("p", "search-empty-sub", "Try a different word"));
      box.appendChild(empty);
      renderDefault(box);
      // renderDefault cleared the box — rebuild with the message on top.
      box.prepend(empty);
      return;
    }
    renderGroups(box, results);
    setActive(0);
  }

  // ── Keyboard selection ──

  function rows(): HTMLAnchorElement[] {
    return Array.from(
      resultsBox()?.querySelectorAll<HTMLAnchorElement>(".search-result") ?? []
    );
  }

  function setActive(index: number) {
    const all = rows();
    if (all.length === 0) return;
    activeIndex = (index + all.length) % all.length;
    all.forEach((row, i) =>
      row.setAttribute("aria-selected", String(i === activeIndex))
    );
    all[activeIndex].scrollIntoView({ block: "nearest" });
  }

  // ── Open / close ──

  function openPalette() {
    const d = dialog();
    if (!d || d.open) return;
    lastFocused = document.activeElement as HTMLElement | null;
    d.showModal();
    document.documentElement.style.overflow = "hidden";
    const field = input();
    if (field) {
      field.value = "";
      field.focus();
    }
    loadIndex().then(() => {
      const box = resultsBox();
      if (box && dialog()?.open) renderDefault(box);
    });
  }

  function closePalette() {
    const d = dialog();
    if (d?.open) d.close();
  }

  // ── Document-level delegation (bound once per session) ──

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.closest("[data-search-open]")) {
      e.preventDefault();
      openPalette();
      return;
    }
    const d = dialog();
    if (d?.open) {
      // Click on the backdrop lands on the <dialog> element itself.
      if (target === d) closePalette();
      else if (target.closest(".search-result")) closePalette();
    }
  });

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      dialog()?.open ? closePalette() : openPalette();
      return;
    }
    const d = dialog();
    if (!d?.open) return;
    if (e.key === "ArrowDown") {
      e.preventDefault();
      setActive(activeIndex + 1);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setActive(activeIndex - 1);
    } else if (e.key === "Enter") {
      e.preventDefault();
      rows()[activeIndex]?.click();
    }
  });

  document.addEventListener("input", (e) => {
    if ((e.target as HTMLElement).id !== "search-input") return;
    const value = (e.target as HTMLInputElement).value;
    window.clearTimeout(debounceTimer);
    debounceTimer = window.setTimeout(() => renderResults(value), 80);
  });

  // `close` doesn't bubble — capture phase still sees it.
  document.addEventListener(
    "close",
    (e) => {
      if ((e.target as HTMLElement).id !== "search-palette") return;
      document.documentElement.style.overflow = "";
      lastFocused?.focus?.();
      lastFocused = null;
    },
    true
  );

  document.addEventListener("astro:before-swap", () => {
    closePalette();
    document.documentElement.style.overflow = "";
  });
</script>
