---
// Public "Get a Quote" form — the single shared lead-capture component, used
// on /quote, /contact, the homepage hero, and anywhere else. Multiple
// instances per page are fine: the script binds each `.quote-form` by class
// and reads fields via form.elements, no ids. Pricing cards deep-link with
// ?plan=launch|growth|scale|website|website-local|care|ecommerce|newsletter|custom
// (comma-separated for several), which pre-checks those plan chips on load.
// Plans are checkboxes sharing name="plan"; FormSubmit joins them as "a, b".
// Sent by FormSubmit to the api's /api/agency/send, which emails it to
// a@alisamadii.com (recipient fixed server-side).
import { CARE, NEWSLETTER, PLANS, WEBSITE_PLANS } from "../data/pricing";

interface Props {
  // Compact mode: tighter paddings + no intro copy, for the hero column.
  compact?: boolean;
  // Per-page heading so pages sharing the form don't emit duplicate <h2>s.
  heading?: string;
}
const { compact = false, heading = "Tell us about your business" } = Astro.props;

const inputClass =
  "w-full rounded-xl border border-charcoal/[0.08] bg-white px-4 py-3.5 text-sm text-charcoal transition-all focus:border-accent/30 focus:ring-2 focus:ring-accent/30 focus:outline-none";
// "I'm interested in" chips, grouped. Multi-select.
const planGroups = [
  {
    label: "Google Ads + website",
    options: PLANS.map((plan) => ({
      id: plan.id,
      label: plan.name,
    })),
  },
  {
    label: "Website only",
    options: WEBSITE_PLANS.map((plan) => ({
      id: plan.id,
      label: plan.name,
    })),
  },
  {
    label: "Add-ons",
    options: [
      { id: CARE.id, label: `${CARE.name} plan` },
      { id: NEWSLETTER.id, label: "Managed newsletter" },
    ],
  },
  {
    label: "Other",
    options: [
      { id: "ecommerce", label: "Online store, web app, or integrations" },
      { id: "custom", label: "Not sure yet" },
    ],
  },
];

const labelClass =
  "mb-2 block text-xs font-medium tracking-[0.1em] text-warmgray uppercase";
---

<div
  class="quote-form-card rounded-[18px] bg-charcoal/[0.03] p-1.5 ring-1 ring-charcoal/[0.04]"
>
  <div
    class:list={[
      "rounded-[14px] bg-white text-charcoal",
      compact ? "p-6" : "p-8",
    ]}
  >
    {
      !compact && (
        <>
          <div class="mb-2 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] text-muted uppercase">
            <span class="h-px w-[26px] bg-accent" />
            Get a Quote
          </div>
          <h2 class="text-2xl font-semibold tracking-[-0.02em] text-charcoal">
            {heading}
          </h2>
          <p class="mt-2 max-w-[52ch] text-sm leading-relaxed text-warmgray">
            Share a few details and we'll come back with scope, timeline, and a
            clear price — usually within a day.
          </p>
        </>
      )
    }
    {
      compact && (
        <h2 class="text-lg font-semibold tracking-[-0.02em] text-charcoal">
          Get a free quote
        </h2>
      )
    }

    <form
      class:list={["quote-form space-y-5", compact ? "mt-5" : "mt-8"]}
      data-form="Quote"
      data-success="Thanks, we'll reply within a day."
    >
      <div
        class:list={["grid grid-cols-1 gap-5", compact ? "" : "sm:grid-cols-2"]}
      >
        <div>
          <span class={labelClass}>Name</span>
          <input
            name="name"
            type="text"
            required
            maxlength="200"
            autocomplete="name"
            aria-label="Name"
            class={inputClass}
          />
        </div>
        <div>
          <span class={labelClass}>Email</span>
          <input
            name="email"
            type="email"
            required
            maxlength="200"
            autocomplete="email"
            aria-label="Email"
            class={inputClass}
          />
        </div>
      </div>

      {
        !compact && (
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
              <span class={labelClass}>
                Business <span class="text-muted normal-case">(optional)</span>
              </span>
              <input
                name="business"
                type="text"
                maxlength="200"
                autocomplete="organization"
                aria-label="Business (optional)"
                class={inputClass}
              />
            </div>
            <div>
              <span class={labelClass}>
                Phone <span class="text-muted normal-case">(optional)</span>
              </span>
              <input
                name="phone"
                type="tel"
                maxlength="40"
                autocomplete="tel"
                aria-label="Phone (optional)"
                class={inputClass}
              />
            </div>
          </div>
        )
      }

      <fieldset>
        <legend class={labelClass}>I'm interested in <span class="tracking-normal normal-case">(pick any)</span></legend>
        <div class="flex flex-col gap-3">
          {
            planGroups.map((group) => (
              <div>
                <p class="mb-1.5 text-[11px] text-warmgray">{group.label}</p>
                <div class="flex flex-wrap gap-2">
                  {group.options.map((option) => (
                    <label class="cursor-pointer rounded-full border border-charcoal/[0.1] bg-white px-3.5 py-2 text-sm text-charcoal transition-all select-none hover:border-charcoal/25 has-checked:border-accent has-checked:bg-accent/10 has-focus-visible:ring-2 has-focus-visible:ring-accent/30">
                      <input type="checkbox" name="plan" value={option.id} class="sr-only" />
                      {option.label}
                    </label>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </fieldset>

      <div>
        <span class={labelClass}>Your goals</span>
        <textarea
          name="message"
          rows={compact ? "3" : "4"}
          required
          maxlength="2000"
          aria-label="Your goals"
          placeholder="What do you sell, where, and how do leads come in today?"
          class={`${inputClass} resize-none`}></textarea>
      </div>

      <div>
        <span class={labelClass}>
          Referral code <span class="text-muted normal-case">(optional)</span>
        </span>
        <input
          name="referralCode"
          type="text"
          maxlength="40"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          aria-label="Referral code (optional)"
          placeholder="If a partner sent you"
          class={inputClass}
        />
      </div>

      {/* Honeypot: hidden from people, bots fill it in (the send endpoint drops those). */}
      <input
        type="text"
        name="_hp"
        tabindex="-1"
        autocomplete="off"
        style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden"
        aria-hidden="true"
      />

      <div class="flex flex-col gap-3 pt-1">
        <button
          type="submit"
          class:list={[
            "mag-btn inline-flex w-full items-center justify-center gap-2 rounded-full bg-charcoal px-5 py-3 text-sm font-medium text-cream transition-all duration-300 hover:bg-accent disabled:cursor-not-allowed disabled:opacity-60",
            compact ? "" : "sm:w-auto sm:px-8",
          ]}
        >
          Request a Quote
        </button>
        {/* FormSubmit shows the thank-you here after a successful submit. */}
        <p data-form-message class="text-sm" role="status"></p>
      </div>
    </form>
  </div>
</div>

<script is:inline data-astro-rerun>
  // Pre-check plans from ?plan=a,b (pricing cards + offer CTAs deep-link here).
  // Submission is handled by FormSubmit (Layout); this form just needs
  // data-form, which it has.
  (() => {
    const plans = (new URLSearchParams(location.search).get("plan") || "")
      .split(",")
      .filter(Boolean);
    if (!plans.length) return;
    document.querySelectorAll(".quote-form").forEach((form) => {
      form.querySelectorAll('input[name="plan"]').forEach((input) => {
        if (plans.includes(input.value)) input.checked = true;
      });
    });
  })();
</script>
