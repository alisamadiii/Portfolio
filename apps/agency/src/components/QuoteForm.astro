---
// Public "Get a Quote" form — the single shared lead-capture component, used
// on /quote, /contact, the homepage hero, and anywhere else. Multiple
// instances per page are fine: the script binds each `.quote-form` by class
// and reads fields via form.elements, no ids. Pricing cards deep-link with
// ?plan=launch|growth|scale|website|ecommerce|newsletter|custom, which preselects the plan <select>
// on load.
// Submits to the portfolio quote API, which relays to agency@alisamadii.com
// via the SES contact backend (recipient fixed server-side).
import { PLANS, PRICING, WEBSITE_ONLY, fmtPrice } from "../data/pricing";

interface Props {
  // Compact mode: tighter paddings + no intro copy, for the hero column.
  compact?: boolean;
  // Per-page heading so pages sharing the form don't emit duplicate <h2>s.
  heading?: string;
}
const { compact = false, heading = "Tell us about your business" } = Astro.props;

const inputClass =
  "w-full rounded-xl border border-charcoal/[0.08] bg-white px-4 py-3.5 text-sm text-charcoal transition-all focus:border-accent/30 focus:ring-2 focus:ring-accent/30 focus:outline-none";
const labelClass =
  "mb-2 block text-xs font-medium tracking-[0.1em] text-warmgray uppercase";
---

<div
  class="quote-form-card rounded-[18px] bg-charcoal/[0.03] p-1.5 ring-1 ring-charcoal/[0.04]"
>
  <div
    class:list={[
      "rounded-[14px] bg-white text-charcoal",
      compact ? "p-6" : "p-8",
    ]}
  >
    {
      !compact && (
        <>
          <div class="mb-2 inline-flex items-center gap-2.5 font-mono text-[12.5px] tracking-[0.12em] text-muted uppercase">
            <span class="h-px w-[26px] bg-accent" />
            Get a Quote
          </div>
          <h2 class="text-2xl font-semibold tracking-[-0.02em] text-charcoal">
            {heading}
          </h2>
          <p class="mt-2 max-w-[52ch] text-sm leading-relaxed text-warmgray">
            Share a few details and we'll come back with scope, timeline, and a
            clear price — usually within a day.
          </p>
        </>
      )
    }
    {
      compact && (
        <h2 class="text-lg font-semibold tracking-[-0.02em] text-charcoal">
          Get a free quote
        </h2>
      )
    }

    <form
      class:list={["quote-form space-y-5", compact ? "mt-5" : "mt-8"]}
      data-lead-form="Quote"
      data-success="Thanks, we'll reply within a day."
    >
      <div
        class:list={["grid grid-cols-1 gap-5", compact ? "" : "sm:grid-cols-2"]}
      >
        <div>
          <span class={labelClass}>Name</span>
          <input
            name="name"
            type="text"
            required
            maxlength="200"
            autocomplete="name"
            aria-label="Name"
            class={inputClass}
          />
        </div>
        <div>
          <span class={labelClass}>Email</span>
          <input
            name="email"
            type="email"
            required
            maxlength="200"
            autocomplete="email"
            aria-label="Email"
            class={inputClass}
          />
        </div>
      </div>

      {
        !compact && (
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
              <span class={labelClass}>
                Business <span class="text-muted normal-case">(optional)</span>
              </span>
              <input
                name="business"
                type="text"
                maxlength="200"
                autocomplete="organization"
                aria-label="Business (optional)"
                class={inputClass}
              />
            </div>
            <div>
              <span class={labelClass}>
                Phone <span class="text-muted normal-case">(optional)</span>
              </span>
              <input
                name="phone"
                type="tel"
                maxlength="40"
                autocomplete="tel"
                aria-label="Phone (optional)"
                class={inputClass}
              />
            </div>
          </div>
        )
      }

      <div>
        <span class={labelClass}>I'm interested in</span>
        <select name="plan" aria-label="I'm interested in" class={inputClass}>
          {
            PLANS.map((plan) => (
              <option value={plan.id} selected={plan.featured}>
                {plan.name}: website + Google Ads, {fmtPrice(plan.monthly)}/mo
              </option>
            ))
          }
          <option value={WEBSITE_ONLY.id}
            >Website only, no ads: {fmtPrice(WEBSITE_ONLY.setup)} setup + {
              fmtPrice(WEBSITE_ONLY.monthly)
            }/mo</option
          >
          <option value="ecommerce"
            >E-commerce Storefront (Shopify): {
              fmtPrice(PRICING.ecommerce.setup)
            } setup + {fmtPrice(PRICING.ecommerce.monthly)}/mo</option
          >
          <option value="newsletter">Newsletter for my business: quoted</option>
          <option value="custom">Custom / not sure yet</option>
        </select>
      </div>

      <div>
        <span class={labelClass}>Your goals</span>
        <textarea
          name="message"
          rows={compact ? "3" : "4"}
          required
          maxlength="2000"
          aria-label="Your goals"
          placeholder="What do you sell, where, and how do leads come in today?"
          class={`${inputClass} resize-none`}></textarea>
      </div>

      {/* Honeypot: hidden from people, bots fill it in (leads.js drops those). */}
      <input
        type="text"
        name="_hp"
        tabindex="-1"
        autocomplete="off"
        style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden"
        aria-hidden="true"
      />

      <div class="flex flex-col gap-3 pt-1">
        <button
          type="submit"
          class:list={[
            "mag-btn inline-flex w-full items-center justify-center gap-2 rounded-full bg-charcoal px-5 py-3 text-sm font-medium text-cream transition-all duration-300 hover:bg-accent disabled:cursor-not-allowed disabled:opacity-60",
            compact ? "" : "sm:w-auto sm:px-8",
          ]}
        >
          Request a Quote
        </button>
        {/* leads.js shows the thank-you here after a successful submit. */}
        <p data-lead-message class="text-sm" role="status"></p>
      </div>
    </form>
  </div>
</div>

<script is:inline data-astro-rerun>
  // Preselect the plan from ?plan= (pricing cards + offer CTAs deep-link here).
  // Submission is handled by the shared lead-capture script (leads.js); this form
  // just needs data-lead-form, which it has.
  (() => {
    const plan = new URLSearchParams(location.search).get("plan");
    if (!plan) return;
    document.querySelectorAll(".quote-form").forEach((form) => {
      const select = form.elements.plan;
      if (select && select.querySelector(`option[value="${plan}"]`)) {
        select.value = plan;
      }
    });
  })();
</script>
