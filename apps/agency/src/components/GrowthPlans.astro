---
// Growth partnership tiers. Rendered from src/data/pricing.ts so every page
// (home, /pricing, industry pages, city pages) shows the same numbers.
// Markup mirrors the mockup pricing-card styling (inline styles, not Tailwind).
import { GUARANTEE, PLANS, TERMS_LINE, WEBSITE_ONLY, fmtPrice } from "../data/pricing";

interface Props {
  showTerms?: boolean;
  showWebsiteOnly?: boolean;
  showGuarantee?: boolean;
}

const { showTerms = true, showWebsiteOnly = true, showGuarantee = true } = Astro.props;
---

<div>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 24px; align-items: stretch;">
    {
      PLANS.map((plan) => (
        <article
          style={
            plan.featured
              ? "padding: 6px; border-radius: 24px; background: rgba(252, 132, 100, 0.14); box-shadow: rgba(252, 132, 100, 0.35) 0px 0px 0px 1px, rgba(27, 26, 23, 0.12) 0px 24px 60px; display: flex;"
              : "padding: 6px; border-radius: 24px; background: rgba(27, 26, 23, 0.03); box-shadow: rgba(27, 26, 23, 0.04) 0px 0px 0px 1px, rgba(27, 26, 23, 0.1) 0px 14px 34px; display: flex;"
          }
        >
          <div style="flex: 1 1 0%; border-radius: 18px; background: rgb(255, 254, 252); padding: 32px; display: flex; flex-direction: column; gap: 20px;">
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px;">
              <h3 style="margin: 0px; font-size: 22px; line-height: 1.3; font-weight: 600; letter-spacing: -0.01em;">
                {plan.name}
              </h3>
              {plan.featured ? (
                <span
                  class="mono"
                  style="padding: 5px 10px; border-radius: 9999px; background: rgb(252, 132, 100); color: rgb(27, 26, 23); font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;"
                >
                  Most popular
                </span>
              ) : (
                <span
                  class="mono"
                  style="padding: 5px 10px; border-radius: 9999px; background: rgba(27, 26, 23, 0.05); font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;"
                >
                  Ads up to {fmtPrice(plan.adSpendCap / 1000)}k/mo
                </span>
              )}
            </div>
            <p style="margin: 0px; display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px;">
              <span style="font-size: 44px; line-height: 1; font-weight: 600; letter-spacing: -0.03em;">
                {fmtPrice(plan.monthly)}
              </span>
              <span class="mono" style="font-size: 15px; color: rgb(103, 98, 90);">
                /mo
              </span>
            </p>
            <p style="margin: 0px; font-size: 15px; line-height: 1.55; color: rgb(103, 98, 90);">
              {plan.blurb}
            </p>
            <ul style="margin: 0px; padding: 20px 0px 0px; list-style: none; border-top: 1px solid rgba(27, 26, 23, 0.07); display: flex; flex-direction: column; gap: 12px; font-size: 15px; line-height: 1.45;">
              {plan.features.map((f) => (
                <li style="display: flex; gap: 10px;">
                  <span aria-hidden="true" style="color: rgb(47, 107, 63); font-weight: 600;">
                    ✓
                  </span>
                  {f}
                </li>
              ))}
            </ul>
            <a
              href={`/quote?plan=${plan.id}`}
              class={plan.featured ? "btn btn-primary" : "btn btn-secondary"}
              style={
                plan.featured
                  ? "margin-top: auto; display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; border-radius: 11px; background: rgb(252, 132, 100); color: rgb(27, 26, 23); font-size: 15px; font-weight: 500; text-decoration: none; box-shadow: rgba(252, 132, 100, 0.32) 0px 8px 24px;"
                  : "margin-top: auto; display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; border-radius: 11px; background: rgb(27, 26, 23); color: rgb(246, 245, 243); font-size: 15px; font-weight: 500; text-decoration: none; box-shadow: rgba(27, 26, 23, 0.22) 0px 8px 24px;"
              }
            >
              Start a Project <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))
    }
  </div>
  {
    showGuarantee && (
      <section aria-label="Our guarantee" style="margin-top: 32px; padding: 32px; border-radius: 24px; background: rgb(27, 26, 23); color: rgb(246, 245, 243); display: flex; flex-direction: column; gap: 24px;">
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px;">
          <span
            class="mono"
            style="padding: 5px 10px; border-radius: 9999px; background: rgb(252, 132, 100); color: rgb(27, 26, 23); font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;"
          >
            Our guarantee
          </span>
          <h3 style="margin: 0px; font-size: clamp(22px, 2.4vw, 28px); line-height: 1.2; font-weight: 600; letter-spacing: -0.02em;">
            {GUARANTEE.headline}
          </h3>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px 40px;">
          <div style="display: flex; flex-direction: column; gap: 8px;">
            <p class="mono" style="margin: 0px; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(252, 132, 100);">
              Lead guarantee · {GUARANTEE.days} days
            </p>
            <p style="margin: 0px; font-size: 16px; line-height: 1.6; color: rgb(214, 209, 200);">
              {GUARANTEE.leads}
            </p>
          </div>
          <div style="display: flex; flex-direction: column; gap: 8px;">
            <p class="mono" style="margin: 0px; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(252, 132, 100);">
              On-time guarantee
            </p>
            <p style="margin: 0px; font-size: 16px; line-height: 1.6; color: rgb(214, 209, 200);">
              {GUARANTEE.process}
            </p>
          </div>
        </div>
        <p class="mono" style="margin: 0px; padding-top: 16px; border-top: 1px solid rgba(246, 245, 243, 0.12); font-size: 12px; line-height: 1.6; color: rgb(160, 154, 145);">
          {GUARANTEE.fine}
        </p>
      </section>
    )
  }
  {
    showTerms && (
      <p class="mono" style="margin: 28px 0px 0px; text-align: center; font-size: 13px; line-height: 1.6; letter-spacing: 0.02em; color: rgb(107, 102, 93);">
        {TERMS_LINE}
      </p>
    )
  }
  {
    showWebsiteOnly && (
      <p style="margin: 20px 0px 0px; text-align: center; font-size: 15px; line-height: 1.6; color: rgb(103, 98, 90);">
        Just need a website, no ads?{" "}
        <strong style="font-weight: 600; color: rgb(27, 26, 23);">
          {fmtPrice(WEBSITE_ONLY.setup)} + {fmtPrice(WEBSITE_ONLY.monthly)}/mo
        </strong>{" "}
        &middot;{" "}
        <a href="/websites" class="tlink" style="font-weight: 500; color: rgb(27, 26, 23);">
          See website plans →
        </a>
      </p>
    )
  }
</div>
