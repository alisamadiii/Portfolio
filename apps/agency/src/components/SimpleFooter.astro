---
const year = new Date().getFullYear();
---

<footer class="border-t border-charcoal/[0.06] px-4 py-12 md:px-8">
  <div
    class="mx-auto flex max-w-[1400px] flex-col items-center justify-center gap-x-6 gap-y-3 text-center md:flex-row md:justify-between"
  >
    <p class="text-sm text-warmgray">
      &copy; {year} Ali Samadi Agency. All rights reserved.
    </p>
    <nav class="flex items-center gap-5 text-sm text-warmgray">
      <a
        href="/privacy"
        class="transition-colors duration-300 hover:text-charcoal">Privacy</a
      >
      <a
        href="/terms"
        class="transition-colors duration-300 hover:text-charcoal">Terms</a
      >
      <a
        href="/locations"
        class="transition-colors duration-300 hover:text-charcoal">Locations</a
      >
      <a href="/" class="transition-colors duration-300 hover:text-charcoal"
        >Back to Home</a
      >
    </nav>
  </div>
</footer>
