  <div
    class="mx-auto flex max-w-[1400px] flex-col items-center justify-center gap-x-6 gap-y-3 text-center md:flex-row md:justify-between"
  >
    <p class="text-warmgray text-sm">
      &copy; {year} Ali Samadi Agency. All rights reserved.
    </p>
    <nav class="text-warmgray flex items-center gap-5 text-sm">
      <a href="/privacy" class="hover:text-charcoal transition-colors duration-300"
        >Privacy</a
      >
      <a href="/terms" class="hover:text-charcoal transition-colors duration-300"
        >Terms</a
      >
      <a href="/" class="hover:text-charcoal transition-colors duration-300"
        >Back to Home</a
      >
    </nav>
  </div>
</footer>
