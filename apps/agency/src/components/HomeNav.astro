---
import SearchTrigger from "./SearchTrigger.astro";
---

<nav
  class="fixed top-0 left-0 z-40 w-full border-b border-charcoal/[0.07] bg-cream/70 px-6 py-4 backdrop-blur-[14px] md:px-10"
>
  <div class="mx-auto flex max-w-[1200px] items-center justify-between">
    <a
      href="#"
      class="flex items-center gap-2.5 text-[17px] font-semibold tracking-[-0.02em]"
    >
      <img
        src="https://cdn.alisamadii.com/company/business-logo-soft-rounded.png"
        alt="alisamadii logo"
        width="26"
        height="26"
        class="h-[26px] w-[26px]"
      />
      alisamadii
    </a>
    <div class="hidden items-center gap-8 text-[14.5px] text-warmgray md:flex">
      <a
        href="/services"
        class="transition-colors duration-300 hover:text-accent">Services</a
      >
      <a
        href="/ecommerce"
        class="transition-colors duration-300 hover:text-accent">E-commerce</a
      >
      <a href="/about" class="transition-colors duration-300 hover:text-accent"
        >About</a
      >
      <a href="/work" class="transition-colors duration-300 hover:text-accent"
        >Work</a
      >
      <a href="/blog" class="transition-colors duration-300 hover:text-accent"
        >Blog</a
      >
      <a
        href="#pricing"
        class="transition-colors duration-300 hover:text-accent">Pricing</a
      >
      <a
        href="#contact"
        class="transition-colors duration-300 hover:text-accent">Contact</a
      >
    </div>
    <div class="hidden items-center gap-4 md:flex">
      <SearchTrigger />
      <a
        href="https://hub.alisamadii.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-warmgray transition-colors duration-300 hover:text-charcoal"
        >I am a customer &rarr;</a
      >
      <a
        href="#contact"
        class="mag-btn inline-flex items-center gap-2 rounded-[9px] bg-charcoal px-[17px] py-[9px] text-sm font-medium text-cream hover:bg-accent"
      >
        Start a Project
        <span class="text-[13px]">&#8599;</span>
      </a>
    </div>
    <!-- Mobile search + hamburger -->
    <div class="flex items-center md:hidden">
      <SearchTrigger variant="mobile" />
      <button
        id="menuToggle"
        aria-label="Toggle menu"
        class="z-50 flex size-11 flex-col items-center justify-center gap-1.5"
      >
        <span
          class="block h-[1.5px] w-6 origin-center bg-charcoal transition-all duration-300"
          id="line1"></span>
        <span
          class="block h-[1.5px] w-6 origin-center bg-charcoal transition-all duration-300"
          id="line2"></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile menu overlay -->
<div
  id="menuOverlay"
  class="menu-overlay fixed inset-0 z-30 flex flex-col items-start justify-center bg-cream/95 px-8 backdrop-blur-2xl"
>
  <div class="stagger space-y-5">
    <a
      href="/services"
      class="reveal block text-4xl font-semibold tracking-[-0.03em] text-charcoal"
      onclick="closeMenu()">Services</a
    >
    <a
      href="/ecommerce"
      class="reveal block text-4xl font-semibold tracking-[-0.03em] text-charcoal"
      onclick="closeMenu()">E-commerce</a
    >
    <a
      href="/about"
      class="reveal block text-4xl font-semibold tracking-[-0.03em] text-charcoal"
      onclick="closeMenu()">About</a
    >
    <a
      href="/work"
      class="reveal block text-4xl font-semibold tracking-[-0.03em] text-charcoal"
      onclick="closeMenu()">Work</a
    >
    <a
      href="/blog"
      class="reveal block text-4xl font-semibold tracking-[-0.03em] text-charcoal"
      onclick="closeMenu()">Blog</a
    >
    <a
      href="#pricing"
      class="reveal block text-4xl font-semibold tracking-[-0.03em] text-charcoal"
      onclick="closeMenu()">Pricing</a
    >
    <a
      href="#contact"
      class="reveal block text-4xl font-semibold tracking-[-0.03em] text-accent"
      onclick="closeMenu()">Contact</a
    >
    <a
      href="https://hub.alisamadii.com"
      class="reveal mt-4 block text-lg text-warmgray"
      onclick="closeMenu()">I am a customer &rarr;</a
    >
  </div>
</div>
