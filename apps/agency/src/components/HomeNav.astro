---
import home from "../data/home.json";

const { nav } = home;
---

<nav
  class="border-charcoal/[0.07] bg-cream/70 fixed top-0 left-0 z-40 w-full border-b px-6 py-4 backdrop-blur-[14px] md:px-10"
>
  <div class="mx-auto flex max-w-[1200px] items-center justify-between">
    <a
      href="#"
      class="flex items-center gap-2.5 text-[17px] font-semibold tracking-[-0.02em]"
    >
      <img
        src="https://cdn.alisamadii.com/company/business-logo-soft-rounded.png"
        alt="alisamadii logo"
        class="h-[26px] w-[26px]"
      />
      <span data-cms-field="nav.brand">{nav.brand}</span>
    </a>
    <div class="text-warmgray hidden items-center gap-8 text-[14.5px] md:flex">
      {
        nav.links.map((link, i) => (
          <a
            href={link.href}
            class="hover:text-accent transition-colors duration-300"
            data-cms-field={`nav.links.${i}`}
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="hidden items-center gap-4 md:flex">
      <a
        href={nav.customer.href}
        target="_blank"
        class="text-warmgray hover:text-charcoal text-sm transition-colors duration-300"
        data-cms-field="nav.customer"
        >{nav.customer.label} &rarr;</a
      >
      <a
        href={nav.cta.href}
        class="mag-btn bg-charcoal hover:bg-accent inline-flex items-center gap-2 rounded-[9px] px-[17px] py-[9px] text-sm font-medium text-white"
        data-cms-field="nav.cta"
      >
        {nav.cta.label}
        <span class="text-[13px]">&#8599;</span>
      </a>
    </div>
    <!-- Mobile hamburger -->
    <button
      id="menuToggle"
      aria-label="Toggle menu"
      class="z-50 flex size-10 flex-col items-center justify-center gap-1.5 md:hidden"
    >
      <span
        class="bg-charcoal block h-[1.5px] w-6 origin-center transition-all duration-300"
        id="line1"></span>
      <span
        class="bg-charcoal block h-[1.5px] w-6 origin-center transition-all duration-300"
        id="line2"></span>
    </button>
  </div>
</nav>

<!-- Mobile menu overlay -->
<div
  id="menuOverlay"
  class="menu-overlay bg-cream/95 fixed inset-0 z-30 flex flex-col items-start justify-center px-8 backdrop-blur-2xl"
>
  <div class="stagger space-y-5">
    {
      nav.links.map((link, i) => (
        <a
          href={link.href}
          class={`reveal ${i === nav.links.length - 1 ? "text-accent" : "text-charcoal"} block text-4xl font-semibold tracking-[-0.03em]`}
          onclick="closeMenu()"
          data-cms-field={`nav.links.${i}`}
        >
          {link.label}
        </a>
      ))
    }
    <a
      href={nav.customer.href}
      class="reveal text-warmgray mt-4 block text-lg"
      onclick="closeMenu()"
      data-cms-field="nav.customer"
      >{nav.customer.label} &rarr;</a
    >
  </div>
</div>
