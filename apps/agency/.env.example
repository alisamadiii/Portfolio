# Base URL of the api app — the on-demand /[slug] URL-shortener route calls it
# to resolve a slug to its target. Defaults to https://api.alisamadii.com.
API_URL=https://api.alisamadii.com

# /showcase: pre-built client sites from the client-websites R2 bucket. Use a
# READ-ONLY token scoped to that bucket. Only preview.mp4, preview.jpg and
# _meta.json are ever read; without these the showcase renders empty.
SHOWCASE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
SHOWCASE_R2_ACCESS_KEY_ID=
SHOWCASE_R2_SECRET_ACCESS_KEY=
SHOWCASE_R2_BUCKET=client-websites
