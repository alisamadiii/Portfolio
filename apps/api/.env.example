# The `api` app is the single source of truth for the backend
# (https://api.alisamadii.com): tRPC, the Better Auth server, agency endpoints,
# Stripe + GitHub webhooks, and the weekly cron. Every other app in the fleet
# points NEXT_PUBLIC_API_URL / VITE_API_URL at it.

DATABASE_URL=

BETTER_AUTH_SECRET=

# This app's own base URL. Local dev: http://localhost:3000. Prod: https://api.alisamadii.com
NEXT_PUBLIC_API_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App ("Ali Samadi App") — the ONLY repo credential: owners install it
# on their repos, the platform mints per-installation tokens for reads/commits.
# GITHUB_APP_PRIVATE_KEY is the base64 of GitHub's PKCS#1 PEM (single line):
#   base64 < ali-samadi-app.private-key.pem | tr -d '\n'
# MUST match content-pilot's GITHUB_APP_ID / GITHUB_APP_PRIVATE_KEY.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_NAME= # the app's slug (install URL: github.com/apps/<slug>)
GITHUB_APP_WEBHOOK_SECRET= # webhook secret for /api/webhook/github-app

STRIPE_SECRET_KEY= # sandbox (test) key locally, live key on production
STRIPE_WEBHOOK_SECRET= # sandbox (test) key locally, live key on production

INTERNAL_API_SECRET= # shared secret for server-to-server tRPC calls
CRON_SECRET= # Bearer secret guarding /api/cron/* (Coolify scheduled task sends it)
EDIT_TOKEN_SECRET= # HMAC secret for canvas-editor edit tokens; MUST match content-pilot's EDIT_TOKEN_SECRET
CONTENT_PILOT_URL= # content-pilot base URL (e.g. https://pilot.alisamadii.com)
CONTENT_PILOT_API_KEY= # content-pilot cp_ api key for server-to-server job reads (Deployments view)
CONTENT_PILOT_WEBHOOK_SECRET= # signing secret of the content-pilot webhook targeting this app (whsec_…); emails the owner on rejected/failed AI edits

# Cloudflare R2 media library (packages/trpc lib/r2.ts: presign/list/delete for
# the admin /media page and lead/client uploads). ALL FIVE must be set or every
# media call throws "R2 storage is not configured". R2 > Manage API Tokens >
# Object Read & Write token gives the key id + secret.
R2_ENDPOINT= # https://<account_id>.r2.cloudflarestorage.com (no bucket in path)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET= # the media bucket name
R2_PUBLIC_BASE_URL= # public base the objects are served from, no trailing slash (bucket public dev URL or custom domain)

# useSend (self-hosted, mail.alisamadii.com) — all email: auth, quote form, newsletter
USESEND_API_KEY= # shared/admin-level team key (fallback for domain-less sends)
USESEND_CONTACT_BOOK_ID= # newsletter contact book (double opt-in adds/unsubscribes)
USESEND_URL=https://mail.alisamadii.com # default, override for another instance
# Instance admin key (useSend USESEND_ADMIN_API_KEY) — provisions a per-project
# team at import via POST /api/v1/workspaces. Without it, project email setup fails.
USESEND_ADMIN_API_KEY=
# Shared agency sending domain; must match the useSend instance's
# USESEND_SHARED_SENDING_DOMAIN. The contact script sends from contact@<this>.
USESEND_AGENCY_DOMAIN=alisamadii.com

GA_API_SECRET= # GA4 Measurement Protocol secret — server-side purchase events

GOOGLE_PLACES_API_KEY=

# Google Ads API (agency MCC): client ad stats + offline closed-deal conversions.
# All five must be set or the agency Ads tab shows 'not connected'.
GOOGLE_ADS_DEVELOPER_TOKEN= # MCC > Admin > API Center
GOOGLE_ADS_CLIENT_ID= # Google Cloud OAuth client (Web app, redirect = OAuth Playground)
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN= # adwords scope, minted once by the MCC login
GOOGLE_ADS_LOGIN_CUSTOMER_ID= # MCC id, digits only
GOOGLE_ADS_API_VERSION= # optional, defaults to v25

# Self-hosted (non-Vercel) deploy settings.
# NODE_ENV=production (set automatically by next start / the Coolify container)
# selects LIVE Stripe prices in packages/trpc/src/lib/features.ts.
EXTRA_ALLOWED_ORIGIN= # optional extra CORS origin for the api (e.g. the Coolify app URL)
