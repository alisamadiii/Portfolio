# The `api` app is the single source of truth for the backend
# (https://api.alisamadii.com): tRPC, the Better Auth server, agency endpoints,
# Stripe + GitHub webhooks, and the weekly cron. Every other app in the fleet
# points NEXT_PUBLIC_API_URL / VITE_API_URL at it.

DATABASE_URL=

BETTER_AUTH_SECRET=

# This app's own base URL. Local dev: http://localhost:3000. Prod: https://api.alisamadii.com
NEXT_PUBLIC_API_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Netlify OAuth app (hub Integrations → deploy upload projects to the user's
# own Netlify). Redirect URI: <NEXT_PUBLIC_API_URL>/api/auth/oauth2/callback/netlify
NETLIFY_CLIENT_ID=
NETLIFY_CLIENT_SECRET=
# Agency personal access token: hosts upload projects when the user hasn't
# connected their own Netlify.
NETLIFY_AGENCY_TOKEN=

# Resend OAuth client (hub Resend app: client links Resend so the hub can
# read domains/emails and mint API keys). Registered via POST
# https://api.resend.com/oauth/register; the secret is shown once.
# Redirect URI: <NEXT_PUBLIC_API_URL>/api/auth/oauth2/callback/resend
RESEND_CLIENT_ID=
RESEND_CLIENT_SECRET=
# Neon OAuth client (hub Neon app). Partner-only: issued by Neon.
# Redirect URI: <NEXT_PUBLIC_API_URL>/api/auth/oauth2/callback/neon
NEON_CLIENT_ID=
NEON_CLIENT_SECRET=
# Wix app (hub Wix app, installed on the client's Wix site). Set on Coolify.
# manage.wix.com/account/custom-apps -> app -> OAuth: App ID + App secret.
# WIX_SHARE_URL_ID: GUID from the app's share install link
# (https://www.wix.com/app-market/install/<GUID>).
# Install callback: <NEXT_PUBLIC_API_URL>/api/wix/callback (passed at runtime).
WIX_APP_ID=
WIX_APP_SECRET=
WIX_SHARE_URL_ID=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App ("Ali Samadi App") — the ONLY repo credential: owners install it
# on their repos, the platform mints per-installation tokens for reads/commits.
# GITHUB_APP_PRIVATE_KEY is the base64 of GitHub's PKCS#1 PEM (single line):
#   base64 < ali-samadi-app.private-key.pem | tr -d '\n'
# MUST match content-pilot's GITHUB_APP_ID / GITHUB_APP_PRIVATE_KEY.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_NAME= # the app's slug (install URL: github.com/apps/<slug>)
GITHUB_APP_WEBHOOK_SECRET= # webhook secret for /api/webhook/github-app

STRIPE_SECRET_KEY= # sandbox (test) key locally, live key on production
STRIPE_WEBHOOK_SECRET= # sandbox (test) key locally, live key on production

INTERNAL_API_SECRET= # shared secret for server-to-server tRPC calls
EDIT_TOKEN_SECRET= # HMAC secret for canvas-editor edit tokens; MUST match content-pilot's EDIT_TOKEN_SECRET

# GitHub backup of upload projects: the hub creates/links/archives repos in this org and
# tells content-pilot which repo to push main to; Source Code downloads read from it.
# Fine-grained PAT on the org: Administration RW + Contents R (pilot's own: Contents RW).
GITHUB_BACKUP_ORG=
GITHUB_BACKUP_TOKEN=
CONTENT_PILOT_URL= # content-pilot base URL (e.g. https://pilot.alisamadii.com)
CONTENT_PILOT_API_KEY= # content-pilot cp_ api key for server-to-server job reads (Deployments view)
CONTENT_PILOT_WEBHOOK_SECRET= # signing secret of the content-pilot webhook targeting this app (whsec_…); emails the owner on rejected/failed AI edits

# Cloudflare R2 media library (packages/trpc lib/r2.ts: presign/list/delete for
# the admin /media page and lead/client uploads). ALL FIVE must be set or every
# media call throws "R2 storage is not configured". R2 > Manage API Tokens >
# Object Read & Write token gives the key id + secret.
R2_ENDPOINT= # https://<account_id>.r2.cloudflarestorage.com (no bucket in path)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET= # the media bucket name
R2_PUBLIC_BASE_URL= # public base the objects are served from, no trailing slash (bucket public dev URL or custom domain)
R2_PRIVATE_BUCKET= # private bucket, NO public domain: signed partner agreements + payout receipts (presigned GETs only)
CLIENT_WEBSITES_ORIGIN_ADDRESS= # optional: start of the driving route on the hub /client-websites map (e.g. the agency address)

# Leads inbox texting (lib/sms): one agency account per provider; numbers bought per project in the hub
SMS_PROVIDER= # zernio (default) | telnyx: which provider the hub buys numbers on and sends with
ZERNIO_API_KEY= # zernio.com dashboard > API keys
ZERNIO_WEBHOOK_SECRET= # any random string (openssl rand -hex 32); the hub registers the Zernio webhook with it
ZERNIO_WEBHOOK_URL= # optional: override https://api.alisamadii.com/api/webhook/zernio (e.g. a local tunnel)
TELNYX_API_KEY= # Telnyx portal > Auth > API Keys
TELNYX_PUBLIC_KEY= # Telnyx portal > Keys & Credentials > Public Key (verifies /api/webhook/telnyx)
TELNYX_WEBHOOK_URL= # optional: override the webhook URL new messaging profiles get (e.g. a local tunnel)

# Leads inbox email replies: SES us-west-2 receives mail for INBOX_REPLY_DOMAIN (MX on Cloudflare),
# rule set "hub-inbound" stores it in S3 + notifies SNS -> POST /api/webhook/ses-inbound
INBOX_REPLY_DOMAIN= # reply.alisamadii.com (unset = replies go to the owner's own inbox)
INBOX_REPLY_SECRET= # random 32+ bytes hex; signs r+<leadId>.<sig>@ reply addresses (changing it breaks old reply links)
INBOUND_SNS_TOPIC_ARN= # arn:aws:sns:us-west-2:135808932294:lead-replies
INBOUND_S3_BUCKET= # alisamadii-inbound-mail
INBOUND_AWS_REGION= # us-west-2
INBOUND_AWS_ACCESS_KEY_ID= # IAM user api-inbound-mail (s3:GetObject on the bucket only)
INBOUND_AWS_SECRET_ACCESS_KEY=

# useSend (self-hosted, mail.alisamadii.com) — all email: auth, quote form, newsletter
USESEND_API_KEY= # shared/admin-level team key (fallback for domain-less sends)
USESEND_CONTACT_BOOK_ID= # newsletter contact book (double opt-in adds/unsubscribes)
USESEND_URL=https://mail.alisamadii.com # default, override for another instance
# Instance admin key (useSend USESEND_ADMIN_API_KEY) — provisions a per-project
# team at import via POST /api/v1/workspaces. Without it, project email setup fails.
USESEND_ADMIN_API_KEY=
# Shared agency sending domain; must match the useSend instance's
# USESEND_SHARED_SENDING_DOMAIN. The contact script sends from contact@<this>.
USESEND_AGENCY_DOMAIN=alisamadii.com

GA_API_SECRET= # GA4 Measurement Protocol secret — server-side purchase events

GOOGLE_PLACES_API_KEY=

# Google Reviews app: Apify token (compass/google-maps-reviews-scraper). The
# daily Coolify task hitting /api/cron/google-reviews sends INTERNAL_API_SECRET.
APIFY_TOKEN=

# Site Monitor page: sitewatch (agency-toolkit/apps/sitewatch). Key from its
# Account page (x-api-key); one key sees every monitored site.
SITEWATCH_URL=https://site-monitor.alisamadii.com
SITEWATCH_API_KEY=

# Automations page: Flows (agency-toolkit/apps/flows). An ADMIN key from Flows
# (`pnpm admin-key "Client hub"`); it only mints one-time iframe links, each
# pinned to one hub project. Flows must list the hub in EMBED_ALLOWED_ORIGINS.
FLOWS_URL=https://flows.alisamadii.com
FLOWS_API_KEY=

# Uber Eats app (developer.uber.com/dashboard, API suite "Eats Marketplace",
# the agency's one app for every client store). Redirect URI in the Uber app:
# <NEXT_PUBLIC_API_URL>/api/uber-eats/callback. Webhook URL:
# <NEXT_PUBLIC_API_URL>/api/webhook/uber-eats (signed with the client secret).
# UBER_EATS_ENV=sandbox (default, test-api.uber.com) or production once Uber
# approves the app. The hourly Coolify task hitting /api/cron/uber-eats sends
# INTERNAL_API_SECRET.
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
UBER_EATS_ENV=sandbox
# Local only: point both at the stand-in Uber server (pnpm uber:mock, port 4010).
# UBER_EATS_AUTH_URL=http://localhost:4010
# UBER_EATS_API_URL=http://localhost:4010

# DoorDash app (developer.doordash.com/portal, Marketplace for Restaurants,
# the agency's one integration for every client store). Sandbox and production
# have separate access keys; same API host. Redirect URL on the OAuth client:
# <NEXT_PUBLIC_API_URL>/api/doordash/callback. Webhook subscriptions (onboarding
# status + Menu Request) point at <NEXT_PUBLIC_API_URL>/api/webhook/doordash and
# <NEXT_PUBLIC_API_URL>/api/doordash/menu with DOORDASH_WEBHOOK_TOKEN as the
# portal's "Auth token". DOORDASH_ENV is a label only (sandbox | production).
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
DOORDASH_OAUTH_CLIENT_ID=
DOORDASH_WEBHOOK_TOKEN=
DOORDASH_ENV=sandbox
# Local only: point both at a stand-in DoorDash server.
# DOORDASH_AUTH_URL=http://localhost:4011
# DOORDASH_API_URL=http://localhost:4011

# Grubhub app (developer.grubhub.com, Marketplace API, the agency's one partner
# integration for every client store). Credentials come from the Grubhub team
# after the kickoff call: Partner Key, Client ID (sv:v1:<uuid>), Secret and the
# Issue Date (ISO date or epoch ms). Preprod and production are separate hosts
# and separate credentials; GRUBHUB_ENV=preprod (default) or production.
# Webhook URL to give Grubhub (one URL for every webhook type, Basic auth):
# <NEXT_PUBLIC_API_URL>/api/webhook/grubhub with GRUBHUB_WEBHOOK_USER / PASSWORD.
# Menu URL for phase 2 ingestion: <NEXT_PUBLIC_API_URL>/api/grubhub/menu/<projectId>.
# The hourly Coolify task hitting /api/cron/uber-eats reconciles Grubhub too.
GRUBHUB_PARTNER_KEY=
GRUBHUB_CLIENT_ID=
GRUBHUB_CLIENT_SECRET=
GRUBHUB_ISSUE_DATE=
GRUBHUB_ENV=preprod
GRUBHUB_WEBHOOK_USER=
GRUBHUB_WEBHOOK_PASSWORD=
# Local only: point at the stand-in Grubhub server (pnpm grubhub:mock, port 4011).
# GRUBHUB_API_URL=http://localhost:4011

# Shopify app (Shopify Dev Dashboard, the agency's one public app for every
# client shop). App URL: <NEXT_PUBLIC_API_URL>/api/shopify/install
# Redirect URL: <NEXT_PUBLIC_API_URL>/api/shopify/callback
# Compliance webhooks (customers/data_request, customers/redact, shop/redact):
# <NEXT_PUBLIC_API_URL>/api/webhook/shopify. app/uninstalled is registered per
# shop at connect. The client secret also signs every webhook.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Google Ads API (agency MCC): client ad stats + offline closed-deal conversions.
# All five must be set or the agency Ads tab shows 'not connected'.
GOOGLE_ADS_DEVELOPER_TOKEN= # MCC > Admin > API Center
GOOGLE_ADS_CLIENT_ID= # Google Cloud OAuth client (Web app, redirect = OAuth Playground)
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN= # adwords scope, minted once by the MCC login
GOOGLE_ADS_LOGIN_CUSTOMER_ID= # MCC id, digits only
GOOGLE_ADS_API_VERSION= # optional, defaults to v25

# Self-hosted (non-Vercel) deploy settings.
# NODE_ENV=production (set automatically by next start / the Coolify container)
# selects LIVE Stripe prices in packages/trpc/src/lib/features.ts.
EXTRA_ALLOWED_ORIGIN= # optional extra CORS origin for the api (e.g. the Coolify app URL)
