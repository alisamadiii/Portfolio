{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@workspace/drizzle/*": ["../../packages/drizzle/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
