# Cloudflare R2 (S3-compatible API). Use a token scoped to this one bucket:
# read-only for the deployed app, read + write only where `pnpm upload` runs.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=client-websites

# Basic Auth for the whole app. Required in production; leave APP_PASSWORD
# empty in local dev to skip the prompt.
APP_USER=ali
APP_PASSWORD=

# Location dialog: the map shows the driving route from here to the client.
ORIGIN_ADDRESS=

# Payment links. Local: sandbox sk_test_ key. Production: restricted key with
# Customers + Checkout Sessions write, Products + Prices read.
STRIPE_SECRET_KEY=

# Port the server listens on (dev: Vite on 3027 proxies to this).
PORT=3028
