AGENCY_API_KEY= # agency-api key (ak_live_...) for email + media uploads

GITHUB_ORG= # GitHub org holding all client repos (used by the CMS)
GITHUB_TOKEN= # fine-grained PAT (org resource owner, all repos, Contents RW + Metadata R); rotate before expiry
GITHUB_WEBHOOK_SECRET= # org webhook HMAC secret (webhook points at this app's /api/webhook/github)
INTERNAL_API_SECRET= # shared secret for server-to-server tRPC calls

# CMS cache tuning (optional)
# CACHE_CHECK_MIN=5
# CONFIG_CHECK_MIN=5
# FILE_TTL_MIN=1440
# BRANCH_HEAD_TTL_MS=15000
# REPO_META_TTL_MS=15000
# WEBHOOK_PUSH_INCREMENTAL_MAX_FILES=120
# WEBHOOK_PUSH_SCOPED_INVALIDATION_MAX_FILES=800


CLICKUP_API_TOKEN=

STRIPE_SECRET_KEY= # sandbox (test) key locally, live key on Vercel production
STRIPE_WEBHOOK_SECRET= # sandbox (test) key locally, live key on Vercel production

VERCEL_TOKEN= # Vercel REST API token (team scope) — Account Settings → Tokens
VERCEL_TEAM_ID= # team_... id of the Pro team owning the client projects
VERCEL_WEBHOOK_SECRET= # shown once when creating the team webhook (→ /api/webhook/vercel)
