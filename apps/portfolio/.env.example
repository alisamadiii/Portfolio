# Portfolio is a frontend-only app: the personal/marketing site UI. All backend
# logic (tRPC, auth, agency endpoints, webhooks, cron, the URL shortener) lives
# in the `api` app; the shortener redirect now lives on the agency site. Portfolio
# holds no database connection and no secrets — it only needs the api base URL.

# Backend/api base URL. Local dev: http://localhost:3000 (the api app's port).
# Production: https://api.alisamadii.com
NEXT_PUBLIC_API_URL=http://localhost:3000
