# Portfolio is a frontend-only app: the marketing/personal site plus the public
# URL-shortener redirect (/[slug]). All backend logic — tRPC, the auth server,
# agency endpoints, webhooks, cron, and the admin /api/links CRUD — lives in the
# `api` app. No auth secret lives here; the redirect only reads the DB.

# Neon Postgres — the /[slug] redirect looks up the slug + bumps its click count.
DATABASE_URL=

# Backend/api base URL. Local dev: http://localhost:3000 (the api app's port).
# Production: https://api.alisamadii.com
NEXT_PUBLIC_API_URL=http://localhost:3000
