DATABASE_URL=

BETTER_AUTH_SECRET=

NEXT_PUBLIC_API_URL= # DEFAULT FOR ALL APPS

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_DOMAIN=
NEXT_PUBLIC_EMAIL_DOMAIN=

POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=
NEXT_PUBLIC_POLAR_URL=
NEXT_PUBLIC_MOTION_PRODUCT=

# R2 storage (media uploads via tRPC uploads router)
R2_ENDPOINT= # https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL= # e.g. https://cdn.alisamadii.com

# Twenty CRM (self-hosted, crm.alisamadii.com) — quote form leads; key from Settings → APIs
TWENTY_API_KEY=
# TWENTY_API_URL=https://crm.alisamadii.com # default, override for another instance

# useSend (self-hosted, mail.alisamadii.com) — all email: auth, quote form, newsletter
USESEND_API_KEY=
USESEND_CONTACT_BOOK_ID= # newsletter contact book (double opt-in adds/unsubscribes)
# USESEND_URL=https://mail.alisamadii.com # default, override for another instance

GITHUB_ORG= # GitHub org holding all client repos (used by the CMS)
GITHUB_TOKEN= # fine-grained PAT (org resource owner, all repos, Contents RW + Metadata R); rotate before expiry
GITHUB_WEBHOOK_SECRET= # org webhook HMAC secret (webhook points at this app's /api/webhook/github)
INTERNAL_API_SECRET= # shared secret for server-to-server tRPC calls

# CMS cache tuning (optional)
# CACHE_CHECK_MIN=5
# CONFIG_CHECK_MIN=5
# FILE_TTL_MIN=1440
# BRANCH_HEAD_TTL_MS=15000
# REPO_META_TTL_MS=15000
# WEBHOOK_PUSH_INCREMENTAL_MAX_FILES=120
# WEBHOOK_PUSH_SCOPED_INVALIDATION_MAX_FILES=800


CLICKUP_API_TOKEN=

STRIPE_SECRET_KEY= # sandbox (test) key locally, live key on Vercel production
STRIPE_WEBHOOK_SECRET= # sandbox (test) key locally, live key on Vercel production

GA_API_SECRET= # GA4 Measurement Protocol secret (GA Admin → Data streams → agency stream → MP API secrets) — server-side purchase events

VERCEL_TOKEN= # Vercel REST API token (team scope) — Account Settings → Tokens
VERCEL_TEAM_ID= # team_... id of the Pro team owning the client projects
VERCEL_WEBHOOK_SECRET= # shown once when creating the team webhook (→ /api/webhook/vercel)
