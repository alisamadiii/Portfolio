# Auth + tRPC + all CMS APIs are hosted by the portfolio app
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Shared Neon database (same as packages/drizzle / apps/portfolio)
# Only used by the collaborator-invites route — everything else goes through tRPC
DATABASE_URL="postgresql://user:password@host/db"

# Email (collaborator invites) — self-hosted useSend instance
USESEND_API_KEY="your-usesend-api-key"
# USESEND_URL="https://mail.alisamadii.com" # default, override for another instance

# Speed tab — PageSpeed Insights API key (browser-side; keyless quota is ~zero).
# Restrict it in Google Cloud to the PageSpeed Insights API + hub referrers.
NEXT_PUBLIC_PAGESPEED_API_KEY="your-pagespeed-api-key"
