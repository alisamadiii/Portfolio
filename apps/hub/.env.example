# Auth + tRPC + all CMS APIs (incl. all DB access) are hosted by the `api`
# app — the hub has no database connection of its own.
# Local dev: http://localhost:3000  ·  Prod: https://api.alisamadii.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# Speed tab — PageSpeed Insights API key (browser-side; keyless quota is ~zero).
# Restrict it in Google Cloud to the PageSpeed Insights API + hub referrers.
NEXT_PUBLIC_PAGESPEED_API_KEY=

# content-pilot base URL for the BROWSER: the AI session chat panel POSTs
# messages + opens its SSE stream directly against it (auth = the short-lived
# edit token). Local dev: http://localhost:3010 · Prod: https://pilot.alisamadii.com
NEXT_PUBLIC_CONTENT_PILOT_URL=http://localhost:3010

