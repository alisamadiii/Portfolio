{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uptime-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],

  // Vars are plain-text bindings; keep_vars stops redeploys from wiping
  // dashboard-set values (same lesson as the old agency-api worker).
  "keep_vars": true,

  "observability": { "enabled": true },

  // Every 10 minutes (src/index.ts scheduled handler).
  "triggers": { "crons": ["*/10 * * * *"] },

  "kv_namespaces": [
    {
      "binding": "MONITOR_KV",
      "id": "c7982af6b2154be9935a0921f57d8fee"
    }
  ],

  "vars": {
    // Workers cannot fetch non-standard ports, so http://<ip>:8000 will NOT
    // work here — must stay the https domain.
    "COOLIFY_URL": "https://coolify.alisamadii.com",
    "SES_REGION": "us-west-2",
    "ALERT_EMAIL_FROM": "Uptime Monitor <alerts@alisamadii.com>",
    "ALERT_EMAIL_TO": "agency@alisamadii.com"
  }

  // Secrets (never here — `wrangler secret put <NAME>`; local dev: .dev.vars):
  //   COOLIFY_API_TOKEN       Coolify → Keys & Tokens → API token (read-only)
  //   DISCORD_WEBHOOK_URL     Discord channel → Integrations → Webhooks
  //   AWS_ACCESS_KEY_ID       IAM key with ses:GetAccount + ses:SendEmail
  //   AWS_SECRET_ACCESS_KEY
  //   MONITOR_LOG_DB_URL      Portfolio Neon (= packages/drizzle DATABASE_URL) —
  //                           failing/near-miss runs logged to monitor_log
}
