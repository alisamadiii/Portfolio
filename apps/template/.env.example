# ── Email (useSend) ──
# Sends go through the self-hosted useSend instance and carry X-Project-Id /
# X-Email-Type headers. Handover: the client swaps this key for their own —
# no code changes needed.
USESEND_API_KEY=""
# USESEND_URL="https://mail.alisamadii.com" # default, override for another instance

# Hub project id (hub_project.id, a uuid) — stamps every send.
PROJECT_ID=""

# Where contact-form messages are delivered.
CONTACT_EMAIL=""

# Optional — defaults to no-reply@alisamadii.com (shared verified domain).
# EMAIL_FROM="Acme <no-reply@acme.com>"
