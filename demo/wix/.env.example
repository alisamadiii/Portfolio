# Wix Headless OAuth client ID (Wix dashboard > Settings > Headless settings > OAuth apps).
# Mints anonymous visitor tokens for reading the FAQ and submitting forms.
WIX_CLIENT_ID=

# Wix Forms form to post the contact form into. Dashboard > Forms & Submissions >
# open the form > the GUID in the URL. Leave empty to show the "connect a form" card.
WIX_FORM_ID=

# Optional, unused by this demo. The OAuth client secret is only needed for the
# member login redirect flow. Never commit it.
# WIX_CLIENT_SECRET=
