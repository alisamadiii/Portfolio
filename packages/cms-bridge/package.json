{
  "name": "@alisamadiillc/cms-bridge",
  "version": "0.3.1",
  "description": "CMS live-preview & in-page editing bridge for client sites — highlight fields from the CMS, edit text inline on the canvas",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./astro": {
      "import": {
        "types": "./dist/astro.d.ts",
        "default": "./dist/astro.js"
      },
      "require": {
        "types": "./dist/astro.d.cts",
        "default": "./dist/astro.cjs"
      }
    }
  },
  "bin": {
    "cms-bridge": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@astrojs/compiler": "^2.10.0",
    "es-module-lexer": "^1.5.0",
    "magicast": "^0.3.4",
    "mri": "^1.2.0",
    "picocolors": "^1.1.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@workspace/typescript-config": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "cms",
    "live-preview",
    "contenteditable",
    "astro-integration"
  ],
  "license": "MIT"
}
