{
  "name": "@alisamadiillc/cms-bridge",
  "version": "1.0.15",
  "description": "Build-time source annotator + click-to-request overlay: stamps every element with data-cms-src and posts plain-language change requests to content-pilot",
  "private": false,
  "type": "module",
  "exports": {
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./client": "./dist/client.global.js"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "astro": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/compiler": "^2.10.0"
  },
  "devDependencies": {
    "@workspace/typescript-config": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "cms",
    "astro-integration",
    "ai",
    "content-editing"
  ],
  "license": "MIT"
}
