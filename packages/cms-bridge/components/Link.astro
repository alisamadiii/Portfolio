---
/**
 * CMS-editable link. `value` is a `{ label, link }` object (the shared link
 * shape) or a plain href string. The anchor edits its URL via the canvas link
 * popover; the label renders as plain text (never a nested field — the label
 * is edited from the entry form or via the link popover).
 *
 *   <Link field="hero.cta" value={hero.cta} class="btn" />
 *   <Link field="hero.cta" value={hero.cta}><Icon /> {hero.cta.label}</Link>
 */
type LinkValue = { label?: string | null; link?: string | null };

interface Props {
  field: string | null | undefined;
  value?: LinkValue | string | null;
  class?: string;
  [key: string]: unknown;
}

const { field, value = "", ...rest } = Astro.props;
const isObject = typeof value === "object" && value !== null;
const href = typeof value === "string" ? value : String((value as LinkValue)?.link ?? "");
const label = isObject ? String((value as LinkValue).label ?? "") : "";
// Anchor commits a URL string, so it carries the leaf `.link` path when `value`
// is a {label, link} object; a bare string href tags the field itself. A falsy
// `field` (no cmsPath) renders a plain <a> with no CMS attributes.
const cmsField = field ? (isObject ? `${field}.link` : field) : undefined;
const hasChildren = Astro.slots.has("default");
---

<a
  data-cms-field={cmsField || undefined}
  data-cms-kind={cmsField ? "link" : undefined}
  href={href}
  {...rest}
>
  {hasChildren ? <slot /> : label}
</a>
