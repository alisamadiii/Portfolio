---
/**
 * CMS-editable text element. Renders `value` (with `backtick` accent and
 * **bold** inline markup) and tags itself with the field path + explicit kind,
 * so the canvas can edit it with zero guessing. `as` picks the HTML tag.
 *
 *   <Text as="p" field="hero.text" value={hero.text} class="lead" />
 *
 * Children override `value` — use them when you need custom inline markup:
 *
 *   <Heading1 field="hero.heading">Wood-fired <strong>pasta</strong></Heading1>
 *
 * `field` is required to pass, but may resolve to null/undefined (no cmsPath);
 * then the plain element renders with no CMS attributes.
 */
import { renderRich } from "@alisamadiillc/cms-bridge/rich";

interface Props {
  field: string | null | undefined;
  value?: string | number | null;
  as?: string;
  class?: string;
  /** Extra class(es) applied to **mark** spans in `value` (Tailwind etc.). */
  markClass?: string;
  /** Inline style applied to **mark** spans in `value`. */
  markStyle?: string;
  [key: string]: unknown;
}

const { field, value, as = "p", markClass, markStyle, ...rest } = Astro.props;
const Tag = as;
// Render the slot to a string so an EMPTY forwarded slot (the Heading* wrappers
// always pass `<slot/>`) falls back to `value` instead of blanking the field.
const slotHtml = Astro.slots.has("default")
  ? (await Astro.slots.render("default")).trim()
  : "";
const html = slotHtml || renderRich(String(value ?? ""), { markClass, markStyle });
---

<Tag
  data-cms-field={field || undefined}
  data-cms-kind={field ? "text" : undefined}
  data-cms-mark-class={(field && markClass) || undefined}
  data-cms-mark-style={(field && markStyle) || undefined}
  {...rest}
  set:html={html}
/>
