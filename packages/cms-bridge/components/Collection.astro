---
/**
 * Wrapper for a page region driven by a CMS collection (a Projects grid, Team
 * wall, etc. rendered from a `cms.json` collection). Tags the region with the
 * collection name so the canvas draws a purple outline and offers a button that
 * opens that collection's editor. Unlike <Group>, the entries are NOT edited
 * inline — the button jumps to the collection page.
 *
 *   <Collection collection="projects" class="grid">
 *     {projects.map((p) => <ProjectCard {...p} />)}
 *   </Collection>
 *
 * `collection` is required and must be a non-empty collection name.
 */
interface Props {
  collection: string;
  as?: string;
  class?: string;
  [key: string]: unknown;
}

const { collection, as = "div", ...rest } = Astro.props;
if (typeof collection !== "string" || collection.trim() === "")
  throw new Error(
    "cms-bridge <Collection> requires a non-empty `collection` name prop."
  );
const Tag = as;
---

<Tag data-cms-collection={collection} {...rest}>
  <slot />
</Tag>
