---
/**
 * Wrapper for repeated/mapped content (galleries, lists, card grids). Tags
 * the array's field path so the canvas can offer add/remove/reorder controls.
 * Each mapped child must be wrapped in an <Item index={i}>.
 *
 *   <Group field="gallery.images" class="grid">
 *     {images.map((image, i) => (
 *       <Item index={i}>
 *         <Image field={`gallery.images.${i}.src`} value={image.src} alt={image.alt} />
 *       </Item>
 *     ))}
 *   </Group>
 *
 * `field` is required to pass (from `cmsField(...)`), but may resolve to
 * null/undefined (no cmsPath — a collection card or non-preview render); then
 * the plain wrapper renders with no CMS attributes.
 */
interface Props {
  field: string | null | undefined;
  as?: string;
  class?: string;
  [key: string]: unknown;
}

const { field, as = "div", ...rest } = Astro.props;
const Tag = as;
---

<Tag
  data-cms-field={field || undefined}
  data-cms-kind={field ? "group" : undefined}
  {...rest}
>
  <slot />
</Tag>
