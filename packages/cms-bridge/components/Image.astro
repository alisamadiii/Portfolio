---
/**
 * CMS-editable image. Clicking it on the canvas opens the media picker.
 * The convention pairs `field` (the src) with a sibling alt key in the JSON:
 *
 *   <Image field="hero.image" value={hero.image} alt={hero.imageAlt} class="rounded" />
 *
 * `field` is required to pass, but may resolve to null/undefined (no cmsPath);
 * then a plain <img> renders with no CMS attributes.
 */
interface Props {
  field: string | null | undefined;
  value?: string | null;
  alt?: string | null;
  class?: string;
  [key: string]: unknown;
}

const { field, value = "", alt = "", ...rest } = Astro.props;
---

<img
  data-cms-field={field || undefined}
  data-cms-kind={field ? "media" : undefined}
  src={String(value ?? "")}
  alt={String(alt ?? "")}
  {...rest}
/>
