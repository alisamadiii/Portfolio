---
/**
 * The whole /admin page as one drop-in component. Requires @astrojs/react and
 * an SSR adapter in the consuming site (the route must not be prerendered).
 *
 * Reads PUBLIC_CLERK_PUBLISHABLE_KEY at request time server-side and hands it
 * to the client-only island as a prop — the /react module never touches env.
 */
import { AdminApp } from "@alisamadiillc/site-admin/react";

type Props = {
  siteName?: string;
  siteUrl?: string;
  apiBase?: string;
};

const publishableKey = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY ?? "";
const {
  siteName = import.meta.env.PUBLIC_SITE_NAME,
  siteUrl = "/",
  apiBase = "/api/admin",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{siteName ? `${siteName} — Admin` : "Admin"}</title>
  </head>
  <body style="margin:0">
    <AdminApp
      client:only="react"
      publishableKey={publishableKey}
      siteName={siteName}
      siteUrl={siteUrl}
      apiBase={apiBase}
    />
  </body>
</html>
