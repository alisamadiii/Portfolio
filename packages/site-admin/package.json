{
  "name": "@alisamadiillc/site-admin",
  "version": "0.1.0",
  "description": "Self-hosted /admin for client sites — WordPress-style content forms over the cms-bridge v2 JSON contract. Clerk (GitHub) login, commits straight to the client's own repo with their own token. No external dashboard in the publish path.",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./astro": {
      "import": {
        "types": "./dist/astro.d.ts",
        "default": "./dist/astro.js"
      },
      "require": {
        "types": "./dist/astro.d.cts",
        "default": "./dist/astro.cjs"
      }
    },
    "./astro/Admin.astro": "./astro-components/Admin.astro"
  },
  "files": [
    "dist",
    "astro-components"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@clerk/backend": "^2.0.0",
    "@clerk/clerk-react": "^5.0.0",
    "@octokit/rest": "^22.0.1",
    "@tanstack/react-query": "^5.0.0"
  },
  "peerDependencies": {
    "astro": ">=4.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@workspace/typescript-config": "workspace:*",
    "react": "^19.2.7",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "cms",
    "admin",
    "astro",
    "self-hosted",
    "github",
    "clerk"
  ],
  "license": "MIT"
}
